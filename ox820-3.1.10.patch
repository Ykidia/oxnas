+ * after the end of the vmalloc mapping region
+ */
+#define OXNAS_HW_PA_TO_VA(x) (VMALLOC_END + (x))
+
+/* Virtual address mapping of hardware core */
+#define USBHOST_BASE			OXNAS_HW_PA_TO_VA(0x00200000)
