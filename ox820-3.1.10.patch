+    TDES0_DP_BIT  = 27,
+    TDES0_CIC_BIT = 22,
+    TDES0_TER_BIT = 21,
+    TDES0_TCH_BIT = 20,
+    TDES0_IHE_BIT = 16,
+    TDES0_ES_BIT  = 15,
+    TDES0_JT_BIT  = 14,
+    TDES0_FF_BIT  = 13,
+    TDES0_IPE_BIT = 12,
+    TDES0_LOC_BIT = 11,
+    TDES0_NC_BIT  = 10,
+    TDES0_LC_BIT  = 9,
+    TDES0_EC_BIT  = 8,
+    TDES0_VF_BIT  = 7,
