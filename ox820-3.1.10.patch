+    gmac_priv_t			 *priv,
+    u32                   opcode,
+    u32                   operand,
+    cmd_que_ack_callback  callback);    // non-zero if ack. required
+
+#define COPRO_SEM_INT_CMD 0
+#define COPRO_SEM_INT_TX  1
+
