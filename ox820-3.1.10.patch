+/* IC+ Phy */
+#define IP1001LF_PHYSPECIFIC_CSR        16
+#define IP1001LF_PHYSPECIFIC_CSR_RXPHASE_SEL    (1  << 0)
+#define IP1001LF_PHYSPECIFIC_CSR_TXPHASE_SEL    (1  << 1)
+#define IP1001LF_PHYSPECIFIC_CSR_DRIVE_MASK     (15 << 5)
