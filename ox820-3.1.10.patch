+}
+
+static void ox820_gpiob_irq_unmask(struct irq_data* d)
+{
+	unsigned long flags;
+	int irqno = d->irq - ox820_gpiob_irq_base;
+	spin_lock_irqsave(&oxnas_gpio_spinlock, flags);
