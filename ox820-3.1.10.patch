+#define SYS_CTRL_DELAY_RX_RST   (1 << (16 + 0))
+#define SYS_CTRL_DELAY_RX_CE    (1 << (16 + 1))
+#define SYS_CTRL_DELAY_RX_INC   (1 << (16 + 2))
+#define SYS_CTRL_DELAY_RX_CLK   (1 << (16 + 3))
