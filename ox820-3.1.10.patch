+        printk("%#8.8x,", netoe_reg_read(priv, NETOE_TX_DESC_LIST_BASE+i+1));
+        printk("%#8.8x,", netoe_reg_read(priv, NETOE_TX_DESC_LIST_BASE+i+2));
+        printk("%#8.8x", netoe_reg_read(priv, NETOE_TX_DESC_LIST_BASE+i+3));
+        printk("\n");
+    }    
+}
