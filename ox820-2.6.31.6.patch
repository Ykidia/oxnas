+#define PCI_BUS_CMD_DUAL_ADDRESS_CYCLE          0x0d  
+#define PCI_BUS_CMD_MEMORY_READ_LINE            0x0e  
+#define PCI_BUS_CMD_MEMORY_WRITE_AND_INVALIDATE 0x0f  
