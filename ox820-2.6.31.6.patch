+	.ndo_open				= open,
+	.ndo_stop				= stop,
+	.ndo_start_xmit			= copro_hard_start_xmit,
+	.ndo_get_stats			= get_stats,
+	.ndo_set_multicast_list	= set_multicast_list,
+	.ndo_set_mac_address	= set_mac_address,
