+/** interrupt bits */
+#define OX820SATA_INT_END_OF_CMD      (1 << 0)
+#define OX820SATA_INT_LINK_SERROR     (1 << 1)
+#define OX820SATA_INT_ERROR           (1 << 2)
+#define OX820SATA_INT_LINK_IRQ        (1 << 3)
