+#define DPE_REGS_BASE          (APB_BRIDGE_B_BASE + 0x700000)
+#define IBW_REGS_BASE          (APB_BRIDGE_B_BASE + 0x780000)
+#define DDR_REGS_BASE          (APB_BRIDGE_B_BASE + 0x800000)
