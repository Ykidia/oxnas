+    return netoe_reg_read(priv, NETOE_TX_CARRIER_ERRORS);
+}
+
+/**
+ *  get the netoe status
+ */ 
+unsigned long netoe_get_status(gmac_priv_t *priv)
+{
+    return netoe_reg_read(priv, NETOE_STATUS);
+}
