+#define MAC_BASE_2	(ETHB_BASE)
+#define USBDEV_BASE				OXNAS_HW_PA_TO_VA(0x00E00000)
+#define STATIC_CS0_BASE			OXNAS_HW_PA_TO_VA(0x01000000)
