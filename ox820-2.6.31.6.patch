+static void DumpPRDTable(struct ata_prd* prd) {
+    u32 count = 0;
+    printk("PRD Table at %p\n",prd);
+    while(prd) {
+        printk("    A %08x LF %x\n",prd->addr, prd->flags_len);
+        if ((prd->flags_len & ATA_PRD_EOT) || (count > ATA_MAX_PRD))
+            break;
+        count++;
+        prd++;
+    } 
+}
