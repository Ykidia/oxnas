--- a/drivers/usb/gadget/dwc_common_port/dwc_cc.h	1970-01-01 03:00:00.000000000 +0300
+++ b/drivers/usb/gadget/dwc_common_port/dwc_cc.h	2022-11-13 02:12:43.000000000 +0300
@@ -0,0 +1,209 @@
