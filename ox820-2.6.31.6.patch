+		 * In Host mode this bit contains handsake response to 
+		 * LPM transaction.
+		 * In Device mode the response of the core to 
+		 * LPM transaction received is reflected in these two bits.
+		 	- 0x0 : ERROR (No handshake response)
+			- 0x1 : STALL
+			- 0x2 : NYET
+			- 0x3 : ACK			
+		 */
+		unsigned lpm_resp:2;
