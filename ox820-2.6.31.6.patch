+/*#define PCI_BUS_RESERVED                      0x08  */
+/*#define PCI_BUS_RESERVED                      0x09  */
+#define PCI_BUS_CMD_CONFIGURATION_READ          0x0a  
+#define PCI_BUS_CMD_CONFIGURATION_WRITE         0x0b  
