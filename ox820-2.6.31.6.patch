+static void link_state_change_callback(
+	int   link_state,
+	void *arg)
+{
+	gmac_priv_t* priv = (gmac_priv_t*)arg;
+
+	priv->link_state = link_state;
+	schedule_work(&priv->link_state_change_work);
+}
