+typedef enum gmac_mac_regs {
+    NETOE_JOB_QUEUE_BASE    =  0,
+    NETOE_JOB_QUEUE_FILL    =  1,
+    NETOE_JOB_RPTR          =  2,
+    NETOE_JOB_WPTR          =  3,
+    NETOE_MTU               =  4,
+    NETOE_CONTROL           =  5,
+    NETOE_STATUS            =  6,
+    NETOE_COMPLETE_COUNT    =  7,
+    NETOE_TX_BYTES          =  8,
