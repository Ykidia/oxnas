+/**
+ *
+ */
+void ox820sata_freeze_host(int port_no)
+{
+    set_bit(port_no, &ox820sata_driver.port_in_eh);
+    smp_wmb();
+}
+
+void ox820sata_thaw_host(int port_no)
+{
+    clear_bit(port_no, &ox820sata_driver.port_in_eh);
+    smp_wmb();
+}
