+static int
+oxnas_wd810_leds_suspend(struct platform_device *pdev, pm_message_t state)
+{
+	int n = leds_created;
+	while (n > 0) {
+		if (--n < ARRAY_SIZE(oxnas_led_classes)) {
+			led_classdev_suspend(oxnas_led_classes[n]);
+		}
+	}
+
+	return 0;
+}
