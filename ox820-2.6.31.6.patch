--- a/arch/arm/mach-oxnas/irq.c	1970-01-01 03:00:00.000000000 +0300
+++ b/arch/arm/mach-oxnas/irq.c	2022-11-13 02:12:41.000000000 +0300
@@ -0,0 +1,67 @@
