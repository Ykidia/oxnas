+/***************************************************************************/
+static struct led_classdev oxnas_wd810_leds_capacity_gauge = {
+	.name = "oxnas-wd810-leds:capacity",
+	.brightness_set = oxnas_wd810_leds_set_capacity_gauge,
+};
