+{
+	struct device *dev = &pdev->dev;
+	device_create_file(dev, &dev_attr_registers);
+}
+
+static void remove_debug_files(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	device_remove_file(dev, &dev_attr_registers);
+}
