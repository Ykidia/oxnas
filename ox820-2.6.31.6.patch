+		unsigned descdma : 1;
+		/** Frame List Entries */
+		unsigned frlisten: 2;
+		/** Enable Periodic Scheduling */
+		unsigned perschedena: 1;
+		/** Periodic Scheduling Enabled Status */
+		unsigned perschedstat: 1;
+	} b;
+} hcfg_data_t;
