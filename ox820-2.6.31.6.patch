+/* synopsis PCI core register set */
+#define PCI_CORE_REG_START                     PCI_CSRS_BASE
+#define PCI_CRP_CMD_AND_ADDR                   PCI_CORE_REG_START
+#define PCI_CRP_WRITE_DATA                    (PCI_CRP_CMD_AND_ADDR       + 4)
