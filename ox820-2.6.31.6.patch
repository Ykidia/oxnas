+	*((volatile unsigned long*)SYS_CTRL_GPIO_TERTSEL_CTRL_0) |= (1UL << PCI_GPIO_CLKO_0);
+#endif // CONFIG_ARCH_OXNAS_PCI_CLKOUT_0
