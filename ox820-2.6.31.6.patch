 		else if (mapping)
 			__flush_icache_all();
+		set_bit(PG_dcache_clean, &page->flags);
 	}
 }
+#endif // CONFIG_SMP_LAZY_DCACHE_FLUSH
+
 EXPORT_SYMBOL(flush_dcache_page);
 
 /*
@@ -261,5 +373,5 @@
 	 * in this mapping of the page.  FIXME: this is overkill
