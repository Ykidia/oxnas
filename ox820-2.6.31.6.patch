+	}
+
+	if (trustees_init_security() != 0) {
+		trustees_deinit_fs();
+		trustees_funcs_cleanup_globals();
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+fs_initcall(trustees_init);
