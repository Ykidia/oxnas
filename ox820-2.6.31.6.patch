+/*
+ * SATA interrupt handler
+ */
+#ifdef CONFIG_SATA_OX810
+static irqreturn_t isr(int irq, unsigned long arg)
+#elif defined(CONFIG_SATA_OX820_DIRECT)
+static void isr(int error, void *data)
+#endif // CONFIG_SATA_XXX
+{
+	int  need_wmb = 0;
+#ifdef CONFIG_SATA_OX810
+	u32 *port_base;
+	u32  int_status;
+	int  sata_status;
+#ifndef CONFIG_ODRB_USE_COMBINED_SATA_INTERRUPT
+	int  dma_wait_loops;
+#endif // CONFIG_ODRB_USE_COMBINED_SATA_INTERRUPT
+#endif // CONFIG_SATA_OX810
+
+#ifdef CONFIG_SATA_OX810
+//printk("isr() irq %d, arg %p\n", irq, (void*)arg);
+#elif defined(CONFIG_SATA_OX820_DIRECT)
+//printk("isr() error %d, data %p\n", error, data);
+#endif // CONFIG_SATA_OX810
+
+	// This interrupt should be for us and it's therefore a major problem if we
+	// don't have the tracking for the in-progress fill setup
+	smp_rmb();
+	BUG_ON(!current_fill_progress_s);
+
+#ifdef CONFIG_SATA_OX810
+	if (!current_fill_progress_s->entry) {
+		printk(KERN_WARNING "incoherent_sendfile.isr() No fill entry set\n");
+		return IRQ_NONE;
+	}
+#elif defined(CONFIG_SATA_OX820_DIRECT)
+	BUG_ON(!current_fill_progress_s->entry);
+#endif // CONFIG_SATA_OX820_DIRECT
+
+#ifdef CONFIG_SATA_OX810
+	// From which port should the interrupt have come?
+	port_base = (current_fill_progress_s->context->inode->filemap_info.port == 0) ?
+		(u32*)SATA0_REGS_BASE : (u32*)SATA1_REGS_BASE;
+
+	// Was the interrupt generated by the port?
+	int_status = readl(port_base + OX810SATA_INT_STATUS);
+
+	if (!(int_status & OX810SATA_INT_WANT)) {
+		printk(KERN_WARNING "incoherent_sendfile.isr() Int not for us\n");
+		return IRQ_NONE;
+	}
+
+	// Disable all interrupts for ports and RAID controller
+	writel(~0, (u32*)SATA0_REGS_BASE + OX810SATA_INT_DISABLE);
+	writel(~0, (u32*)SATA1_REGS_BASE + OX810SATA_INT_DISABLE);
+	writel(~0, (u32*)SATARAID_REGS_BASE + OX810SATA_INT_DISABLE);
+
+	// Disable all interrupts for core
+	writel(~0, OX810SATA_CORE_IEC);
+
+#ifdef CONFIG_ODRB_USE_COMBINED_SATA_INTERRUPT
+#error "Combined SATA/DMA interrupt not yet supported"
+#else // CONFIG_ODRB_USE_COMBINED_SATA_INTERRUPT
+	// For reads the DMA controller may finish slightly after the SATA
+	// controller, so we should allow a little time for the DMA channel to
+	// become inactive
+	dma_wait_loops = 0;
+	while (odrb_dma_isactive(current_fill_progress_s->is_sg)) {
+		printk("@");
+		if (++dma_wait_loops >= 10) {
+			printk(KERN_WARNING "incoherent_sendfile.isr() Give up on wait for DMA to complete\n");
+			break;
+		}
+	}
+
+	// Force DMA to finish if it hasn't already
+	odrb_dma_abort(current_fill_progress_s->is_sg);
+#endif // CONFIG_ODRB_USE_COMBINED_SATA_INTERRUPT
+
+	// Housekeeping after completion of the DMA transfer
+	// May not be required with PRD/non-legacy SATA/DMA mode, but shouldn't
+	// do any harm
+	odrb_dma_postop_housekeeping(current_fill_progress_s->is_sg);
+#endif // CONFIG_SATA_OX810
+
+	if (current_fill_progress_s->is_sg) {
+		// Relinquish ownership of the SG list used for the DMA transfer
+#ifdef CONFIG_ODRB_USE_PRDS
+		BUG_ON(!current_fill_progress_s->prd_list);
+		odrb_reader_free_prd_array(current_fill_progress_s->prd_list);
+#else // CONFIG_ODRB_USE_PRDS
+		BUG_ON(!current_fill_progress_s->sg_list);
+		odrb_reader_free_sg_list(current_fill_progress_s->sg_list);
+#endif // CONFIG_ODRB_USE_PRDS
+		current_fill_progress_s->is_sg = 0;
+		need_wmb = 1;
+	}
+
+#ifdef CONFIG_SATA_OX810
+	sata_status = sata_transfer_complete(port_base);
+	if (sata_status == 0) {
+		// Don't expect a SATA interrupt before the SATA core has become !busy,
+		printk(KERN_WARNING "incoherent_sendfile.isr() Transfer not yet complete\n");
+		BUG();
+
+		// Check for an unfinished SATA command that requires aborting
+		// Don't know how to do this yet due to the convoluted SATA stack core
+	}
+
+	if (sata_status < 0) {
+#elif defined(CONFIG_SATA_OX820_DIRECT)
+	if (error) {
+#endif // CONFIG_SATA_XXX
+		// Record that the transfer failed, so the block(s) can be disgarded
+		current_fill_progress_s->entry->failed = 1;
+		++current_fill_progress_s->context->failure_count;
+		need_wmb = 1;
+printk("isr() Transfer failed total failures %d\n", current_fill_progress_s->context->failure_count);
+	}
+
+	if (likely(need_wmb)) {
+		// Ensure tasklet will see changes to current_fill_progress_s and entry
+		// that were made without fill lock held
+		smp_wmb();
+	}
+
+//printk("isr() Schedule tasklet\n");
+	tasklet_hi_schedule(&tasklet_s);
+
+#ifdef CONFIG_SATA_OX810
+	return IRQ_HANDLED;
+#endif // CONFIG_SATA_OX810
+}
