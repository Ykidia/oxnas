+static void work_handler(struct work_struct *ws) {
+	gmac_priv_t *priv = container_of(ws, gmac_priv_t, link_state_change_work);
+
+	kobject_uevent(&priv->link_state_kobject, priv->link_state ? KOBJ_ONLINE : KOBJ_OFFLINE);
+}
