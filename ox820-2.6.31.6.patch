+	if (ip->i_d.di_format != XFS_DINODE_FMT_EXTENTS &&
+		ip->i_d.di_format != XFS_DINODE_FMT_BTREE &&
+		ip->i_d.di_format != XFS_DINODE_FMT_LOCAL)
