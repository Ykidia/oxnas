+void odrb_dma_sata_prd_nogo(
+    oxnas_dma_direction_t dir,
+	unsigned long         nsects,
+	dma_addr_t            prds_phys)
+{
+    _odrb_dma_sata_prd(dir, nsects, prds_phys, 0, 0);
+}
