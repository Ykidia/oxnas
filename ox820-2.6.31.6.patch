+            unsigned long psize = PAGE_CACHE_SIZE - offset;
+            struct page *page_it;
+        
+            psize = PAGE_CACHE_SIZE - offset;
+            if (size <= psize) {
+                psize = size;                
+            }
+            page_it = *page;
+            ret += sock_no_sendpage(sock, page_it, offset, psize, flags);
+            size -= psize;            
+            page++;
+            offset += psize;
+            offset &= (PAGE_CACHE_SIZE - 1);
+        }
+		return ret;        
