+static int start_oxnas_usb_ehci(struct platform_device *dev)
+{
+    unsigned long flags;
+    unsigned long input_polarity = 0;
+    unsigned long output_polarity = 0;
+    unsigned long power_switch_mask = 0;
+    unsigned long power_monitor_mask = 0;
+    unsigned long power_lines_mask = 0;
+
+	if (usb_disabled())
+		return -ENODEV;
+
+	pr_debug("block sizes: qh %zd qtd %zd itd %zd sitd %zd\n",
+		sizeof (struct ehci_qh), sizeof (struct ehci_qtd),
+		sizeof (struct ehci_itd), sizeof (struct ehci_sitd));
+
+#ifdef CONFIG_OXNAS_USB_PORTA_POWER_CONTROL
+    power_switch_mask  |= (1UL << USBA_POWO_GPIO);
+    power_monitor_mask |= (1UL << USBA_OVERI_GPIO);
+#endif // CONFIG_OXNAS_USB_PORTA_POWER_CONTROL
+
+#ifdef CONFIG_OXNAS_USB_PORTB_POWER_CONTROL
+    power_switch_mask  |= (1UL << USBB_POWO_GPIO);
+    power_monitor_mask |= (1UL << USBB_OVERI_GPIO);
+#endif // CONFIG_OXNAS_USB_PORTB_POWER_CONTROL
+
+#ifdef CONFIG_OXNAS_USB_PORTC_POWER_CONTROL
+    power_switch_mask  |= (1UL << USBC_POWO_GPIO);
+    power_monitor_mask |= (1UL << USBC_OVERI_GPIO);
+#endif // CONFIG_OXNAS_USB_PORTC_POWER_CONTROL
+
+    power_lines_mask = power_switch_mask | power_monitor_mask;
+
+    // Configure USB power monitoring input and switch output GPIOs
+#ifdef CONFIG_OXNAS_USB_OVERCURRENT_POLARITY_NEGATIVE
+    input_polarity = ((1UL << SYS_CTRL_USBHSMPH_IP_POL_A_BIT) |
+                      (1UL << SYS_CTRL_USBHSMPH_IP_POL_B_BIT) |
+                      (1UL << SYS_CTRL_USBHSMPH_IP_POL_C_BIT));
+#endif // CONFIG_OXNAS_USB_OVERCURRENT_POLARITY_NEGATIVE
+
+#ifdef CONFIG_OXNAS_USB_POWER_SWITCH_POLARITY_NEGATIVE
+    output_polarity = ((1UL << SYS_CTRL_USBHSMPH_OP_POL_A_BIT) |
+                       (1UL << SYS_CTRL_USBHSMPH_OP_POL_B_BIT) |
+                       (1UL << SYS_CTRL_USBHSMPH_OP_POL_C_BIT));
+#endif // CONFIG_OXNAS_USB_POWER_SWITCH_POLARITY_NEGATIVE
+
+    // Enable primary function on USB power monitor and switch lines
+    spin_lock_irqsave(&oxnas_gpio_spinlock, flags);
+    oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, power_lines_mask);
+    oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~power_lines_mask, 0);
+    oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~power_lines_mask, 0);
+    spin_unlock_irqrestore(&oxnas_gpio_spinlock, flags);
+
+    // Enable GPIO output on USB power switch output GPIOs
+    oxnas_gpio_write(GPIO_A_OUTPUT_ENABLE_SET, power_switch_mask);
+
+    // Enable GPIO input on USB power monitoring input GPIOs
+    oxnas_gpio_write(GPIO_A_OUTPUT_ENABLE_CLEAR, power_monitor_mask);
+
+    // Set the polarity of the USB power switch output and monitoring
+    // inputs in system control
+    if (usb_patch) {
+        oxnas_sys_write(SYS_CTRL_USBHSMPH_CTRL, input_polarity | output_polarity | (1<<6));
+    }
+    else {
+            oxnas_sys_write(SYS_CTRL_USBHSMPH_CTRL, input_polarity | output_polarity);
+    }
+    
+    // Ensure the USB block is properly reset
+    oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_USBHS_BIT);
+    oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_USBHS_BIT);
+    oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_USBHSPHY_BIT);
+    oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_USBHSPHY_BIT);
+
+    // Force the high speed clock to be generated all the time, via serial
+    // programming of the USB HS PHY
+    oxnas_sys_write(SYS_CTRL_USBHSPHY_CTRL, (2UL << SYS_CTRL_USBHSPHY_TEST_ADD_BIT)
+           | (0xe0UL << SYS_CTRL_USBHSPHY_TEST_DIN_BIT));
+
+    oxnas_sys_write(SYS_CTRL_USBHSPHY_CTRL, (1UL << SYS_CTRL_USBHSPHY_TEST_CLK_BIT)
+           | (2UL << SYS_CTRL_USBHSPHY_TEST_ADD_BIT)
+           | (0xe0UL << SYS_CTRL_USBHSPHY_TEST_DIN_BIT));
+
+    oxnas_sys_write(SYS_CTRL_USBHSPHY_CTRL, (0xfUL << SYS_CTRL_USBHSPHY_TEST_ADD_BIT)
+           | (0xaaUL << SYS_CTRL_USBHSPHY_TEST_DIN_BIT));
+
+    oxnas_sys_write(SYS_CTRL_USBHSPHY_CTRL, (1UL << SYS_CTRL_USBHSPHY_TEST_CLK_BIT)
+           | (0xfUL << SYS_CTRL_USBHSPHY_TEST_ADD_BIT)
+           | (0xaaUL << SYS_CTRL_USBHSPHY_TEST_DIN_BIT));
+
+    // Enable the clock to the USB block
+    oxnas_sys_write(SYS_CTRL_CKEN_SET_CTRL, 1UL << SYS_CTRL_CKEN_USBHS_BIT);
+
+    // Ensure reset and clock operations are complete
+    wmb();
+
+	return 0;
+}
+
+static void stop_oxnas_usb_ehci(struct platform_device *dev)
+{
+	// put usb core into reset
+    oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_USBHS_BIT);
+
+    // Disable the clock to the USB block
+    oxnas_sys_write(SYS_CTRL_CKEN_CLR_CTRL, 1UL << SYS_CTRL_CKEN_USBHS_BIT);
+}
+
+/**
+ * usb_hcd_oxnas_probe - initialize OXNAS-based HCD
+ * Context: !in_interrupt()
+ *
+ * Allocates basic resources for this USB host controller.
+ *
+ */
+static int usb_hcd_oxnas_probe(const struct hc_driver *driver, struct platform_device *pdev)
+{
+	u32 ehci_id;
+	struct usb_hcd *hcd = 0;
+	void __iomem *port_base = NULL;
+	int retval, irq = 0;
+
+	// Get IRQ line
+	if (pdev->dev.of_node != NULL)
+		irq = irq_of_parse_and_map(pdev->dev.of_node, 0);
+	if (irq <= 0)
+		irq = platform_get_irq(pdev, 0);
+	if (irq <= 0) {
+		dev_err(&pdev->dev, "Failed to acquire IRQ line\n");
+		retval = irq == 0 ? -ENXIO : irq;
+		goto probe_err;
+	}
+
+	port_base = oxnas_devm_platform_get_and_ioremap_resource(pdev, 0, NULL);
+	if (IS_ERR(port_base)) {
+		dev_err(&pdev->dev, "Failed to map registers region\n");
+		return PTR_ERR(port_base);
+	}
+	start_oxnas_usb_ehci(pdev);
+
+	if (((ehci_id = readl(port_base)) & 0x2f) != 0x05) {
+		dev_err(&pdev->dev, "Unsupported chip found id=0x%08x\n", ehci_id);
+		retval = -ENODEV;
+		goto probe_err;
+	}
+
+	hcd = usb_create_hcd(driver, &pdev->dev, "usb");
+	if (!hcd) {
+		dev_err(&pdev->dev, "Failed to create an HCD\n");
+		retval = -ENOMEM;
+		goto probe_err;
+	}
+	hcd->rsrc_start = (resource_size_t)port_base;
+	hcd->regs = port_base + 0x100; /* adjust to point at cap length register */
+	hcd->irq = irq;
+
+	/* OXNAS device has a transaction translator */
+	hcd->has_tt = 1;
+
+	/* Finished initialisation and register */
+	if ((retval = usb_add_hcd(hcd, irq, 0))) {
+		pr_debug("Failed to add HCD\n");
+		goto probe_err;
+	}
+
+//	dev_info(&pdev->dev, "id=0x%08x, iomap=0x%08X\n", ehci_id, (u32)port_base);
+
+	return 0;
+
+probe_err:
+	if (port_base != NULL) {
+		iounmap(port_base);
+	}
+	if (hcd != NULL)
+		usb_put_hcd(hcd);
+	stop_oxnas_usb_ehci(pdev);
+
+	return retval;
+}
+
+/**
+ * usb_hcd_oxnas_remove - shutdown processing for OXNAS-based HCD
+ * @dev: USB Host Controller being removed
+ * Context: !in_interrupt()
+ *
+ * Reverses the effect of usb_hcd_oxnas_probe(), first invoking
+ * the HCD's stop() method.  It is always called from a thread
+ * context, normally "rmmod", "apmd", or something similar.
+ *
+ */
+static void usb_hcd_oxnas_remove(struct usb_hcd *hcd, struct platform_device *dev)
+{
+	if (hcd != NULL) {
+		if (hcd->rsrc_start != 0)
+			iounmap((void *)hcd->rsrc_start);
+	}
+	usb_remove_hcd(hcd);
+	usb_put_hcd(hcd);
+	stop_oxnas_usb_ehci(dev);
+}
+
+static int ehci_hcd_oxnas_drv_probe(struct platform_device *dev)
+{
+	if (usb_disabled()) {
+		dev_err(&dev->dev, "USB disabled\n");
+		return -ENODEV;
+	}
+
+	pr_info("%s: " DRIVER_DESC "\n", DRIVER_NAME);
+	return usb_hcd_oxnas_probe(&ehci_oxnas_driver, dev);
+}
+
+static int ehci_hcd_oxnas_drv_remove(struct platform_device *dev)
+{
+	usb_hcd_oxnas_remove(platform_get_drvdata(dev), dev);
+	return 0;
+}
