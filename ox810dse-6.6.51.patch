+static void oxnas_power_off(void)
+{
+	local_irq_disable();
+	smp_send_stop();
+
+	// Disable IRQs and FIQs
+	oxnas_disable_all_irqs_fiqs();
+
+	// Turn of power to SATA disk if possible
+	oxnas_sata_power_off();
+
+	// Disable clocks to cores as per power-on defaults
+	oxnas_sys_write(SYS_CTRL_CKEN_CLR_CTRL,
+		(1UL << SYS_CTRL_CKEN_PCI_BIT)
+#if !defined(CONFIG_LEON_POWER_BUTTON_MONITOR) && !defined(CONFIG_LEON_POWER_BUTTON_MONITOR_MODULE)
+			| (1UL << SYS_CTRL_CKEN_COPRO_BIT)
+#endif
+			| (1UL << SYS_CTRL_CKEN_MAC_BIT)
+			| (1UL << SYS_CTRL_CKEN_DMA_BIT)
+			| (1UL << SYS_CTRL_CKEN_DPE_BIT)
+			| (1UL << SYS_CTRL_CKEN_SATA_BIT)
+			| (1UL << SYS_CTRL_CKEN_I2S_BIT)
+			| (1UL << SYS_CTRL_CKEN_USBHS_BIT)
+			| (1UL << SYS_CTRL_CKEN_STATIC_BIT));
+
+#if defined(CONFIG_LEON_POWER_BUTTON_MONITOR) || defined(CONFIG_LEON_POWER_BUTTON_MONITOR_MODULE)
+	// Load CoPro program and start it running
+	init_copro(leon_power_button_srec, oxnas_global_invert_leds);
+#else
+	// Set sys-control pin mux'ing as per power-on defaults
+	oxnas_sys_write(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, 0x800UL);
+	oxnas_sys_write(SYS_CTRL_GPIO_PRIMSEL_CTRL_1, 0);
+	oxnas_sys_write(SYS_CTRL_GPIO_SECSEL_CTRL_0, 0);
+	oxnas_sys_write(SYS_CTRL_GPIO_SECSEL_CTRL_1, 0);
+	oxnas_sys_write(SYS_CTRL_GPIO_TERTSEL_CTRL_0, 0);
+	oxnas_sys_write(SYS_CTRL_GPIO_TERTSEL_CTRL_1, 0);
+#endif // CONFIG_LEON_POWER_BUTTON_MONITOR
+
+	while (1) {
+		if (arm_pm_idle != NULL)
+			arm_pm_idle();
+	}
+}
