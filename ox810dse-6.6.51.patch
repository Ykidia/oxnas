+static void oxnas_setup_sata_power(void)
+{
+#ifdef CONFIG_OXNAS_SATA_POWER_1
+	// Disable primary, secondary and teriary GPIO functions on SATA 1 power line
+	oxnas_sys_andor(CONFIG_OXNAS_SATA_POWER_GPIO_1 < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_PRIMSEL_CTRL_0 : SYS_CTRL_GPIO_PRIMSEL_CTRL_1,
+		~SATA_POWER_1_MASK, 0);
+	oxnas_sys_andor(CONFIG_OXNAS_SATA_POWER_GPIO_1 < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_SECSEL_CTRL_0 : SYS_CTRL_GPIO_SECSEL_CTRL_1,
+		~SATA_POWER_1_MASK, 0);
+	oxnas_sys_andor(CONFIG_OXNAS_SATA_POWER_GPIO_1 < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_TERTSEL_CTRL_0 : SYS_CTRL_GPIO_TERTSEL_CTRL_1,
+		~SATA_POWER_1_MASK, 0);
+
+	// Enable power to SATA 1
+	oxnas_gpio_write(CONFIG_OXNAS_SATA_POWER_GPIO_1 < GPIO_AB_NUM_PINS
+			? GPIO_A_OUTPUT_SET : GPIO_B_OUTPUT_SET,
+		SATA_POWER_1_MASK);
+
+	// Enable GPIO output on SATA 1 power line
+	oxnas_gpio_write(CONFIG_OXNAS_SATA_POWER_GPIO_1 < GPIO_AB_NUM_PINS
+			? GPIO_A_OUTPUT_ENABLE_SET : GPIO_B_OUTPUT_ENABLE_SET,
+		SATA_POWER_1_MASK);
+#endif // CONFIG_OXNAS_SATA_POWER_1
+
+#ifdef CONFIG_OXNAS_SATA_POWER_2
+	// Disable primary, secondary and teriary GPIO functions on SATA 2 power line
+	oxnas_sys_andor(CONFIG_OXNAS_SATA_POWER_GPIO_2 < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_PRIMSEL_CTRL_0 : SYS_CTRL_GPIO_PRIMSEL_CTRL_1,
+		~SATA_POWER_2_MASK, 0);
+	oxnas_sys_andor(CONFIG_OXNAS_SATA_POWER_GPIO_2 < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_SECSEL_CTRL_0 : SYS_CTRL_GPIO_SECSEL_CTRL_1,
+		~SATA_POWER_2_MASK, 0);
+	oxnas_sys_andor(CONFIG_OXNAS_SATA_POWER_GPIO_2 < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_TERTSEL_CTRL_0 : SYS_CTRL_GPIO_TERTSEL_CTRL_1,
+		~SATA_POWER_2_MASK, 0);
+
+	// Enable power to SATA 2
+	oxnas_gpio_write(CONFIG_OXNAS_SATA_POWER_GPIO_2 < GPIO_AB_NUM_PINS
+			? GPIO_A_OUTPUT_SET : GPIO_B_OUTPUT_SET,
+		SATA_POWER_2_MASK);
+
+	// Enable GPIO output on SATA 2 power line
+	oxnas_gpio_write(CONFIG_OXNAS_SATA_POWER_GPIO_2 < GPIO_AB_NUM_PINS
+			? GPIO_A_OUTPUT_ENABLE_SET : GPIO_B_OUTPUT_ENABLE_SET,
+		SATA_POWER_2_MASK);
+#endif // CONFIG_OXNAS_SATA_POWER_2
+
+}
