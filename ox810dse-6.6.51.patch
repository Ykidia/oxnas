+/**
+ * Optionally blocking acquisition of a DMA channel
+ * May be invoked either at task or softirq level
+ */
+struct dma_chan *oxnas_dma_request_chan(
+	struct device                   *const dev,
+	oxnas_dma_device_settings_t     *const settings)
+{
+	oxnas_adma_channel_t *channel = NULL;
+
+	if (adma_priv == NULL)
+		return NULL;
+
+	while (channel == NULL) {
+		// Serialise while manipulating free list
+		spin_lock_bh(&adma_priv->channel_alloc_spinlock_);
+
+		// It's an error if there isn't a channel available at this point
+		channel = adma_priv->channel_head_;
+		if (channel == NULL) {
+			// Finished manipulating free list
+			spin_unlock_bh(&adma_priv->channel_alloc_spinlock_);
+			adma_err("channels are unavailable\n");
+			return NULL;
+		}
+
+		// Unlink the head entry on the free list and return it to caller
+		adma_priv->channel_head_ = channel->next_;
+
+		// Finished manipulating free list
+		spin_unlock_bh(&adma_priv->channel_alloc_spinlock_);
+
+		if (channel->common.device == NULL) {
+			adma_err("channel %u is not initialized\n", channel->common.chan_id);
+			continue;
+		}
+
+		if (settings != NULL &&
+		    settings->max_sg_entries_ >= adma_priv->sg_entries_per_channel) {
+///			adma_warn("not enough descriptors for channel %u, requested %u while only %u is available\n",
+///				channel->common.chan_id, settings->max_sg_entries_, adma_priv->sg_entries_per_channel - 1);
+			settings->max_sg_entries_ = adma_priv->sg_entries_per_channel - 1;
+		}
+
+		if (channel->sg_entries_ != NULL && dev != NULL) {
+			channel->settings = settings;
+/*
+			if (channel->settings == &oxnas_sata_dma_settings) {
+				const struct dma_map_ops *common_dma_ops = get_dma_ops(dev);
+				if (dev->dma_ops == NULL && common_dma_ops != NULL) {
+					struct dma_map_ops *new_dma_ops = devm_kmemdup(
+						dev, common_dma_ops, sizeof(struct dma_map_ops), GFP_KERNEL);
+					if (new_dma_ops != NULL) {
+						adma_info("setting up channel %u operations optimized for SATA\n",
+							channel->common.chan_id);
+						new_dma_ops->map_sg = oxnas_dma_map_sata_sg;
+						new_dma_ops->unmap_sg = oxnas_dma_unmap_sata_sg;
+						set_dma_ops(dev, new_dma_ops);
+						if (dev->platform_data != NULL)
+							adma_warn("platform_data is not NULL\n");
+						dev->platform_data = channel;
+					}
+				}
+			}
+*/
+		}
+	}
+
+	if (channel != NULL)
+		return &channel->common;
+
+	return NULL;
+}
+
+/**
+ * May be invoked either at task or softirq level
+ */
+static inline void oxnas_dma_free(oxnas_adma_channel_t *const channel)
+{
+	if (oxnas_dma_busy_check(channel))
+		adma_warn("freeing channel %u while active\n", channel->common.chan_id);
+
+	// Serialise while manipulating free list
+	spin_lock_bh(&adma_priv->channel_alloc_spinlock_);
+
+	// Insert the freed buffer at the head of the free list
+	channel->next_ = adma_priv->channel_head_;
+	adma_priv->channel_head_ = channel;
+
+	// Finished manipulating free list
+	spin_unlock_bh(&adma_priv->channel_alloc_spinlock_);
+}
+
+void oxnas_dma_free_chan(struct dma_chan *const chan)
+{
+	oxnas_adma_channel_t *const channel = container_of(chan, oxnas_adma_channel_t, common);
+	oxnas_dma_free(channel);
+}
