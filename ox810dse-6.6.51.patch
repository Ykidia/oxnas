+
+extern spinlock_t oxnas_gpio_spinlock;
+
+static int usb_patch = 1;
+module_param(usb_patch, int, S_IRUGO);
+MODULE_PARM_DESC(usb_patch, "use usb hw patch");
+
+//static const char hcd_name[] = DRIVER_NAME;
