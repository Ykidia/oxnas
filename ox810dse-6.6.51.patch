+#define    TX_BUFFER_LEVEL                 0x0040
+#define    TX_BUFFER_INTERRUPT_LEVEL       0x0048
+#define    RX_BUFFER_LEVEL                 0x0050
+#define    RX_BUFFER_INTERRUPT_LEVEL       0x0058
