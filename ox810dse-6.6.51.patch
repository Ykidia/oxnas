+/**
+ * Builtins
+ */
+bool oxnas_ioremap(void __iomem **baseptr, resource_size_t res_cookie, size_t size)
+{
+	if (*baseptr >= (void *)VMALLOC_START && *baseptr < (void *)VMALLOC_END) {
+		printk(KERN_WARNING "%s(): area [0x%08X..0x%08X] already remapped\n",
+			__func__, res_cookie, res_cookie + size - 1);
+		return true;
+	}
+	*baseptr = ioremap_wc(res_cookie, size);
+	if (*baseptr < (void *)VMALLOC_START) {
+		*baseptr = NULL;
+		printk(KERN_ERR "%s(): error area [0x%08X..0x%08X] remap\n",
+			__func__, res_cookie, res_cookie + size - 1);
+		return false;
+	}
+	return true;
+}
+
+bool oxnas_ioremap_wc(void __iomem **baseptr, resource_size_t res_cookie, size_t size)
+{
+	if (*baseptr >= (void *)VMALLOC_START && *baseptr < (void *)VMALLOC_END) {
+		printk(KERN_WARNING "%s(): area [0x%08X..0x%08X] already remapped\n",
+			__func__, res_cookie, res_cookie + size - 1);
+		return true;
+	}
+	*baseptr = ioremap_wc(res_cookie, size);
+	if (*baseptr < (void *)VMALLOC_START) {
+		*baseptr = NULL;
+		printk(KERN_ERR "%s(): error area [0x%08X..0x%08X] remap\n",
+			__func__, res_cookie, res_cookie + size - 1);
+		return false;
+	}
+	return true;
+}
+
+void __iomem *oxnas_devm_platform_get_and_ioremap_resource(
+	struct platform_device *pdev, unsigned int index, struct resource **res)
+{
+	struct resource *r = platform_get_resource(pdev, IORESOURCE_MEM, index);
+	if (res)
+		*res = r;
+	return devm_ioremap_resource_wc(&pdev->dev, r);
+}
+
+static inline u32 oxnas_ddr_read(u32 reg)
+{
+	return readl((void __iomem *)(ddr_regs_base + reg));
+}
+
+static inline void oxnas_ddr_write(u32 reg, u32 val)
+{
+	writel(val, (void __iomem *)(ddr_regs_base + reg));
+}
+
+static inline void oxnas_ddr_andor(u32 reg, u32 andmask, u32 orval)
+{
+	writel((readl((void __iomem *)(ddr_regs_base + reg)) & andmask) | orval,
+		(void __iomem *)(ddr_regs_base + reg));
+}
+
+static void oxnas_setup_gpio(void)
+{
+	/* Initialise the spinlock used to make GPIO register set access atomic */
+	spin_lock_init(&oxnas_gpio_spinlock);
+	/* Clear all GPIO interrupts */
+	oxnas_gpio_write(GPIO_A_RISING_EDGE_ACTIVE_HIGH_ENABLE, 0);
+	oxnas_gpio_write(GPIO_A_FALLING_EDGE_ACTIVE_LOW_ENABLE, 0);
+	oxnas_gpio_write(GPIO_A_INTERRUPT_STATUS_REGISTER, ~0UL);
+	oxnas_gpio_write(GPIO_B_RISING_EDGE_ACTIVE_HIGH_ENABLE, 0);
+	oxnas_gpio_write(GPIO_B_FALLING_EDGE_ACTIVE_LOW_ENABLE, 0);
+	oxnas_gpio_write(GPIO_B_INTERRUPT_STATUS_REGISTER, ~0UL);
+	/* Disable GPIO interrupts. */
+	oxnas_gpio_write(GPIO_A_LEVEL_INTERRUPT_ENABLE, 0);
+	oxnas_gpio_write(GPIO_B_LEVEL_INTERRUPT_ENABLE, 0);
+	oxnas_gpio_write(GPIO_A_INTERRUPT_ENABLE, 0);
+	oxnas_gpio_write(GPIO_B_INTERRUPT_ENABLE, 0);
+}
+
+static void oxnas_setup_ddr(void)
+{
+	// Configure the DDR controller arbitration scheme
+	oxnas_ddr_write(DDR_ARB_REG,
+		(1UL << DDR_ARB_DATDIR_NCH_BIT)
+			| (1UL << DDR_ARB_DATDIR_EN_BIT)
+			| (1UL << DDR_ARB_REQAGE_EN_BIT)
+			| (1UL << DDR_ARB_LRUBANK_EN_BIT)
+			| (1UL << DDR_ARB_MIDBUF_BIT));
+
+	// Configure read buffers - Do not disable any read buffers
+	oxnas_ddr_write(DDR_AHB_REG, 0);
+
+	// Configure wrapping - Ignore wrap
+	// Configure HPROT - Ignore all HPROT except ARM data
+	oxnas_ddr_write(DDR_AHB2_REG,
+		(1UL << DDR_AHB2_IGNORE_WRAP_ARMD_BIT)
+			| (1UL << DDR_AHB2_IGNORE_WRAP_ARMI_BIT)
+			| (1UL << DDR_AHB2_IGNORE_WRAP_COPRO_BIT)
+			| (1UL << DDR_AHB2_IGNORE_WRAP_DMAA_BIT)
+			| (1UL << DDR_AHB2_IGNORE_WRAP_DMAB_BIT)
+			| (1UL << DDR_AHB2_IGNORE_WRAP_PCI_BIT)
+			| (1UL << DDR_AHB2_IGNORE_WRAP_GMAC_BIT)
+			| (1UL << DDR_AHB2_IGNORE_WRAP_US_BIT)
+			| (1UL << DDR_AHB2_IGNORE_HPROT_ARMI_BIT)
+			| (1UL << DDR_AHB2_IGNORE_HPROT_COPRO_BIT)
+			| (1UL << DDR_AHB2_IGNORE_HPROT_DMAA_BIT)
+			| (1UL << DDR_AHB2_IGNORE_HPROT_DMAB_BIT)
+			| (1UL << DDR_AHB2_IGNORE_HPROT_PCI_BIT)
+			| (1UL << DDR_AHB2_IGNORE_HPROT_GMAC_BIT)
+			| (1UL << DDR_AHB2_IGNORE_HPROT_USB_BIT));
+
+	// Configure burst ordering - Do not disable burst ordering
+	// Configure non-cachable - Do not prevent non-cachable accesses from using read buffers
+	oxnas_ddr_write(DDR_AHB3_REG, 0);
+
+	// Configure read buffer timeout - Do not enable read buffer invalidate after timeout
+	// Configure write behind - Enable write behind coherency
+	oxnas_ddr_write(DDR_AHB4_REG,
+		(1UL << DDR_AHB4_EN_WRBEHIND_ARMD_BIT)
+			| (1UL << DDR_AHB4_EN_WRBEHIND_ARMI_BIT)
+			| (1UL << DDR_AHB4_EN_WRBEHIND_COPRO_BIT)
+			| (1UL << DDR_AHB4_EN_WRBEHIND_DMAA_BIT)
+			| (1UL << DDR_AHB4_EN_WRBEHIND_DMAB_BIT)
+			| (1UL << DDR_AHB4_EN_WRBEHIND_PCI_BIT)
+			| (1UL << DDR_AHB4_EN_WRBEHIND_GMAC_BIT)
+			| (1UL << DDR_AHB4_EN_WRBEHIND_USB_BIT));
+
+	// Enable all DDR client interfaces
+	oxnas_ddr_andor(DDR_BLKEN_REG,
+		~0UL,
+		((1UL << DDR_BLKEN_CLIENTS_NUM_BITS) - 1) << DDR_BLKEN_CLIENTS_BIT);
+}
