+ * published by the Free Software Foundation.
+ */
+
+#ifndef __MACH_OXNAS_IO_H__
+#define __MACH_OXNAS_IO_H__
+
+
+/* I/O physical base addresses */
+#define CORE_MODULE_BASE_PA			0x10000000
+#define ROM_BASE_PA				0x40000000
+#define USBHOST_BASE_PA				0x40200000
+#define MAC_BASE_PA				0x40400000
+#define PCI_CSRS_BASE_PA			0x40600000
+#define PCI_BASE_PA				0x40800000
+#define STATIC_CS0_BASE_PA			0x41000000
+#define STATIC_CS1_BASE_PA			0x41400000
+#define STATIC_CS2_BASE_PA			0x41800000
+#define STATIC_CONTROL_BASE_PA			0x41C00000
+#define SATA_DATA_BASE_PA			0x42000000
+#define DPE_BASE_PA				0x43000000
+#define APB_BRIDGE_A_BASE_PA			0x44000000
+#define GPIO_A_BASE_PA				APB_BRIDGE_A_BASE_PA
+#define GPIO_B_BASE_PA				(APB_BRIDGE_A_BASE_PA + 0x100000)
+#define UART_1_BASE_PA				(APB_BRIDGE_A_BASE_PA + 0x200000)
+#define UART_2_BASE_PA				(APB_BRIDGE_A_BASE_PA + 0x300000)
+#define I2C_BASE_PA				(APB_BRIDGE_A_BASE_PA + 0x400000)
+#define I2S_BASE_PA				(APB_BRIDGE_A_BASE_PA + 0x500000)
+#define FAN_MON_BASE_PA				(APB_BRIDGE_A_BASE_PA + 0x600000)
+#define PWM_BASE_PA				(APB_BRIDGE_A_BASE_PA + 0x700000)
+#define IRRX_BASE_PA				(APB_BRIDGE_A_BASE_PA + 0x800000)
+#define UART_3_BASE_PA				(APB_BRIDGE_A_BASE_PA + 0x900000)
+#define UART_4_BASE_PA				(APB_BRIDGE_A_BASE_PA + 0xA00000)
+#define APB_BRIDGE_B_BASE_PA			0x45000000
+#define SYS_CONTROL_BASE_PA			APB_BRIDGE_B_BASE_PA
+#define CLOCK_CONTROL_BASE_PA			(APB_BRIDGE_B_BASE_PA + 0x100000)
+#define RTC_BASE_PA				(APB_BRIDGE_B_BASE_PA + 0x200000)
+#define RPS_BASE_PA				(APB_BRIDGE_B_BASE_PA + 0x300000)
+#define COPRO_RPS_BASE_PA			(APB_BRIDGE_B_BASE_PA + 0x400000)
+#define AHB_MON_BASE_PA				(APB_BRIDGE_B_BASE_PA + 0x500000)
+#define DMA_BASE_PA				(APB_BRIDGE_B_BASE_PA + 0x600000)
+#define DPE_REGS_BASE_PA			(APB_BRIDGE_B_BASE_PA + 0x700000)
+#define IBW_REGS_BASE_PA			(APB_BRIDGE_B_BASE_PA + 0x780000)
+#define DDR_REGS_BASE_PA			(APB_BRIDGE_B_BASE_PA + 0x800000)
+#define SATA_REGS_BASE_PA			(APB_BRIDGE_B_BASE_PA + 0x900000)
+#define DMA_CHECKSUM_BASE_PA			(APB_BRIDGE_B_BASE_PA + 0xA00000)
+#define COPRO_REGS_BASE_PA			(APB_BRIDGE_B_BASE_PA + 0xB00000)
+#define DMA_SG_BASE_PA				(APB_BRIDGE_B_BASE_PA + 0xC00000)
+#define SDRAM_BASE_PA				CONFIG_PHYS_OFFSET
+#define SRAM_BASE_PA				0x58000000
+#define DEBUG_BASE_PA				0xE0000000
+
+/**
+ * SRAM and LEON2
+ */
+#ifdef CONFIG_SUPPORT_LEON
+#define OXNAS_LEON_MAX_IMAGE_SIZE		(CONFIG_LEON_PAGES * PAGE_SIZE)
+#else
+#define OXNAS_LEON_MAX_IMAGE_SIZE		0
+#endif
+#define OXNAS_SRAM_SIZE				(CONFIG_SRAM_NUM_PAGES * PAGE_SIZE)
+#define OXNAS_SRAM_DESCRIPTORS_SIZE		(CONFIG_DESCRIPTORS_PAGES * PAGE_SIZE)
+#define OXNAS_SRAM_GMAC_DESCRIPTORS_SIZE	(CONFIG_GMAC_DESCRIPTORS_PAGES * PAGE_SIZE)
+
+
+#ifndef __ASSEMBLY__
+
+
+extern void __iomem *sys_regs_base;
+extern void __iomem *rps_regs_base;
+extern void __iomem *ddr_regs_base;
+extern void __iomem *pwm_regs_base;
+extern void __iomem *gpio_regs_base;
+extern void __iomem *cached_sram_base;
+
+void *oxnas_sram_alloc(size_t sz, dma_addr_t *ppa, gfp_t gfp);
+void *oxnas_sram_zalloc(size_t sz, dma_addr_t *ppa);
+bool oxnas_ioremap(void __iomem **baseptr, resource_size_t res_cookie, size_t size);
+bool oxnas_ioremap_wc(void __iomem **baseptr, resource_size_t res_cookie, size_t size);
+void __iomem *oxnas_devm_platform_get_and_ioremap_resource(
+	struct platform_device *pdev, unsigned int index, struct resource **res);
+
+static inline u32 oxnas_sys_read(u32 reg)
+{
+	return readl((void __iomem *)(sys_regs_base + reg));
+}
+
+static inline void oxnas_sys_write(u32 reg, u32 val)
+{
+	writel(val, (void __iomem *)(sys_regs_base + reg));
+}
+
+static inline void oxnas_sys_andor(u32 reg, u32 andmask, u32 orval)
+{
+	writel((readl((void __iomem *)(sys_regs_base + reg)) & andmask) | orval,
+		(void __iomem *)(sys_regs_base + reg));
+}
+
+static inline u32 oxnas_rps_read(u32 reg)
+{
+	return readl((void __iomem *)(rps_regs_base + reg));
+}
+
+static inline void oxnas_rps_write(u32 reg, u32 val)
+{
+	writel(val, (void __iomem *)(rps_regs_base + reg));
+}
+
+static inline void oxnas_rps_andor(u32 reg, u32 andmask, u32 orval)
+{
+	writel((readl((void __iomem *)(rps_regs_base + reg)) & andmask) | orval,
+		(void __iomem *)(rps_regs_base + reg));
+}
+
+static inline u32 oxnas_pwm_read(u32 reg)
+{
+	return readl((void __iomem *)(pwm_regs_base + reg));
+}
+
+static inline void oxnas_pwm_write(u32 reg, u32 val)
+{
+	writel(val, (void __iomem *)(pwm_regs_base + reg));
+}
+
+static inline void oxnas_pwm_andor(u32 reg, u32 andmask, u32 orval)
+{
+	writel((readl((void __iomem *)(pwm_regs_base + reg)) & andmask) | orval,
+		(void __iomem *)(pwm_regs_base + reg));
+}
+
+static inline u32 oxnas_gpio_read(u32 reg)
+{
+	return readl((void __iomem *)(gpio_regs_base + reg));
+}
+
+static inline void oxnas_gpio_write(u32 reg, u32 val)
+{
+	writel(val, (void __iomem *)(gpio_regs_base + reg));
+}
+
+static inline void oxnas_gpio_andor(u32 reg, u32 andmask, u32 orval)
+{
+	writel((readl((void __iomem *)(gpio_regs_base + reg)) & andmask) | orval,
+		(void __iomem *)(gpio_regs_base + reg));
+}
+
+#endif // __ASSEMBLY__
+
+
+#endif // __MACH_OXNAS_IO_H__
diff -ruN a/arch/arm/mach-oxnas/include/mach/irqs.h b/arch/arm/mach-oxnas/include/mach/irqs.h
--- a/arch/arm/mach-oxnas/include/mach/irqs.h	1970-01-01 03:00:00.000000000 +0300
