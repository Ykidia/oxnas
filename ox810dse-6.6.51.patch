diff -ruN a/drivers/usb/host/ehci-hcd.c b/drivers/usb/host/ehci-hcd.c
--- a/drivers/usb/host/ehci-hcd.c	2024-09-12 12:11:45.000000000 +0300
+++ b/drivers/usb/host/ehci-hcd.c	2024-09-18 19:13:04.000000000 +0300
@@ -222,6 +222,23 @@
 	if (ehci_big_endian_mmio(ehci))
 		tmp |= USBMODE_BE;
 	ehci_writel(ehci, tmp, &ehci->regs->usbmode);
+
+#ifdef CONFIG_ARCH_OXNAS
+	{
+		u32 __iomem	*reg_ptr;
+		reg_ptr = (u32 __iomem *)&ehci->regs->txfill_tuning;
+		tmp = ehci_readl(ehci, reg_ptr);
+		tmp &= ~0x00ff0000;
+		tmp |= 0x00200000; /* set burst pre load count to 16 */
+		tmp |= 0x16; /* set sheduler overhead to 3 * 1.267us */
+		ehci_writel(ehci, tmp, reg_ptr);
+
+		reg_ptr = (u32 __iomem *)&ehci->regs->txttfilltuning;
+		tmp = readl (reg_ptr);
+		tmp |= 0x2; /* set sheduler overhead to 2 * 6.333us */
+		writel (tmp, reg_ptr);
+	}
+#endif // CONFIG_ARCH_OXNAS
 }
 
 /*
@@ -257,6 +274,16 @@
 	if (ehci_is_TDI(ehci))
 		tdi_reset (ehci);
 
+#ifdef CONFIG_ARCH_OXNAS
+	command=readl(&ehci->regs->port_status[1]);
+	command |=0xc0000000; /* force use of serial PHY on 1st full speed port */
+	writel(command,&ehci->regs->port_status[1]); 
+
+	command=readl(&ehci->regs->port_status[2]);
+	command |=0xc0000000; /* force use of serial PHY on 2nd full speed port */
+	writel(command,&ehci->regs->port_status[2]); 
+#endif // CONFIG_ARCH_OXNAS
+
 	if (ehci->debug)
 		dbgp_external_startup(ehci_to_hcd(ehci));
 
@@ -1313,6 +1340,10 @@
 MODULE_AUTHOR (DRIVER_AUTHOR);
 MODULE_LICENSE ("GPL");
 
+#ifdef CONFIG_ARCH_OXNAS
+#include "ehci-oxnas.c"
+#endif
+
 #ifdef CONFIG_USB_EHCI_SH
 #include "ehci-sh.c"
 #endif
diff -ruN a/drivers/usb/host/ehci-oxnas.c b/drivers/usb/host/ehci-oxnas.c
--- a/drivers/usb/host/ehci-oxnas.c	1970-01-01 03:00:00.000000000 +0300
