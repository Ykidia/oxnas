+static int gmac_open(struct net_device *netdev)
+{
+	int status;
+
+	// Ensure the MAC block is properly reset
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_MAC_BIT);
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_MAC_BIT);
+
+	// Enable the clock to the MAC block
+	oxnas_sys_write(SYS_CTRL_CKEN_SET_CTRL, 1UL << SYS_CTRL_CKEN_MAC_BIT);
+
+	// Ensure reset and clock operations are complete
+	wmb();
+
+	// Reset the PHY to get it into a known state and ensure we have Tx/Rx clocks
+	// to allow the GMAC reset to complete
+#ifdef CONFIG_SYNOPSYS_GMAC_PHYLIB
+	if (gmac_priv->phydev == NULL || genphy_soft_reset(gmac_priv->phydev)) {
+		gmac_dbg("Failed to reset PHY\n");
+		status = -EIO;
+		goto open_err_out;
+	}
+#else // CONFIG_SYNOPSYS_GMAC_PHYLIB
+	if (phy_reset(netdev)) {
+		gmac_dbg("Failed to reset PHY\n");
+		status = -EIO;
+		goto open_err_out;
+	}
+#endif // CONFIG_SYNOPSYS_GMAC_PHYLIB
+
+	// Set PHY specfic features
+	initialize_phy();
+
+	// Check that the MAC address is valid.  If it's not, refuse to bring the
+	// device up
+	if (!is_valid_ether_addr(netdev->dev_addr)) {
+		gmac_err("MAC address invalid\n");
+		status = -EINVAL;
+		goto open_err_out;
+	}
+
+	// Record whether jumbo frames should be enabled
+	gmac_priv->jumbo_ = (netdev->mtu > NORMAL_PACKET_SIZE);
+
+	set_rx_packet_info(netdev);
+
+#ifdef CONFIG_LEON_COPRO
+	if (!gmac_priv->shared_copro_params_) {
+		size_t copro_data_size = sizeof(copro_params_t)
+			+ sizeof(gmac_fwd_intrs_t)
+			+ sizeof(gmac_cmd_que_ent_t) * COPRO_CMD_QUEUE_NUM_ENTRIES
+			+ sizeof(gmac_tx_que_ent_t) * COPRO_TX_QUEUE_NUM_ENTRIES;
+		// Allocate SRAM for the command queue entries
+		gmac_priv->shared_copro_params_ = oxnas_sram_zalloc(copro_data_size,
+			&gmac_priv->shared_copro_params_phys);
+
+		if (gmac_priv->shared_copro_params_ == NULL) {
+			gmac_err("Failed to allocate %u bytes of SRAM for CoPro\n", (u32)copro_data_size);
+			status = -ENOMEM;
+			goto open_err_out;
+		}
+
+		gmac_priv->copro_params_.cmd_que_head_ = gmac_priv->shared_copro_params_phys + sizeof(copro_params_t);
+		gmac_priv->copro_params_.cmd_que_tail_
+			= gmac_priv->copro_params_.cmd_que_head_ + sizeof(gmac_cmd_que_ent_t) * COPRO_CMD_QUEUE_NUM_ENTRIES;
+		gmac_priv->copro_params_.fwd_intrs_mailbox_ = gmac_priv->copro_params_.cmd_que_tail_;
+		gmac_priv->copro_params_.tx_que_head_ = gmac_priv->copro_params_.fwd_intrs_mailbox_ + sizeof(gmac_fwd_intrs_t);
+		gmac_priv->copro_params_.tx_que_tail_
+			= gmac_priv->copro_params_.tx_que_head_ + sizeof(gmac_tx_que_ent_t) * COPRO_TX_QUEUE_NUM_ENTRIES;
+		gmac_priv->copro_params_.free_start_ = (gmac_priv->copro_params_.tx_que_tail_ + 15UL) & ~15UL;
+
+		// Set Rx interrupt mitigation behaviour (may change between opens)
+		gmac_priv->copro_params_.rx_mitigation_        = COPRO_RX_MITIGATION;
+		gmac_priv->copro_params_.rx_mitigation_frames_ = COPRO_RX_MITIGATION_FRAMES;
+		gmac_priv->copro_params_.rx_mitigation_usec_   = COPRO_RX_MITIGATION_USECS;
+	}
+
+
+	// Update the CoPro's parameters with the current MTU (may change between opens)
+	gmac_priv->copro_params_.mtu_ = netdev->mtu;
+
+	// Request CoPro firmware from userspace or fallback to builtin one
+	gmac_init_copro();
+
+	// Print the layout so the workspace can be checked against the SRAM map / LEON image location
+	gmac_info("CoPro SRAM: params=0x%08X cmd=0x%08X..0x%08X fwd=0x%08X tx=0x%08X..0x%08X free=0x%08X\n",
+		gmac_priv->shared_copro_params_phys,
+		gmac_priv->copro_params_.cmd_que_head_,
+		gmac_priv->copro_params_.cmd_que_tail_,
+		gmac_priv->copro_params_.fwd_intrs_mailbox_,
+		gmac_priv->copro_params_.tx_que_head_,
+		gmac_priv->copro_params_.tx_que_tail_,
+		gmac_priv->copro_params_.free_start_);
+
+	// Enable selected semaphore register bits to cause ARM interrupts
+	oxnas_sys_write(SYS_CTRL_SEMA_MASKA_CTRL, SEM_INTA_MASK);
+	oxnas_sys_write(SYS_CTRL_SEMA_MASKB_CTRL, SEM_INTB_MASK);
+
+#ifdef TEST_COPRO
+	// Send test commands to the CoPro
+	gmac_test_copro();
+#endif
+#endif // CONFIG_LEON_COPRO
+
+	// Initialize sysfs for link state reporting
+	status = gmac_link_state_init_sysfs();
+	if (status) {
+		gmac_err("Failed to initialize sysfs support\n");
+		goto open_err_out;
+	}
+
+	// Initialize the work queue entry to be used to issue hotplug events to userspace
+	INIT_WORK(&gmac_priv->link_state_change_work, work_handler);
+
+	// Do startup operations that are in common with gmac_down()/_up() processing
+	gmac_priv->mii_init_media = 1;
+#ifndef CONFIG_SYNOPSYS_GMAC_PHYLIB
+	gmac_priv->phy_force_negotiation = 1;
+#endif
+	status = gmac_up(netdev);
+	if (status) {
+		goto open_err_out;
+	}
+
+	gmac_priv->interface_up = 1;
+	return 0;
+
+open_err_out:
+	gmac_stop(netdev);
+
+	return status;
+}
