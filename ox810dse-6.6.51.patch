+	DMA_OP_MODE_RTC_96  = 2,
+	DMA_OP_MODE_RTC_32  = 1,
+	DMA_OP_MODE_RTC_64  = 0 
+} gmac_dma_op_mode_rtc_val_t;
+
+typedef enum gmac_dma_intr_enable_reg {
+	DMA_INT_ENABLE_NI_BIT  = 16,
+	DMA_INT_ENABLE_AI_BIT  = 15,
+	DMA_INT_ENABLE_ERE_BIT = 14,
+	DMA_INT_ENABLE_FBE_BIT = 13,
+	DMA_INT_ENABLE_ETE_BIT = 10,
+	DMA_INT_ENABLE_RW_BIT  = 9,
+	DMA_INT_ENABLE_RS_BIT  = 8,
+	DMA_INT_ENABLE_RU_BIT  = 7,
+	DMA_INT_ENABLE_RI_BIT  = 6,
+	DMA_INT_ENABLE_UN_BIT  = 5,
+	DMA_INT_ENABLE_OV_BIT  = 4,
+	DMA_INT_ENABLE_TJ_BIT  = 3,
+	DMA_INT_ENABLE_TU_BIT  = 2,
+	DMA_INT_ENABLE_TS_BIT  = 1,
+	DMA_INT_ENABLE_TI_BIT  = 0
+} gmac_dma_intr_enable_reg_t;
+
+#define DMA_INT_ENABLE_NA_MASK ((1UL << DMA_INT_ENABLE_NI_BIT) \
+	| (1UL << DMA_INT_ENABLE_AI_BIT))
+#define DMA_INT_ENABLE_NAI_MASK DMA_INT_ENABLE_NA_MASK
+#define DMA_INT_ENABLE_RX_MASK ((1UL << DMA_INT_ENABLE_RI_BIT) \
+	| (1UL << DMA_INT_ENABLE_RU_BIT) \
+	| (1UL << DMA_INT_ENABLE_OV_BIT))
+#define DMA_INT_ENABLE_TX_MASK ((1UL << DMA_INT_ENABLE_TI_BIT) \
+	| (1UL << DMA_INT_ENABLE_TJ_BIT) \
+	| (1UL << DMA_INT_ENABLE_UN_BIT))
+/* PATCH TXRX: RI|TI only - the pair whose interrupts get masked while the
+ * NAPI poll is running (they are re-enabled by gmac_poll_txrx() when it
+ * completes).  RU/OV/TJ/UN stay enabled throughout, their events are
+ * handled inline by the ISR and never gate the poll. */
+#define DMA_INT_ENABLE_TXRX_MASK ((1UL << DMA_INT_ENABLE_RI_BIT) | (1UL << DMA_INT_ENABLE_TI_BIT))
+/* PATCH TXRX: alias so the CoPro paths can mask/unmask the virtual semaphore
+ * events with the same call as the hardware events; folds to 0 without
+ * CONFIG_LEON_COPRO, keeping those gmac_int_en_clr() calls no-ops. */
+#define DMA_INT_ENABLE_VX_MASK DMA_STATUS_VX_MASK
+#define DMA_INT_ENABLE_FLAGS_MASK ((1UL << DMA_INT_ENABLE_FBE_BIT) \
+	| (1UL << DMA_INT_ENABLE_RW_BIT) \
+	| (1UL << DMA_INT_ENABLE_RS_BIT) \
+	| (1UL << DMA_INT_ENABLE_TS_BIT))
