+/**
+ * called to write a taskfile into the ORB registers
+ * @param ap hardware with the registers in
+ * @param tf taskfile to write to the registers
+ */
+static void ox810se_sata_tf_load(struct ata_port *ap, const struct ata_taskfile *tf)
+{
+	ox810se_sata_port_priv_t *pd = ap->private_data;
+	u32 Orb1 = 0;
+	u32 Orb2 = 0;
+	u32 Orb3 = 0;
+	u32 Orb4 = 0;
+
+	/* check if the ctl register has interrupts disabled or enabled and
+	modify the interrupt enable registers on the ata core as required */
+//	if (tf->ctl & ATA_NIEN) {
+//		ata_port_warn(ap, "NIEN!\n");
+//			ox810se_sata_irq_off(ap);
+//	} else {
+//		ox810se_sata_irq_on(ap);
+//	}
+
+	Orb2 |= (tf->command)    << 24;
+
+	/* write 48 or 28 bit tf parameters */
+	if (tf->flags & ATA_TFLAG_ISADDR) {
+		/* set LBA bit as it's an address */
+		Orb1 |= (tf->device & ATA_LBA) << 24;
+
+		if (tf->flags & ATA_TFLAG_LBA48) {
+			Orb1 |= ATA_LBA << 24;
+			Orb2 |= (tf->hob_nsect)  << 8 ;
+			Orb3 |= (tf->hob_lbal)   << 24;
+			Orb4 |= (tf->hob_lbam)   << 0 ;
+			Orb4 |= (tf->hob_lbah)   << 8 ;
+			Orb4 |= (tf->hob_feature)<< 16;
+		}
+		else {
+			Orb3 |= (tf->device & 0xf)<< 24;
+		}
+
+		/* write 28-bit lba */
+		Orb2 |= (tf->nsect)      << 0 ;
+		Orb2 |= (tf->feature)    << 16;
+		Orb3 |= (tf->lbal)       << 0 ;
+		Orb3 |= (tf->lbam)       << 8 ;
+		Orb3 |= (tf->lbah)       << 16;
+		Orb4 |= (tf->ctl)        << 24;
+
+	}
+
+	if (tf->flags & ATA_TFLAG_DEVICE) {
+		Orb1 |= (tf->device) << 24;
+	}
+
+	pd->last_ctl = tf->ctl;
+
+	/* write values to registers */
+	ox810se_sata_ioportraid_andor(ap, ORB1, 0, Orb1);
+	ox810se_sata_ioportraid_andor(ap, ORB2, 0, Orb2);
+	ox810se_sata_ioportraid_andor(ap, ORB3, 0, Orb3);
+	ox810se_sata_ioportraid_andor(ap, ORB4, 0, Orb4);
+
+	tfdump(tf, true);
+}
+
+/**
+ * Called to read the hardware registers / DMA buffers, to
+ * obtain the current set of taskfile register values.
+ * @param ap hardware with the registers in
+ * @param tf taskfile to read the registers into
+ */
+static void ox810se_sata_tf_read(struct ata_port *ap, struct ata_taskfile *tf)
+{
+	/* read the orb registers */
+	u32 Orb1, Orb2, Orb3, Orb4;
+
+	(void)ox810se_sata_core_idle_wait(ap);
+
+	Orb1 = ox810se_sata_ioportraid_read(ap, ORB1);
+	Orb2 = ox810se_sata_ioportraid_read(ap, ORB2);
+	Orb3 = ox810se_sata_ioportraid_read(ap, ORB3);
+	Orb4 = ox810se_sata_ioportraid_read(ap, ORB4);
+
+	/* read common 28/48 bit tf parameters */
+	tf->device  = (Orb1 >> 24);
+	tf->nsect   = (Orb2 >> 0);
+	tf->feature = (Orb2 >> 16);
+	tf->command = ox810se_sata_check_status(ap);
+
+	/* read 48 or 28 bit tf parameters */
+	if (tf->flags & ATA_TFLAG_LBA48) {
+		tf->hob_nsect = (Orb2 >> 8) ;
+
+		tf->lbal      = (Orb3 >> 0) ;
+		tf->lbam      = (Orb3 >> 8) ;
+		tf->lbah      = (Orb3 >> 16) ;
+		tf->hob_lbal  = (Orb3 >> 24) ;
+
+		tf->hob_lbam  = (Orb4 >> 0) ;
+		tf->hob_lbah  = (Orb4 >> 8) ;
+		/* feature ext and control are write only */
+	} else {
+		/* read 28-bit lba */
+		tf->lbal      = (Orb3 >> 0) ;
+		tf->lbam      = (Orb3 >> 8) ;
+		tf->lbah      = (Orb3 >> 16) ;
+	}
+
+	tfdump(tf, false);
+}
