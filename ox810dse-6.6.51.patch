+static inline void ox810se_sata_led_init(void)
+{
+#ifdef CONFIG_SATA_OXNAS_DISK_LIGHT
+#ifndef SATA_USE_RESOURCES_BY_DT
+	// setup path
+	oxnas_sys_andor(CONFIG_SATA_OXNAS_DISK_LIGHT_GPIO_LINE < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_PRIMSEL_CTRL_0 : SYS_CTRL_GPIO_PRIMSEL_CTRL_1,
+		~SATA_LED_MASK,
+		0);
+	oxnas_sys_andor(CONFIG_SATA_OXNAS_DISK_LIGHT_GPIO_LINE < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_SECSEL_CTRL_0 : SYS_CTRL_GPIO_SECSEL_CTRL_1,
+		~SATA_LED_MASK,
+		0);
+	oxnas_sys_andor(CONFIG_SATA_OXNAS_DISK_LIGHT_GPIO_LINE < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_TERTSEL_CTRL_0 : SYS_CTRL_GPIO_TERTSEL_CTRL_1,
+		~SATA_LED_MASK,
+		0);
+	// disable PWM
+	oxnas_sys_andor(CONFIG_SATA_OXNAS_DISK_LIGHT_GPIO_LINE < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_PWMSEL_CTRL_0 : SYS_CTRL_GPIO_PWMSEL_CTRL_1,
+		~SATA_LED_MASK,
+		0);
+	// enable output
+	oxnas_gpio_write(CONFIG_SATA_OXNAS_DISK_LIGHT_GPIO_LINE < GPIO_AB_NUM_PINS
+			? GPIO_A_OUTPUT_ENABLE : GPIO_B_OUTPUT_ENABLE,
+		SATA_LED_MASK);
+#endif
+#endif
+
+#ifdef CONFIG_WDC_LEDS_TRIGGER_SATA_DISK
+	led_trigger_register_simple("sata-disk", &wdc_ledtrig_sata);
+#endif
+}
