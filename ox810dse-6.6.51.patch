+
+static inline void oxnas_pci_write(u32 reg, u32 val)
+{
+	writel(val, (void __iomem *)(pci_regs_base + reg));
+}
+
+static inline void oxnas_pci_andor(u32 reg, u32 andmask, u32 orval)
+{
+	if (andmask != 0)
+		writel((readl((void __iomem *)(pci_regs_base + reg)) & andmask) | orval, (void __iomem *)(pci_regs_base + reg));
+	else
+		writel(orval, (void __iomem *)(pci_regs_base + reg));
+}
+
+static int oxnas_pci_read_core_config( unsigned int config_register )
+{
+	unsigned long val, flags;
+	//printk(KERN_DEBUG "PCI: oxnas_pci_read_core_config( 0x%x )\n", config_register );
+	spin_lock_irqsave(&oxnas_lock, flags);
+	oxnas_pci_write(PCI_CRP_CMD_AND_ADDR,
+		0x00                            << PCI_CRP_BYTE_ENABLES_START |
+		PCI_BUS_CMD_CONFIGURATION_READ  << PCI_CRP_CMD_START          |
+		config_register                 << PCI_CRP_ADDRESS_START);
+	wmb();
+	val = oxnas_pci_read(PCI_CRP_READ_DATA);
+	spin_unlock_irqrestore(&oxnas_lock, flags);
+	return val;
+}
