+     */
+#define    RX_DEBUG2_FIFO_READ_ADDRESS      16
+    /**
+     * 19 - 16   Current read pointer of FIFO 
+     */
+#define    RX_DEBUG2_FIFO_WRITE_ADDRESS     24
+    /**
+     * 27 - 24   Current write pointer of FIFO 
+     */
+#define    RX_DEBUG2_WORD_CLK               31
