+ * Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+ */
+
+
+#include <linux/delay.h>
+
+#include "gmac.h"
+#include "gmac_desc.h"
+
+
+void init_rx_desc_list(
+	gmac_desc_list_info_t           *const desc_list,
+	gmac_dma_desc_t                 *const base_ptr,
+	gmac_dma_desc_t                 *const shadow_ptr,
+	const int                       num_descriptors,
+	const u16                       rx_buffer_length)
+{
+	int i;
+
+	desc_list->base_ptr = base_ptr;
+	desc_list->shadow_ptr = shadow_ptr;
+	desc_list->num_descriptors = num_descriptors;
+	desc_list->empty_count = num_descriptors;
+	desc_list->r_index = 0;
+	desc_list->w_index = 0;
+
+	for (i = 0; i < num_descriptors; i++) {
+		gmac_dma_desc_t *shadow = desc_list->shadow_ptr + i;
+		gmac_dma_desc_t *desc = base_ptr + i;
+
+		// Initialize the shadow descriptor
+		shadow->status = 0;
+		shadow->length = (rx_buffer_length << RDES1_RBS1_BIT);
+		if (i == (num_descriptors - 1)) {
+			shadow->length |= (1UL << RDES1_RER_BIT);
+		}
+		shadow->buffer1 = 0;
+		shadow->buffer2 = 0;
+
+		// Copy the shadow descriptor into the real descriptor
+		desc->status  = shadow->status;
+		desc->length  = shadow->length;
+		desc->buffer1 = shadow->buffer1;
+		desc->buffer2 = shadow->buffer2;
+	}
+}
+
+void init_tx_desc_list(
+	gmac_desc_list_info_t           *const desc_list,
+	gmac_dma_desc_t                 *const base_ptr,
+	gmac_dma_desc_t                 *const shadow_ptr,
+	const int                       num_descriptors)
+{
+	int i;
+
+	desc_list->base_ptr = base_ptr;
+	desc_list->shadow_ptr = shadow_ptr;
+	desc_list->num_descriptors = num_descriptors;
+	desc_list->empty_count = num_descriptors;
+	desc_list->r_index = 0;
+	desc_list->w_index = 0;
+
+	for (i=0; i < num_descriptors; ++i) {
+		gmac_dma_desc_t *shadow = desc_list->shadow_ptr + i;
+		gmac_dma_desc_t *desc = base_ptr + i;
+
+		// Initialize the shadow descriptor
+		shadow->status = 0;
+		shadow->length = (1UL << TDES1_IC_BIT);
+		if (i == (num_descriptors - 1)) {
+			shadow->length |= (1UL << TDES1_TER_BIT);
+		}
+		shadow->buffer1 = 0;
+		shadow->buffer2 = 0;
+
+		// Copy the shadow descriptor into the real descriptor
+		desc->status  = shadow->status;
+		desc->length  = shadow->length;
+		desc->buffer1 = shadow->buffer1;
+		desc->buffer2 = shadow->buffer2;
+	}
+}
diff -ruN a/drivers/net/ethernet/synopsys/gmac/gmac_desc.h b/drivers/net/ethernet/synopsys/gmac/gmac_desc.h
