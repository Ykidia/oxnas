+static inline unsigned long encode_control_status(
+	const oxnas_dma_device_settings_t       *src_settings,
+	const oxnas_dma_device_settings_t       *dst_settings,
+	const bool                              isPaused)
+{
+    u32 ctrl_status;
+    u32 direction;
+
+    ctrl_status  = isPaused ? DMA_CTRL_STATUS_PAUSE : 0;							// Paused if requested
+	ctrl_status |= DMA_CTRL_STATUS_INTERRUPT_ENABLE;
+    ctrl_status |= (DMA_CTRL_STATUS_FAIR_SHARE_ARB   |							// High priority
+					DMA_CTRL_STATUS_INTR_CLEAR_ENABLE);						// Use new interrupt clearing register
+    ctrl_status |= (src_settings->dreq_ << DMA_CTRL_STATUS_SRC_DREQ_SHIFT);	// Source dreq
+    ctrl_status |= (dst_settings->dreq_ << DMA_CTRL_STATUS_DEST_DREQ_SHIFT);	// Destination dreq
+
+    // Setup the transfer direction and burst/single mode for the two DMA busses
+    if (src_settings->bus_ == OXNAS_DMA_SIDE_A) {
+        // Set the burst/single mode for bus A based on src device's settings
+        if (src_settings->transfer_mode_ == OXNAS_DMA_TRANSFER_MODE_BURST) {
+            ctrl_status |= DMA_CTRL_STATUS_TRANSFER_MODE_A;
+        } else {
+//            ctrl_status &= ~DMA_CTRL_STATUS_TRANSFER_MODE_A;
+        }
+
+        if (dst_settings->bus_ == OXNAS_DMA_SIDE_A) {
+            direction = OXNAS_DMA_A_TO_A << DMA_CTRL_STATUS_DIR_SHIFT;
+        } else {
+            direction = OXNAS_DMA_A_TO_B << DMA_CTRL_STATUS_DIR_SHIFT;
+
+            // Set the burst/single mode for bus B based on dst device's settings
+            if (dst_settings->transfer_mode_ == OXNAS_DMA_TRANSFER_MODE_BURST) {
+                ctrl_status |= DMA_CTRL_STATUS_TRANSFER_MODE_B;
+            } else {
+//                ctrl_status &= ~DMA_CTRL_STATUS_TRANSFER_MODE_B;
+            }
+        }
+    } else {
+        // Set the burst/single mode for bus B based on src device's settings
+        if (src_settings->transfer_mode_ == OXNAS_DMA_TRANSFER_MODE_BURST) {
+            ctrl_status |= DMA_CTRL_STATUS_TRANSFER_MODE_B;
+        } else {
+//            ctrl_status &= ~DMA_CTRL_STATUS_TRANSFER_MODE_B;
+        }
+
+        if (dst_settings->bus_ == OXNAS_DMA_SIDE_A) {
+            direction = OXNAS_DMA_B_TO_A << DMA_CTRL_STATUS_DIR_SHIFT;
+
+            // Set the burst/single mode for bus A based on dst device's settings
+            if (dst_settings->transfer_mode_ == OXNAS_DMA_TRANSFER_MODE_BURST) {
+                ctrl_status |= DMA_CTRL_STATUS_TRANSFER_MODE_A;
+            } else {
+//                ctrl_status &= ~DMA_CTRL_STATUS_TRANSFER_MODE_A;
+            }
+        } else {
+            direction = OXNAS_DMA_B_TO_B << DMA_CTRL_STATUS_DIR_SHIFT;
+        }
+    }
+    ctrl_status |= direction;
+
+    // Setup source address mode fixed or increment
+    if (likely(src_settings->address_mode_ == OXNAS_DMA_MODE_FIXED)) {
+        // Fixed address
+//        ctrl_status &= ~DMA_CTRL_STATUS_SRC_ADR_MODE;
+
+        // Set up whether fixed address is _really_ fixed
+        if (src_settings->address_really_fixed_) {
+            ctrl_status |= DMA_CTRL_STATUS_SOURCE_ADDRESS_FIXED;
+        } else {
+//            ctrl_status &= ~DMA_CTRL_STATUS_SOURCE_ADDRESS_FIXED;
+        }
+    } else {
+        // Incrementing address
+        ctrl_status |= DMA_CTRL_STATUS_SRC_ADR_MODE;
+//        ctrl_status &= ~DMA_CTRL_STATUS_SOURCE_ADDRESS_FIXED;
+    }
+
+    // Setup destination address mode fixed or increment
+    if (likely(dst_settings->address_mode_ == OXNAS_DMA_MODE_FIXED)) {
+        // Fixed address
+//        ctrl_status &= ~DMA_CTRL_STATUS_DEST_ADR_MODE;
+        
+        // Set up whether fixed address is _really_ fixed
+        if (dst_settings->address_really_fixed_) {
+            ctrl_status |= DMA_CTRL_STATUS_DESTINATION_ADDRESS_FIXED;
+        } else {
+//            ctrl_status &= ~DMA_CTRL_STATUS_DESTINATION_ADDRESS_FIXED;
+        }
+    } else {
+        // Incrementing address
+        ctrl_status |= DMA_CTRL_STATUS_DEST_ADR_MODE;
+//        ctrl_status &= ~DMA_CTRL_STATUS_DESTINATION_ADDRESS_FIXED;
+    }
+
+    // Set up the width of the transfers on the DMA buses
+    ctrl_status |= (src_settings->width_ << DMA_CTRL_STATUS_SRC_WIDTH_SHIFT);
+    ctrl_status |= (dst_settings->width_ << DMA_CTRL_STATUS_DEST_WIDTH_SHIFT);
+
+    // Setup the priority arbitration scheme
+//    ctrl_status &= ~DMA_CTRL_STATUS_STARVE_LOW_PRIORITY;    // !Starve low priority
+
+    return ctrl_status;
+}
+
+static inline unsigned long encode_eot(
+	const oxnas_dma_device_settings_t       *const src_settings,
+	const oxnas_dma_device_settings_t       *const dst_settings,
+	const unsigned                          length,
+	const bool                              isFinalTransfer)
+{
+	// Write the length, with EOT configuration and enable INC4 tranfers and
+	// HPROT. HPROT will delay data reaching memory for a few clock cycles, but
+	// most unlikely to cause a problem for the CPU.
+	unsigned long encoded = length
+		| DMA_BYTE_CNT_INC4_SET_MASK    // Always enable INC4 transfers
+		| DMA_BYTE_CNT_HPROT_MASK;      // Always enable HPROT assertion
+
+	// Encode the EOT setting for the src device based on its policy
+	if (((src_settings->read_eot_policy_ == OXNAS_DMA_EOT_FINAL) && isFinalTransfer)
+		|| (src_settings->read_eot_policy_ == OXNAS_DMA_EOT_ALL))
+	{
+		encoded |= DMA_BYTE_CNT_RD_EOT_MASK;
+	}
+
+	// Encode the EOT setting for the dst device based on its policy
+	if (((dst_settings->write_eot_policy_ == OXNAS_DMA_EOT_FINAL) && isFinalTransfer)
+		|| (dst_settings->write_eot_policy_ == OXNAS_DMA_EOT_ALL))
+	{
+		encoded |= DMA_BYTE_CNT_WR_EOT_MASK;
+	}
+
+	return encoded;
+}
+
+static inline void oxnas_dma_set_common_lowlevel(
+	oxnas_adma_channel_t    *const channel,
+	const unsigned long     ctrl_status,
+	const dma_addr_t        src_address,
+	const dma_addr_t        dst_address,
+	const unsigned long     lengthAndEOT)
+{
+	unsigned channel_number = channel->common.chan_id;
+
+	spin_lock(&adma_priv->spinlock_);
+
+	// Write the control/status value to the DMAC
+	oxnas_dma_iochannel_andor(channel_number, DMA_CTRL_STATUS, 0, ctrl_status);
+
+	// Ensure control/status word makes it to the DMAC before we write address/length info
+	wmb();
+
+	// Write the source addresses to the DMAC
+	oxnas_dma_iochannel_andor(channel_number, DMA_BASE_SRC_ADR, 0, src_address/* & OXNAS_DMA_ADR_MASK*/);
+
+	// Write the destination addresses to the DMAC
+	oxnas_dma_iochannel_andor(channel_number, DMA_BASE_DST_ADR, 0, dst_address/* & OXNAS_DMA_ADR_MASK*/);
+
+	// Write the length, with EOT configuration for the single transfer
+	oxnas_dma_iochannel_andor(channel_number, DMA_BYTE_CNT, 0, lengthAndEOT);
+
+	// Ensure adr/len info makes it to DMAC before later modifications to
+	// control/status register due to starting the transfer, which happens in
+	// oxnas_dma_start()
+	wmb();
+
+	spin_unlock(&adma_priv->spinlock_);
+
+	// Increase count of in-progress transfers on this channel
+	atomic_inc(&channel->active_count_);
+}
+
+static inline int oxnas_dma_set_common(
+	oxnas_adma_channel_t                    *const channel,
+	const unsigned                          length,
+	const oxnas_dma_device_settings_t       *const src_settings,
+	const oxnas_dma_device_settings_t       *const dst_settings,
+	const bool                              isFinalTransfer)
+{
+	if (unlikely(length > OXNAS_DMA_MAX_TRANSFER_LENGTH)) {
+		adma_warn("length exceeds hardware allowed maximum\n");
+		return 1;
+	}
+
+	oxnas_dma_set_common_lowlevel(
+		channel,
+		encode_control_status(src_settings, dst_settings, true),
+		src_settings->address_,
+		dst_settings->address_,
+		encode_eot(src_settings, dst_settings, length, isFinalTransfer));
+
+	return 0;
+}
+
+static inline int oxnas_dma_set(
+	oxnas_adma_channel_t    *const channel,
+	const dma_addr_t        src_adr,   // Physical address
+	const unsigned          length,
+	const dma_addr_t        dst_adr,   // Physical address
+	const oxnas_dma_mode_t  src_mode,
+	const oxnas_dma_mode_t  dst_mode)
+{
+	/* STACK COPIES: the old code wrote address_/address_mode_ through
+	 * pointers into the SHARED globals - a race between all users */
+	oxnas_dma_device_settings_t src_settings = oxnas_ram_only_src_dma_settings;
+	oxnas_dma_device_settings_t dst_settings = oxnas_ram_generic_dma_settings;
+
+	if (unlikely(oxnas_dma_busy_check(channel))) {
+		adma_warn("trying to use channel %u while active\n", channel->common.chan_id);
+	}
+
+	// Assemble complete memory settings (local copies, no shared state)
+	src_settings.address_ = (dma_addr_t)src_adr;
+	src_settings.address_mode_ = src_mode;
+	dst_settings.address_ = (dma_addr_t)dst_adr;
+	dst_settings.address_mode_ = dst_mode;
+
+	return oxnas_dma_set_common(
+		channel,
+		length,
+		&src_settings,
+		&dst_settings,
+		true);
+}
+
+int oxnas_dma_device_set(
+	struct dma_chan                 *const chan,
+	const enum dma_data_direction   direction,
+	void                            *const mem_adr,   // Physical address
+	const unsigned                  length,
+	oxnas_dma_device_settings_t     *const device_settings,
+	const oxnas_dma_mode_t          mem_mode)
+{
+	oxnas_adma_channel_t *const channel = container_of(chan, oxnas_adma_channel_t, common);
+	oxnas_dma_device_settings_t mem_settings = oxnas_ram_generic_dma_settings;
+	oxnas_dma_device_settings_t *const dev_settings
+		= device_settings == NULL ? channel->settings : device_settings;
+
+	if (unlikely(oxnas_dma_busy_check(channel))) {
+		adma_warn("trying to use channel %u while active\n", channel->common.chan_id);
+	}
+
+	// Assemble complete memory settings
+	mem_settings.address_ = (unsigned long)mem_adr;
+	mem_settings.address_mode_ = mem_mode;
+
+	return oxnas_dma_set_common(
+		channel,
+		length,
+		(direction == DMA_TO_DEVICE) ? &mem_settings : dev_settings,
+		(direction == DMA_TO_DEVICE) ? dev_settings : &mem_settings,
+		true);
+}
