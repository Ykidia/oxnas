+		cmd_que_queue_cmd(&gmac_priv->cmd_queue_, GMAC_CMD_UPDATE_PARAMS, 0, copro_ack_noop_callback);	/* PATCH A: was 0 (leaked a queue entry) */
+
+		// Interrupt the CoPro so it sees the new command
+		oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+	}
+
+	return 0;
+}
