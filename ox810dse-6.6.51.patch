+	},
+	{
+		.start = USB_FS_INTERRUPT,
+		.flags = IORESOURCE_IRQ,
+	},
+};
+
+static struct platform_device ehci_hcd_oxnas_device = {
+	.name = DRIVER_NAME,
+	.id = 0,
+	.num_resources = ARRAY_SIZE(ehci_hcd_oxnas_resources),
+	.resource = ehci_hcd_oxnas_resources,
+	.dev = {
+		.dma_mask = &oxnas_dma_mask,
+		.coherent_dma_mask = OXNAS_MAX_DMA_ADDRESS,
+	},
+}; 
