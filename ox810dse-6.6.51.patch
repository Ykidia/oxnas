+static void ox810se_sata_dma_callback(void *arg)
+{
+	struct ata_port *const ap = arg;
+
+	ox810se_sata_ioportraid_andor(ap, INT_DISABLE, 0, INT_END_OF_CMD);
+	ox810se_sata_qc_complete(ap);
+
+///#ifdef SATA_USE_NEW_ADMA_DRIVER
+///	if (!NULLPTR(sata_priv->desc)) {
+///		sata_priv->desc->callback = NULL;
+///		sata_priv->desc = NULL;
+///	}
+///#else
+///	oxnas_dma_set_callback(sata_priv->chan, NULL, NULL);
+///#endif
+}
