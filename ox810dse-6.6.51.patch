+	TIMER_2_PRESCALE_VALUE = 1UL << (TIMER_2_PRESCALE_ENUM * 4),
+	TIMER_2_TICK_RATE = TIMER_INPUT_CLOCK / TIMER_2_PRESCALE_VALUE,
+	TIMER_2_CONTROL_VALUE = (TIMER_2_PRESCALE_ENUM << TIMER_PRESCALE_BIT)
+		| (TIMER_2_MODE << TIMER_MODE_BIT)
+		| (TIMER_ENABLE_ENABLE << TIMER_ENABLE_BIT),
+
+//	TIMER_2_EARLY_PRESCALE_ENUM = TIMER_PRESCALE_1,
+//	TIMER_2_PRESCALE_ENUM = TIMER_PRESCALE_16,
+//	TIMER_2_MODE = TIMER_MODE_FREE_RUNNING,
+//	TIMER_2_EARLY_PRESCALE_VALUE = 1UL << (TIMER_2_EARLY_PRESCALE_ENUM * 4),
+//	TIMER_2_PRESCALE_VALUE = 1UL << (TIMER_2_PRESCALE_ENUM * 4),
+//	TIMER_2_EARLY_TICK_RATE = TIMER_INPUT_CLOCK / TIMER_2_EARLY_PRESCALE_VALUE,
+//	TIMER_2_TICK_RATE = TIMER_INPUT_CLOCK / TIMER_2_PRESCALE_VALUE,
+};
