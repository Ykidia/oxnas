+#define CHIP_ID_ACK_LOCAL       (1UL << 0)
+#define CHIP_ID_BCK_LOCAL       (1UL << 1)
+#define CHIP_ID_FENB_LOCAL      (1UL << 5)
+#define CHIP_ID_SET_LOCAL       (1UL << 3)
+#define CHIP_ID_SEN_LOCAL       (1UL << 2)
+#define CHIP_ID_SDI_LOCAL       (1UL << 4)
+#define CHIP_ID_SDOUT_LOCAL     (1UL << 16)
+#define CHIP_ID_BITS            48
+#define READBACK_BITS           32
+
+/*
+ * void read_ox810_chip_id()
+ *
+ * Read the 48-bit die-id stored in electrically fused (EFROM).
+
+ * The stored id is accessed via the RPS GPIO lines. The data is clocked out
+ * serially, reconstructed, and written to the global uint_32t values that hold
+ * the low and high serial id's. The value can be accessed from user space at
+ * /proc/cpuinfo.
+ *
+ * During the readout, it is possible to inject values into the EFROM that will
+ * be read out after the first 48 die-id bits have been clocked out. This is
+ * used to confirm the integrity of the die-id bits.
+ *
+ * References: Samsung SS90GRVLV_EFROM_HD V1.0
+ *             OxSemi AMBA Sub-System Design Doc DD_B011A_AMBASys 2.0
+ */
+static void read_ox810_chip_id(void)
+{
+	unsigned int temp = 0;
+	int i = 0;
+	unsigned long long chip_id = 0;
+	unsigned long long readback = 0;
+	unsigned long sdi = 0xBEEFCAFE;
+
+	// enable RPS GPIO outputs
+	temp  = oxnas_rps_read(RPS_GPIO_OUTPUT_ENABLE);
+	temp |= (CHIP_ID_SET_LOCAL | CHIP_ID_FENB_LOCAL | CHIP_ID_SEN_LOCAL);
+	temp |= (CHIP_ID_ACK_LOCAL | CHIP_ID_BCK_LOCAL | CHIP_ID_SDI_LOCAL);
+	oxnas_rps_write(RPS_GPIO_OUTPUT_ENABLE, temp);
+
+	// raise set
+	temp = CHIP_ID_SET_LOCAL;
+	oxnas_rps_write(RPS_GPIO_OUTPUT, temp);
+	udelay(1);
+
+	// raise fenb
+	temp |= CHIP_ID_FENB_LOCAL;
+	oxnas_rps_write(RPS_GPIO_OUTPUT, temp);
+	udelay(1);
+
+	// clear set
+	temp &= ~CHIP_ID_SET_LOCAL;
+	oxnas_rps_write(RPS_GPIO_OUTPUT, temp);
+	udelay(1);
+
+	// raise sense
+	temp |= CHIP_ID_SEN_LOCAL;
+	oxnas_rps_write(RPS_GPIO_OUTPUT, temp);
+	udelay(1);
+
+	// clear sense
+	temp &= ~CHIP_ID_SEN_LOCAL;
+	oxnas_rps_write(RPS_GPIO_OUTPUT, temp);
+	udelay(1);
+
+	// clear fenb
+	temp &= ~CHIP_ID_FENB_LOCAL;
+	oxnas_rps_write(RPS_GPIO_OUTPUT, temp);
+	udelay(1);
+
+	for (i = 0; i < (CHIP_ID_BITS + READBACK_BITS); i++) {
+		// raise bclk
+		temp |= CHIP_ID_BCK_LOCAL;
+		oxnas_rps_write(RPS_GPIO_OUTPUT, temp);
+		udelay(1);
+
+		// feed in predefined value for testing
+		if (sdi & (1ULL<< i)) {
+			temp |= CHIP_ID_SDI_LOCAL;
+		} else {
+			temp &= ~CHIP_ID_SDI_LOCAL;
+		}
+
+		oxnas_rps_write(RPS_GPIO_OUTPUT, temp);
+		udelay(1);
+
+		// lower bclk
+		temp &= ~CHIP_ID_BCK_LOCAL;
+		oxnas_rps_write(RPS_GPIO_OUTPUT, temp);
+		udelay(1);
+
+		// pulse ack
+		temp |= CHIP_ID_ACK_LOCAL;
+		oxnas_rps_write(RPS_GPIO_OUTPUT, temp);
+		udelay(1);
+
+		temp &= ~CHIP_ID_ACK_LOCAL;
+		oxnas_rps_write(RPS_GPIO_OUTPUT, temp);
+
+		if (i >= CHIP_ID_BITS) {
+			readback |= (((unsigned long long)oxnas_rps_read(RPS_GPIO_BASE) & CHIP_ID_SDOUT_LOCAL) << 16);
+			readback >>= 1;
+		} else {
+			chip_id |= (((unsigned long long)oxnas_rps_read(RPS_GPIO_BASE) & CHIP_ID_SDOUT_LOCAL) << 32);
+			chip_id >>= 1;
+		}
+	}
+
+	chip_id = ~chip_id & 0xFFFFFFFFFFFFULL;
+	readback = ~readback & (unsigned long long) ~0UL;
+
+	if (readback == sdi) {
+		printk(KERN_INFO "Chip Id: die-id 0x%0*llX read back 0x%08llX\n", 12, chip_id, readback);
+		system_serial_high = chip_id >> 32;
+		system_serial_low = chip_id & ~0UL;
+	} else {
+		printk(KERN_INFO "Chip Id: unexpected readback 0x%08llX\n", readback);
+	}
+}
+
+static irqreturn_t oxnas_timer1_irq_handler(int irq, void *dev_id)
+{
+	struct clock_event_device *evt = dev_id;
+
+	// Clear the timer interrupt - any write will do
+	oxnas_rps_write(TIMER1_CLEAR, 0);
+
+	// One-shot emulation
+	if (clockevent_state_oneshot(evt))
+		oxnas_rps_write(TIMER1_CONTROL, 0);
+
+	evt->event_handler(evt);
+
+	return IRQ_HANDLED;
+}
+
+static volatile u32 timer2_high_counter = 1;
+
+static irqreturn_t oxnas_timer2_irq_handler(int irq, void *unused)
+{
+	// Clear the timer interrupt - any write will do
+	oxnas_rps_write(TIMER2_CLEAR, 0);
+
+	timer2_high_counter++;
+
+	return IRQ_HANDLED;
+}
+
+static inline u64 oxnas_timer2_ticks_combo(void)
+{
+	u32 hi, lo, pend;
+
+	do {
+		hi = READ_ONCE(timer2_high_counter);
+		lo = oxnas_rps_read(TIMER2_VALUE);
+		pend = 0;
+		if (oxnas_rps_read(RPS_IRQ_RAW_STATUS) & (1UL << TIMER_2_INTERRUPT)) {
+			u32 tmp = oxnas_rps_read(TIMER2_VALUE);
+			/* down-counter: tmp <= lo => reload ÑƒÐ¶Ðµ Ð±Ñ‹Ð» Ð”Ðž Ð¿ÐµÑ€Ð²Ð¾Ð¹ Ð²Ñ‹Ð±Ð¾Ñ€ÐºÐ¸ */
+			if (tmp <= lo)
+				pend = 1;
+		}
+	} while (hi != READ_ONCE(timer2_high_counter));
+
+	return ((u64)(hi + pend) << 24) - lo - 1;
+}
+
+static u64 notrace oxnas_sched_clock(void)
+{
+	return oxnas_timer2_ticks_combo();
+}
+
+static u64 oxnas_read_clk(struct clocksource *unused)
+{
+	return oxnas_timer2_ticks_combo();
+//	return ~oxnas_rps_read(TIMER2_VALUE);
+}
+
+static struct clocksource oxnas_clk = {
+	.name   = "oxnas-timer2",
+	.rating = 300,
+	.read   = oxnas_read_clk,
+	.mask   = CLOCKSOURCE_MASK(56),
+	.flags  = CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+static int oxnas_set_clk_shutdown(struct clock_event_device *evt)
+{
+	oxnas_rps_write(TIMER1_CONTROL, 0);
+
+	return 0;
+}
+
+static int oxnas_set_clk_periodic(struct clock_event_device *evt)
+{
+	oxnas_rps_write(TIMER1_CONTROL, 0);
+	oxnas_rps_write(TIMER1_VALUE, 0);
+	oxnas_rps_write(TIMER1_LOAD, TIMER_1_LOAD_VALUE);
+	oxnas_rps_write(TIMER1_CLEAR, 0);
+	// Setup timer 1 prescaler, periodic operation and start it
+	oxnas_rps_write(TIMER1_CONTROL, TIMER_1_CONTROL_VALUE);
+
+	return 0;
+}
+
+static int oxnas_set_clk_oneshot(struct clock_event_device *evt)
+{
+	oxnas_rps_write(TIMER1_CONTROL, 0);
+	oxnas_rps_write(TIMER1_CLEAR, 0);
+	return 0;
+}
+
+static int oxnas_clk_next_event(unsigned long delta, struct clock_event_device *evt)
+{
+	oxnas_rps_write(TIMER1_CONTROL, 0);
+	oxnas_rps_write(TIMER1_VALUE, 0);
+	oxnas_rps_write(TIMER1_LOAD, delta);
+	oxnas_rps_write(TIMER1_CLEAR, 0);
+	oxnas_rps_write(TIMER1_CONTROL, TIMER_1_CONTROL_VALUE);
+	return 0;
+}
+
+static struct clock_event_device oxnas_clk_event = {
+	.name	= "oxnas-clkevt",
+	.rating = 300,
+	.irq	= TIMER_1_INTERRUPT,
+	.owner	= THIS_MODULE,
+
+	.features		= CLOCK_EVT_FEAT_PERIODIC | CLOCK_EVT_FEAT_ONESHOT,
+	.set_state_shutdown	= oxnas_set_clk_shutdown,
+	.set_state_periodic	= oxnas_set_clk_periodic,
+	.set_state_oneshot	= oxnas_set_clk_oneshot,
+	.set_state_oneshot_stopped = oxnas_set_clk_shutdown,
+	.set_next_event		= oxnas_clk_next_event,
+};
