+static void oxnas_setup_usb(void)
+{
+#ifdef CONFIG_OXNAS_USB_CKOUT
+	// Enable secondary function (USB clock out) on GPIO 10
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~(1UL << 10), 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~0UL, 1UL << 10);
+#endif // CONFIG_OXNAS_USB_CKOUT
+
+#ifdef CONFIG_OXNAS_USB_HUB_RESET_CONTROL
+	// Disable primary, secondary and teriary GPIO functions on USB hub reset control line
+	oxnas_sys_andor(CONFIG_OXNAS_USB_HUB_RESET_GPIO < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_PRIMSEL_CTRL_0 : SYS_CTRL_GPIO_PRIMSEL_CTRL_1,
+		~USB_HUB_RESET_MASK, 0);
+	oxnas_sys_andor(CONFIG_OXNAS_USB_HUB_RESET_GPIO < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_SECSEL_CTRL_0 : SYS_CTRL_GPIO_SECSEL_CTRL_1,
+		~USB_HUB_RESET_MASK, 0);
+	oxnas_sys_andor(CONFIG_OXNAS_USB_HUB_RESET_GPIO < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_TERTSEL_CTRL_0 : SYS_CTRL_GPIO_TERTSEL_CTRL_1,
+		~USB_HUB_RESET_MASK, 0);
+
+#ifdef CONFIG_OXNAS_USB_HUB_RESET_TOGGLE
+	// Assert USB hub reset
+	oxnas_gpio_write(CONFIG_OXNAS_USB_HUB_RESET_ACTIVE_HIGH
+			? (CONFIG_OXNAS_USB_HUB_RESET_GPIO < GPIO_AB_NUM_PINS
+				? GPIO_A_OUTPUT_SET : GPIO_B_OUTPUT_SET)
+			: (CONFIG_OXNAS_USB_HUB_RESET_GPIO < GPIO_AB_NUM_PINS
+				? GPIO_A_OUTPUT_CLEAR : GPIO_B_OUTPUT_CLEAR),
+		USB_HUB_RESET_MASK);
+#else
+	// Deassert USB hub reset
+	oxnas_gpio_write(CONFIG_OXNAS_USB_HUB_RESET_ACTIVE_HIGH
+			? (CONFIG_OXNAS_USB_HUB_RESET_GPIO < GPIO_AB_NUM_PINS
+				? GPIO_A_OUTPUT_CLEAR : GPIO_B_OUTPUT_CLEAR)
+			: (CONFIG_OXNAS_USB_HUB_RESET_GPIO < GPIO_AB_NUM_PINS
+				? GPIO_A_OUTPUT_SET : GPIO_B_OUTPUT_SET),
+		USB_HUB_RESET_MASK);
+#endif // CONFIG_OXNAS_USB_HUB_RESET_TOGGLE
+
+	// Enable GPIO output on USB hub reset line
+	oxnas_gpio_write(CONFIG_OXNAS_USB_HUB_RESET_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_OUTPUT_ENABLE_SET : GPIO_B_OUTPUT_ENABLE_SET,
+		USB_HUB_RESET_MASK);
+
+#ifdef CONFIG_OXNAS_USB_HUB_RESET_TOGGLE
+	if (CONFIG_OXNAS_USB_HUB_RESET_PERIOD_MS > 0) {
+		// Wait for USB hub reset toggle assertion time
+		mdelay(CONFIG_OXNAS_USB_HUB_RESET_PERIOD_MS);
+	}
+
+	// Deassert USB hub reset
+	oxnas_gpio_write(CONFIG_OXNAS_USB_HUB_RESET_ACTIVE_HIGH
+			? (CONFIG_OXNAS_USB_HUB_RESET_GPIO < GPIO_AB_NUM_PINS
+				? GPIO_A_OUTPUT_CLEAR : GPIO_B_OUTPUT_CLEAR)
+			: (CONFIG_OXNAS_USB_HUB_RESET_GPIO < GPIO_AB_NUM_PINS
+				? GPIO_A_OUTPUT_SET : GPIO_B_OUTPUT_SET),
+		USB_HUB_RESET_MASK);
+#endif // CONFIG_OXNAS_USB_HUB_RESET_TOGGLE
+
+#endif // CONFIG_OXNAS_USB_HUB_RESET_CONTROL
+
+}
