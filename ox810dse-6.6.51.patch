+static inline void gmac_int_en_set(u32 mask)
+{
+	u32 hw_mask = mask & ~DMA_INT_ENABLE_VX_MASK;
+	atomic_or(mask, &gmac_priv->int_enable);
+	if (!hw_mask)
+		return;
+
+	copro_queue_cmd(GMAC_CMD_INT_EN_SET, hw_mask, copro_ack_noop_callback);
+	// Interrupt the CoPro so it sees the new command
+	oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+}
+
+static inline void gmac_int_en_clr(u32 mask)
+{
+	u32 hw_mask = mask & ~DMA_INT_ENABLE_VX_MASK;
+	atomic_and(~mask, &gmac_priv->int_enable);
+	if (!hw_mask)
+		return;
+
+	copro_queue_cmd(GMAC_CMD_INT_EN_CLR, hw_mask, copro_ack_noop_callback);
+	// Interrupt the CoPro so it sees the new command
+	oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+}
+
+#else // CONFIG_LEON_COPRO
+
+static inline void gmac_int_en_set(u32 mask)
+{
+	atomic_or(mask, &gmac_priv->int_enable);
+	dma_reg_set_mask(DMA_INT_ENABLE_REG, mask & ~DMA_INT_ENABLE_VX_MASK);
+}
+
+static inline void gmac_int_en_clr(u32 mask)
+{
+	u32 hw_mask = mask & ~DMA_INT_ENABLE_VX_MASK;
+	if (!hw_mask)
+		return;
+
+	dma_reg_clear_mask(DMA_INT_ENABLE_REG, hw_mask);
+	atomic_and(~hw_mask, &gmac_priv->int_enable);
+}
