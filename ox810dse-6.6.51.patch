+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+ */
+#if !defined(__GMAC_OFFLOAD_H__)
+#define __GMAC_OFFLOAD_H__
+
+#ifdef CONFIG_LEON_COPRO
+
+
+enum {
+	COPRO_RX_MITIGATION = 0,	// No Rx mitigation in CoPro
+	COPRO_RX_MITIGATION_FRAMES = 5,
+	COPRO_RX_MITIGATION_USECS = 500,
+
+	COPRO_SEM_INT_CMD = 0,
+	COPRO_SEM_INT_TX = 1,
+	SEM_INT_FWD = 8,
+	SEM_INT_ACK = 16,
+	SEM_INT_TX = 17,
+	SEM_INT_STOP_ACK = 18,
+	SEM_INTA_MASK = 1UL << SEM_INT_FWD,
+	SEM_INTB_MASK = (1UL << SEM_INT_ACK)
+#ifdef CONFIG_LEON_OFFLOAD_TX
+		| (1UL << SEM_INT_TX)
+#endif
+		| (1UL << SEM_INT_STOP_ACK),
+};
+
+enum {
+	GMAC_CMD_STOP = 0,
+	GMAC_CMD_START = 1,
+	GMAC_CMD_INT_EN_SET = 2,
+	GMAC_CMD_INT_EN_CLR = 3,
+	GMAC_CMD_HEARTBEAT = 4,
+	GMAC_CMD_UPDATE_PARAMS = 5,
+	GMAC_CMD_CHANGE_GIG_MODE = 6,
+	GMAC_CMD_CHANGE_RX_ENABLE = 7,
+	GMAC_CMD_CLEAR_RX_INTS = 8,
+	GMAC_CMD_CHANGE_PAUSE_MODE = 9,
+
+	GMAC_CMD_QUE_SKP_BIT = 29,
+	GMAC_CMD_QUE_ACK_BIT = 30,
+	GMAC_CMD_QUE_OWN_BIT = 31, // 0-Owned by ARM, 1-Owned by CoPro
+	GMAC_CMD_OPCODE_FLAGS_MASK = (1UL << GMAC_CMD_QUE_SKP_BIT)
+		| (1UL << GMAC_CMD_QUE_ACK_BIT)
+		| (1UL << GMAC_CMD_QUE_OWN_BIT),
+};
+
+enum {
+	TX_JOB_STATS_BYTES_BIT = 0,
+	TX_JOB_STATS_BYTES_NUM_BITS = 16,
+	TX_JOB_STATS_BYTES_MASK = ((1UL << TX_JOB_STATS_BYTES_NUM_BITS) - 1) << TX_JOB_STATS_BYTES_BIT,
+	TX_JOB_STATS_PACKETS_BIT = 16,
+	TX_JOB_STATS_PACKETS_NUM_BITS = 6,
+	TX_JOB_STATS_PACKETS_MASK = ((1UL << TX_JOB_STATS_PACKETS_NUM_BITS) - 1) << TX_JOB_STATS_PACKETS_BIT,
+	TX_JOB_STATS_ABORT_BIT = 22,
+	TX_JOB_STATS_ABORT_NUM_BITS = 3,
+	TX_JOB_STATS_ABORT_MASK = ((1UL << TX_JOB_STATS_ABORT_NUM_BITS) - 1) << TX_JOB_STATS_ABORT_BIT,
+	TX_JOB_STATS_CARRIER_BIT = 25,
+	TX_JOB_STATS_CARRIER_NUM_BITS = 3,
+	TX_JOB_STATS_CARRIER_MASK = ((1UL << TX_JOB_STATS_CARRIER_NUM_BITS) - 1) << TX_JOB_STATS_CARRIER_BIT,
+	TX_JOB_STATS_COLLISION_BIT = 28,
+	TX_JOB_STATS_COLLISION_NUM_BITS = 4,
+	TX_JOB_STATS_COLLISION_MASK = ((1UL << TX_JOB_STATS_COLLISION_NUM_BITS) - 1) << TX_JOB_STATS_COLLISION_BIT,
+
+	TX_JOB_FLAGS_OWN_BIT = 0,
+	TX_JOB_FLAGS_COPRO_RESERVED_1_BIT = 1,
+	TX_JOB_FLAGS_ACCELERATE_BIT = 2,
+};
+
+extern void cmd_que_init(
+	cmd_que_t          *queue,
+	gmac_cmd_que_ent_t *start,
+	int                 num_entries);
+
+extern int cmd_que_dequeue_ack(cmd_que_t *queue);
+
+extern int cmd_que_queue_cmd(
+	cmd_que_t             *queue,
+	u32                   opcode,
+	u32                   operand,
+	cmd_que_ack_callback  callback);
+
+extern void tx_que_init(
+	tx_que_t          *queue,
+	gmac_tx_que_ent_t *start,
+	int                num_entries);
+
+static inline int tx_que_not_empty(tx_que_t *queue)
+{
+	return (queue->r_ptr_ != queue->w_ptr_) || queue->full_;
+}
+
+static inline int tx_que_is_full(tx_que_t *queue)
+{
+	return queue->full_;
+}
+
+static inline void tx_que_inc_r_ptr(tx_que_t *queue)
+{
+	if (++queue->r_ptr_ == queue->tail_) {
+		queue->r_ptr_ = queue->head_;
+	}
+	if (queue->full_) {
+		queue->full_ = 0;
+	}
+}
+
+extern volatile gmac_tx_que_ent_t* tx_que_get_finished_job(void);
+
+extern volatile gmac_tx_que_ent_t* tx_que_get_idle_job(void);
+
+extern void tx_que_new_job(volatile gmac_tx_que_ent_t *entry);
+
+#endif // CONFIG_LEON_COPRO
+
+#endif        //  #if !defined(__GMAC_OFFLOAD_H__)
diff -ruN a/drivers/net/ethernet/synopsys/gmac/gmac_phy.c b/drivers/net/ethernet/synopsys/gmac/gmac_phy.c
