+/**
+ * Called when the amba bus tells this device to remove itself.
+ * @param pdev pointer to the device that needs to be shutdown
+ */
+static int ox810se_sata_driver_remove(struct platform_device *pdev)
+{
+	struct ata_host *host = dev_get_drvdata(&pdev->dev);
+	int i;
+
+	for (i = 0; i < host->n_ports; i++)
+		scsi_remove_host(host->ports[i]->scsi_host);
+
+	ox810se_sata_dma_free();
+
+	// Hold reset to the SATA block
+	// !!! This is needed for normal bootloader start !!!
+	ox810se_sata_core_reset_start();
+
+#ifdef CONFIG_WDC_LEDS_TRIGGER_SATA_DISK
+	led_trigger_unregister_simple(wdc_ledtrig_sata);
+#endif
+
+	return 0;
+}
+
+/**
+ * Called after IDENTIFY [PACKET] DEVICE is issued to each device found.
+ * Typically used to apply device-specific fixups prior to issue of
+ * SET FEATURES - XFER MODE, and prior to operation.
+ * @param port The port to configure
+ * @param adev The hardware associated with controlling the port
+ */
+static void ox810se_sata_dev_config(struct ata_device *const adev)
+{
+	struct ata_port *ap = adev->link->ap;
+	ox810se_sata_port_priv_t *pd = ap->private_data;
+
+	if (!ox810se_sata_core_idle_wait(ap)) {
+		ata_port_warn(ap, "configuring device while core still not idle\n");
+	}
+
+	// turn on phy error detection by removing the masks
+	ox810se_sata_link_write(ap, 0x0C, 0x00030003, &pd->scrlock);
+
+	// tune for sata compatability
+	ox810se_sata_scr_write_port(ap, 0x10, 0x00002988);
+	ox810se_sata_scr_write_port(ap, 0x14, 0x00055629);
+
+	// enable hotplug event detection
+	ox810se_sata_scr_write_port(ap, SERROR_IRQ_MASK, 0x03feffff);
+	ox810se_sata_scr_write_port(ap, SCR_ACTIVE, ~0 & ~(1 << 26) & ~(1 << 16));
+
+	/* Set the bits to put the interface into 28 or 48-bit node */
+	ox810se_sata_ioport_andor(ap, DRIVE_CONTROL,
+	/* mask out the pair of bits associaed with each port */
+		~(3 << (ox810se_sata_port_no(ap) * 2)),
+	/* set the mode pair associated with each port */
+		((adev->flags & ATA_DFLAG_LBA48) ? DR_CON_48 : DR_CON_28)
+			<< (ox810se_sata_port_no(ap) * 2));
+
+	/* if this is an ATA-6 disk, put the port into ATA-5 auto translate mode */
+	if (adev->flags & ATA_DFLAG_LBA48)
+		ox810se_sata_ioport_andor(ap, PORT_CONTROL, ~0, 0x2);
+
+	ox810se_sata_phy_error_clear(ap);
+}
