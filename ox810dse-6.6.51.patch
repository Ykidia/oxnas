+static void oxnas_setup_pci(void)
+{
+#ifdef CONFIG_PCI
+	// Block reset PCI core
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_PCI_BIT);
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_PCI_BIT);
+
+	// Setup the PCI clock divider
+	oxnas_sys_andor(SYS_CTRL_CKCTRL_CTRL,
+		~(((1UL << SYS_CTRL_CKCTRL_CTRL_PCIDIV_NUM_BITS) - 1) << SYS_CTRL_CKCTRL_CTRL_PCIDIV_BIT),
+		PCI_CLOCK_DIVIDER << SYS_CTRL_CKCTRL_CTRL_PCIDIV_BIT);
+
+	// Enable clock to PCI core
+	oxnas_sys_write(SYS_CTRL_CKEN_SET_CTRL, 1UL << SYS_CTRL_CKEN_PCI_BIT);
+
+	// Enable auto-arbitration between static and PCI
+	oxnas_sys_andor(SYS_CTRL_PCI_CTRL_1, ~(1UL << SYS_CTRL_PCI_CTRL1_SYSPCI_STATIC_REQ_BIT), 0);
+
+	// Enable primary function on PCI clock line to be looped back
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, PCI_CLOCK_MASK);
+
+	// Enable GPIO output on PCI clock line to be looped back
+	oxnas_gpio_write(GPIO_A_OUTPUT_ENABLE_SET, PCI_CLOCK_MASK);
+
+#ifdef CONFIG_OXNAS_PCI_RESET
+	// Disable primary, secondary and teriary GPIO functions on PCI reset line
+	oxnas_sys_andor(CONFIG_OXNAS_PCI_RESET_GPIO < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_PRIMSEL_CTRL_0 : SYS_CTRL_GPIO_PRIMSEL_CTRL_1,
+		~PCI_RESET_MASK, 0);
+	oxnas_sys_andor(CONFIG_OXNAS_PCI_RESET_GPIO < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_SECSEL_CTRL_0 : SYS_CTRL_GPIO_SECSEL_CTRL_1,
+		~PCI_RESET_MASK, 0);
+	oxnas_sys_andor(CONFIG_OXNAS_PCI_RESET_GPIO < GPIO_AB_NUM_PINS
+			? SYS_CTRL_GPIO_TERTSEL_CTRL_0 : SYS_CTRL_GPIO_TERTSEL_CTRL_1,
+		~PCI_RESET_MASK, 0);
+
+	// Assert PCI reset from GPIO line
+	oxnas_gpio_write(CONFIG_OXNAS_PCI_RESET_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_OUTPUT_CLEAR : GPIO_B_OUTPUT_CLEAR,
+		PCI_RESET_MASK);
+
+	// Enable GPIO output on PCI reset line
+	oxnas_gpio_write(CONFIG_OXNAS_PCI_RESET_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_OUTPUT_ENABLE_SET : GPIO_B_OUTPUT_ENABLE_SET,
+		PCI_RESET_MASK);
+
+	// Wait awhile for PCI reset to take effect
+	mdelay(100);
+
+	// Deassert PCI reset from GPIO line
+	oxnas_gpio_write(CONFIG_OXNAS_PCI_RESET_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_OUTPUT_SET : GPIO_B_OUTPUT_SET,
+		PCI_RESET_MASK);
+#endif // CONFIG_OXNAS_PCI_RESET
+#endif // CONFIG_PCI
+}
