+
+// static int irq_tab[4] __initdata = {
+//  	IRQ_AP_PCIINT0,	IRQ_AP_PCIINT1,	IRQ_AP_PCIINT2,	IRQ_AP_PCIINT3
+// };
+
+
+/*
+ * map the specified device/slot/pin to an IRQ.  This works out such
+ * that ..
+ */
+static int __init oxnas_map_irq(const struct pci_dev *dev, u8 slot, u8 pin)
+{
+	BUG_ON(pin < 1 || pin > 4);
+
+//	printk(KERN_DEBUG "PCI: oxnas_map_irq %d,%d,%d = %d\n", dev->bus->number, dev->devfn, slot, PCI_A_INTERRUPT /*pci_irq_table[pin-1]*/);
+	return PCI_A_INTERRUPT;
+}
+
+
+///-static int __init oxnas_pci_setup_resources(struct resource **resource)
+static int __init oxnas_pci_setup_resources(struct list_head *resources)
+{
+	/*
+	 * bus->resource[0] is the IO resource for this bus
+	 * bus->resource[1] is the mem resource for this bus
+	 * bus->resource[2] is the prefetch mem resource for this bus
+	 */
+
+	pci_add_resource(resources, &io_mem);
+	pci_add_resource(resources, &pre_mem);
+	pci_add_resource(resources, &non_mem);
+
+
+	// these regions apply to incomming transactions on PCI
+	oxnas_pci_write_core_config(0xffffffff, SYNOPSYS_PCI_MEMORY_BASE_ADDRESS    );
+	oxnas_pci_write_core_config(0xffffffff, SYNOPSYS_PCI_DUAL_CYCLE_BASE_ADDRESS);
+	oxnas_pci_write_core_config(0xffffffff, SYNOPSYS_PCI_IO_MEM_BASE_ADDRESS    );
+
+//	printk(KERN_INFO "PCI: SYNOPSYS_PCI_MEMORY_BASE_ADDRESS     == 0x%08x\n", (u32)oxnas_pci_read_core_config(SYNOPSYS_PCI_MEMORY_BASE_ADDRESS    ));
+//	printk(KERN_INFO "PCI: SYNOPSYS_PCI_DUAL_CYCLE_BASE_ADDRESS == 0x%08x\n", (u32)oxnas_pci_read_core_config(SYNOPSYS_PCI_DUAL_CYCLE_BASE_ADDRESS));
+//	printk(KERN_INFO "PCI: SYNOPSYS_PCI_IO_MEM_BASE_ADDRESS     == 0x%08x\n", (u32)oxnas_pci_read_core_config(SYNOPSYS_PCI_IO_MEM_BASE_ADDRESS    ));
+
+	oxnas_pci_write_core_config(SDRAM_BASE_PA, SYNOPSYS_PCI_MEMORY_BASE_ADDRESS    );
+	oxnas_pci_write_core_config(SDRAM_BASE_PA, SYNOPSYS_PCI_DUAL_CYCLE_BASE_ADDRESS);
+	oxnas_pci_write_core_config(SDRAM_BASE_PA, SYNOPSYS_PCI_IO_MEM_BASE_ADDRESS    );
+
+//	printk(KERN_INFO "PCI: SYNOPSYS_PCI_MEMORY_BASE_ADDRESS     == 0x%08x\n", (u32)oxnas_pci_read_core_config(SYNOPSYS_PCI_MEMORY_BASE_ADDRESS    ));
+//	printk(KERN_INFO "PCI: SYNOPSYS_PCI_DUAL_CYCLE_BASE_ADDRESS == 0x%08x\n", (u32)oxnas_pci_read_core_config(SYNOPSYS_PCI_DUAL_CYCLE_BASE_ADDRESS));
+//	printk(KERN_INFO "PCI: SYNOPSYS_PCI_IO_MEM_BASE_ADDRESS     == 0x%08x\n", (u32)oxnas_pci_read_core_config(SYNOPSYS_PCI_IO_MEM_BASE_ADDRESS    ));
+
+	return 1;
+}
+
+
+int __init oxnas_pci_setup(int nr, struct pci_sys_data *sys)
+{
+	int ret = 0;
+
+	if (nr == 0) {
+		/* the PCI core has been setup so that the top nybble is forced to 0, so
+		we need to offset by whatever is in the top nybble or the devices won't
+		recognise their memory accesses */
+		sys->mem_offset = PCI_BASE_PA & 0xf0000000;
+
+		// ioremap is not called on IO ports. this should shift the physical
+		// address to the statically mapped virtual one after the BARS have been
+		// setup.
+		sys->io_offset = 0;
+
+		spin_lock_init(&oxnas_lock);
+		ret = oxnas_pci_setup_resources(&sys->resources);
+	}
+
+	return ret;
+}
+
+
+static struct pci_ops oxnas_pci_ops = {
+	.read	= oxnas_read_config,
+	.write	= oxnas_write_config,
+};
+
+
+///-static struct pci_bus *oxnas_pci_scan_bus(int nr, struct pci_sys_data *sys)
+static int oxnas_pci_scan_bus(int nr, struct pci_host_bridge *bridge)
+{
+	struct pci_sys_data *sys = pci_host_bridge_priv(bridge);
+
+//	printk(KERN_DEBUG "PCI: oxnas_pci_scan_bus\n");
+///-	return pci_scan_bus(sys->busnr, &oxnas_pci_ops, sys);
+	list_splice_init(&sys->resources, &bridge->windows);
+	bridge->dev.parent = NULL;
+	bridge->sysdata = sys;
+	bridge->busnr = sys->busnr;
+	bridge->ops = &oxnas_pci_ops;
+
+	return pci_scan_root_bus_bridge(bridge);
+}
+
+static irqreturn_t pci_irq_handler(int irq, void *dev_id)
+{
+	int status = IRQ_NONE;
+	u32 int_status = oxnas_gpio_read(GPIO_A_INTERRUPT_STATUS_REGISTER);
+
+	/* Is the interrupt for us? */
+	if (int_status & ((1UL << PCI_GPIO_INTA_MINIPCI) | (1UL << PCI_GPIO_INTA_PLANAR))) {
+		/* Nothing to do here, disable PCI interrupts */
+		spin_lock(&oxnas_gpio_spinlock);
+		oxnas_gpio_andor(GPIO_A_FALLING_EDGE_ACTIVE_LOW_ENABLE,
+			~((1UL << PCI_GPIO_INTA_MINIPCI) | (1UL << PCI_GPIO_INTA_PLANAR)),
+			0);
+		oxnas_gpio_andor(GPIO_A_LEVEL_INTERRUPT_ENABLE,
+			~((1UL << PCI_GPIO_INTA_MINIPCI) | (1UL << PCI_GPIO_INTA_PLANAR)),
+			0);
+		spin_unlock(&oxnas_gpio_spinlock);
+
+		/* Only mark interrupt as serviced if no other unmasked GPIO interrupts
+		   are pending */
+		if (!oxnas_gpio_read(GPIO_A_INTERRUPT_STATUS_REGISTER)) {
+			status = IRQ_HANDLED;
+		}
+	}
+
+	return status;
+}
+
+void __init oxnas_pci_preinit(void)
+{
+	unsigned int temp;
+	unsigned long flags;
+//	printk(KERN_DEBUG "PCI: oxnas_pci_preinit\n");
+
+    // Configure GPIO lines which map PCI INTA for both minipci and planar as active low
+    spin_lock_irqsave(&oxnas_gpio_spinlock, flags);
+	/* Install a shared interrupt handler on the GPIOA bank's interrupt line,
+	   &io_mem - dummy pointer */
+	if (request_irq(GPIOA_INTERRUPT, pci_irq_handler, IRQF_SHARED, "PCI", &io_mem)) {
+		printk(KERN_ERR "PCI: cannot register IRQ %d\n", GPIOA_INTERRUPT);
+		return;
+	}
+
+	pci_regs_base = (u32)ioremap(PCI_CSRS_BASE_PA, SZ_2M);
+	if (!pci_regs_base) {
+		printk(KERN_ERR "PCI: failed to ioremap PCI_CSRS_BASE_PA\n");
+		return;
+	}
+
+	oxnas_gpio_andor(GPIO_A_FALLING_EDGE_ACTIVE_LOW_ENABLE,
+		~0UL,
+		(1UL << PCI_GPIO_INTA_MINIPCI) | (1UL << PCI_GPIO_INTA_PLANAR));
+	oxnas_gpio_andor(GPIO_A_LEVEL_INTERRUPT_ENABLE,
+		~0UL,
+		(1UL << PCI_GPIO_INTA_MINIPCI) | (1UL << PCI_GPIO_INTA_PLANAR));
+    spin_unlock_irqrestore(&oxnas_gpio_spinlock, flags);
+
+	/*
+	printk(KERN_DEBUG "\n\nPCI: GPIO ABse 0x%08x\n", GPIO_1_BASE);
+	for (temp = 0; temp < 0x40; temp += 4)
+	{
+		printk(KERN_DEBUG "       GPIO ABse + 0x%02x == 0x%08x\n",temp, oxnas_pci_read(GPIO_1_BASE+temp));
+	}
+	*/
+
+	// put pci into host mode
+	temp = (0 << SYS_CTRL_PCI_CTRL1_PULL_UP_ENABLE_GPIO5_BIT ) |
+		(0 << SYS_CTRL_PCI_CTRL1_PULL_UP_ENABLE_GPIO4_BIT) |
+		(0 << SYS_CTRL_PCI_CTRL1_PULL_UP_ENABLE_GPIO3_BIT) |
+		(0 << SYS_CTRL_PCI_CTRL1_PULL_UP_ENABLE_GPIO2_BIT) |
+		(0 << SYS_CTRL_PCI_CTRL1_PULL_UP_ENABLE_GPIO1_BIT) |
+		(0 << SYS_CTRL_PCI_CTRL1_PULL_UP_ENABLE_GPIO0_BIT) |
+		(0 << SYS_CTRL_PCI_CTRL1_ENPU_BIT                ) |
+		(0 << SYS_CTRL_PCI_CTRL1_ENCB_BIT                ) |
+		(0 << SYS_CTRL_PCI_CTRL1_SYSPCI_STATIC_REQ_BIT   ) |
+		(1 << SYS_CTRL_PCI_CTRL1_SS_HOST_E_BIT           ) |
+		(0 << SYS_CTRL_PCI_CTRL1_SYSPCI_PAKING_ENABLE_BIT) |
+		(0 << SYS_CTRL_PCI_CTRL1_SYSPCI_PAKING_MASTE_BIT ) |
+		(0 << SYS_CTRL_PCI_CTRL1_SS_CADBUS_E_BIT         ) |
+		(0 << SYS_CTRL_PCI_CTRL1_SS_MINIPCI_BIT          ) |
+		(0 << SYS_CTRL_PCI_CTRL1_SS_INT_MASK_0_BIT       ) |
+		(0 << SYS_CTRL_PCI_CTRL1_INT_STATUS_0_BIT        ) |
+		(0 << SYS_CTRL_PCI_CTRL1_APP_EQUIES_NOM_CLK_BIT  ) |
+		(0 << SYS_CTRL_PCI_CTRL1_APP_CBUS_INT_N_BIT      ) |
+		(0 << SYS_CTRL_PCI_CTRL1_APP_CSTSCHG_N_BIT       );
+
+//	printk(KERN_DEBUG "PCI: pci into host mode - oxnas_sys_write(0x%08x, 0x%08x)\n", SYS_CTRL_PCI_CTRL_1, temp);
+	oxnas_sys_write(SYS_CTRL_PCI_CTRL_1, temp);
+
+	/* the interrupt lines map directly to the GPIO lines, so disable any
+    primary, secondary and tertiary functionality */
+    spin_lock_irqsave(&oxnas_gpio_spinlock, flags);
+
+    // Interrupt line the cardbus/mini-PCI slot
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~(1UL << PCI_GPIO_INTA_MINIPCI), 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~(1UL << PCI_GPIO_INTA_MINIPCI), 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~(1UL << PCI_GPIO_INTA_MINIPCI), 0);
+
+    // Interrupt line for VIA-SATA PCI device
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~(1UL << PCI_GPIO_INTA_PLANAR), 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~(1UL << PCI_GPIO_INTA_PLANAR), 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~(1UL << PCI_GPIO_INTA_PLANAR), 0);
+
+#ifdef CONFIG_ARCH_OXNAS_PCI_CLKOUT_0
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_0);
+#endif // CONFIG_ARCH_OXNAS_PCI_CLKOUT_0
+
+#ifdef CONFIG_ARCH_OXNAS_PCI_CLKOUT_1
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_1);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_1);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_1);
+#endif // CONFIG_ARCH_OXNAS_PCI_CLKOUT_1
+
+#ifdef CONFIG_ARCH_OXNAS_PCI_CLKOUT_2
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_2);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_2);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_2);
+#endif // CONFIG_ARCH_OXNAS_PCI_CLKOUT_2
+
+#ifdef CONFIG_ARCH_OXNAS_PCI_CLKOUT_3
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_3);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_3);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~0UL, 1UL << PCI_GPIO_CLKO_3);
+#endif // CONFIG_ARCH_OXNAS_PCI_CLKOUT_3
+
+//	printk(KERN_DEBUG "PCI: set gnt and req functions for pci arbiters\n" );
+
+#ifdef CONFIG_ARCH_OXNAS_PCI_REQGNT_0
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_REQ_N0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_GNT_N0);
+#endif // CONFIG_ARCH_OXNAS_PCI_REQGNT_0
+
+#ifdef CONFIG_ARCH_OXNAS_PCI_REQGNT_1
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_REQ_N1);
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_GNT_N1);
+#endif // CONFIG_ARCH_OXNAS_PCI_REQGNT_1
+
+#ifdef CONFIG_ARCH_OXNAS_PCI_REQGNT_2
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_REQ_N2);
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_GNT_N2);
+#endif // CONFIG_ARCH_OXNAS_PCI_REQGNT_2
+
+#ifdef CONFIG_ARCH_OXNAS_PCI_REQGNT_3
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_REQ_N2);
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PCI_GNT_N2);
+#endif // CONFIG_ARCH_OXNAS_PCI_REQGNT_3
+
+    spin_unlock_irqrestore(&oxnas_gpio_spinlock, flags);
+
+	// no eeprom to setup core, so perform eeporm functions --------------------
+	// setup the data to write to enable pci config
+//	printk(KERN_DEBUG "PCI: enable core features\n" );
+	oxnas_pci_write_core_config(
+		PCI_COMMAND_IO              |
+		PCI_COMMAND_MEMORY          |
+		PCI_COMMAND_MASTER          |
+		PCI_COMMAND_SPECIAL         |
+		PCI_COMMAND_INVALIDATE      |
+		PCI_COMMAND_VGA_PALETTE     |
+		PCI_COMMAND_PARITY          |
+		PCI_COMMAND_WAIT            |
+		PCI_COMMAND_SERR            |
+		PCI_COMMAND_FAST_BACK /*    |
+		PCI_COMMAND_INTX_DISABLE, */,
+		PCI_COMMAND );
+
+//	printk(KERN_DEBUG "PCI:  PCI_COMMAND == 0x%08x\n", (u32) oxnas_pci_read_core_config(PCI_COMMAND) );
+}
+
+void __init oxnas_pci_postinit(void)
+{
+//	printk(KERN_DEBUG "PCI: oxnas_pci_postinit\n");
+}
+
+static struct hw_pci oxnas_pci __initdata = {
+	.swizzle	= oxnas_swizzle,
+	.map_irq	= oxnas_map_irq,
+	.setup		= oxnas_pci_setup,
+	.nr_controllers	= 1,
+	.scan		= oxnas_pci_scan_bus,
+	.preinit	= oxnas_pci_preinit,
+	.postinit	= oxnas_pci_postinit,
+};
+
+static int __init oxnas_pci_init(void)
+{
+	pci_common_init(&oxnas_pci);
+	return 0;
+}
+
+static void __exit oxnas_pci_exit(void)
+{
+	// if ( resource[0] ) {
+	//     int errVal = release_resource(resource[0];
+	//     if ( errVal ) {
+	//         printk(KERN_ERR "PCI: unable to release csrRegister space %d", errVal );
+	//     }
+	// }
+
+    // Put the PCI core into reset, but don't stop the clock as the PCI arbiter
+    // still requires it in order to be able to grant the static bus access to
+    // the PCI I/Os
+    oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_PCI_BIT);
+
+	return;
+}
+
+subsys_initcall(oxnas_pci_init);
+module_exit(oxnas_pci_exit);
+
+#endif
