+static struct kobj_type ktype_gmac_link_state = {
+	.release = 0,
+	.sysfs_ops = 0,
+};
+
+static int gmac_link_state_hotplug_filter(const struct kobject *kobj) {
+	return get_ktype(kobj) == &ktype_gmac_link_state;
+}
+
+static const char* gmac_link_state_hotplug_name(const struct kobject *kobj) {
+	return "gmac_link_state";
+}
+
+static struct kset_uevent_ops gmac_link_state_uevent_ops = {
+	.filter = gmac_link_state_hotplug_filter,
+	.name   = gmac_link_state_hotplug_name,
+	.uevent = NULL,
+};
+
+static int gmac_link_state_init_sysfs(void)
+{
+	int err = 0;
+
+	if (gmac_priv->link_state_kobject.kset != NULL)
+		return 0;
+
+	// Prepare the sysfs interface for use
+	gmac_priv->link_state_kset = kset_create_and_add("gmac_link_state", &gmac_link_state_uevent_ops, kernel_kobj);
+	if (gmac_priv->link_state_kset == NULL)
+		return -ENOMEM;
+
+	// Setup hotplugging
+	gmac_priv->link_state_kobject.kset = gmac_priv->link_state_kset;
+
+	// Build the sysfs entry
+	err = kobject_init_and_add(&gmac_priv->link_state_kobject, &ktype_gmac_link_state, NULL, "%s", "gmac_link_state-1");
+	if (err) {
+		kobject_put(&gmac_priv->link_state_kobject);
+		memset(&gmac_priv->link_state_kobject, 0, sizeof(struct kobject));
+		gmac_priv->link_state_kobject.kset = NULL;
+		return err;
+	}
+
+	kobject_uevent(&gmac_priv->link_state_kobject, KOBJ_ADD);
+
+	return 0;
+}
+
+static void work_handler(struct work_struct *ws) {
+	kobject_uevent(&gmac_priv->link_state_kobject, gmac_priv->link_state ? KOBJ_ONLINE : KOBJ_OFFLINE);
+}
