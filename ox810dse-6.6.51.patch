+static inline int oxnas_dma_set_sg_common(
+	oxnas_adma_channel_t                    *const channel,
+	const struct scatterlist                *const src_sg,
+	const unsigned                          src_sg_count,
+	const struct scatterlist                *const dst_sg,
+	const unsigned                          dst_sg_count,
+	const oxnas_dma_device_settings_t       *const src_settings,
+	const oxnas_dma_device_settings_t       *const dst_settings)
+{
+	int i;
+	oxnas_dma_sg_entry_t *sg_entry, *previous_entry;
+
+	// Get reference to this channel's top level SG DMA descriptor structure
+	oxnas_dma_sg_info_t *sg_info = channel->sg_info_;
+
+	previous_entry = NULL;
+	sg_entry = channel->sg_entries_;
+	// Create a link from the SG info structure to the first SG list entry
+	sg_info->p_srcEntries_ = adma_virt_to_phys(sg_entry);
+
+	for (i = 0; i < src_sg_count; i++) {
+		if (unlikely(!sg_entry))
+			goto set_sg_common_fail;
+
+		// Fill in the SG list entry with start address, ensuring only valid
+		// address bits are used, preserving the checksum enabling flag
+		sg_entry->addr_ = src_sg[i].dma_address & OXNAS_DMA_ADR_MASK;
+
+		// Fill in the length, checking that it does not exceed the hardware
+		// allowed maximum
+		sg_entry->length_ = src_sg[i].length;
+		if (unlikely(sg_entry->length_ > OXNAS_DMA_MAX_TRANSFER_LENGTH)) {
+			adma_warn("source entry too long, zeroing\n");
+			sg_entry->length_ = 0;
+		}
+
+		// Get pointer to next available SG entry
+		previous_entry = sg_entry;
+		sg_entry++;
+
+		// Link the previous SG list entry forward to this one
+		previous_entry->p_next_ = adma_virt_to_phys(sg_entry);
+	}
+	if (likely(previous_entry)) {
+		// Mark the end of the source SG list with nulls
+		previous_entry->p_next_ = 0;
+	}
+
+	// Assemble destination descriptors
+	previous_entry = NULL;
+	// Create a link from the SG info structure to the first SG list entry
+	sg_info->p_dstEntries_ = adma_virt_to_phys(sg_entry);
+
+	for (i = 0; i < dst_sg_count; i++) {
+		if (unlikely(!sg_entry))
+			goto set_sg_common_fail;
+
+		// Fill in the SG list entry with start address, ensuring address
+		// does not affect the checksum enabling high order adr bit
+		sg_entry->addr_   = dst_sg[i].dma_address & OXNAS_DMA_ADR_MASK;
+
+		// Fill in the length, checking that it does not exceed the hardware
+		// allowed maximum
+		sg_entry->length_ = dst_sg[i].length;
+		if (unlikely(sg_entry->length_ > OXNAS_DMA_MAX_TRANSFER_LENGTH)) {
+			adma_warn("destination entry too long, zeroing\n");
+			sg_entry->length_ = 0;
+		}
+
+		// Get pointer to next available SG entry
+		previous_entry = sg_entry;
+		sg_entry++;
+
+		// Link the previous SG list entry forward to this one
+		previous_entry->p_next_ = adma_virt_to_phys(sg_entry);
+	}
+	if (likely(previous_entry)) {
+		// Mark the end of the destination SG list with nulls
+		previous_entry->p_next_ = 0;
+	}
+
+	sg_info->qualifer_ = ((channel->common.chan_id << OXNAS_DMA_SG_CHANNEL_BIT)
+		| (src_settings->read_eot_policy_ << OXNAS_DMA_SG_SRC_EOT_BIT)
+		| (dst_settings->write_eot_policy_ << OXNAS_DMA_SG_DST_EOT_BIT)
+		| (1UL << OXNAS_DMA_SG_QUALIFIER_BIT));
+
+	// Flags are the same for source and destination for each SG transfer component
+	sg_info->control_ = encode_control_status(src_settings, dst_settings, false);
+
+	// Increase count of in-progress transfers on this channel
+	atomic_inc(&channel->active_count_);
+
+	return 0;
+
+set_sg_common_fail:
+	sg_info->p_srcEntries_ = 0;
+	sg_info->p_dstEntries_ = 0;
+
+	return 1;
+}
