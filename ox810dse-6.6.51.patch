+/**
+ * Delay helper
+ */
+
+static inline void ox810se_sata_wait_ms(struct ata_port *const ap, const unsigned ms)
+{
+	if (in_atomic())
+		mdelay(ms);
+	else {
+		if (NULLPTR(ap))
+			msleep(ms);
+		else
+			ata_msleep(ap, ms);
+	}
+}
+
+/**
+ *
+ */
+static inline int ox810se_sata_port_no(const struct ata_port *const ap)
+{
+	if (unlikely(NULLPTR(ap)))
+		return 0;
+
+	return sata_priv->host->ports[0] == ap ? 0 : 1;
+}
+static inline int ox810se_sata_other_port_no(const struct ata_port *const ap)
+{
+	if (unlikely(NULLPTR(ap)))
+		return 1;
+
+	return sata_priv->host->ports[0] == ap ? 1 : 0;
+}
+
+/**
+ *
+ */
+static inline struct ata_port *ox810se_sata_other_ap(const struct ata_port *const ap)
+{
+	if (likely(!NULLPTR(ap))) {
+		const int port_no = (sata_priv->host->n_ports > 1)
+			? ox810se_sata_other_port_no(ap) : 0;
+
+		return sata_priv->host->ports[port_no];
+	}
+
+	return NULL;
+}
+
+/**
+ * Gets the base address of the ata core from the ata_port structure. The value
+ * returned will remain the same when hardware raid is active.
+ *
+ * @param ap pointer to the appropriate ata_port structure
+ * @return the base address of the SATA core
+ */
+static inline void __iomem *ox810se_sata_iocore(void)
+{
+	return sata_priv->iomap + CORE_REG_BASE;
+}
+
+static inline void __iomem *ox810se_sata_ioport(const struct ata_port *const ap)
+{
+	return sata_priv->iomap + ox810se_sata_port_no(ap) * PORT_SIZE;
+}
+
+/**
+ * Gets the base of the ox810 port associated with the ata-port as known
+ * by lib-ata, The value returned changes to the single RAID port when
+ * hardware RAID commands are active.
+ *
+ * @param ap pointer to the appropriate ata_port structure
+ * @return the base address of the SATA core
+ */
+static inline void __iomem *ox810se_sata_ioportraid(const struct ata_port *const ap)
+{
+	if (likely(!sata_priv->hw_raid_active || sata_priv->active_ap != ap))
+		return ox810se_sata_ioport(ap);
+
+	return sata_priv->iomap + RAID_REG_BASE;
+
+}
+
+
+static inline u32 ox810se_sata_io_read(const void __iomem *const io)
+{
+	return readl(io);
+}
+
+static inline u32 ox810se_sata_iocore_read(const u32 reg)
+{
+	return ox810se_sata_io_read(ox810se_sata_iocore() + reg);
+}
+
+static inline u32 ox810se_sata_ioport_read(const struct ata_port *const ap, const u32 reg)
+{
+	return ox810se_sata_io_read(ox810se_sata_ioport(ap) + reg);
+}
+
+static inline u32 ox810se_sata_ioportraid_read(const struct ata_port *const ap, const u32 reg)
+{
+	return ox810se_sata_io_read(ox810se_sata_ioportraid(ap) + reg);
+}
+
+static inline void ox810se_sata_io_andor(void __iomem *const io, const u32 andmask, const u32 orval)
+{
+	if (andmask != 0)
+		writel((readl(io) & andmask) | orval, io);
+	else
+		writel(orval, io);
+	wmb();
+}
+
+static inline void ox810se_sata_iocore_andor(const u32 reg, const u32 andmask, const u32 orval)
+{
+	ox810se_sata_io_andor(ox810se_sata_iocore() + reg, andmask, orval);
+}
+
+static inline void ox810se_sata_ioport_andor(const struct ata_port *const ap, const u32 reg, const u32 andmask, const u32 orval)
+{
+	ox810se_sata_io_andor(ox810se_sata_ioport(ap) + reg, andmask, orval);
+}
+
+static inline void ox810se_sata_ioportraid_andor(const struct ata_port *const ap, const u32 reg, const u32 andmask, const u32 orval)
+{
+	ox810se_sata_io_andor(ox810se_sata_ioportraid(ap) + reg, andmask, orval);
+}
+
+/**
+ * Resetting core and clock helpers
+ */
+static void ox810se_sata_reset_assert(void)
+{
+#ifdef SATA_USE_RESOURCES_BY_DT
+	reset_control_assert(sata_priv->rst_sata);
+	reset_control_assert(sata_priv->rst_link);
+	reset_control_assert(sata_priv->rst_phy);
+#else
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL,
+		(1UL << SYS_CTRL_RSTEN_SATA_BIT)
+			| (1UL << SYS_CTRL_RSTEN_SATA_LINK_BIT)
+			| (1UL << SYS_CTRL_RSTEN_SATA_PHY_BIT));
+	wmb();
+#endif
+}
+
+static void ox810se_sata_reset_deassert(void)
+{
+#ifdef SATA_USE_RESOURCES_BY_DT
+	reset_control_deassert(sata_priv->rst_phy);
+#else
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_SATA_PHY_BIT);
+	wmb();
+#endif
+
+//	ox810se_sata_wait_ms(NULL, 1);
+	// poll for the block to leave reset instead of sleeping:
+	// the PHY un-resets in a handful of AHB clocks
+	{
+		u32 lim = 1000;
+		while (ox810se_sata_iocore_read(IDLE_STATUS) & CORE_IDLE && --lim)
+			udelay(10);
+	}
+
+#ifdef SATA_USE_RESOURCES_BY_DT
+	reset_control_deassert(sata_priv->rst_link);
+#else
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_SATA_LINK_BIT);
+	wmb();
+#endif
+
+//	ox810se_sata_wait_ms(NULL, 1);
+	udelay(100);
+
+#ifdef SATA_USE_RESOURCES_BY_DT
+	reset_control_deassert(sata_priv->rst_sata);
+#else
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_SATA_BIT);
+	wmb();
+#endif
+
+//	ox810se_sata_wait_ms(NULL, 1);
+	udelay(100);
+}
+
+static void ox810se_sata_clock_disable(void)
+{
+#ifdef SATA_USE_RESOURCES_BY_DT
+	clk_disable_unprepare(sata_priv->clk);
+#else
+	oxnas_sys_write(SYS_CTRL_CKEN_CLR_CTRL, 1UL << SYS_CTRL_CKEN_SATA_BIT);
+	wmb();
+#endif
+}
+
+static void ox810se_sata_clock_enable(void)
+{
+#ifdef SATA_USE_RESOURCES_BY_DT
+	clk_prepare_enable(sata_priv->clk);
+#else
+	oxnas_sys_write(SYS_CTRL_CKEN_SET_CTRL, 1UL << SYS_CTRL_CKEN_SATA_BIT);
+	wmb();
+#endif
+}
+
+static void ox810se_sata_dma_abort(void)
+{
+	const u32 mask = DEVICE_CONTROL_DMABT | DEVICE_CONTROL_ABORT;
+
+	ox810se_sata_iocore_andor(DEVICE_CONTROL, ~0UL, mask);
+	ox810se_sata_wait_ms(NULL, 1);
+	ox810se_sata_iocore_andor(DEVICE_CONTROL, ~mask, 0);
+
+	if (!NULLPTR(sata_priv->chan)) {
+#ifdef SATA_USE_NEW_ADMA_DRIVER
+		if (!NULLPTR(sata_priv->desc)) {
+			if (dmaengine_tx_status(sata_priv->chan, sata_priv->desc->cookie, NULL) == DMA_IN_PROGRESS)
+				dmaengine_terminate_async(sata_priv->chan);
+///			sata_priv->desc->callback = NULL;
+			sata_priv->desc = NULL;
+		}
+#else
+		if (oxnas_dma_is_active(sata_priv->chan))
+			oxnas_dma_abort(sata_priv->chan);
+///		oxnas_dma_set_callback(sata_priv->chan, NULL, NULL);
+#endif
+	}
+}
+
+static inline struct ata_queued_cmd *ox810se_sata_qc_from_tag(const struct ata_port *const ap, const unsigned int tag)
+{
+	if (likely(ata_tag_valid(tag) && !(ap->pflags & ATA_PFLAG_FROZEN)))
+		return ata_qc_from_tag((struct ata_port *)ap, tag);
+
+	return NULL;
+}
+
+static inline struct ata_queued_cmd *ox810se_sata_active_qc(const struct ata_port *const ap)
+{
+	if (likely(!NULLPTR(ap))) {
+		struct ata_queued_cmd *qc = ox810se_sata_qc_from_tag(ap, ap->link.active_tag);
+
+		if (likely(!NULLPTR(qc) && (qc->flags & ATA_QCFLAG_ACTIVE)))
+			return qc;
+	}
+
+	return NULL;
+}
+
+static inline void ox810se_sata_send_control_fis(const struct ata_port *const ap, const u32 cmd)
+{
+	ox810se_sata_ioportraid_andor(ap, SATA_COMMAND, ~SATA_OPCODE_MASK, cmd);
+}
+
+/* clears errors */
+static inline void ox810se_sata_cs_error_clear(const struct ata_port *const ap)
+{
+	if (!NULLPTR(ap))
+		ox810se_sata_ioportraid_andor(ap, SATA_COMMAND, SATA_CTL_ERR_MASK, 0);
+}
+
+static inline void ox810se_sata_sctl_error_clear(const struct ata_port *const ap)
+{
+	if (sata_priv->hw_raid_active)
+		ox810se_sata_ioportraid_andor(ap, SATA_CONTROL, RAID_CLR_ERR, 0);
+	if (!NULLPTR(ap))
+		ox810se_sata_ioportraid_andor(ap, SATA_CONTROL, SCTL_CLR_ERR, 0);
+}
+
+/**
+ * Clears the error caused by the core's registers being accessed when the
+ * core is busy.
+ */
+static inline void ox810se_sata_reg_access_error_clear(const struct ata_port *const ap)
+{
+	if (!NULLPTR(ap))
+		ox810se_sata_ioportraid_andor(ap, INT_STATUS, INT_REG_ACCESS_ERR, 0);
+}
+
+/**
+ * ox810se_sata_irq_clear is called during probe just before the interrupt handler is
+ * registered, to be sure hardware is quiet. It clears and masks interrupt bits
+ * in the SATA core.
+ *
+ * @param ap hardware with the registers in
+ */
+static inline void ox810se_sata_irq_clear(const struct ata_port *const ap)
+{
+	ox810se_sata_ioportraid_andor(ap, INT_CLEAR, 0, INT_USED/*~0*/);
+//    ox810se_sata_iocore_andor(CORE_INT_CLEAR, 0, ~0/*COREINT_PORT0_END << ox810se_sata_port_no(ap)*/);
+}
+
+/**
+ * turn off the interrupts from the ata drive
+ * clear any pending interrupts.
+ *
+ * @param ap Hardware with the registers in
+ */
+static inline void ox810se_sata_irq_off(const struct ata_port *const ap)
+{
+	// disable End of command interrupt
+	ox810se_sata_ioportraid_andor(ap, INT_DISABLE, 0, INT_USED);
+//    ox810se_sata_iocore_andor(CORE_INT_DISABLE, 0, ~0/*COREINT_PORT0_END << ox810se_sata_port_no(ap)*/);
+
+	// Clear pending interrupts
+	ox810se_sata_irq_clear(ap);
+
+//    ata_port_warn(ap, "interrupts DISabled\n");
+}
+
+/**
+ * turn on the interrupts from the ata drive
+ * wait for idle, clear any pending interrupts.
+ *
+ * @param ap Hardware with the registers in
+ */
+static inline void ox810se_sata_irq_on(const struct ata_port *const ap)
+{
+	// Clear pending interrupts
+	ox810se_sata_irq_clear(ap);
+
+	if (likely(!sata_priv->hw_raid_active)) {
+		// set normal interrupt scheme
+		ox810se_sata_iocore_andor(CORE_INT_ENABLE, 0, COREINT_NORMAL_USED);
+	}
+	else {
+		// set interrupt mode for raid controller interrupts only
+		ox810se_sata_iocore_andor(CORE_INT_ENABLE, 0, COREINT_RAID_USED);
+	}
+
+	// enable End of command interrupt
+	ox810se_sata_ioportraid_andor(ap, INT_ENABLE, 0, INT_USED);
+//	ox810se_sata_iocore_andor(CORE_INT_ENABLE, 0, COREINT_PORT0_END << ox810se_sata_port_no(ap));
+
+//	ata_port_warn(ap, "interrupts ENabled\n");
+}
+
+static inline bool ox810se_sata_qc_is_dma(const struct ata_queued_cmd *const qc)
+{
+	return NULLPTR(qc) ? false : (ata_is_data(qc->tf.protocol));
+}
+
+static inline void ox810se_sata_qc_complete(struct ata_port *const ap)
+{
+	struct ata_queued_cmd *qc;
+	unsigned long flags;
+
+	spin_lock_irqsave(ap->lock, flags);
+
+	qc = ox810se_sata_active_qc(ap);
+	if (likely(!NULLPTR(qc))) {
+		qc->err_mask = ac_err_mask(ox810se_sata_check_status(ap)) | AC_ERR_OK;
+		ata_qc_complete(qc);
+	}
+
+	spin_unlock_irqrestore(ap->lock, flags);
+
+	ox810se_sata_led_OFF();
+}
+
+static int ox810se_sata_dma_alloc(void)
+{
+	int rc = 0;
+
+	if (NULLPTR(sata_priv->chan) || IS_ERR(sata_priv->chan))
+	{
+#ifdef SATA_USE_NEW_ADMA_DRIVER
+		sata_priv->chan = dma_request_chan(&sata_priv->pdev->dev, "sgdma");
+#else
+		oxnas_sata_dma_settings.max_sg_entries_ = sata_priv->sht.sg_tablesize;
+		sata_priv->chan = oxnas_dma_request_chan(
+			&sata_priv->pdev->dev,
+			&oxnas_sata_dma_settings);
+		if (oxnas_sata_dma_settings.max_sg_entries_ < sata_priv->sht.sg_tablesize)
+			sata_priv->sht.sg_tablesize = oxnas_sata_dma_settings.max_sg_entries_;
+		printki("using maximum of %u descriptors on DMA channel %u\n",
+			sata_priv->sht.sg_tablesize, sata_priv->chan->chan_id);
+		if (NULLPTR(sata_priv->chan))
+			sata_priv->chan = ERR_PTR(-EPROBE_DEFER);
+#endif
+	}
+	if (NULLPTR(sata_priv->chan)) {
+		printke("failed to obtain DMA channel\n");
+		rc = -ENXIO;
+	}
+	else if (IS_ERR(sata_priv->chan)) {
+		rc = PTR_ERR(sata_priv->chan);
+		if (rc == -EPROBE_DEFER)
+			printkw("waiting for DMA to initialize\n");
+		else
+			printke("error %d allocating DMA channel\n", rc);
+		sata_priv->chan = NULL;
+	}
+	else ox810se_sata_dma_abort();
+
+	return rc;
+}
+
+static void ox810se_sata_dma_free(void)
+{
+	ox810se_sata_dma_abort();
+	if (!NULLPTR(sata_priv->chan)) {
+#ifdef SATA_USE_NEW_ADMA_DRIVER
+		dmaengine_synchronize(sata_priv->chan);
+		dma_release_channel(sata_priv->chan);
+#else
+		oxnas_dma_free_chan(sata_priv->chan);
+#endif
+		sata_priv->chan = NULL;
+	}
+}
+
+static inline bool ox810se_sata_dma_busy_check(const struct ata_port *const ap)
+{
+	struct ata_queued_cmd *qc = ox810se_sata_active_qc(ap);
+	bool check_dma = NULLPTR(qc) ? true : ox810se_sata_qc_is_dma(qc);
+
+	return check_dma && (
+#ifdef SATA_USE_NEW_ADMA_DRIVER
+		NULLPTR(sata_priv->desc) ? false
+			: dmaengine_tx_status(sata_priv->chan, sata_priv->desc->cookie, NULL)
+				== DMA_IN_PROGRESS
+#else
+		oxnas_dma_is_active(sata_priv->chan)
+#endif
+		);
+}
+
+static inline bool ox810se_sata_core_busy_check(const struct ata_port *const ap)
+{
+//	ox810se_sata_iocore_andor(IDLE_STATUS, 0, 0);
+
+	if (NULLPTR(ap))
+		return (~ox810se_sata_iocore_read(IDLE_STATUS)) & CORE_IDLE;
+	return (~ox810se_sata_iocore_read(IDLE_STATUS))
+		& (CORE_PORT0_IDLE << ox810se_sata_port_no(ap));
+}
+
+static inline bool ox810se_sata_port_ready_check(struct ata_queued_cmd *const qc)
+{
+	bool ready = false;
+
+///	if (ox810se_sata_core_busy_check(qc->ap) || (ox810se_sata_dma_busy_check(qc->ap)/* && ox810se_sata_qc_is_dma(qc)*/))
+///		return ATA_DEFER_PORT;
+	if (!ox810se_sata_core_busy_check(qc->ap)) {
+		if (NULLPTR(sata_priv->active_ap) || (qc->ap == sata_priv->active_ap)) {
+			if (!ox810se_sata_dma_busy_check(qc->ap))
+				ready = true;
+		}
+		else {
+			if (!(ox810se_sata_dma_busy_check(qc->ap) & (ox810se_sata_dma_busy_check(sata_priv->active_ap))))
+				ready = true;
+		}
+	}
+
+	return ready;
+}
+
+/**
+ * @return true if idle or false if still busy after timeout
+ */
+static inline bool ox810se_sata_core_idle_wait(struct ata_port *const ap)
+{
+	u32 t0;
+
+	if (likely(!irqs_disabled())) {
+		t0 = jiffies;
+		while (ox810se_sata_core_busy_check(ap) && (jiffies - t0 < MS_TO_JIFFIES(IDLE_WAIT_MS)))
+			cond_resched();
+		return jiffies - t0 < MS_TO_JIFFIES(IDLE_WAIT_MS);
+	}
+
+	t0 = (IDLE_WAIT_MS * 1000) / ATOMIC_DELAY_US + 1;
+	while (ox810se_sata_core_busy_check(ap) && --t0 != 0)
+		udelay(ATOMIC_DELAY_US - 1);
+	return t0 != 0;
+}
+
+static void ox810se_sata_core_reset_start(void)
+{
+	// Dirty hack for core to operate normally
+	// without additional resets or power triggering
+	ox810se_sata_iocore_andor(DEVICE_CONTROL, 0, ~0);
+	ox810se_sata_wait_ms(NULL, CORE_RESET_DELAY_MS);
+	ox810se_sata_iocore_andor(DEVICE_CONTROL, 0, 0);
+//	ox810se_sata_wait_ms(NULL, CORE_RESET_DELAY_MS);
+	udelay(1000);
+	ox810se_sata_iocore_andor(DEVICE_CONTROL, 0, ~0);
+//	ox810se_sata_wait_ms(NULL, CORE_RESET_DELAY_MS);
+	udelay(1000);
+
+	// reset Controller, Link and PHY
+	ox810se_sata_reset_assert();
+//	ox810se_sata_wait_ms(NULL, CORE_RESET_DELAY_MS);
+	udelay(1000);
+}
+
+/**
+ * Turns on the cores clock and resets it
+ */
+static void ox810se_sata_core_reset(void)
+{
+	int i;
+
+	for (i = 0; i < 25; i++) {
+
+		ox810se_sata_core_reset_start();
+
+		// un-reset the PHY, then Link and Controller
+		ox810se_sata_reset_deassert();
+		ox810se_sata_wait_ms(NULL, CORE_RESET_DELAY_MS);
+
+		if (!ox810se_sata_core_busy_check(NULL))
+			break;
+	}
+
+	ox810se_sata_iocore_andor(DEVICE_CONTROL, 0, 0);
+
+	// disable padding
+	ox810se_sata_iocore_andor(DEVICE_CONTROL, ~DEVICE_CONTROL_PAD, DEVICE_CONTROL_PADPAT);
+
+}
+
+static void ox810se_sata_srst_send(struct ata_port *const ap)
+{
+	ox810se_sata_port_priv_t *pd = ap->private_data;
+	struct ata_queued_cmd *qc = ox810se_sata_active_qc(ap);
+	u8 ctl;
+
+	if (!NULLPTR(qc))
+		pd->last_ctl = qc->tf.ctl;
+
+	ctl = pd->last_ctl;
+	ctl &= ~ATA_SRST;
+
+	// write values to registers
+	ox810se_sata_ioportraid_andor(ap, ORB1, 0, 0);
+	ox810se_sata_ioportraid_andor(ap, ORB2, 0, 0);
+	ox810se_sata_ioportraid_andor(ap, ORB3, 0, 0);
+	ox810se_sata_ioportraid_andor(ap, ORB4, 0, ctl << 24);
+	ox810se_sata_ioportraid_andor(ap, ORB5, 0, 0);
+	// command the core to send a control FIS
+	ox810se_sata_send_control_fis(ap, CMD_WRITE_TO_ORB_REGS_NO_COMMAND);
+	ox810se_sata_wait_ms(ap, 1);
+
+	// write value to register
+	ox810se_sata_ioportraid_andor(ap, ORB4, 0, (ctl | ATA_SRST) << 24);
+	// command the core to send a control FIS
+	ox810se_sata_send_control_fis(ap, CMD_WRITE_TO_ORB_REGS_NO_COMMAND);
+	ox810se_sata_wait_ms(ap, 1);
+
+	// write value to register
+	ox810se_sata_ioportraid_andor(ap, ORB4, 0, ctl << 24);
+	// command the core to send a control FIS
+	ox810se_sata_send_control_fis(ap, CMD_WRITE_TO_ORB_REGS_NO_COMMAND);
+	ox810se_sata_wait_ms(ap, SRST_WAIT_MS);
+}
+
+static inline void ox810se_sata_link_wait_ready(struct ata_port *const ap)
+{
+	u32 tries = SATA_OXNAS_LINK_WAIT_TRIES;
+
+	do {
+		if (ox810se_sata_ioport_read(ap, LINK_CONTROL) & 1UL)
+			break;
+	} while (--tries > 0);
+}
+
+/**
+ * allows access to the link layer registers
+ * @param link_reg the link layer register to access (oxsemi indexing ie
+ *        00 = static config, 04 = phy ctrl)
+ */
+static inline u32 ox810se_sata_link_read(struct ata_port *ap, unsigned int link_reg, spinlock_t *lock)
+{
+	u32 result;
+	unsigned long flags = 0;
+
+	if (!NULLPTR(lock) && !in_hardirq())
+		spin_lock_irqsave(lock, flags);
+
+	ox810se_sata_link_wait_ready(ap);
+
+	/* accessed twice as a workaround for a bug in the SATA abp bridge
+	 * hardware (bug 6828) */
+	ox810se_sata_ioport_andor(ap, LINK_RD_ADDR, 0, link_reg);
+	wmb();
+	(void)ox810se_sata_ioport_read(ap, LINK_RD_ADDR);
+
+	ox810se_sata_link_wait_ready(ap);
+
+	result = ox810se_sata_ioport_read(ap, LINK_DATA);
+
+	if (!NULLPTR(lock) && !in_hardirq())
+		spin_unlock_irqrestore(lock, flags);
+
+	return result;
+}
+/**
+ *  Read standard SATA phy registers. Currently only used if
+ * ->phy_reset hook called the sata_phy_reset() helper function.
+ *
+ * These registers are in another clock domain to the processor, access is via
+ * some bridging registers
+ *
+ * @param ap hardware with the registers in
+ * @param sc_reg the SATA PHY register
+ * @return the value in the register
+ */
+static u32 ox810se_sata_scr_read_port(struct ata_port *ap, unsigned int sc_reg)
+{
+	ox810se_sata_port_priv_t *pd = ap->private_data;
+	spinlock_t *lock = &pd->scrlock;
+
+	return ox810se_sata_link_read(ap, SCR2LINK(sc_reg), lock);
+}
+static int ox810se_sata_scr_read(struct ata_link *link, unsigned int sc_reg, u32 *val)
+{
+	*val = ox810se_sata_scr_read_port(link->ap, sc_reg);
+	return 0;
+}
+
+/**
+ * allows access to the link layer registers
+ * @param link_reg the link layer register to access (oxsemi indexing ie
+ *        00 = static config, 04 = phy ctrl)
+ */
+static inline void ox810se_sata_link_write(struct ata_port *ap, unsigned int link_reg, u32 val, spinlock_t *lock)
+{
+	unsigned long flags = 0;
+
+	if (!NULLPTR(lock) && !in_hardirq())
+		spin_lock_irqsave(lock, flags);
+
+	ox810se_sata_link_wait_ready(ap);
+
+	ox810se_sata_ioport_andor(ap, LINK_DATA, 0, val);
+//	wmb();
+	/* accessed twice as a workaround for a bug in the SATA abp bridge
+	 * hardware (bug 6828) */
+	ox810se_sata_ioport_andor(ap, LINK_WR_ADDR, 0, link_reg);
+	wmb();
+	(void)ox810se_sata_ioport_read(ap, LINK_WR_ADDR);
+
+	ox810se_sata_link_wait_ready(ap);
+
+	if (!NULLPTR(lock) && !in_hardirq())
+		spin_unlock_irqrestore(lock, flags);
+
+}
+/**
+ *  Write standard SATA phy registers. Currently only used if
+ * phy_reset hook called the sata_phy_reset() helper function.
+ *
+ * These registers are in another clock domain to the processor, access is via
+ * some bridging registers
+ *
+ * @param ap hardware with the registers in
+ * @param sc_reg the SATA PHY register
+ * @param val the value to write into the register
+ */
+static void ox810se_sata_scr_write_port(struct ata_port *ap, unsigned int sc_reg, u32 val)
+{
+	ox810se_sata_port_priv_t *pd = ap->private_data;
+	spinlock_t *lock = &pd->scrlock;
+
+	ox810se_sata_link_write(ap, SCR2LINK(sc_reg), val, lock);
+}
+static int ox810se_sata_scr_write(struct ata_link *link, unsigned int sc_reg, u32 val)
+{
+	ox810se_sata_scr_write_port(link->ap, sc_reg, val);
+	return 0;
+}
+
+/*
+ * @return true if the port has a cable connected
+ */
+static u32 ox810se_sata_check_link(struct ata_port *ap)
+{
+	/* Check for the cable present indicated by SCR status bit-0 set */
+	return ox810se_sata_scr_read_port(ap, SCR_STATUS) & 0x1;
+}
+
+/**
+ * sends a sync-escape if there is a link present
+ */
+static inline bool ox810se_sata_sync_escape_send(struct ata_port *const ap)
+{
+	bool reset = false;
+
+	// read the SSTATUS register and only send a sync escape if there is a link active
+	if (ox810se_sata_check_link(ap)) {
+//	if ((ox810se_sata_scr_read_port(ap, SCR_STATUS) & 3) == 3) {
+		ox810se_sata_ioport_andor(ap, SATA_COMMAND, ~SATA_OPCODE_MASK, CMD_SYNC_ESCAPE);
+		reset = true;
+	}
+
+	return reset;
+}
+
+static inline void ox810se_sata_phy_error_clear(struct ata_port *const ap)
+{
+	// clear phy/link errors
+	ox810se_sata_scr_write_port(ap, SCR_ERROR, ~0);
+}
+
+static inline void ox810se_sata_errors_clear(struct ata_port *const ap)
+{
+	ox810se_sata_reg_access_error_clear(ap);
+	ox810se_sata_cs_error_clear(ap);
+	ox810se_sata_sctl_error_clear(ap);
+	ox810se_sata_phy_error_clear(ap);
+}
+
+static bool ox810se_sata_link_hard_reset(struct ata_port *ap)
+{
+	u32 tries = SATA_OXNAS_HARD_RESET_TRIES;
+	int rc;
+
+	do {
+		const unsigned int *timing = sata_ehc_deb_timing(&ap->link.eh_context);
+
+		ox810se_sata_errors_clear(ap);
+		rc = sata_link_hardreset(
+			&ap->link, timing, msecs_to_jiffies(IDLE_WAIT_MS), NULL, NULL);
+	} while ((!ox810se_sata_check_link(ap) || rc) && --tries > 0);
+
+	if (rc)
+		ata_port_warn(ap, "link reset fail\n");
+
+	return rc == 0;
+}
+
+/**
+ * @param ap ata port
+ */
+static void ox810se_sata_cleanup(struct ata_port *const ap)
+{
+	u32 tries = SATA_OXNAS_CLEANUP_TRIES;
+
+	ox810se_sata_irq_off(ap);
+
+	do {
+		// clear errors
+		ox810se_sata_errors_clear(ap);
+		if (!ox810se_sata_core_busy_check(ap))
+			goto cleanup_exit;
+		ox810se_sata_wait_ms(ap, 1);
+		if (!ox810se_sata_core_busy_check(ap))
+			goto cleanup_exit;
+
+		// abort DMA
+		ox810se_sata_dma_abort();
+		if (ox810se_sata_core_idle_wait(ap))
+			goto cleanup_exit;
+
+		// send sync escape code
+		ox810se_sata_errors_clear(ap);
+		if (ox810se_sata_sync_escape_send(ap)) {
+			if (ox810se_sata_core_idle_wait(ap))
+				goto cleanup_exit;
+			ox810se_sata_errors_clear(ap);
+		}
+
+		// SRST
+		ox810se_sata_srst_send(ap);
+		if (ox810se_sata_core_idle_wait(ap))
+			goto cleanup_exit;
+
+		// link hard reset
+		if (ox810se_sata_link_hard_reset(ap))
+			goto cleanup_exit;
+		if (ox810se_sata_core_idle_wait(ap))
+			goto cleanup_exit;
+
+	} while (--tries > 0);
+
+cleanup_exit:
+	ox810se_sata_errors_clear(ap);
+	ox810se_sata_irq_on(ap);
+	return;
+}
+
+/**
+ * Reads the Status ATA shadow register from hardware. Due to a fault with PIO
+ * transfers, it it sometimes necessary to mask out the DRQ bit
+ * @param ap hardware with the registers in
+ * @return The status register
+ */
+static u8 ox810se_sata_check_status(struct ata_port *ap)
+{
+	u8 status = ox810se_sata_ioportraid_read(ap, ORB2) >> 24;
+
+	// check for the drive going missing indicated by SCR status bits 0-3 = 0
+	u32 reg = ox810se_sata_check_link(ap);
+
+	if (sata_priv->hw_raid_active)
+		reg |= ox810se_sata_check_link(ox810se_sata_other_ap(ap));
+
+	if (!reg)
+		status |= ATA_DF | ATA_ERR;
+
+	return status;
+}
+
+/**
+ * The driver probe function.
+ * Registered with the amba bus driver as a parameter of ox810se_sata_driver.bus
+ * it will register the ata device with kernel first performing any
+ * initialization required (if the correct device is present).
+ * @param pdev Pointer to the 921 device structure
+ * @return 0 if no errors
+ */
+static int ox810se_sata_driver_probe(struct platform_device *pdev)
+{
+	u32 version;
+	void __iomem *port_base = NULL;
+	struct ata_port_info *port_info[SATA_OXNAS_MAX_PORTS + 1] = { NULL };
+	struct resource *res;
+	int i, rc, irq = 0, n_ports = SATA_OXNAS_MAX_PORTS;
+	struct scsi_host_template sht = {
+		ATA_NCQ_SHT(DRIVER_NAME),
+		.can_queue = SATA_OXNAS_QUEUE_DEPTH,
+		.sg_tablesize = SATA_OXNAS_MAX_SG,
+		.dma_boundary = SZ_2M - 1, //OXNAS_MAX_DMA_ADDRESS,
+	};
+
+#ifdef CONFIG_DRIVERS_PRIVATE_IN_SRAM
+	sata_priv = oxnas_sram_zalloc(sizeof(ox810se_sata_host_priv_t), NULL);
+#else
+	sata_priv = devm_kzalloc(&pdev->dev, sizeof(ox810se_sata_host_priv_t), GFP_KERNEL);
+#endif
+	if (sata_priv == NULL) {
+		printke("couldn't allocate %u bytes for private data\n", sizeof(ox810se_sata_host_priv_t));
+		return -ENOMEM;
+	}
+
+	// Get IRQ line
+	if (!NULLPTR(pdev->dev.of_node))
+		irq = irq_of_parse_and_map(pdev->dev.of_node, 0);
+	if (irq <= 0)
+		irq = platform_get_irq(pdev, 0);
+	if (irq <= 0) {
+		printke("couldn't acquire IRQ line\n");
+		rc = irq == 0 ? -ENXIO : irq;
+		goto error_exit_with_cleanup;
+	}
+
+	// Check I/O base
+	port_base = oxnas_devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(port_base)) {
+		rc = PTR_ERR(port_base);
+		goto error_exit_with_cleanup;
+	}
+	sata_priv->iomap = port_base;
+	sata_priv->pdev = pdev;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	sata_priv->data_phys = res->start;
+
+	// Port operations for the ox810se ports
+	sata_priv->port_ops.inherits = &sata_port_ops;
+	sata_priv->port_ops.qc_defer = ox810se_sata_qc_defer;
+	sata_priv->port_ops.qc_prep = ox810se_sata_qc_prep;
+	sata_priv->port_ops.qc_issue = ox810se_sata_qc_issue;
+	sata_priv->port_ops.qc_fill_rtf = ox810se_sata_qc_fill_rtf;
+	sata_priv->port_ops.softreset = ox810se_sata_softreset;
+	sata_priv->port_ops.dev_config = ox810se_sata_dev_config;
+	sata_priv->port_ops.scr_read = ox810se_sata_scr_read;
+	sata_priv->port_ops.scr_write = ox810se_sata_scr_write;
+	sata_priv->port_ops.port_start = ox810se_sata_port_start;
+	sata_priv->port_ops.port_stop = ox810se_sata_port_stop;
+	sata_priv->port_ops.host_stop = ox810se_sata_host_stop;
+	sata_priv->port_ops.error_handler = ox810se_sata_error_handler;
+	sata_priv->port_ops.post_internal_cmd = ox810se_sata_post_internal_cmd;
+	// Port capabilities for the ox810se sata ports
+	sata_priv->port_info.flags = SATA_OXNAS_HOST_FLAGS;
+	sata_priv->port_info.pio_mask = ATA_PIO4; /* pio modes 0..4 */
+	sata_priv->port_info.udma_mask = ATA_UDMA6; /* udma 0..6 */
+	sata_priv->port_info.port_ops = &sata_priv->port_ops;
+	// The scsi_host_template structure describes the capabilities of libata
+	//  and our 921 core to the SCSI framework in the libata library
+	memcpy(&sata_priv->sht, &sht, sizeof(sht));
+
+	// Hold on to a DMA channel for the life of the SATA driver
+	rc = ox810se_sata_dma_alloc();
+	if (rc) {
+		goto error_exit_with_cleanup;
+	}
+
+#ifdef SATA_USE_RESOURCES_BY_DT
+	sata_priv->clk = of_clk_get(pdev->dev.of_node, 0);
+	if (IS_ERR(sata_priv->clk)) {
+		rc = PTR_ERR(sata_priv->clk);
+		sata_priv->clk = NULL;
+		goto error_exit_with_cleanup;
+	}
+
+	sata_priv->rst_sata = devm_reset_control_get(&pdev->dev, "sata");
+	if (IS_ERR(sata_priv->rst_sata)) {
+		rc = PTR_ERR(sata_priv->rst_sata);
+		sata_priv->rst_sata = NULL;
+		goto error_exit_with_cleanup;
+	}
+
+	sata_priv->rst_link = devm_reset_control_get(&pdev->dev, "link");
+	if (IS_ERR(sata_priv->rst_link)) {
+		rc = PTR_ERR(sata_priv->rst_link);
+		sata_priv->rst_link = NULL;
+		goto error_exit_with_cleanup;
+	}
+
+	sata_priv->rst_phy = devm_reset_control_get(&pdev->dev, "phy");
+	if (IS_ERR(sata_priv->rst_phy)) {
+		rc = PTR_ERR(sata_priv->rst_phy);
+		sata_priv->rst_phy = NULL;
+		goto error_exit_with_cleanup;
+	}
+#endif
+
+	ox810se_sata_clock_enable();
+	ox810se_sata_wait_ms(NULL, 1);
+	// reset the core
+	ox810se_sata_core_reset();
+
+	// Get and check number of ports
+	if (!NULLPTR(pdev->dev.of_node)) {
+		(void)of_property_read_u32(pdev->dev.of_node, "nr-ports", &n_ports);
+		if (n_ports < 1 || n_ports > SATA_OXNAS_MAX_PORTS) {
+			printke("invalid number of ports (=%d)\n", n_ports);
+			rc = -ENXIO;
+			goto error_exit_with_cleanup;
+		}
+	}
+
+	version = ox810se_sata_ioport_read(NULL, SATA_VERSION);
+	if (n_ports > 1 && ox810se_sata_ioport_read(NULL, PORT_SIZE + SATA_VERSION) != version) {
+		n_ports = 1;
+		port_info[1] = NULL;
+	}
+
+	// check we support this version of the core
+	switch (version) {
+		case SATA_OXNAS_CORE_VERSION:
+			printki("934 %s SATA core v%u.%02X (0x%08X), iomap=0x%08X\n",
+				n_ports > 1 ? "two-ports" : "single-port", version >> 8, version & 0xFF,
+					ox810se_sata_iocore_read(SATA_VERSION), (u32)port_base);
+			break;
+		default:
+			printke("unknown SATA core (v%u.%02X/0x%08X, iomap=0x%08X)\n",
+				version >> 8, version & 0xFF,
+					ox810se_sata_iocore_read(SATA_VERSION), (u32)port_base);
+			rc = -EINVAL;
+			goto error_exit_with_cleanup;
+	}
+
+	// Get and enable ports power gpios if available
+	for (i = 0 ; i < n_ports ; i++) {
+#ifdef SATA_USE_RESOURCES_BY_DT
+		struct gpio_desc *gpio_power
+			= devm_gpiod_get_index_optional(&pdev->dev, "power", i, 0);
+		if (!NULLPTR(gpio_power))
+			gpiod_direction_output(gpio_power, 1);
+#endif
+		port_info[i] = &sata_priv->port_info;
+	}
+	port_info[i] = NULL;
+
+	// allocate memory and check
+	sata_priv->host = ata_host_alloc_pinfo(&pdev->dev, (const struct ata_port_info **)port_info, n_ports);
+	if (!NULLPTR(sata_priv->host) && !IS_ERR(sata_priv->host)) {
+		sata_priv->host->private_data = sata_priv; // recursion
+		// call ata_device_add and begin probing for drives
+		rc = ata_host_activate(
+			sata_priv->host, irq, ox810se_sata_irq_handler, SATA_OXNAS_IRQ_FLAG, &sata_priv->sht);
+		if (rc) {
+			sata_priv->host = NULL;
+			goto error_exit_with_cleanup;
+		}
+	}
+	if (IS_ERR(sata_priv->host)) {
+		rc = PTR_ERR(sata_priv->host);
+		sata_priv->host = NULL;
+	}
+	if (NULLPTR(sata_priv->host)) {
+		if (!rc)
+			rc = -ENOMEM;
+		printke("couldn't create an ata host, error %d\n", rc);
+		goto error_exit_with_cleanup;
+	}
+
+	// Get 2nd IRQ line
+	if (n_ports > 1) {
+		irq = 0;
+		if (!NULLPTR(pdev->dev.of_node))
+			irq = irq_of_parse_and_map(pdev->dev.of_node, 1);
+		if (irq <= 0)
+			irq = platform_get_irq(pdev, 1);
+		if (irq > 0) {
+			if (devm_request_irq(&pdev->dev, irq, ox810se_sata_irq_handler, 0, "sata-2", sata_priv->host))
+				printkw("Failed to allocate aux. IRQ %u for SATA\n", irq);
+		}
+	}
+	// Get 3rd IRQ line
+	irq = 0;
+	if (!NULLPTR(pdev->dev.of_node))
+		irq = irq_of_parse_and_map(pdev->dev.of_node, 2);
+	if (irq <= 0)
+		irq = platform_get_irq(pdev, 2);
+	if (irq > 0) {
+		if (devm_request_irq(&pdev->dev, irq, ox810se_sata_irq_handler, 0, "sata-err", sata_priv->host))
+			printkw("Failed to allocate aux. IRQ %u for SATA\n", irq);
+	}
+	// Get 4th IRQ line
+	irq = 0;
+	if (!NULLPTR(pdev->dev.of_node))
+		irq = irq_of_parse_and_map(pdev->dev.of_node, 3);
+	if (irq <= 0)
+		irq = platform_get_irq(pdev, 3);
+	if (irq > 0) {
+		if (devm_request_irq(&pdev->dev, irq, ox810se_sata_irq_handler, 0, "sata-2-err", sata_priv->host))
+			printkw("Failed to allocate aux. IRQ %u for SATA\n", irq);
+	}
+
+	ox810se_sata_led_init();
+	sata_priv->active_ap = NULL;
+	return 0;
+
+error_exit_with_cleanup:
+	if (irq > 0 && !NULLPTR(pdev->dev.of_node))
+		irq_dispose_mapping(irq);
+	if (!NULLPTR(sata_priv)) {
+#ifdef SATA_USE_RESOURCES_BY_DT
+		if (!NULLPTR(sata_priv->clk))
+			clk_put(sata_priv->clk);
+		if (!NULLPTR(sata_priv->rst_sata))
+			reset_control_put(sata_priv->rst_sata);
+		if (!NULLPTR(sata_priv->rst_link))
+			reset_control_put(sata_priv->rst_link);
+		if (!NULLPTR(sata_priv->rst_phy))
+			reset_control_put(sata_priv->rst_phy);
+#endif
+		if (!NULLPTR(sata_priv->host))
+			ata_host_detach(sata_priv->host);
+		ox810se_sata_dma_free();
+	}
+	return rc;
+}
