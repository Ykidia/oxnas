+	NAPI_OOM_POLL_INTERVAL_MS = 50,
+	WATCHDOG_TIMER_INTERVAL = 500*HZ/1000,
+	AUTO_NEG_MS_WAIT = 500,
+	AUTO_NEG_INTERVAL = (AUTO_NEG_MS_WAIT)*HZ/1000,
+	START_RESET_INTERVAL = 50*HZ/1000,
+	RESET_INTERVAL = 10*HZ/1000,
+	GMAC_RESET_TIMEOUT_MS = 10000,
+	CHECK_TX_STOP_TRIES = 10000,
+	COPRO_GENERAL_TIMEOUT = HZ*3,
+	COPRO_CMD_QUEUE_RETRIES = 11,
+};
+
+#ifdef CONFIG_LEON_COPRO
+
+static int copro_queue_cmd(u32 opcode, u32 operand, cmd_que_ack_callback callback)
+{
+	int cmd_queue_result;
+	int tries = COPRO_CMD_QUEUE_RETRIES;
+
+	do {
+		cmd_queue_result = cmd_que_queue_cmd(&gmac_priv->cmd_queue_, opcode, operand, callback);
+		if (cmd_queue_result) {
+			udelay(100);
+		}
+	} while (cmd_queue_result && --tries);
+
+	if (cmd_queue_result) {
+		gmac_warn("CoPro command queue full (op=0x%08x), CoPro not draining\n", opcode);
+		return -EBUSY;
+	}
+	return 0;
+}
