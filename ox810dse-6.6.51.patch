+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+ */
+
+#include <linux/init.h>
+#include <linux/list.h>
+#include <linux/irq.h>
+#include <mach/hardware.h>
+#include <asm/irq.h>      /* set_handle_irq, handle_IRQ */
+#include <asm/exception.h> /* __exception_irq_entry */
+#include <linux/bitops.h> /* __ffs */
+
+
+extern void __init oxnas_init_resources(void);
+
+
+static void __exception_irq_entry oxnas_handle_irq(struct pt_regs *regs)
+{
+	u32 stat;
+
+	while ((stat = oxnas_rps_read(RPS_IRQ_STATUS)) != 0) {
+		do {
+			unsigned int irqnr = __builtin_ctz(stat);
+			stat &= stat - 1;
+			generic_handle_irq(irqnr);
+		} while (stat);
+	}
+}
+
+void oxnas_disable_all_irqs_fiqs(void)
+{
+	/* Disable all IRQs */
+	oxnas_rps_write(RPS_IRQ_DISABLE, ~0UL);
+
+	/* Disable FIQ */
+	oxnas_rps_write(RPS_FIQ_DISABLE, ~0UL);
+}
+
+static void oxnas_mask_irq(struct irq_data *data)
+{
+	oxnas_rps_write(RPS_IRQ_DISABLE, 1UL << data->irq);
+}
+
+static void oxnas_unmask_irq(struct irq_data *data)
+{
+	oxnas_rps_write(RPS_IRQ_ENABLE, 1UL << data->irq);
+}
+
+static struct irq_chip oxnas_irq_chip = {
+	.name		= "oxnas-irq",
+/*	.irq_ack	= oxnas_mask_irq, */
+	.irq_mask_ack	= oxnas_mask_irq,
+	.irq_mask	= oxnas_mask_irq,
+	.irq_unmask	= oxnas_unmask_irq,
+};
+
+void __init oxnas_init_irq(void)
+{
+	unsigned irq;
+
+	oxnas_init_resources();
+
+	printk(KERN_DEBUG "%s():\n", __func__);
+
+	oxnas_disable_all_irqs_fiqs();
+
+	/* Initialise IRQ tracking structures */
+	for (irq = 0; irq < NR_IRQS; irq++) {
+		irq_flow_handler_t flow = handle_level_irq;
+		// timers handlers already do source reset by itself
+		if (irq == TIMER_1_INTERRUPT || irq == TIMER_2_INTERRUPT)
+			flow = handle_simple_irq;
+		irq_set_chip_and_handler(irq, &oxnas_irq_chip, flow);
+		irq_modify_status(irq, IRQ_NOREQUEST | IRQ_NOPROBE, 0/*IRQ_NOAUTOEN*/);
+	}
+
+	set_handle_irq(oxnas_handle_irq);
+}
+
