+static void start_watchdog_timer(void)
+{
+	gmac_priv->watchdog_timer_shutdown = 0;
+	mod_timer(&gmac_priv->watchdog_timer, jiffies + WATCHDOG_TIMER_INTERVAL);
+}
+
+static void delete_watchdog_timer(void)
+{
+	// Ensure link/PHY state watchdog timer won't be invoked again
+	gmac_priv->watchdog_timer_shutdown = 1;
+	del_timer_sync(&gmac_priv->watchdog_timer);
+}
