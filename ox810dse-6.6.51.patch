+#include <scsi/scsi_device.h>
+#include <asm/io.h>
+
+#include <linux/platform_device.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/of_dma.h>
+#include <linux/clk.h>
+#include <linux/dmaengine.h>
+#include <linux/reset.h>
+#include <linux/gpio/consumer.h>
+#include <linux/version.h>
+
+//#define SATA_USE_RESOURCES_BY_DT
+//#define SATA_USE_NEW_ADMA_DRIVER
+#undef SATA_USE_RESOURCES_BY_DT
+#undef SATA_USE_NEW_ADMA_DRIVER
+
+#ifndef SATA_USE_RESOURCES_BY_DT
+#include <mach/hardware.h>
+#endif
+#ifdef CONFIG_WDC_LEDS_TRIGGER_SATA_DISK
+#include <linux/leds.h>
+#endif
+
+#include "libata.h"
+
+/***************************************************************************
+* CONSTANTS
+***************************************************************************/
+
+#define DRIVER_AUTHOR			"Oxford Semiconductor Ltd, Artem Bogdanov"
+#define DRIVER_DESC			"934 SATA core controler driver"
+#define DRIVER_NAME			"ox810se-sata"
+
+#define SCR2LINK(x)			(0x20 + ((x) * 4))
+#ifndef NULLPTR
+#define NULLPTR(x)			((u32)(x) < (PAGE_SIZE))
+#endif
+
+#define printkx(x, fmt, args...)	printk(x DRIVER_NAME ": " fmt, ## args)
+#define printkd(fmt, args...)		printkx(KERN_DEBUG, fmt, ## args))
+#define printki(fmt, args...)		printkx(KERN_INFO, fmt, ## args)
+#define printkw(fmt, args...)		printkx(KERN_WARNING, fmt, ## args)
+#define printke(fmt, args...)		printkx(KERN_ERR, fmt, ## args)
+#define PRINTKX(x, fmt, args...)	printk(x DRIVER_NAME ": %s() " fmt, __func__, ## args)
+#define PRINTKD(fmt, args...)		PRINTKX(KERN_DEBUG, fmt, ## args)
+#define PRINTKI(fmt, args...)		PRINTKX(KERN_INFO, fmt, ## args)
+#define PRINTKW(fmt, args...)		PRINTKX(KERN_WARNING, fmt, ## args)
+#define PRINTKE(fmt, args...)		PRINTKX(KERN_ERR, fmt, ## args)
+#ifdef ATA_DEBUG
+#define DPRINTKI(fmt, args...)		printki(fmt, ## args)
+#define DPRINTKW(fmt, args...)		printkw(fmt, ## args)
+#define DPRINTKE(fmt, args...)		printke(fmt, ## args)
+#ifdef ATA_VERBOSE_DEBUG
+#define VPRINTKI(fmt, args...)		printki(fmt, ## args)
+#define VPRINTKW(fmt, args...)		printkw(fmt, ## args)
+#else
+#define VPRINTKI(fmt, args...)
+#define VPRINTKW(fmt, args...)
+#endif
+#else
+#define DPRINTKI(fmt, args...)
+#define DPRINTKW(fmt, args...)
+#define DPRINTKE(fmt, args...)
+#define VPRINTKI(fmt, args...)
+#define VPRINTKW(fmt, args...)
+#endif
+
+#ifdef CONFIG_SATA_OXNAS_DISK_LIGHT_GPIO_LINE
+#define SATA_LED_MASK		(1UL << (CONFIG_SATA_OXNAS_DISK_LIGHT_GPIO_LINE % GPIO_AB_NUM_PINS))
+#endif
+#ifndef CONFIG_ARCH_OXNAS_MAX_SATA_SG_ENTRIES
+#define CONFIG_ARCH_OXNAS_MAX_SATA_SG_ENTRIES 254 // 63 //
+#endif
+
+#define SATA_OXNAS_PORT(n, x)	((x) << n)
+#define SATA_OXNAS_ALL_PORTS(x)	((x) | SATA_OXNAS_PORT(1, x))
+#define MS_TO_JIFFIES(x)	(((x) < (1000/(HZ))) ? 1 : (x) * (HZ) / 1000)
+
+/* Delays/waits */
+enum {
+	ATOMIC_DELAY_US = 10,
+	IDLE_WAIT_MS = 1000,
+	IDLE_MAXIMUM_WAIT_MS = 3000,
+	CORE_RESET_DELAY_MS = 20,
+	SRST_WAIT_MS = ATA_WAIT_AFTER_RESET,
+	ABORT_WAIT_MS = 5000,
+};
+
+/* Retries */
+enum {
+	SATA_OXNAS_LINK_WAIT_TRIES = 0x10000,
+	SATA_OXNAS_INTERNAL_CMD_IDLE_WAIT_TRIES = 999,
+	SATA_OXNAS_CLEANUP_TRIES = 33,
+	SATA_OXNAS_HARD_RESET_TRIES = 29,
+	SATA_OXNAS_PORT_FAIL_TRIES = 2,
+};
+
+/* Controller information */
+enum {
+	SATA_OXNAS_MAX_SG = CONFIG_ARCH_OXNAS_MAX_SATA_SG_ENTRIES,
+#ifdef CONFIG_OX810SATA_SINGLE_SATA
+	SATA_OXNAS_MAX_PORTS = 1,
+#else
+	SATA_OXNAS_MAX_PORTS = 2,
+#endif
+	/** The different OxSemi SATA core version numbers */
+	SATA_OXNAS_CORE_VERSION = 0x1F2, /* 0x1F3 for ox820 */
+	SATA_OXNAS_IRQ_FLAG = 0,
+	SATA_OXNAS_HOST_FLAGS = (ATA_FLAG_SATA | ATA_FLAG_PIO_DMA
+		| ATA_FLAG_NO_ATAPI /*| ATA_FLAG_NCQ*/),
+	SATA_OXNAS_QUEUE_DEPTH = 32,
+
+	SATA_OXNAS_DMA_BOUNDARY = OXNAS_MAX_DMA_ADDRESS,
+
+	PORT_SIZE = 0x10000,
+	CORE_REG_BASE = 0xE0000,
+	RAID_REG_BASE = 0xF0000,
+	SATA_REG_SIZE = PORT_SIZE * 0x10,
+	SATA_DATA_SIZE = 0x1000000,
+};
+
+/*
+ * SATA Port Registers
+ */
+enum {
+	/** sata host port register offsets */
+	ORB1 = 0x00,
+	ORB2 = 0x04,
+	ORB3 = 0x08,
+	ORB4 = 0x0C,
+	ORB5 = 0x10,
+	MASTER_STATUS = 0x10,
+	FIS_CTRL = 0x18,
+	FIS_DATA = 0x1C,
+	INT_STATUS = 0x30,
+	INT_CLEAR = 0x30,
+	INT_ENABLE = 0x34,
+	INT_DISABLE = 0x38,
+	SATA_VERSION = 0x3C,
+	SATA_CONTROL = 0x5C,
+	SATA_COMMAND = 0x60,
+	HID_FEATURES = 0x64,
+	PORT_CONTROL = 0x68,
+	DRIVE_CONTROL = 0x6C,
+
+	/** These registers allow access to the link layer registers
+	that reside in a different clock domain to the processor bus */
+	LINK_DATA = 0x70,
+	LINK_RD_ADDR = 0x74,
+	LINK_WR_ADDR = 0x78,
+	LINK_CONTROL = 0x7C,
+};
+
+/** sata port register bits */
+enum {
+	/**
+	 * commands to issue in the master status to tell it to move shadow ,
+	 * registers to the actual device ,
+	 */
+	SATA_OPCODE_MASK = 0x00000007,
+	CMD_WRITE_TO_ORB_REGS_NO_COMMAND = 0x4,
+	CMD_WRITE_TO_ORB_REGS = 0x2,
+	CMD_SYNC_ESCAPE = 0x7,
+	CMD_CORE_BUSY = (1 << 7),
+	CMD_DRIVE_SELECT_SHIFT = 12,
+	CMD_DRIVE_SELECT_MASK = (0xf << CMD_DRIVE_SELECT_SHIFT),
+
+	/** interrupt bits */
+	INT_END_OF_CMD = 1 << 0,
+	INT_LINK_SERROR = 1 << 1,
+	INT_ERROR = 1 << 2,
+	INT_LINK_IRQ = 1 << 3,
+	INT_REG_ACCESS_ERR = 1 << 7,
+	INT_BIST_FIS = 1 << 11,
+	INT_ERRORS = INT_LINK_SERROR
+		| INT_REG_ACCESS_ERR
+		| INT_ERROR,
+	INT_MASKABLE = INT_END_OF_CMD
+		| INT_ERRORS
+		| INT_LINK_IRQ
+		| INT_BIST_FIS,
+	INT_USED = INT_MASKABLE, // INT_END_OF_CMD | INT_ERRORS, //
+
+	/** raw interrupt bits, unmaskable, but do not generate interrupts */
+	RAW_END_OF_CMD = INT_END_OF_CMD << 16,
+	RAW_LINK_SERROR = INT_LINK_SERROR  << 16,
+	RAW_ERROR = INT_ERROR << 16,
+	RAW_LINK_IRQ = INT_LINK_IRQ << 16,
+	RAW_REG_ACCESS_ERR = INT_REG_ACCESS_ERR << 16,
+	RAW_BIST_FIS = INT_BIST_FIS << 16,
+	RAW_USED = INT_USED << 16,
+	RAW_ERRORS = INT_ERRORS << 16,
+
+	/**
+	 * variables to write to the device control register to set the current
+	 * device, ie. master or slave.
+	 */
+	DR_CON_48 = 2,
+	DR_CON_28 = 0,
+
+	SATA_CTL_ERR_MASK = 0x00000016,
+};
+
+/** SATA core register offsets */
+enum {
+	DM_DBG1 = 0x000,
+	RAID_SET = 0x004,
+	DM_DBG2 = 0x008,
+	DATACOUNT_PORT0 = 0x010,
+	DATACOUNT_PORT1 = 0x014,
+	CORE_INT_STATUS = 0x030,
+	CORE_INT_CLEAR = 0x030,
+	CORE_INT_ENABLE = 0x034,
+	CORE_INT_DISABLE  = 0x038,
+	CORE_REBUILD_ENABLE = 0x050,
+	CORE_FAILED_PORT_R = 0x054,
+	DEVICE_CONTROL = 0x068,
+	EXCESS = 0x06C,
+	PORT_ERROR_MASK = 0x078,
+	IDLE_STATUS = 0x07C,
+	RAID_CONTROL = 0x090,
+	PROC_PC = 0x100,
+	CONFIG_IN = 0x3d8,
+	PROC_START = 0x3f0,
+	PROC_RESET = 0x3f4,
+	DATA_MUX_RAM0 = 0x8000,
+	DATA_MUX_RAM1 = 0xA000,
+};
+
+enum {
+	/* Sata core debug1 register bits */
+	CORE_PORT0_DATA_DIR = 1 << 20,
+
+	/** sata core control register bits */
+	SCTL_CLR_ERR = 0x00003016,
+	RAID_CLR_ERR = 0x0000011e,
+
+	/* shift these left by port number */
+	COREINT_PORT0_HOST = 0x00000001,
+	COREINT_PORT0_END = 0x00000100,
+
+	/* Interrupts direct from the selected port (shift left by port number) */
+	COREINT_PORT0 = COREINT_PORT0_HOST | COREINT_PORT0_END,
+	/* Interrupts from the RAID controller only */
+	COREINT_RAID = 0x00008000,
+	COREINT_NORMAL_USED = SATA_OXNAS_ALL_PORTS(COREINT_PORT0),
+	COREINT_RAID_USED = COREINT_RAID | COREINT_NORMAL_USED,
+	CORERAW_PORT0_HOST = COREINT_PORT0_HOST << 16,
+	CORERAW_PORT0_END = COREINT_PORT0_END << 16,
+
+	/* The bits in the IDLE_STATUS that, when set indicate an idle core */
+	CORE_PORT0_IDLE = 1 << 18,
+	CORE_IDLE = SATA_OXNAS_ALL_PORTS(CORE_PORT0_IDLE),
+
+	/** Device Control register bits */
+	DEVICE_CONTROL_DMABT = 1 << 4,
+	DEVICE_CONTROL_ABORT = 1 << 2,
+	DEVICE_CONTROL_PAD = 1 << 3,
+	DEVICE_CONTROL_PADPAT = 1 << 16,
+	DEVICE_CONTROL_PRTRST = 1 << 8,
+	DEVICE_CONTROL_RAMRST = 1 << 12,
+	DEVICE_CONTROL_ATA_ERR_OVERRIDE = 1 << 28,
+
+	/** standard HW raid flags */
+	OXNASSATA_NOTRAID = 3,
+	OXNASSATA_RAID1 = 1,
+	OXNASSATA_RAID0 = 0,
+	OXNASSATA_RAID_TWODISKS = 3,
+};
+
+enum {
+	STAT_READ_VALID = (1 << 21),
+	STAT_CR_ACK = (1 << 20),
+	STAT_CR_READ = (1 << 19),
+	STAT_CR_WRITE = (1 << 18),
+	STAT_CAP_DATA = (1 << 17),
+	STAT_CAP_ADDR = (1 << 16),
+
+	STAT_ACK_ANY = STAT_CR_ACK
+		| STAT_CR_READ
+		| STAT_CR_WRITE
+		| STAT_CAP_DATA
+		| STAT_CAP_ADDR,
+
+	CR_READ_ENABLE = (1 << 16),
+	CR_WRITE_ENABLE = (1 << 17),
+	CR_CAP_DATA = (1 << 18),
+};
+
+enum {
+	/* Link layer registers */
+	SERROR_IRQ_MASK = 5,
+};
