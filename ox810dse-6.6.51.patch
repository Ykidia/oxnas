+static inline int is_auto_negotiation_in_progress(void)
+{
+	return !(gmac_priv->mii.mdio_read(gmac_priv->netdev, gmac_priv->phy_addr, MII_BMSR) & BMSR_ANEGCOMPLETE);
+}
+
+static void watchdog_timer_action(struct timer_list *t)
+{
+	typedef enum watchdog_state {
+		WDS_IDLE,
+		WDS_RESETTING,
+		WDS_NEGOTIATING
+	} watchdog_state_t;
+
+	static watchdog_state_t state = WDS_IDLE;
+
+	unsigned long new_timeout = jiffies + WATCHDOG_TIMER_INTERVAL;
+	int ready;
+	int duplex_changed;
+	int gigabit_changed;
+	int pause_changed;
+
+	// Interpret the PHY/link state.
+	if (gmac_priv->phy_force_negotiation || (state == WDS_RESETTING)) {
+		mii_check_link(&gmac_priv->mii);
+		ready = 0;
+	} else {
+		duplex_changed = mii_check_media_ex(&gigabit_changed, &pause_changed);
+		gmac_priv->mii_init_media = 0;
+		ready = netif_carrier_ok(gmac_priv->netdev);
+	}
+
+	if (!ready) {
+		if (gmac_priv->phy_force_negotiation) {
+			if (netif_carrier_ok(gmac_priv->netdev)) {
+				state = WDS_RESETTING;
+			} else {
+				state = WDS_IDLE;
+			}
+
+			gmac_priv->phy_force_negotiation = 0;
+		}
+
+		// May be a good idea to restart everything here, in an attempt to clear
+		// out any fault conditions
+		if ((state == WDS_NEGOTIATING) && is_auto_negotiation_in_progress()) {
+			new_timeout = jiffies + AUTO_NEG_INTERVAL;
+		} else {
+			switch (state) {
+				case WDS_IDLE:
+					// Reset the PHY to get it into a known state
+					start_phy_reset();
+					new_timeout = jiffies + START_RESET_INTERVAL;
+					state = WDS_RESETTING;
+					break;
+				case WDS_RESETTING:
+					if (!is_phy_reset_complete()) {
+						new_timeout = jiffies + RESET_INTERVAL;
+					} else {
+						// Force or auto-negotiate PHY mode
+						set_phy_negotiate_mode(gmac_priv->netdev);
+
+						// Set PHY specfic features
+						initialize_phy();
+
+						state = WDS_NEGOTIATING;
+						new_timeout = jiffies + AUTO_NEG_INTERVAL;
+					}
+					break;
+				default:
+					gmac_dbg("Unexpected state %d\n", state);
+					state = WDS_IDLE;
+					break;
+			}
+		}
+	} else {
+		state = WDS_IDLE;
+		if (duplex_changed) {
+			gmac_priv->mii.full_duplex ? mac_reg_set_mask(MAC_CONFIG_REG, (1UL << MAC_CONFIG_DM_BIT))
+				: mac_reg_clear_mask(MAC_CONFIG_REG, (1UL << MAC_CONFIG_DM_BIT));
+		}
+
+		if (gigabit_changed) {
+			change_gig_mode();
+		}
+
+		if (pause_changed) {
+			change_pause_mode();
+		}
+	}
+
+	// Re-trigger the timer, unless some other thread has requested it be stopped
+	if (!gmac_priv->watchdog_timer_shutdown) {
+		// Restart the timer
+		mod_timer(&gmac_priv->watchdog_timer, new_timeout);
+	}
+}
+#endif // CONFIG_SYNOPSYS_GMAC_PHYLIB
+
+static int inline is_ip_packet(unsigned short eth_protocol)
+{
+	return (eth_protocol == ETH_P_IP)
+#ifdef SUPPORT_IPV6
+		|| (eth_protocol == ETH_P_IPV6)
+#endif
+		;
+}
+
+static int inline is_ipv4_packet(unsigned short eth_protocol)
+{
+	return eth_protocol == ETH_P_IP;
+}
+
+#ifdef SUPPORT_IPV6
+static int inline is_ipv6_packet(unsigned short eth_protocol)
+{
+	return eth_protocol == ETH_P_IPV6;
+}
+#endif
+
+static int inline is_hw_checksummable(unsigned short protocol)
+{
+	return (protocol == IPPROTO_TCP) || (protocol == IPPROTO_UDP) || (protocol == IPPROTO_ICMP);
+}
+
+static u32 unmap_rx_page(dma_addr_t phys_adr)
+{
+	u32 offset = phys_adr & ~PAGE_MASK;
+	u32 next_offset = offset + gmac_priv->rx_buffer_size_;
+	next_offset = SKB_DATA_ALIGN(next_offset);
+	next_offset += NET_IP_ALIGN;
+
+	// If this is the last packet in a page
+	if (next_offset > GMAC_ALLOC_SIZE) {
+		// Release the DMA mapping for the page
+		dma_unmap_page(&gmac_priv->netdev->dev, phys_adr & PAGE_MASK, GMAC_ALLOC_SIZE, DMA_FROM_DEVICE);
+	}
+
+	return offset;
+}
+
+static inline int get_desc_len(
+	u32 desc_status,
+	int last)
+{
+	int length = get_rx_length(desc_status);
+
+	if (last) {
+		length -= FCS_LEN;
+	}
+
+	return length;
+}
+
+static inline int process_rx_packet_skb(void)
+{
+	int             desc;
+	int             last;
+	u32             desc_status = 0;
+	rx_frag_info_t  frag_info;
+	int             packet_len;
+	struct sk_buff *skb;
+	int             valid;
+	int             ip_summed;
+
+	desc = get_rx_descriptor(&last, &desc_status, &frag_info);
+	if (desc < 0) {
+		return 0;
+	}
+
+	// Release the DMA mapping for the received data
+	dma_unmap_single(&gmac_priv->netdev->dev, frag_info.phys_adr, frag_info.length, DMA_FROM_DEVICE);
+
+	// Get the packet data length
+	packet_len = get_desc_len(desc_status, last);
+
+	// Get pointer to the SKB
+	skb = (struct sk_buff *)frag_info.page;
+
+	// Is the packet entirely contained within the descriptors and without errors?
+	valid = !(desc_status & (1UL << RDES0_ES_BIT));
+
+	if (unlikely(!valid)) {
+		goto not_valid_skb;
+	}
+
+	ip_summed = CHECKSUM_NONE;
+
+#ifdef USE_RX_CSUM
+	// Has the h/w flagged an IP header checksum failure?
+	valid = !(desc_status & (1UL << RDES0_IPC_BIT));
+
+	if (likely(valid)) {
+		// Determine whether Ethernet frame contains an IP packet -
+		// only bother with Ethernet II frames, but do cope with
+		// 802.1Q VLAN tag presence
+		int vlan_offset = 0;
+		unsigned short eth_protocol = ntohs(((struct ethhdr *)skb->data)->h_proto);
+		int is_ip = is_ip_packet(eth_protocol);
+
+		if (!is_ip) {
+			// Check for VLAN tag
+			if (eth_protocol == ETH_P_8021Q) {
+				// Extract the contained protocol type from after
+				// the VLAN tag
+				eth_protocol = ntohs(*(unsigned short *)(skb->data + ETH_HLEN));
+				is_ip = is_ip_packet(eth_protocol);
+
+				// Adjustment required to skip the VLAN stuff and
+				// get to the IP header
+				vlan_offset = 4;
+			}
+		}
+
+		// Only offload checksum calculation for IP packets
+		if (is_ip) {
+			struct iphdr *ipv4_header = NULL;
+
+			if (unlikely(desc_status & (1UL << RDES0_PCE_BIT))) {
+				valid = 0;
+			} else
+			if (is_ipv4_packet(eth_protocol)) {
+				ipv4_header = (struct iphdr *)(skb->data + ETH_HLEN + vlan_offset);
+
+				// H/W can only checksum non-fragmented IP packets
+				if (!(ipv4_header->frag_off & htons(IP_MF | IP_OFFSET))) {
+					if (is_hw_checksummable(ipv4_header->protocol)) {
+						ip_summed = CHECKSUM_UNNECESSARY;
+					}
+				}
+			}
+			else {
+#ifdef SUPPORT_IPV6
+				struct ipv6hdr *ipv6_header = (struct ipv6hdr *)(skb->data + ETH_HLEN + vlan_offset);
+
+				if (is_hw_checksummable(ipv6_header->nexthdr)) {
+					ip_summed = CHECKSUM_UNNECESSARY;
+				}
+#endif // SUPPORT_IPV6
+			}
+
+		}
+	}
+
+	if (unlikely(!valid)) {
+		goto not_valid_skb;
+	}
+#endif // USE_RX_CSUM
+
+	// Increase the skb's data pointer to account for the Rx packet that has
+	// been DMAed into it
+	skb_put(skb, packet_len);
+
+	// Set the device for the skb
+	skb->dev = gmac_priv->netdev;
+
+	// Set packet protocol
+	skb->protocol = eth_type_trans(skb, gmac_priv->netdev);
+
+	// Record whether h/w checksumed the packet
+	skb->ip_summed = ip_summed;
+
+	// Send the packet up the network stack
+	netif_receive_skb(skb);
+
+	// Update receive statistics
+	gmac_priv->stats.rx_packets++;
+	gmac_priv->stats.rx_bytes += packet_len;
+
+	return 1;
+
+not_valid_skb:
+	dev_kfree_skb(skb);
+
+	gmac_dbg("Received packet has bad desc_status = 0x%08x\n", desc_status);
+
+	// Update receive statistics from the descriptor status
+	if (is_rx_collision_error(desc_status)) {
+		gmac_dbg("Collision (0x%08x:%u bytes)\n", desc_status, packet_len);
+		gmac_priv->stats.collisions++;
+	}
+	if (is_rx_crc_error(desc_status)) {
+		gmac_dbg("CRC error (0x%08x:%u bytes)\n", desc_status, packet_len);
+		gmac_priv->stats.rx_crc_errors++;
+		gmac_priv->stats.rx_errors++;
+	}
+	if (is_rx_frame_error(desc_status)) {
+		gmac_dbg("Frame error (0x%08x:%u bytes)\n", desc_status, packet_len);
+		gmac_priv->stats.rx_frame_errors++;
+		gmac_priv->stats.rx_errors++;
+	}
+	if (is_rx_length_error(desc_status)) {
+		gmac_dbg("Length error (0x%08x:%u bytes)\n", desc_status, packet_len);
+		gmac_priv->stats.rx_length_errors++;
+		gmac_priv->stats.rx_errors++;
+	}
+	if (is_rx_csum_error(desc_status)) {
+		gmac_dbg("Checksum error (0x%08x:%u bytes)\n", desc_status, packet_len);
+		gmac_priv->stats.rx_frame_errors++;
+		gmac_priv->stats.rx_errors++;
+	}
+
+	return 0;
+}
+
+static inline int process_rx_packet(void)
+{
+	struct sk_buff *skb = NULL;
+	int             last;
+	u32             desc_status;
+	rx_frag_info_t  frag_info;
+	int             desc;
+	u32             offset;
+	int             desc_len;
+	unsigned char  *packet;
+	int             valid;
+	int             desc_used = 0;
+	int             hlen = 0;
+	int             partial_len = 0;
+	int             first = 1;
+
+	// Check that there is at least one Rx descriptor available. Cache the
+	// descriptor information so we don't have to touch the uncached/unbuffered
+	// descriptor memory more than necessary when we come to use that descriptor
+	if (!rx_available_for_read(&gmac_priv->rx_gmac_desc_list_info, &desc_status)) {
+		return 0;
+	}
+
+	// Attempt to allocate an skb before we change anything on the Rx descriptor ring
+	skb = gmac_alloc_skb(GMAC_HLEN + NET_IP_ALIGN);
+	if (unlikely(skb == NULL)) {
+		gmac_dbg("Cannot allocate sk_buff\n");
+		return 0;
+	}
+
+	// Align IP header start in header storage
+	skb_reserve(skb, NET_IP_ALIGN);
+
+	// Process all descriptors associated with the packet
+	while (1) {
+		int prev_len;
+
+		// First call to get_rx_descriptor() will use the status read from the
+		// first descriptor by the call to rx_available_for_read() above
+		while ((desc = get_rx_descriptor(&last, &desc_status, &frag_info)) < 0) {
+			// We are part way through processing a multi-descriptor packet
+			// and the GMAC hasn't finished with the next descriptor for the
+			// packet yet, so have to poll until it becomes available
+			desc_status = 0;
+//			udelay(1);
+		}
+
+		// We've consumed a descriptor
+		desc_used++;
+
+		if (!frag_info.page) {
+			panic("process_rx_packet() %s: Found Rx descriptor without attached page\n", gmac_priv->netdev->name);
+		}
+
+		// If this is the last packet in the page, release the DMA mapping
+		offset = unmap_rx_page(frag_info.phys_adr);
+		if (!first) {
+			// The buffer adr of descriptors associate with middle or last
+			// parts of a packet have ls 2 bits of buffer adr ignored by GMAC DMA
+			offset &= ~0x3;
+		}
+
+		// Get the length of the packet excluding CRC, h/w csum etc.
+		prev_len = partial_len;
+		partial_len = get_desc_len(desc_status, last);
+		desc_len = partial_len - prev_len;
+
+		// Get a pointer to the start of the packet data received into page
+		packet = page_address(frag_info.page) + offset;
+
+		// Is the packet entirely contained within the desciptors and without errors?
+		valid = !(desc_status & (1UL << RDES0_ES_BIT));
+
+		if (unlikely(!valid)) {
+			goto not_valid;
+		}
+
+		if (first) {
+			// Store headers in skb buffer
+			hlen = min(GMAC_HLEN, desc_len);
+
+			// Copy header into skb buffer
+			memcpy(skb->data, packet, hlen);
+			skb->tail += hlen;
+
+			if (desc_len > hlen) {
+				// Point skb frags array at remaining packet data in pages
+				skb_shinfo(skb)->nr_frags = 1;
+				skb_shinfo(skb)->frags[0].bv_page = frag_info.page;
+				skb_shinfo(skb)->frags[0].bv_offset = offset + hlen;
+				skb_shinfo(skb)->frags[0].bv_len = desc_len - hlen;
+			}
+			else {
+				// Entire packet now in skb buffer so don't require page anymore
+				put_page(frag_info.page);
+			}
+
+			first = 0;
+		} else {
+			// Store intermediate descriptor data into packet
+			int frag_index = skb_shinfo(skb)->nr_frags;
+			skb_shinfo(skb)->frags[frag_index].bv_page = frag_info.page;
+			skb_shinfo(skb)->frags[frag_index].bv_offset = offset;
+			skb_shinfo(skb)->frags[frag_index].bv_len = desc_len;
+			skb_shinfo(skb)->nr_frags++;
+		}
+
+		if (last) {
+			int ip_summed = CHECKSUM_NONE;
+
+			// Update total packet length skb metadata
+			skb->len = partial_len;
+			skb->data_len = skb->len - hlen;
+			skb->truesize = skb->len + sizeof(struct sk_buff);
+#ifdef USE_RX_CSUM
+			// Has the h/w flagged an IP header checksum failure?
+			valid = !(desc_status & (1UL << RDES0_IPC_BIT));
+
+			// Are we offloading Rx checksuming?
+			if (likely(valid)) {
+				// Determine whether Ethernet frame contains an IP packet -
+				// only bother with Ethernet II frames, but do cope with
+				// 802.1Q VLAN tag presence
+				int vlan_offset = 0;
+				unsigned short eth_protocol = ntohs(((struct ethhdr*)skb->data)->h_proto);
+				int is_ip = is_ip_packet(eth_protocol);
+
+				if (!is_ip) {
+					// Check for VLAN tag
+					if (eth_protocol == ETH_P_8021Q) {
+						// Extract the contained protocol type from after
+						// the VLAN tag
+						eth_protocol = ntohs(*(unsigned short *)(skb->data + ETH_HLEN));
+						is_ip = is_ip_packet(eth_protocol);
+
+						// Adjustment required to skip the VLAN stuff and
+						// get to the IP header
+						vlan_offset = 4;
+					}
+				}
+
+				// Only offload checksum calculation for IP packets
+				if (is_ip) {
+					struct iphdr *ipv4_header = 0;
+
+					if (unlikely(desc_status & (1UL << RDES0_PCE_BIT))) {
+						valid = 0;
+					} else
+					if (is_ipv4_packet(eth_protocol)) {
+						ipv4_header = (struct iphdr *)(skb->data + ETH_HLEN + vlan_offset);
+
+						// H/W can only checksum non-fragmented IP packets
+						if (!(ipv4_header->frag_off & htons(IP_MF | IP_OFFSET))) {
+							if (is_hw_checksummable(ipv4_header->protocol)) {
+								ip_summed = CHECKSUM_UNNECESSARY;
+							}
+						}
+					}
+					else {
+#ifdef SUPPORT_IPV6
+						struct ipv6hdr *ipv6_header = (struct ipv6hdr *)(skb->data + ETH_HLEN + vlan_offset);
+
+						if (is_hw_checksummable(ipv6_header->nexthdr)) {
+							ip_summed = CHECKSUM_UNNECESSARY;
+						}
+#endif // SUPPORT_IPV6
+					}
+
+				}
+			}
+
+			if (unlikely(!valid)) {
+				goto not_valid;
+			}
+#endif // USE_RX_CSUM
+
+			// Set the device for the skb
+			skb->dev = gmac_priv->netdev;
+
+			// Set packet protocol
+			skb->protocol = eth_type_trans(skb, gmac_priv->netdev);
+
+			// Record whether h/w checksumed the packet
+			skb->ip_summed = ip_summed;
+
+			// Send the skb up the network stack
+			netif_receive_skb(skb);
+
+			// Update receive statistics
+			gmac_priv->stats.rx_packets++;
+			gmac_priv->stats.rx_bytes += partial_len;
+
+			break;
+		}
+
+		// Want next call to get_rx_descriptor() to read status from descriptor
+		desc_status = 0;
+	}
+	return desc_used;
+
+not_valid:
+	if (!skb_shinfo(skb)->nr_frags) {
+		// Free the page as it wasn't attached to the skb
+		put_page(frag_info.page);
+	}
+
+	dev_kfree_skb(skb);
+
+	gmac_dbg("Received packet has bad desc_status = 0x%08x\n", desc_status);
+
+	// Update receive statistics from the descriptor status
+	if (is_rx_collision_error(desc_status)) {
+		gmac_dbg("Collision (0x%08x:%u bytes)\n", desc_status, desc_len);
+		gmac_priv->stats.collisions++;
+	}
+	if (is_rx_crc_error(desc_status)) {
+		gmac_dbg("CRC error (0x%08x:%u bytes)\n", desc_status, desc_len);
+		gmac_priv->stats.rx_crc_errors++;
+		gmac_priv->stats.rx_errors++;
+	}
+	if (is_rx_frame_error(desc_status)) {
+		gmac_dbg("Frame error (0x%08x:%u bytes)\n", desc_status, desc_len);
+		gmac_priv->stats.rx_frame_errors++;
+		gmac_priv->stats.rx_errors++;
+	}
+	if (is_rx_length_error(desc_status)) {
+		gmac_dbg("Length error (0x%08x:%u bytes)\n", desc_status, desc_len);
+		gmac_priv->stats.rx_length_errors++;
+		gmac_priv->stats.rx_errors++;
+	}
+	if (is_rx_csum_error(desc_status)) {
+		gmac_dbg("Checksum error (0x%08x:%u bytes)\n", desc_status, desc_len);
+		gmac_priv->stats.rx_frame_errors++;
+		gmac_priv->stats.rx_errors++;
+	}
+
+	return desc_used;
+}
+
+static inline u32 gmac_read_int_status(void)
+{
+	u32 int_status = 0;
+#ifdef CONFIG_LEON_COPRO
+	u32 sem_stat = oxnas_sys_read(SYS_CTRL_SEMA_STAT) & (SEM_INTA_MASK | SEM_INTB_MASK);
+
+	if (sem_stat) {
+		// Clear any interrupts directed at the ARM
+		oxnas_sys_write(SYS_CTRL_SEMA_CLR_CTRL, sem_stat);
+		if (!gmac_priv->shared_copro_params_)
+			return 0;
+		if (sem_stat & SEM_INTA_MASK) {
+			int_status |= ((volatile gmac_fwd_intrs_t *)gmac_copro_phys_to_virt(
+				gmac_priv->copro_params_.fwd_intrs_mailbox_))->status_ & ~DMA_STATUS_V_SEM_MASK;
+		}
+		if (sem_stat & SEM_INTB_MASK) {
+			if (sem_stat & (1UL << SEM_INT_ACK)) {
+				unsigned long irq_flags;
+				spin_lock_irqsave(&gmac_priv->cmd_que_lock_, irq_flags);
+				while (!cmd_que_dequeue_ack(&gmac_priv->cmd_queue_));
+				spin_unlock_irqrestore(&gmac_priv->cmd_que_lock_, irq_flags);
+			}
+			if (sem_stat & (1UL << SEM_INT_STOP_ACK)) {
+				up(&gmac_priv->copro_stop_complete_semaphore_);
+			}
+#ifdef CONFIG_LEON_OFFLOAD_TX
+			// Process any completed Tx offload jobs
+			if (sem_stat & (1UL << SEM_INT_TX)) {
+				int_status |= 1UL << DMA_STATUS_TI_BIT;
+			}
+#endif // CONFIG_LEON_OFFLOAD_TX
+		}
+	}
+#else // CONFIG_LEON_COPRO
+	int_status |= dma_reg_read(DMA_STATUS_REG);
+	// The broken GMAC interrupt mechanism with its sticky summary bits
+	// means that we have to ack all asserted interrupts here; we can't not
+	// ack the RI interrupt source as we might like to (in order that the
+	// poll() routine could examine the status) because if it was asserted
+	// prior to being masked above, then the summary bit(s) would remain
+	// asserted and cause an immediate re-interrupt.
+	dma_reg_write(DMA_STATUS_REG, int_status
+		| (1UL << DMA_STATUS_NIS_BIT)
+		| (1UL << DMA_STATUS_AIS_BIT));
+#endif // CONFIG_LEON_COPRO
+
+	return int_status;
+}
+
+#ifdef CONFIG_LEON_OFFLOAD_TX
+
+static void copro_fill_tx_job(
+	volatile gmac_tx_que_ent_t *job,
+	struct sk_buff             *skb)
+{
+	int i;
+	int nr_frags = skb_shinfo(skb)->nr_frags;
+	unsigned short flags = 0;
+	dma_addr_t hdr_dma_address;
+
+	// if too many fragments call sbk_linearize()
+	// and take the CPU memory copies hit
+	if (nr_frags > COPRO_NUM_TX_FRAGS_DIRECT) {
+		int err;
+		gmac_warn("Linearizing socket buffer as required %d frags and have only %d\n", nr_frags, COPRO_NUM_TX_FRAGS_DIRECT);
+		err = skb_linearize(skb);
+		if (err) {
+			panic("Fill: No free memory");
+		}
+
+		// update nr_frags
+		nr_frags = skb_shinfo(skb)->nr_frags;
+	}
+
+	// Get a DMA mapping of the packet's data
+	hdr_dma_address = dma_map_single(&skb->dev->dev, skb->data, skb_headlen(skb), DMA_TO_DEVICE);
+	BUG_ON(dma_mapping_error(&skb->dev->dev, hdr_dma_address));
+
+	// Allocate storage for remainder of fragments and create DMA mappings
+	// Get a DMA mapping for as many fragments as will fit into the first level
+	// fragment info. storage within the job structure
+	for (i = 0; i < nr_frags; ++i) {
+		skb_frag_t *skbfrag = &skb_shinfo(skb)->frags[i];
+
+		job->frag_ptr_[i] = dma_map_page(
+			&skb->dev->dev,
+			skbfrag->bv_page,
+			skbfrag->bv_offset,
+			skbfrag->bv_len,
+			DMA_TO_DEVICE);
+
+		job->frag_len_[i] = skbfrag->bv_len;
+	}
+
+	// Is h/w checksumming and possibly TSO required
+	if (likely((skb->ip_summed == CHECKSUM_PARTIAL) && ((ntohs(skb->protocol) == ETH_P_IP)
+#ifdef SUPPORT_IPV6
+		|| (ntohs(skb->protocol) == ETH_P_IPV6)
+#endif
+		)))
+	{
+		flags |= (1UL << TX_JOB_FLAGS_ACCELERATE_BIT);
+	}
+	else if (unlikely(skb->ip_summed == CHECKSUM_PARTIAL)) {
+		// CHECKSUM_PARTIAL that the LEON firmware cannot accelerate (VLAN in
+		// hardware, IPv6 without SUPPORT_IPV6, encapsulation): the vendor
+		// driver used to send these with an uncomputed checksum. Make the
+		// stack compute it instead.
+		if (skb_checksum_help(skb)) {
+			dev_kfree_skb_any(skb);
+			panic("Fill: checksum_help failed");
+		}
+	}
+
+	// Fill the job description with information about the packet
+	job->skb_         = (u32)skb;
+	job->len_         = skb->len;
+	job->data_len_    = skb->data_len;
+	job->ethhdr_      = hdr_dma_address;
+	job->iphdr_       = hdr_dma_address + skb_network_offset(skb);
+	job->iphdr_csum_  = ip_hdr(skb)->check;
+	job->tso_segs_    = skb_shinfo(skb)->gso_segs;
+	job->tso_size_    = skb_shinfo(skb)->gso_size;
+	job->flags_       = flags;
+	job->statistics_  = 0;
+}
+
+static void copro_free_tx_resources(volatile gmac_tx_que_ent_t *job)
+{
+	int i;
+	struct sk_buff *skb = (struct sk_buff *)job->skb_;
+	int nr_frags = skb_shinfo(skb)->nr_frags;
+
+	// This should never happen, since we check space when we filled
+	// the job in copro_fill_tx_job
+	if (nr_frags > COPRO_NUM_TX_FRAGS_DIRECT) {
+		panic("Free: Insufficient fragment storage, required %d, have only %d", nr_frags, COPRO_NUM_TX_FRAGS_DIRECT);
+	}
+
+	// Release the DMA mapping for the data directly referenced by the SKB
+	dma_unmap_single(&skb->dev->dev, job->ethhdr_, skb_headlen(skb), DMA_TO_DEVICE);
+
+	// Release the DMA mapping for any fragments in the first level fragment
+	// info. storage within the job structure
+	for (i=0; (i < nr_frags) && (i < COPRO_NUM_TX_FRAGS_DIRECT); ++i) {
+		dma_unmap_page(&skb->dev->dev, job->frag_ptr_[i], job->frag_len_[i], DMA_TO_DEVICE);
+	}
+
+	// Inform the network stack that we've finished with the packet
+	dev_kfree_skb_any(skb);
+}
+
+static inline void gmac_finish_xmit(void)
+{
+	volatile gmac_tx_que_ent_t *job;
+	bool is_full;
+
+	// Process all available completed jobs
+	while ((job = tx_que_get_finished_job())) {
+		int aborted;
+		int carrier;
+		int collisions;
+		u32 statistics = job->statistics_;
+
+		copro_free_tx_resources(job);
+		atomic_set(&gmac_hang_timeouts, 0);
+
+		// Accumulate Tx statistics returned by CoPro in the job structure
+		gmac_priv->stats.tx_bytes   += (statistics & TX_JOB_STATS_BYTES_MASK)   >> TX_JOB_STATS_BYTES_BIT;
+		gmac_priv->stats.tx_packets += (statistics & TX_JOB_STATS_PACKETS_MASK) >> TX_JOB_STATS_PACKETS_BIT;
+		aborted    = (statistics & TX_JOB_STATS_ABORT_MASK)     >> TX_JOB_STATS_ABORT_BIT;
+		carrier    = (statistics & TX_JOB_STATS_CARRIER_MASK)   >> TX_JOB_STATS_CARRIER_BIT;
+		collisions = (statistics & TX_JOB_STATS_COLLISION_MASK) >> TX_JOB_STATS_COLLISION_BIT;
+		gmac_priv->stats.tx_aborted_errors += aborted;
+		gmac_priv->stats.tx_carrier_errors += carrier;
+		gmac_priv->stats.collisions        += collisions;
+		gmac_priv->stats.tx_errors += (aborted + carrier);
+	}
+	is_full = tx_que_is_full(&gmac_priv->tx_queue_);
+
+	// If the network stack's Tx queue was stopped and we now have resources
+	// to process more Tx offload jobs
+	if (netif_queue_stopped(gmac_priv->netdev) && !is_full) {
+		// Restart the network stack's Tx queue
+		netif_wake_queue(gmac_priv->netdev);
+	}
+}
+
+#else // CONFIG_LEON_OFFLOAD_TX
+
+static inline void gmac_finish_xmit(void)
+{
+	unsigned     descriptors_freed = 0;
+	u32          desc_status = 0;
+
+	// Handle transmit descriptors for the completed packet transmission
+	while (1) {
+		struct sk_buff  *skb = NULL;
+		tx_frag_info_t  fragment;
+		int             buffer_owned = 0;
+		int             desc_index;
+
+		// Get tx descriptor content, accumulating status for all buffers
+		// contributing to each packet
+		desc_index = get_tx_descriptor(&skb, &desc_status, &fragment, &buffer_owned);
+
+		if (desc_index < 0) {
+			// No more completed Tx packets
+			break;
+		}
+
+		// Only unmap DMA buffer if descriptor owned the buffer
+		if (buffer_owned) {
+			// Release the DMA mapping for the buffer
+			dma_unmap_single(&gmac_priv->netdev->dev, fragment.phys_adr, fragment.length, DMA_TO_DEVICE);
+		}
+
+		// When all buffers contributing to a packet have been processed
+		if (skb) {
+			// Check the status of the transmission
+			if (likely(is_tx_valid(desc_status))) {
+				gmac_priv->stats.tx_bytes += skb->len;
+				gmac_priv->stats.tx_packets++;
+			} else {
+				gmac_priv->stats.tx_errors++;
+				if (is_tx_aborted(desc_status)) {
+					gmac_priv->stats.tx_aborted_errors++;
+				}
+				if (is_tx_carrier_error(desc_status)) {
+					gmac_priv->stats.tx_carrier_errors++;
+				}
+			}
+
+			if (unlikely(is_tx_collision_error(desc_status))) {
+				gmac_priv->stats.collisions++;
+			}
+
+			// Inform the network stack that packet transmission has finished
+			dev_kfree_skb_any(skb);
+
+			// Start accumulating status for the next packet
+			desc_status = 0;
+		}
+
+		// Track how many descriptors we make available, so we know
+		// if we need to re-start of network stack's Tx queue processing
+		descriptors_freed++;
+	}
+
+	// If the Tx queue is stopped, there may be a pending Tx packet waiting to
+	// be transmitted
+	if (netif_queue_stopped(gmac_priv->netdev)) {
+		// No locking with gmac_start_xmit() required, as queue is already
+		// stopped so gmac_start_xmit() won't touch the h/w
+
+		// If there are Tx descriptors available we should restart the Tx queue
+		if (descriptors_freed) {
+			// The Tx queue had been stopped by gmac_start_tx() due to lack of
+			// Tx descriptors, so restart it now that we've freed at least one
+			netif_wake_queue(gmac_priv->netdev);
+		}
+	}
+}
+
+static int gmac_start_tx(struct sk_buff *skb, struct net_device *netdev)
+{
+	const struct skb_shared_info    *shinfo = skb_shinfo(skb);
+	const skb_frag_t                *skbfrag;
+	int                             fragment_count = shinfo->nr_frags + 1;
+	tx_frag_info_t                  fragments[fragment_count], *frag;
+	int                             frag_index;
+	int                             descriptor_count;
+
+	// Get consistent DMA mappings for the SDRAM to be DMAed from by the GMAC,
+	// causing a flush from the CPU's cache to the memory.
+
+	// Do the DMA mappings before touching the Tx descriptor state, as this
+	// can be a long operation involving cache flushing
+
+	descriptor_count = 0;
+	frag = fragments;
+	skbfrag = shinfo->frags - 1;
+
+	// Map the main buffer (frag_index = 0) and then any SG fragments
+	for (frag_index = 0; frag_index < fragment_count; frag_index++) {
+		u16 count = 1;
+
+		frag->length = frag_index == 0 ? skb_headlen(skb) : skbfrag->bv_len;
+		frag->phys_adr = dma_map_single(
+			&netdev->dev,
+			frag_index == 0 ? skb->data : page_address(skbfrag->bv_page) + skbfrag->bv_offset,
+			frag->length,
+			DMA_TO_DEVICE);
+		BUG_ON(dma_mapping_error(&netdev->dev, frag->phys_adr));
+
+		if (gmac_priv->netdev->mtu >= (GMAC_MAX_DESC_LEN - ETH_HLEN)) {
+			count = frag->length >> GMAC_MAX_DESC_ORDER;
+			if (frag->length & GMAC_MAX_DESC_MASK)
+				count++;
+			if ((count * GMAC_MAX_DESC_LEN) < frag->length)
+				count++;
+		}
+		descriptor_count += count;
+		frag->num_descs = count;
+
+		skbfrag++;
+		frag++;
+	}
+
+	// Are sufficicent descriptors available for writing by the CPU?
+	if (unlikely(available_for_write(&gmac_priv->tx_gmac_desc_list_info) < descriptor_count)) {
+		gmac_warn("Ring full and pending packet already queued\n");
+		netif_stop_queue(netdev);
+		goto xmit_busy;
+	}
+
+	// Construct the GMAC DMA descriptor
+	set_tx_descriptor(skb, fragments);
+
+	// Record start of transmission, so timeouts will work once they're
+	// implemented
+	netif_trans_update(netdev);
+
+	// Poke the transmitter to look for available Tx descriptors, as we have
+	// just added one, in case it had previously found there were no more
+	// pending transmission
+	gmac_tx_poll_demand();
+
+	return NETDEV_TX_OK;
+
+xmit_busy:
+	while (frag > fragments) {
+		frag--;
+		dma_unmap_single(&gmac_priv->netdev->dev, frag->phys_adr, frag->length, DMA_TO_DEVICE);
+	}
+	return NETDEV_TX_BUSY;
+}
+
+#endif // CONFIG_LEON_OFFLOAD_TX
+
+static int gmac_start_xmit(struct sk_buff *skb, struct net_device *netdev)
+{
+	struct sk_buff *skb0;
+
+	skb0 = (void *)atomic_cmpxchg(
+		&gmac_priv->tx_skb_ring_buf[gmac_priv->tx_skb_ring_head_index], (int)NULL, (int)skb);
+
+	if (skb0 != NULL) {
+		netif_stop_queue(netdev);
+		return NETDEV_TX_BUSY;
+	}
+
+	gmac_priv->tx_skb_ring_head_index =
+		(gmac_priv->tx_skb_ring_head_index + 1) % TX_SKB_RING_ELEMENTS;
+
+	if (napi_schedule_prep(&gmac_priv->txrx_napi)) {
+		atomic_and(~(DMA_INT_ENABLE_NAI_MASK
+			| DMA_INT_ENABLE_TXRX_MASK
+			| DMA_INT_ENABLE_VX_MASK), &gmac_priv->int_enable);
+		__napi_schedule(&gmac_priv->txrx_napi);
+	}
+
+	return NETDEV_TX_OK;
+}
+
+static void gmac_tx_timeout(struct net_device *netdev, unsigned int txqueue)
+{
+	if (atomic_inc_return(&gmac_hang_timeouts) >= 3) {
+		if (!gmac_tx_hang_reset_armed) {
+			gmac_tx_hang_reset_armed = 1;
+			gmac_err("Tx timeout x3: scheduling CoPro Tx reset\n");
+			schedule_work(&gmac_tx_hang_reset_work);
+		}
+		return;
+	}
+
+	gmac_tx_restart();
+	gmac_tx_poll_demand();
+
+	if (napi_schedule_prep(&gmac_priv->txrx_napi)) {
+		atomic_and(~(DMA_INT_ENABLE_TXRX_MASK | DMA_INT_ENABLE_VX_MASK), &gmac_priv->int_enable);
+		__napi_schedule(&gmac_priv->txrx_napi);
+	}
+}
+
+static int gmac_poll_txrx(struct napi_struct *napi, int budget)
+{
+	int work_done = 0;
+	int tx_done = 0;
+	bool continue_polling = false;
+	u32 int_status = (u32)atomic_xchg(&gmac_priv->int_status, 0);
+
+	while (tx_done < budget) {
+		struct sk_buff *skb = (void *)atomic_xchg(
+			&gmac_priv->tx_skb_ring_buf[gmac_priv->tx_skb_ring_tail_index], (int)NULL);
+		int submitted;
+
+		if (!skb)
+			break;
+
+#ifdef CONFIG_LEON_OFFLOAD_TX
+		{
+			volatile gmac_tx_que_ent_t *job;
+
+			if (skb_shinfo(skb)->frag_list) {
+				gmac_err("frag_list in skb %p - not supported\n", skb);
+				dev_kfree_skb_any(skb);
+				submitted = NETDEV_TX_OK;
+			} else if (!(job = tx_que_get_idle_job())) {
+				// Job queue full: put the skb back into its slot for a retry
+				// after gmac_finish_xmit() frees finished jobs below
+				if ((void *)atomic_cmpxchg(
+						&gmac_priv->tx_skb_ring_buf[gmac_priv->tx_skb_ring_tail_index],
+						(int)NULL, (int)skb) != NULL) {
+					dev_kfree_skb_any(skb);
+				}
+				netif_stop_queue(gmac_priv->netdev);
+				submitted = NETDEV_TX_BUSY;
+			} else {
+				// Fill the Tx offload job with the network packet's details
+				copro_fill_tx_job(job, skb);
+
+				// Enqueue the new Tx offload job with the CoPro
+				tx_que_new_job(job);
+
+				// Record start of transmission, so timeouts will work
+				netif_trans_update(gmac_priv->netdev);
+
+				// Interrupt the CoPro to cause it to examine the Tx offload queue
+				wmb();
+				oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_TX);
+
+				submitted = NETDEV_TX_OK;
+			}
+		}
+#else
+		submitted = gmac_start_tx(skb, gmac_priv->netdev);
+#endif // CONFIG_LEON_OFFLOAD_TX
+
+		if (submitted == NETDEV_TX_OK) {
+			gmac_priv->tx_skb_ring_tail_index =
+				(gmac_priv->tx_skb_ring_tail_index + 1) % TX_SKB_RING_ELEMENTS;
+			tx_done++;
+		}
+		else {
+			// Descriptor/job ring full: stop the drain for this cycle;
+			// the skb was already restored to its slot above
+			break;
+		}
+	}
+
+	// Reclaim descriptors of packets the DMA has finished transmitting
+	gmac_finish_xmit();
+
+	if (int_status & DMA_STATUS_TX_MASK) {
+		// Test for abnormal transmitter interrupt where there may be completed
+		// packets waiting to be processed
+		if (int_status & ((1UL << DMA_STATUS_TJT_BIT) | (1UL << DMA_STATUS_UNF_BIT))) {
+			if (int_status & (1UL << DMA_STATUS_TJT_BIT)) {
+				// A transmit jabber timeout causes the transmitter to enter the
+				// stopped state
+				gmac_warn("Tx jabber timeout\n");
+				gmac_tx_restart();
+			}
+			else {
+				gmac_warn("Tx underflow\n");
+			}
+
+			// Issue a Tx poll demand in an attempt to restart Tx descriptor
+			// processing
+			gmac_tx_poll_demand();
+		}
+	}
+
+	if (int_status & (1UL << DMA_STATUS_RU_BIT)) {
+		gmac_warn("Rx buffer unavailable\n");
+		// Accumulate receive statistics
+		gmac_priv->stats.rx_over_errors++;
+		gmac_priv->stats.rx_errors++;
+		dma_reg_write(DMA_RX_POLL_REG, 0);
+	}
+	if (int_status & (1UL << DMA_STATUS_OVF_BIT)) {
+		gmac_warn("Rx overflow\n");
+		// Accumulate receive statistics
+		gmac_priv->stats.rx_fifo_errors++;
+		gmac_priv->stats.rx_errors++;
+	}
+
+	if (int_status & (1UL << DMA_STATUS_RPS_BIT)) {
+		u32 rs_mask = ((1UL << DMA_STATUS_RS_NUM_BITS) - 1) << DMA_STATUS_RS_BIT;
+		u32 rs = (int_status & rs_mask) >> DMA_STATUS_RS_BIT;
+		gmac_warn("Rx process stopped (status=0x%x), restarting receiver\n", rs);
+		gmac_priv->stats.rx_errors++;
+		// Restart the receiver
+		change_rx_enable(1, 0);
+	}
+
+	if (int_status & (1UL << DMA_STATUS_TPS_BIT)) {
+		u32 ts_mask = ((1UL << DMA_STATUS_TS_NUM_BITS) - 1) << DMA_STATUS_TS_BIT;
+		u32 ts = (int_status & ts_mask) >> DMA_STATUS_TS_BIT;
+		if (ts != DMA_STATUS_TS_STOPPED) {
+			gmac_warn("Tx process stopped (status=0x%x)\n", ts);
+			gmac_priv->stats.tx_errors++;
+			// Restart the transmitter, causes an implicit Tx descriptor list poll
+			gmac_tx_restart();
+		}
+		// Harmless either way: poke the engine to look at the ring again
+		gmac_tx_poll_demand();
+	}
+
+	// While there are receive polling jobs to be done
+	while (work_done < budget) {
+		const int desc_used = gmac_priv->rx_buffers_per_page
+			? process_rx_packet()
+			: process_rx_packet_skb();
+
+		if (!desc_used) {
+			// No more received packets available
+			break;
+		}
+
+		// Rx overflows seem to upset the GMAC, so try to ensure we never see them
+		gmac_priv->rx_descs_since_refill_cnr += desc_used;
+		if (gmac_priv->rx_descs_since_refill_cnr >= RX_DESC_REFILL_LIMIT) {
+			refill_rx_ring();
+		}
+
+		// Increment count of processed packets
+		work_done++;
+	}
+
+	// Attempt to fill any empty slots in the Rx ring
+	refill_rx_ring();
+
+	dma_reg_write(DMA_RX_POLL_REG, 0);
+
+	if (netif_queue_stopped(gmac_priv->netdev)
+		&& !(atomic_read(&gmac_priv->tx_skb_ring_buf[gmac_priv->tx_skb_ring_tail_index])))
+	{
+		netif_wake_queue(gmac_priv->netdev);
+	}
+
+	if ((tx_done || work_done || !atomic_read(&gmac_priv->tx_skb_ring_buf[gmac_priv->tx_skb_ring_tail_index]))
+		&& ((tx_done >= budget)
+			|| (work_done < budget && rx_available_for_read(&gmac_priv->rx_gmac_desc_list_info, NULL))
+			|| (atomic_read(&gmac_priv->tx_skb_ring_buf[gmac_priv->tx_skb_ring_tail_index]))
+			|| atomic_read(&gmac_priv->int_status)))
+	{
+		continue_polling = true;
+	}
+
+	if (!continue_polling) {
+		// No more work so return to interrupt mode
+		if (napi_complete_done(napi, work_done)) {
+			// Enable interrupts that were disabled when the poll was
+			// scheduled; the ring checks above have already covered
+			// the window between the last check and the completion
+			gmac_int_en_set(DMA_INT_ENABLE_NAI_MASK
+				| DMA_INT_ENABLE_TXRX_MASK
+				| DMA_INT_ENABLE_VX_MASK);
+
+			if ((void *)atomic_read(&gmac_priv->tx_skb_ring_buf[gmac_priv->tx_skb_ring_tail_index])) {
+				if (napi_schedule_prep(napi))
+					__napi_schedule(napi);
+			}
+		}
+	}
+
+	// The NAPI core expects budget returned when the poll stays scheduled
+	return continue_polling ? budget : (work_done ? work_done : 1);
+}
+
+static irqreturn_t gmac_common_irq_handler(int irq, void *param)
+{
+	// Whether the link/PHY watchdog timer should be restarted
+	bool napi_resched = false;
+	u32 int_status, int_disable_mask = 0;
+	unsigned long irq_flags;
+
+	{
+		u32 raw_status = gmac_read_int_status();
+
+#ifdef CONFIG_LEON_OFFLOAD_TX
+		int_status = raw_status & (DMA_STATUS_TXRX_MASK | atomic_read(&gmac_priv->int_enable));
+#else
+		int_status = raw_status & atomic_read(&gmac_priv->int_enable);
+#endif
+	}
+	if (!int_status)
+		return IRQ_HANDLED;
+	atomic_or(int_status, &gmac_priv->int_status);
+
+	if (int_status & DMA_STATUS_TXRX_MASK) {
+		// Disable interrupts caused by received packets as henceforth
+		// we shall poll for packet reception
+		// Disable Rx buffer unavailable reporting, so we don't get swamped
+		// Disable Rx overflow reporting, so we don't get swamped
+		int_disable_mask |= DMA_INT_ENABLE_TXRX_MASK;
+		// Test for Rx/Tx interrupt resulting from sucessful reception or
+		// transmission of a packet - must do this before ack'ing, else
+		// otherwise can get into trouble with the sticky summary bits
+		// when we try to disable further RI interrupts
+		// Do NAPI compatible receive/transmit processing for RI/TI interrupts
+		napi_resched = true;
+	}
+
+#ifdef CONFIG_LEON_COPRO
+	if (int_status & DMA_STATUS_VX_MASK)
+		napi_resched = true;
+#else
+	// Do any interrupt disabling with a single register write
+	if (int_disable_mask) {
+		gmac_int_en_clr(int_disable_mask | DMA_INT_ENABLE_NA_MASK);
+	}
+#endif // CONFIG_LEON_COPRO
+
+	if (napi_resched) {
+		if (napi_schedule_prep(&gmac_priv->txrx_napi)) {
+			spin_lock_irqsave(&gmac_priv->cmd_que_lock_, irq_flags);
+			atomic_and(~(DMA_INT_ENABLE_TXRX_MASK | DMA_INT_ENABLE_VX_MASK), &gmac_priv->int_enable);
+			spin_unlock_irqrestore(&gmac_priv->cmd_que_lock_, irq_flags);
+#ifndef CONFIG_LEON_COPRO
+			gmac_int_en_clr(int_disable_mask | DMA_INT_ENABLE_NA_MASK);
+#endif
+			__napi_schedule(&gmac_priv->txrx_napi);
+		}
+		else
+			gmac_dbg("Interrupt while in poll\n");
+	}
+
+	// Test for any of the error states which we deal with directly within
+	// this interrupt service routine.
+	if (int_status & DMA_STATUS_FLAGS_MASK)	{
+		bool restart_watchdog = false;
+
+		// Test for early Rx interrupt
+		if (int_status & (1UL << DMA_STATUS_ERI_BIT)) {
+			// Don't expect to see this, as never enable it
+			gmac_warn("Early Rx\n");
+		}
+
+		if (int_status & (1UL << DMA_STATUS_RWT_BIT)) {
+			gmac_warn("Rx watchdog timeout\n");
+			// Accumulate receive statistics
+			gmac_priv->stats.rx_frame_errors++;
+			gmac_priv->stats.rx_errors++;
+			restart_watchdog = true;
+		}
+
+		if (int_status & (1UL << DMA_STATUS_RPS_BIT)) {
+			// Mask to extract the receive status field from the status register
+			u32 rs_mask = ((1UL << DMA_STATUS_RS_NUM_BITS) - 1) << DMA_STATUS_RS_BIT;
+			u32 rs = (int_status & rs_mask) >> DMA_STATUS_RS_BIT;
+			gmac_warn("Rx process stopped (status=0x%x), restarting receiver\n", rs);
+			gmac_priv->stats.rx_errors++;
+			restart_watchdog = true;
+			// Restart the receiver
+			change_rx_enable(1, 0);
+		}
+
+		if (int_status & (1UL << DMA_STATUS_TPS_BIT)) {
+			// Mask to extract the transmit status field from the status register
+			u32 ts_mask = ((1UL << DMA_STATUS_TS_NUM_BITS) - 1) << DMA_STATUS_TS_BIT;
+			u32 ts = (int_status & ts_mask) >> DMA_STATUS_TS_BIT;
+			if (ts != DMA_STATUS_TS_STOPPED) {
+				gmac_warn("Tx process stopped (status=0x%x)\n", ts);
+				gmac_priv->stats.tx_errors++;
+				// Restart the transmitter, causes an implicit Tx descriptor list poll
+				gmac_tx_restart();
+				restart_watchdog = true;
+			}
+			gmac_tx_poll_demand();
+		}
+
+		// Test for pure error interrupts
+		if (int_status & (1UL << DMA_STATUS_FBE_BIT)) {
+			// Mask to extract the bus error status field from the status register
+			u32 eb_mask = ((1UL << DMA_STATUS_EB_NUM_BITS) - 1) << DMA_STATUS_EB_BIT;
+			u32 eb = (int_status & eb_mask) >> DMA_STATUS_EB_BIT;
+			gmac_warn("Bus error (status=0x%x)\n", eb);
+			restart_watchdog = true;
+		}
+
+		if (restart_watchdog) {
+			// Restart the link/PHY state watchdog immediately, which will
+			// attempt to restart the system
+			mod_timer(&gmac_priv->watchdog_timer, jiffies);
+		}
+	}
+
+	return IRQ_HANDLED;
+}
+
+static void gmac_down(struct net_device *netdev)
+{
+	int desc;
+	unsigned int i;
+#ifdef CONFIG_LEON_COPRO
+	tx_que_t *tx_queue = &gmac_priv->tx_queue_;
+	bool copro_stop_timed_out = false;
+#endif
+
+	// Stop the Tx queue under the xmit lock FIRST, so a gmac_start_xmit()
+	// running on another CPU either completes before the ring is torn down below,
+	// or is rejected by the stack - plain netif_stop_queue() does not exclude
+	// a just-entered xmit, whose skb would then be stored into the ring after
+	// the free loop and silently lost on the next gmac_up()
+	netif_tx_disable(netdev);
+	netif_carrier_off(netdev);
+
+	if (gmac_priv->napi_enabled) {
+		// Stop NAPI
+		napi_disable(&gmac_priv->txrx_napi);
+		gmac_priv->napi_enabled = 0;
+	}
+
+	atomic_set(&gmac_priv->int_status, 0);
+
+	for (i = 0; i < TX_SKB_RING_ELEMENTS; i++) {
+		struct sk_buff *skb = (void *)atomic_xchg(&gmac_priv->tx_skb_ring_buf[i], (int)NULL);
+		if (skb)
+			dev_kfree_skb_any(skb);
+	}
+	gmac_priv->tx_skb_ring_head_index = 0;
+	gmac_priv->tx_skb_ring_tail_index = 0;
+	gmac_priv->rx_descs_since_refill_cnr = 0;
+
+#ifdef CONFIG_LEON_COPRO
+	// Disable all GMAC interrupts except virtual CoPro bits
+	gmac_int_en_clr(~0UL & ~DMA_STATUS_V_SEM_MASK);
+
+	if (gmac_priv->copro_started) {
+		copro_queue_cmd(GMAC_CMD_STOP, 0, copro_stop_callback);
+
+		// Interrupt the CoPro so it sees the new command
+		oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+
+		// Wait until the CoPro acknowledges the STOP command
+		// (PATCH 1: both ACKs are now delivered from hardirq, so these no
+		//  longer time out just because NAPI has been disabled above)
+		if (down_timeout(&gmac_priv->copro_stop_semaphore_, COPRO_GENERAL_TIMEOUT) == -ETIME) {
+			gmac_warn("Timeout CoPro stop acknowledge\n");
+			copro_stop_timed_out = true;
+		}
+
+		// Wait until the CoPro acknowledges that it has completed stopping
+		if (down_timeout(&gmac_priv->copro_stop_complete_semaphore_, COPRO_GENERAL_TIMEOUT) == -ETIME) {
+			gmac_warn("Timeout stopping CoPro\n");
+			copro_stop_timed_out = true;
+		}
+
+		gmac_priv->copro_started = 0;
+	}
+
+	// Clear out the Tx offload job queue, deallocating associated resources
+	while (tx_que_not_empty(tx_queue)) {
+#ifdef CONFIG_LEON_OFFLOAD_TX
+		if (!copro_stop_timed_out) {
+			copro_free_tx_resources(tx_queue->r_ptr_);
+		}
+#endif
+		tx_que_inc_r_ptr(tx_queue);
+	}
+
+	// Reinitialize the Tx offload queue metadata
+	tx_que_init(
+		tx_queue,
+		gmac_copro_phys_to_virt(gmac_priv->copro_params_.tx_que_head_),
+		COPRO_TX_QUEUE_NUM_ENTRIES);
+#endif // CONFIG_LEON_COPRO
+
+	// Now disable really all GMAC interrupts
+	gmac_int_en_clr(~0UL);
+
+#ifndef CONFIG_LEON_OFFLOAD_TX
+	// Stop transmitter, take ownership of all tx descriptors
+	dma_reg_clear_mask(DMA_OP_MODE_REG, 1UL << DMA_OP_MODE_ST_BIT);
+	tx_take_ownership(&gmac_priv->tx_gmac_desc_list_info);
+#endif // !CONFIG_LEON_OFFLOAD_TX
+
+	// Stop receiver, waiting until it's really stopped and then take ownership
+	// of all rx descriptors
+	change_rx_enable(0, 1);
+
+	rx_take_ownership(&gmac_priv->rx_gmac_desc_list_info);
+
+	// Stop all timers
+	delete_watchdog_timer();
+
+	// Free receive descriptors
+	do {
+		int first_last = 0;
+		rx_frag_info_t frag_info;
+
+		desc = get_rx_descriptor(&first_last, 0, &frag_info);
+		if (desc >= 0) {
+			if (unlikely(gmac_priv->rx_buffers_per_page)) {
+				// If this is the last packet in the page, release the DMA mapping
+				unmap_rx_page(frag_info.phys_adr);
+				put_page(frag_info.page);
+			} else {
+				// Release the DMA mapping for the packet buffer
+				dma_unmap_single(&netdev->dev, frag_info.phys_adr, frag_info.length, DMA_FROM_DEVICE);
+
+				// Free the skb
+				dev_kfree_skb((struct sk_buff *)frag_info.page);
+			}
+		}
+	} while (desc >= 0);
+
+	// Free transmit descriptors
+	do {
+		struct sk_buff *skb;
+		tx_frag_info_t  frag_info;
+		int             buffer_owned;
+
+		desc = get_tx_descriptor(&skb, 0, &frag_info, &buffer_owned);
+		if (desc >= 0) {
+			if (buffer_owned) {
+				// Release the DMA mapping for the packet buffer
+				dma_unmap_single(&netdev->dev, frag_info.phys_adr, frag_info.length, DMA_FROM_DEVICE);
+			}
+
+			if (skb) {
+				// Free the skb
+				dev_kfree_skb(skb);
+			}
+		}
+	} while (desc >= 0);
+
+	// Power down the PHY
+#ifdef CONFIG_SYNOPSYS_GMAC_PHYLIB
+	if (gmac_priv->phydev != NULL) {
+		phy_stop(gmac_priv->phydev);
+	}
+#else
+	phy_powerdown(netdev);
+#endif // CONFIG_SYNOPSYS_GMAC_PHYLIB
+}
+
+static int gmac_stop(struct net_device *netdev)
+{
+	gmac_down(netdev);
+
+#ifdef CONFIG_LEON_COPRO
+	shutdown_copro();
+
+	// Disable semaphore register from causing ARM interrupts
+	oxnas_sys_write(SYS_CTRL_SEMA_MASKA_CTRL, 0);
+	oxnas_sys_write(SYS_CTRL_SEMA_MASKB_CTRL, 0);
+#endif
+
+	// Disable the clock to the MAC block and put it into reset
+	oxnas_sys_write(SYS_CTRL_CKEN_CLR_CTRL, 1UL << SYS_CTRL_CKEN_MAC_BIT);
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_MAC_BIT);
+
+	// Free the sysfs resources
+	if (gmac_priv->link_state_kobject.kset != NULL) {
+		kobject_put(&gmac_priv->link_state_kobject);
+		memset(&gmac_priv->link_state_kobject, 0, sizeof(struct kobject));
+		kset_unregister(gmac_priv->link_state_kset);
+	}
+
+	gmac_priv->interface_up = 0;
+	return 0;
+}
+
+static void hw_set_mac_address(const unsigned char *addr)
+{
+	u32 mac_lo, mac_hi;
+
+	// Big Endian format in *addr!
+	mac_lo  =  (u32)addr[0];
+	mac_lo |= ((u32)addr[1] << 8);
+	mac_lo |= ((u32)addr[2] << 16);
+	mac_lo |= ((u32)addr[3] << 24);
+
+	mac_hi  =  (u32)addr[4];
+	mac_hi |= ((u32)addr[5] << 8);
+	mac_hi |= 0x80000000UL;
+
+	mac_reg_write(MAC_ADR0_HIGH_REG, mac_hi);
+	mac_reg_write(MAC_ADR0_LOW_REG, mac_lo);
+}
+
+static int gmac_set_mac_address(struct net_device *netdev, void *p)
+{
+	struct sockaddr *addr = p;
+
+	if (!is_valid_ether_addr(addr->sa_data)) {
+		gmac_warn("Invalid ethernet address\n");
+		return -EADDRNOTAVAIL;
+	}
+
+	eth_hw_addr_set(netdev, addr->sa_data);
+	hw_set_mac_address(netdev->dev_addr);
+
+	return 0;
+}
+
+static void multicast_hash(struct netdev_hw_addr *ha, u32 *hash_lo, u32 *hash_hi)
+{
+	u32 crc = ether_crc_le(ETH_ALEN, ha->addr);
+	u32 mask = 1 << ((crc >> 26) & 0x1F);
+
+	if (crc >> 31) {
+		*hash_hi |= mask;
+	} else {
+		*hash_lo |= mask;
+	}
+}
+
+static void gmac_set_rx_mode(struct net_device *netdev)
+{
+	u32 hash_lo=0;
+	u32 hash_hi=0;
+	u32 mode = 0;
+	int i;
+
+	// Disable promiscuous mode and uni/multi-cast matching
+	mac_reg_write(MAC_FRAME_FILTER_REG, mode);
+
+	// Disable all perfect match registers
+	for (i=0; i < NUM_PERFECT_MATCH_REGISTERS; ++i) {
+		mac_adrhi_reg_write(i, 0);
+	}
+
+	// Promiscuous mode overrides all-multi which overrides other filtering
+	if (netdev->flags & IFF_PROMISC) {
+		mode |= (1 << MAC_FRAME_FILTER_PR_BIT);
+	} else if (netdev->flags & IFF_ALLMULTI) {
+		mode |= (1 << MAC_FRAME_FILTER_PM_BIT);
+	} else {
+		struct netdev_hw_addr *ha;
+
+		if (netdev_mc_count(netdev) <= NUM_PERFECT_MATCH_REGISTERS) {
+			// Use perfect matching registers
+			netdev_for_each_mc_addr(ha, netdev) {
+				u32 addr;
+
+				// Note: write to hi register first. The MAC address registers are
+				// double-synchronised to the GMII clock domain, and sync is only
+				// triggered on the write to the low address register.
+				addr  =      ha->addr[4];
+				addr |= (u32)ha->addr[5] << 8;
+				addr |= (1 << MAC_ADR1_HIGH_AE_BIT);
+				mac_adrhi_reg_write(i, addr);
+
+				addr  =      ha->addr[0];
+				addr |= (u32)ha->addr[1] << 8;
+				addr |= (u32)ha->addr[2] << 16;
+				addr |= (u32)ha->addr[3] << 24;
+				mac_adrlo_reg_write(i, addr);
+			}
+		} else {
+			// Use hashing
+			mode |= (1 << MAC_FRAME_FILTER_HUC_BIT);
+			mode |= (1 << MAC_FRAME_FILTER_HMC_BIT);
+
+			netdev_for_each_mc_addr(ha, netdev) {
+				multicast_hash(ha, &hash_lo, &hash_hi);
+			}
+		}
+	}
+
+	// Update the filtering rules
+	mac_reg_write(MAC_FRAME_FILTER_REG, mode);
+
+	// Update the filtering hash table
+	mac_reg_write(MAC_HASH_LOW_REG,  hash_lo);
+	mac_reg_write(MAC_HASH_HIGH_REG, hash_hi);
+}
+
+static int gmac_up(struct net_device *netdev)
+{
+	int status = 0;
+	u32 reg_contents;
+	gmac_dma_desc_t *rx_desc, *tx_desc;
+
+	// Perform any actions required before GMAC reset
+	do_pre_reset_actions();
+
+	// Reset the entire GMAC
+	dma_reg_write(DMA_BUS_MODE_REG, 1UL << DMA_BUS_MODE_SWR_BIT);
+
+	// Ensure reset is performed before testing for completion
+	wmb();
+
+	// Wait for the reset operation to complete
+	{
+		unsigned long swr_end = jiffies + MS_TO_JIFFIES(100);
+
+		status = -EIO;
+		while (time_before(jiffies, swr_end)) {
+			if (!(dma_reg_read(DMA_BUS_MODE_REG) & (1UL << DMA_BUS_MODE_SWR_BIT))) {
+				status = 0;
+				break;
+			}
+			cpu_relax();
+		}
+		if (status) {
+			gmac_err("GMAC DMA soft reset did not complete (no PHY clocks?)\n");
+		}
+	}
+
+	// Perform any actions required after GMAC reset
+	do_post_reset_actions();
+
+	// Did the GMAC reset operation fail?
+	if (status) {
+		gmac_err("GMAC reset failed\n");
+		goto gmac_up_err_out;
+	}
+//	gmac_info("GMAC reset complete\n");
+
+	// Initialize MAC config register contents
+	reg_contents = 0;
+	if (!gmac_priv->using_1000) {
+		gmac_dbg("PHY in 10/100Mbps mode\n");
+		reg_contents |= (1UL << MAC_CONFIG_PS_BIT);
+	} else {
+		gmac_dbg("PHY in 1000Mbps mode\n");
+	}
+	if (gmac_priv->mii_full_duplex) {
+		reg_contents |= (1UL << MAC_CONFIG_DM_BIT);
+	}
+
+	reg_contents |= (1UL << MAC_CONFIG_IPC_BIT);
+
+	if (gmac_priv->jumbo_) {
+		// Allow passage of jumbo frames through both transmitter and receiver
+		reg_contents |=	((1UL << MAC_CONFIG_JE_BIT) |
+						(1UL << MAC_CONFIG_JD_BIT) |
+						 (1UL << MAC_CONFIG_WD_BIT));
+	}
+
+	// Enable transmitter and receiver
+	reg_contents |= ((1UL << MAC_CONFIG_TE_BIT) |
+					 (1UL << MAC_CONFIG_RE_BIT));
+
+	// Select the minimum IFG - I found that 80 bit times caused very poor
+	// IOZone performance, so stcik with the 96 bit times default
+	reg_contents |= (0UL << MAC_CONFIG_IFG_BIT);
+
+	// Write MAC config setup to the GMAC
+	mac_reg_write(MAC_CONFIG_REG, reg_contents);
+
+	// Initialize MAC VLAN register contents
+	reg_contents = 0;
+	mac_reg_write(MAC_VLAN_TAG_REG, reg_contents);
+
+	// Initialize the hardware's record of our primary MAC address
+	hw_set_mac_address(netdev->dev_addr);
+
+	gmac_info("Ethernet MAC address (%d octets specified): %02X:%02X:%02X:%02X:%02X:%02X\n",
+		mac_adr_len, mac_adr[0], mac_adr[1], mac_adr[2], mac_adr[3], mac_adr[4], mac_adr[5]);
+
+	// Initialize multicast and promiscuous modes
+	gmac_set_rx_mode(netdev);
+
+	// Disable all MMC interrupt sources
+	mac_reg_write(MMC_RX_MASK_REG, ~0UL);
+	mac_reg_write(MMC_TX_MASK_REG, ~0UL);
+
+	rx_desc = gmac_priv->descriptors;
+	tx_desc = gmac_priv->descriptors + NUM_RX_DMA_DESCRIPTORS;
+	// Initialize the structures managing the Rx descriptor list
+	init_rx_desc_list(&gmac_priv->rx_gmac_desc_list_info,
+		rx_desc,
+		gmac_priv->shadow_descriptors,
+		NUM_RX_DMA_DESCRIPTORS,
+		gmac_priv->rx_buffer_size_);
+
+	// Initialize the structures managing the Tx descriptor list
+	init_tx_desc_list(&gmac_priv->tx_gmac_desc_list_info,
+		tx_desc,
+		gmac_priv->shadow_descriptors + NUM_RX_DMA_DESCRIPTORS,
+		NUM_TX_DMA_DESCRIPTORS);
+
+	// Write the physical DMA consistent address of the start of the Rx descriptor array
+	dma_reg_write(DMA_RX_DESC_ADR_REG, gmac_desc_virt_to_phys(rx_desc));
+
+#ifndef CONFIG_LEON_OFFLOAD_TX
+	// Write the physical DMA consistent address of the start of the Tx descriptor array
+	dma_reg_write(DMA_TX_DESC_ADR_REG, gmac_desc_virt_to_phys(tx_desc));
+#endif // !CONFIG_LEON_OFFLOAD_TX
+
+	// Initialize the GMAC DMA bus mode register
+	dma_reg_write(DMA_BUS_MODE_REG, ((1UL << DMA_BUS_MODE_FB_BIT)   |	// Force bursts
+										   (8UL << DMA_BUS_MODE_PBL_BIT)  |	// AHB burst size
+										   (1UL << DMA_BUS_MODE_DA_BIT)));	// Round robin Rx/Tx
+
+	// Clear any pending interrupt requests
+	dma_reg_write(DMA_STATUS_REG, dma_reg_read(DMA_STATUS_REG));
+
+	// Initialize flow control register contents
+	// Enable Rx flow control
+	reg_contents = (1UL << MAC_FLOW_CNTL_RFE_BIT);
+
+	if (gmac_priv->using_pause) {
+		// Enable Tx flow control
+		reg_contents |= (1UL << MAC_FLOW_CNTL_TFE_BIT);
+	}
+
+	// Set the duration of the pause frames generated by the transmitter when
+	// the Rx fifo fill threshold is exceeded
+	reg_contents |= ((0x100UL << MAC_FLOW_CNTL_PT_BIT) |	// Pause for 256 slots
+					  (0x1UL << MAC_FLOW_CNTL_PLT_BIT));
+
+	// Write flow control setup to the GMAC
+	mac_reg_write(MAC_FLOW_CNTL_REG, reg_contents);
+
+	// Initialize the GMAC DMA operation mode register. Set Tx/Rx FIFO thresholds
+	// to make best use of our limited SDRAM bandwidth when operating in gigabit
+	reg_contents = ((DMA_OP_MODE_TTC_256 << DMA_OP_MODE_TTC_BIT) |    // Tx threshold
+					(1UL << DMA_OP_MODE_FUF_BIT) |    					// Forward Undersized good Frames
+					(DMA_OP_MODE_RTC_128 << DMA_OP_MODE_RTC_BIT) |	// Rx threshold 128 bytes
+					(1UL << DMA_OP_MODE_OSF_BIT));						// Operate on 2nd frame
+
+	// Enable hardware flow control
+	reg_contents |= (1UL << DMA_OP_MODE_EFC_BIT);
+
+	// Set threshold for enabling hardware flow control at (full-4KB) to give
+	// space for upto two in-flight std MTU packets to arrive after pause frame
+	// has been sent.
+	reg_contents |= ((0UL << DMA_OP_MODE_RFA2_BIT) |
+					  (3UL << DMA_OP_MODE_RFA_BIT));
+
+	// Set threshold for disabling hardware flow control (-7KB)
+	reg_contents |= ((1UL << DMA_OP_MODE_RFD2_BIT) |
+					  (2UL << DMA_OP_MODE_RFD_BIT));
+
+	// Don't flush Rx frames from FIFO just because there's no descriptor available
+	reg_contents |= (1UL << DMA_OP_MODE_DFF_BIT);
+
+	// Write settings to operation mode register
+	dma_reg_write(DMA_OP_MODE_REG, reg_contents);
+
+	// GMAC requires store&forward in order to compute Tx checksums
+	dma_reg_set_mask(DMA_OP_MODE_REG, (1UL << DMA_OP_MODE_SF_BIT));
+
+	// Ensure setup is complete, before enabling Tx and Rx
+	wmb();
+
+#ifdef CONFIG_LEON_COPRO
+	// Update the CoPro's parameters with the current MTU
+	gmac_priv->copro_params_.mtu_ = netdev->mtu;
+
+	// Only attempt to write to uncached/unbuffered shared parameter storage if
+	// CoPro is started and thus storage has been allocated
+	if (gmac_priv->shared_copro_params_) {
+		// Fill the CoPro parameter block
+		memcpy(gmac_priv->shared_copro_params_, &gmac_priv->copro_params_, sizeof(copro_params_t));
+	}
+
+	// Make sure the CoPro parameter block updates have made it to memory (which
+	// is uncached/unbuffered, so just compiler issues to overcome)
+	wmb();
+
+	// Tell the CoPro to re-read parameters
+	// (PATCH 1: the ACK is completed in hardirq, so this wait works even though
+	//  NAPI is not enabled yet at this point)
+	copro_queue_cmd(GMAC_CMD_UPDATE_PARAMS, 0, copro_update_callback);
+
+	// Interrupt the CoPro so it sees the new command
+	oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+
+	// Wait until the CoPro acknowledges that the update of parameters is complete
+	status = down_timeout(&gmac_priv->copro_update_semaphore_, COPRO_GENERAL_TIMEOUT);
+	if (status != 0) {
+		gmac_err("Error updating CoPro parameters\n");
+		goto gmac_up_err_out;
+	};
+
+	// Tell the CoPro to begin network offload operations
+	copro_queue_cmd(GMAC_CMD_START, 0, copro_start_callback);
+
+	// Interrupt the CoPro so it sees the new command
+	oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+
+	// Wait until the CoPro acknowledges that it has started
+	status = down_timeout(&gmac_priv->copro_start_semaphore_, COPRO_GENERAL_TIMEOUT);
+	if (status != 0) {
+	gmac_err("Error starting CoPro\n");
+		goto gmac_up_err_out;
+	}
+
+	gmac_priv->copro_started = 1;
+	// Program GMAC Tx descriptor base to the CoPro's workspace, where
+	// the firmware builds GMAC descriptors for each queued Tx job
+//	dma_reg_write(DMA_TX_DESC_ADR_REG, gmac_priv->copro_params_.free_start_);
+	// PATCH (fix LEON-Tx): do NOT program DMA_TX_DESC_ADR_REG from the ARM.
+	// Stock 2.6.24 never wrote it with CONFIG_LEON_OFFLOAD_TX - the
+	// firmware owns the Tx descriptor ring and programs the register
+	// itself when it builds a chain. Overwriting it from gmac_up() right
+	// after GMAC_CMD_START can point the Tx DMA at a stale/uninitialised
+	// descriptor area
+
+#endif // CONFIG_LEON_COPRO
+
+	// Prepare receive descriptors
+	refill_rx_ring();
+
+	atomic_set(&gmac_priv->int_status, 0);
+	{
+		unsigned int i;
+		for (i = 0; i < TX_SKB_RING_ELEMENTS; i++)
+			atomic_set(&gmac_priv->tx_skb_ring_buf[i], (int)NULL);
+	}
+	gmac_priv->tx_skb_ring_head_index = 0;
+	gmac_priv->tx_skb_ring_tail_index = 0;
+	gmac_priv->rx_descs_since_refill_cnr = 0;
+
+	// Start NAPI
+	BUG_ON(gmac_priv->napi_enabled);
+	napi_enable(&gmac_priv->txrx_napi);
+	gmac_priv->napi_enabled = 1;
+
+	// Start the transmitter and receiver
+#ifdef CONFIG_LEON_COPRO
+	// TE must be on for the MAC to emit frames. Do NOT set ST here -
+	// Tx DMA is started on demand in gmac_start_xmit() once a packet
+	// is actually queued; setting ST earlier makes DMA fetch a NULL
+	// descriptor -> Fatal Bus Error and Transmit Process Stopped
+	mac_reg_set_mask(MAC_CONFIG_REG, (1UL << MAC_CONFIG_TE_BIT));
+#endif
+	gmac_tx_restart();
+	change_rx_enable(1, 0);
+
+	// Enable interesting GMAC interrupts
+	gmac_int_en_set(DMA_INT_ENABLE_NA_MASK
+		| DMA_INT_ENABLE_RX_MASK
+		| DMA_INT_ENABLE_TX_MASK
+		| DMA_INT_ENABLE_FLAGS_MASK);
+
+	// (Re)start the link/PHY state monitoring timer
+	start_watchdog_timer();
+
+#ifdef CONFIG_SYNOPSYS_GMAC_PHYLIB
+	if (gmac_priv->phydev != NULL) {
+		phy_start(gmac_priv->phydev);
+	}
+#endif
+
+	// Allow the network stack to call gmac_start_xmit()
+	netif_start_queue(netdev);
+
+	return status;
+
+gmac_up_err_out:
+	gmac_stop(netdev);
+
+	return status;
+}
+
+static void set_rx_packet_info(struct net_device *netdev)
+{
+	int max_packet_buffer_size = netdev->mtu + EXTRA_RX_SKB_SPACE;
+
+	if (max_packet_buffer_size > GMAC_MAX_DESC_LEN) {
+		if (RX_BUFFER_SIZE < MIN_PACKET_SIZE)
+			gmac_priv->rx_buffer_size_ = max_packet_buffer_size;
+		else
+			gmac_priv->rx_buffer_size_ = RX_BUFFER_SIZE;
+		gmac_priv->rx_buffers_per_page = GMAC_ALLOC_SIZE / (gmac_priv->rx_buffer_size_ + NET_IP_ALIGN);
+	} else {
+		gmac_priv->rx_buffer_size_ = max_packet_buffer_size;
+		gmac_priv->rx_buffers_per_page = 0;
+	}
+}
+
+static void gmac_tx_hang_reset(struct work_struct *work)
+{
+	struct net_device *netdev = gmac_priv ? gmac_priv->netdev : NULL;
+
+	if (!netdev || !gmac_priv->interface_up)
+		return;
+
+	gmac_err("Tx hang: recycling the CoPro Tx pipeline (gmac_down/gmac_up)\n");
+	gmac_down(netdev);
+	if (gmac_up(netdev))
+		gmac_err("Tx hang: gmac_up() failed after reset\n");
+	atomic_set(&gmac_hang_timeouts, 0);
+	gmac_tx_hang_reset_armed = 0;
+}
+
+static int gmac_change_mtu(struct net_device *netdev, int new_mtu)
+{
+	int status = 0;
+	int original_mtu = netdev->mtu;
+
+	// Check that new MTU is within supported range
+	if ((new_mtu < MIN_PACKET_SIZE) || (new_mtu > MAX_JUMBO)) {
+		gmac_dbg("Invalid MTU %d\n", new_mtu);
+		status = -EINVAL;
+	}
+	else if (gmac_priv->interface_up) {
+		// Put MAC/PHY into quiesent state, causing all current buffers to be
+		// deallocated and the PHY to powerdown
+		gmac_down(netdev);
+
+		// Record the new MTU, so bringing the MAC back up will allocate
+		// resources to suit the new MTU
+		netdev->mtu = new_mtu;
+
+		// Set length etc. of rx packets
+		set_rx_packet_info(netdev);
+
+		// Reset the PHY to get it into a known state and ensure we have Tx/Rx
+		// clocks to allow the GMAC reset to complete
+#ifdef CONFIG_SYNOPSYS_GMAC_PHYLIB
+		if (gmac_priv->phydev == NULL || genphy_soft_reset(gmac_priv->phydev)) {
+			gmac_err("Failed to reset PHY\n");
+			status = -EIO;
+		}
+		else {
+			// Set PHY specfic features
+			initialize_phy();
+
+			// Record whether jumbo frames should be enabled
+			gmac_priv->jumbo_ = (netdev->mtu > NORMAL_PACKET_SIZE);
+
+			// Reallocate buffers with new MTU
+			status = gmac_up(netdev);
+		}
+#else // CONFIG_SYNOPSYS_GMAC_PHYLIB
+		if (phy_reset(netdev)) {
+			gmac_err("Failed to reset PHY\n");
+			status = -EIO;
+		}
+		else {
+			// Set PHY specfic features
+			initialize_phy();
+
+			// Record whether jumbo frames should be enabled
+			gmac_priv->jumbo_ = (netdev->mtu > NORMAL_PACKET_SIZE);
+
+			// Force or auto-negotiate PHY mode
+			gmac_priv->phy_force_negotiation = 1;
+
+			// Reallocate buffers with new MTU
+			status = gmac_up(netdev);
+		}
+#endif // CONFIG_SYNOPSYS_GMAC_PHYLIB
+	}
+	else {
+		// Record the new MTU, so bringing the interface up will allocate
+		// resources to suit the new MTU
+		netdev->mtu = new_mtu;
+	}
+
+	// If there was a failure
+	if (status) {
+		// If the interface was up, gmac_down() has already run and interface_up
+		// is still set (only gmac_stop() clears it), so gmac_up() was not attempted
+		// or its PHY reset failed. Bring the MAC back up with the ORIGINAL MTU so
+		// a rejected change does not leave the link dead while administratively UP
+		// (queue stopped, carrier off), and the rx buffer sizing does not stay
+		// computed for the rejected MTU. If gmac_up() itself failed, its error path
+		// has already run gmac_stop() (interface_up == 0) - then only restore
+		// the MTU and the user must ifdown/ifup
+		if (gmac_priv->interface_up) {
+			netdev->mtu = original_mtu;
+			set_rx_packet_info(netdev);
+			gmac_priv->jumbo_ = (netdev->mtu > NORMAL_PACKET_SIZE);
+			gmac_err("Failed, rolling back to MTU %d\n", original_mtu);
+			if (gmac_up(netdev)) {
+				gmac_err("Rollback failed - interface left down, please ifdown/ifup\n");
+			}
+		}
+		else {
+			netdev->mtu = original_mtu;
+			gmac_err("Failed, returning MTU to original value\n");
+		}
+	}
+
+	return status;
+}
+
+static void gmac_init_copro(void)
+{
+	const struct firmware *fw = NULL;
+
+	cmd_que_init(&gmac_priv->cmd_queue_,
+		gmac_copro_phys_to_virt(gmac_priv->copro_params_.cmd_que_head_),
+		COPRO_CMD_QUEUE_NUM_ENTRIES);
+	tx_que_init(&gmac_priv->tx_queue_,
+		gmac_copro_phys_to_virt(gmac_priv->copro_params_.tx_que_head_),
+		COPRO_TX_QUEUE_NUM_ENTRIES);
+	memcpy(gmac_priv->shared_copro_params_, &gmac_priv->copro_params_, sizeof(copro_params_t));
+
+	if (!request_firmware(&fw, "gmac_copro_firmware", &gmac_priv->netdev->dev)) {
+		init_copro(fw->data, gmac_priv->shared_copro_params_phys);
+		release_firmware(fw);
+	}
+	else
+		init_copro(leon_gmac_copro_srec, gmac_priv->shared_copro_params_phys);
+}
