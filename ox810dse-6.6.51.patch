+/* STATE-PROC: on-demand GMAC/CoPro state dump via /proc/gmac_state.
+ *
+ * The Tx-timeout dump only fires when the netdev watchdog triggers, i.e.
+ * when xmit stalls.  Hangs where xmit keeps returning TX_OK (jobs still
+ * being consumed) or where only Rx dies stay completely silent.
+ *
+ * "cat /proc/gmac_state" prints the full state, including the LEON's live
+ * cursors read straight from the firmware's SRAM state block, a HEARTBEAT
+ * liveness probe and a 300 ms "is anything moving" re-snapshot.
+ *
+ * LEON state block (ARM phys 0x5801F800, LEON addr 0x9801F800), offsets
+ * from the firmware disassembly:
+ *   0x2B0 params base cache  0x2B4 cmd_q {r, tail, ?}
+ *   0x2C0 tx_active_ latch   0x2C4 stop_req_      0x2C8 ws top (pool end)
+ *   0x2CC job_q {head, tail, process, complete}   (stride 0x8C)
+ *   0x2DC stats accumulators[5]
+ *   0x2F0 TX_DESC_Q {base, tail, cur, complete, pending} (stride 0x10)
+ *   0x304 pool free-list head (0 == pool exhausted)
+ */
+#ifdef CONFIG_LEON_COPRO
+
+#define GMAC_LEON_STATE_PA	0x5801F800UL
+#define GMAC_LEON_STATE_SZ	0x400
+
+static void __iomem *gmac_leon_state;
+
+static inline u32 gmac_leon_rd(u32 off)
+{
+	return gmac_leon_state ? readl(gmac_leon_state + off) : 0;
+}
+
+static void gmac_state_snap(u32 jobq[4], u32 descq[5], u32 *pool)
+{
+	int i;
+
+	for (i = 0; i < 4; i++)
+		jobq[i] = gmac_leon_rd(0x2CC + 4 * i);
+	for (i = 0; i < 5; i++)
+		descq[i] = gmac_leon_rd(0x2F0 + 4 * i);
+	*pool = gmac_leon_rd(0x304);
+}
+
+static int gmac_state_show(struct seq_file *m, void *v)
+{
+	tx_que_t *q = &gmac_priv->tx_queue_;
+	volatile gmac_cmd_que_ent_t *c;
+	volatile gmac_tx_que_ent_t *job;
+	volatile gmac_dma_desc_t *d;
+	u32 jobq[4], descq[5], pool, jobq2[4], descq2[5], pool2;
+	u32 txadr, curtx, curtxb, rxadr, currx, curtx2, currx2;
+	volatile u32 *fwd;
+	int i, n, own_jobs = 0, own_ws = 0, first_ws = -1, last_ws = -1;
+	int own_cmd = 0, own_cmd2 = 0;
+
+	if (!gmac_priv || !gmac_priv->shared_copro_params_) {
+		seq_puts(m, "gmac: not up\n");
+		return 0;
+	}
+
+	seq_printf(m, "GMAC state jiffies=%lu carrier=%d qstop=%d mtu=%d copro_started=%d\n",
+		jiffies, netif_carrier_ok(gmac_priv->netdev),
+		netif_queue_stopped(gmac_priv->netdev),
+		gmac_priv->netdev->mtu, gmac_priv->copro_started);
+	seq_printf(m, "[DMA] status=%08x opmode=%08x IE_hw=%08x IE_mirror=%08x int_status=%08x\n",
+		dma_reg_read(DMA_STATUS_REG), dma_reg_read(DMA_OP_MODE_REG),
+		dma_reg_read(DMA_INT_ENABLE_REG),
+		(u32)atomic_read(&gmac_priv->int_enable),
+		(u32)atomic_read(&gmac_priv->int_status));
+	seq_printf(m, "[MAC] config=%08x IPC=%d TE=%d DM=%d\n",
+		mac_reg_read(MAC_CONFIG_REG),
+		(mac_reg_read(MAC_CONFIG_REG) >> MAC_CONFIG_IPC_BIT) & 1,
+		(mac_reg_read(MAC_CONFIG_REG) >> MAC_CONFIG_TE_BIT) & 1,
+		(mac_reg_read(MAC_CONFIG_REG) >> MAC_CONFIG_DM_BIT) & 1);
+
+	txadr = dma_reg_read(DMA_TX_DESC_ADR_REG);
+	curtx = dma_reg_read(DMA_CUR_TX_DESC_REG);
+	curtxb = dma_reg_read(DMA_CUR_TX_ADR_REG);
+	rxadr = dma_reg_read(DMA_RX_DESC_ADR_REG);
+	currx = dma_reg_read(DMA_CUR_RX_DESC_REG);
+	seq_printf(m, "[TXDMA] txadr=%08x curdesc=%08x (+%d) curbuf=%08x\n",
+		txadr, curtx, (int)((curtx - txadr) / 16), curtxb);
+	seq_printf(m, "[RXDMA] rxadr=%08x cur=%08x (+%d)\n",
+		rxadr, currx, (int)((currx - rxadr) / 16));
+	seq_printf(m, "[RXlist] n=%d empty=%d r=%d w=%d\n",
+		gmac_priv->rx_gmac_desc_list_info.num_descriptors,
+		gmac_priv->rx_gmac_desc_list_info.empty_count,
+		gmac_priv->rx_gmac_desc_list_info.r_index,
+		gmac_priv->rx_gmac_desc_list_info.w_index);
+	seq_printf(m, "[stats] tx pkts=%lu byts=%lu err=%lu | rx pkts=%lu byts=%lu err=%lu drop=%lu\n",
+		gmac_priv->stats.tx_packets, gmac_priv->stats.tx_bytes,
+		gmac_priv->stats.tx_errors,
+		gmac_priv->stats.rx_packets, gmac_priv->stats.rx_bytes,
+		gmac_priv->stats.rx_errors, gmac_priv->stats.rx_dropped);
+	fwd = (volatile u32 *)gmac_copro_phys_to_virt(
+		gmac_priv->copro_params_.fwd_intrs_mailbox_);
+	seq_printf(m, "[fwd mailbox] %08x\n", *fwd);
+
+	// Job ring as the driver sees it
+	seq_printf(m, "[TXQ] w=%d r=%d full=%d swring_head=%d swring_tail=%d\n",
+		(int)(q->w_ptr_ - q->head_), (int)(q->r_ptr_ - q->head_),
+		q->full_, gmac_priv->tx_skb_ring_head_index,
+		gmac_priv->tx_skb_ring_tail_index);
+	for (i = 0; i < COPRO_TX_QUEUE_NUM_ENTRIES; i++) {
+		job = q->head_ + i;
+		if (job->flags_ & (1u << TX_JOB_FLAGS_OWN_BIT))
+			own_jobs++;
+		seq_printf(m, "[job%d] fl=%04x%s len=%u dlen=%u tso=%u/%u eth=%08x ip=%08x stat=%08x\n",
+			i, job->flags_,
+			(job->flags_ & (1u << TX_JOB_FLAGS_OWN_BIT)) ? " OWN" : "",
+			job->len_, job->data_len_, job->tso_segs_, job->tso_size_,
+			job->ethhdr_, job->iphdr_,
+			job->statistics_);
+	}
+	seq_printf(m, "[jobs] OWN=%d/%d\n", own_jobs, COPRO_TX_QUEUE_NUM_ENTRIES);
+
+	// Command queue + liveness probe
+	c = (volatile gmac_cmd_que_ent_t *)gmac_copro_phys_to_virt(
+		gmac_priv->copro_params_.cmd_que_head_);
+	for (i = 0; i < COPRO_CMD_QUEUE_NUM_ENTRIES; i++) {
+		seq_printf(m, "[cmd%d] op=%08x%s%s%s arg=%08x\n", i, c[i].opcode_,
+			(c[i].opcode_ & (1UL << GMAC_CMD_QUE_OWN_BIT)) ? " OWN" : "",
+			(c[i].opcode_ & (1UL << GMAC_CMD_QUE_ACK_BIT)) ? " ACK" : "",
+			(c[i].opcode_ & (1UL << GMAC_CMD_QUE_SKP_BIT)) ? " SKP" : "",
+			c[i].operand_);
+		if (c[i].opcode_ & (1UL << GMAC_CMD_QUE_OWN_BIT))
+			own_cmd++;
+	}
+	if (copro_queue_cmd(GMAC_CMD_HEARTBEAT, 0, copro_ack_noop_callback))
+		seq_puts(m, "[HEARTBEAT] cmd queue FULL - CoPro not draining!\n");
+	else
+		seq_puts(m, "[HEARTBEAT] queued\n");
+
+	// Workspace descriptors
+	d = (volatile gmac_dma_desc_t *)gmac_copro_phys_to_virt(gmac_priv->copro_params_.free_start_);
+	n = 54;
+	for (i = 0; i < n; i++) {
+		if (d[i].status & (1UL << TDES0_OWN_BIT)) {
+			own_ws++;
+			if (first_ws < 0)
+				first_ws = i;
+			last_ws = i;
+		}
+	}
+	seq_printf(m, "[WS] free=%08x n=%d own=%d first=%d last=%d\n",
+		gmac_priv->copro_params_.free_start_, n, own_ws, first_ws, last_ws);
+
+	// The LEON's live view
+	gmac_state_snap(jobq, descq, &pool);
+	seq_printf(m, "[LEON] active=%08x stopreq=%08x wstop=%08x\n",
+		gmac_leon_rd(0x2C0), gmac_leon_rd(0x2C4), gmac_leon_rd(0x2C8));
+	seq_printf(m, "[LEON job_q] head=%08x tail=%08x process=%08x complete=%08x (tail-head=%d B = %d entries; ARM w=%d)\n",
+		jobq[0], jobq[1], jobq[2], jobq[3],
+		(int)(jobq[1] - jobq[0]),
+		(int)((jobq[1] - jobq[0]) / 0x8C),
+		(int)(q->w_ptr_ - q->head_));
+	seq_printf(m, "[LEON desc_q] base=%08x tail=%08x cur=%08x complete=%08x pend=%08x (ring=%d desc, pool %08x..%08x)\n",
+		descq[0], descq[1], descq[2], descq[3], descq[4],
+		(int)((descq[1] - descq[0]) / 16),
+		descq[1] + 4, gmac_leon_rd(0x2C8));
+	seq_printf(m, "[LEON pool_head=%08x stats=%08x %08x %08x %08x %08x\n",
+		pool, gmac_leon_rd(0x2DC), gmac_leon_rd(0x2E0),
+		gmac_leon_rd(0x2E4), gmac_leon_rd(0x2E8), gmac_leon_rd(0x2EC));
+	seq_printf(m, "[LEON cmd_q] r=%08x tail=%08x x=%08x params_cache=%08x\n",
+		gmac_leon_rd(0x2B4), gmac_leon_rd(0x2B8), gmac_leon_rd(0x2BC), gmac_leon_rd(0x2B0));
+
+	{
+		int nd = (int)((descq[1] - descq[0]) / 16);
+		int cur_i = (int)((descq[2] - descq[0]) / 16);
+		int bld_i = (int)((descq[3] - descq[0]) / 16);
+		int k, l, a, b;
+
+		if (nd > 0 && cur_i >= 0 && cur_i < nd && bld_i >= 0 && bld_i < nd) {
+			a = min(cur_i, bld_i) - 6;
+			b = max(cur_i, bld_i) + 8;
+			if (a < 0)
+				a = 0;
+			if (b > nd - 1)
+				b = nd - 1;
+			seq_printf(m, "[DESC] ring=%d cur(reap)=%d complete(build)=%d behind=%d\n",
+				nd, cur_i, bld_i,
+				(cur_i <= bld_i) ? (bld_i - cur_i) : (nd - cur_i + bld_i));
+			for (k = a; k <= b; k++) {
+				volatile gmac_dma_desc_t *e = &d[k];
+
+				seq_printf(m, "[DESC %3d]%s%s st=%08x len=%08x b1=%08x b2=%08x%s%s%s\n",
+					k, (k == cur_i) ? " >REAP" : "",
+					(k == bld_i) ? " >BUILD" : "",
+					e->status, e->length, e->buffer1, e->buffer2,
+					(e->status & (1UL << TDES0_OWN_BIT)) ? " OWN" : "",
+					(e->buffer2 & 2) ? " lnk" : " STOP",
+					(e->buffer2 & 1) ? " job" : "");
+			}
+		} else {
+			seq_printf(m, "[DESC] bad cursors: ring=%d cur=%d bld=%d\n",
+				nd, cur_i, bld_i);
+		}
+
+		for (l = 0; l < COPRO_TX_QUEUE_NUM_ENTRIES; l++) {
+			volatile gmac_tx_que_ent_t *j = &q->head_[l];
+			int nf = 0;
+
+			for (k = 0; k < COPRO_NUM_TX_FRAGS_DIRECT; k++)
+				if (j->frag_len_[k])
+					nf++;
+			seq_printf(m, "[JOB %d] fl=%04x%s%s%s skb=%08x len=%u dlen=%u eth=%08x iph=%08x(+%d) csum=%04x tso=%u/%u stat=%08x frags=%d\n",
+				l, j->flags_,
+				(j->flags_ & 1) ? " OWN" : "",
+				(j->flags_ & 2) ? " TAKEN" : "",
+				(j->flags_ & 4) ? " ACC" : "",
+				j->skb_, j->len_, j->data_len_, j->ethhdr_, j->iphdr_,
+				(int)(j->iphdr_ - j->ethhdr_), j->iphdr_csum_,
+				j->tso_segs_, j->tso_size_, j->statistics_, nf);
+			if (nf) {
+				seq_puts(m, "        frags:");
+				for (k = 0; k < COPRO_NUM_TX_FRAGS_DIRECT && j->frag_len_[k]; k++)
+					seq_printf(m, " %08x/%u", j->frag_ptr_[k], j->frag_len_[k]);
+				seq_putc(m, '\n');
+			}
+		}
+
+		if (pool) {
+			u32 top = gmac_leon_rd(0x2C8) & ~3UL;
+
+			if (top > pool) {
+				u32 s;
+
+				seq_printf(m, "[POOL] head=%08x top=%08x, slots in use (top-down):\n",
+					pool, top);
+				for (s = top - 0x8C; s >= pool; s -= 0x8C) {
+					volatile u32 *w = gmac_copro_phys_to_virt(s);
+
+					/* if a slot holds a job copy, the word
+					 * layout matches gmac_tx_que_ent_t */
+					seq_printf(m, "[POOL %08x] %08x %08x %08x %08x | fl=%04x len=%u dlen=%u iph=%08x tso=%u/%u\n",
+						s, w[0], w[1], w[2], w[3],
+						((volatile u16 *)w)[13], w[1], w[2], w[4],
+						((volatile u16 *)w)[11], ((volatile u16 *)w)[12]);
+				}
+			}
+		}
+	}
+
+	// 300 ms later: is anything moving?
+	msleep(300);
+	curtx2 = dma_reg_read(DMA_CUR_TX_DESC_REG);
+	currx2 = dma_reg_read(DMA_CUR_RX_DESC_REG);
+	gmac_state_snap(jobq2, descq2, &pool2);
+	for (i = 0; i < COPRO_CMD_QUEUE_NUM_ENTRIES; i++)
+		if (c[i].opcode_ & (1UL << GMAC_CMD_QUE_OWN_BIT))
+			own_cmd2++;
+	seq_printf(m, "[motion 300ms] TXDMA %08x->%08x (%+d) RXDMA %08x->%08x (%+d)\n",
+		curtx, curtx2, (int)(curtx2 - curtx),
+		currx, currx2, (int)(currx2 - currx));
+	seq_printf(m, "[motion] LEON desc cur %08x->%08x | job proc %08x->%08x comp %08x->%08x | pool %08x->%08x\n",
+		descq[2], descq2[2], jobq[2], jobq2[2], jobq[3], jobq2[3], pool, pool2);
+	seq_printf(m, "[motion] cmd OWN=%d -> %d (%s)\n", own_cmd, own_cmd2,
+		own_cmd2 < own_cmd ? "CoPro drains" : "CoPro NOT draining");
+
+	return 0;
+}
+
+static int gmac_state_proc_init(void)
+{
+	if (!gmac_leon_state) {
+		gmac_leon_state = ioremap(GMAC_LEON_STATE_PA, GMAC_LEON_STATE_SZ);
+		if (IS_ERR(gmac_leon_state))
+			gmac_leon_state = NULL;
+	}
+	if (!proc_create_single("gmac_state", 0, NULL, gmac_state_show))
+		gmac_warn("failed to create /proc/gmac_state\n");
+	return 0;
+}
+
+static void gmac_state_proc_exit(void)
+{
+	remove_proc_entry("gmac_state", NULL);
+	if (gmac_leon_state) {
+		iounmap(gmac_leon_state);
+		gmac_leon_state = NULL;
+	}
+}
+
+#endif // CONFIG_LEON_COPRO
+
+static int gmac_probe(struct net_device *netdev)
+{
+	int err = 0;
+	u32 version;
+	unsigned synopsis_version;
+	unsigned vendor_version;
+
+	// Enable the clock to the MAC block
+	oxnas_sys_write(SYS_CTRL_CKEN_SET_CTRL, 1UL << SYS_CTRL_CKEN_MAC_BIT);
+
+	// Ensure the MAC block is properly reset
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_MAC_BIT);
+	mdelay(1);
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_MAC_BIT);
+
+	// Ensure reset and clock operations are complete
+	wmb();
+
+	// Initialize the ethernet device with std. contents
+	ether_setup(netdev);
+
+	// No debug messages allowed
+	gmac_priv->msg_level = 0UL;
+
+	// Initialize the PHY access lock
+	spin_lock_init(&gmac_priv->phy_lock);
+
+	// Set hardware device base addresses
+	gmac_priv->macBase = netdev->base_addr + MAC_BASE_OFFSET;
+	gmac_priv->dmaBase = netdev->base_addr + DMA_BASE_OFFSET;
+
+	// Lock protecting access to CoPro command queue functions or direct access
+	// to the GMAC interrupt enable register if CoPro is not in use
+	spin_lock_init(&gmac_priv->cmd_que_lock_);
+
+#ifdef CONFIG_LEON_COPRO
+	sema_init(&gmac_priv->copro_stop_semaphore_, 0);
+	sema_init(&gmac_priv->copro_start_semaphore_, 0);
+	sema_init(&gmac_priv->copro_int_clr_semaphore_, 0);
+	sema_init(&gmac_priv->copro_update_semaphore_, 0);
+	sema_init(&gmac_priv->copro_rx_enable_semaphore_, 0);
+	sema_init(&gmac_priv->copro_stop_complete_semaphore_, 0);
+#endif // CONFIG_LEON_COPRO
+
+	timer_setup(&gmac_priv->watchdog_timer, watchdog_timer_action, 0);
+
+	// Do something here to detect the present or otherwise of the MAC
+	// Read the version register as a first test
+	version = mac_reg_read(MAC_VERSION_REG);
+	synopsis_version = version & 0xff;
+	vendor_version = (version >> 8) & 0xff;
+
+	// Tell the kernel of our MAC address
+	eth_hw_addr_set(netdev, mac_adr);
+
+	netdev->netdev_ops = &gmac_ops;
+
+	netdev->watchdog_timeo = 1 * HZ;
+
+	// Initialize NAPI support
+	netif_napi_add(netdev, &gmac_priv->txrx_napi, &gmac_poll_txrx);
+
+	set_ethtool_ops(netdev);
+
+#ifdef GMAC_DEBUG
+	netdev->flags |= IFF_DEBUG;
+#endif
+
+#if defined(CONFIG_LEON_COPRO) && defined(CONFIG_LEON_OFFLOAD_TX)
+	// Do Tx H/W checksum and SG list processing
+	netdev->features |= NETIF_F_HW_CSUM;
+//	netdev->features |= NETIF_F_IP_CSUM;
+	netdev->features |= NETIF_F_SG;
+	// Do hardware TCP/IP Segmentation Offload
+	netdev->features |= NETIF_F_TSO;
+#ifdef SUPPORT_IPV6
+//	netdev->features |= NETIF_F_IPV6_CSUM;
+	netdev->features |= NETIF_F_TSO6;
+#endif
+#elif !defined(CONFIG_LEON_COPRO)
+	// Do Tx H/W checksum and SG list processing
+	netdev->features |= NETIF_F_HW_CSUM;
+//	netdev->features |= NETIF_F_IP_CSUM;
+	netdev->features |= NETIF_F_SG;
+#ifdef SUPPORT_IPV6
+//	netdev->features |= NETIF_F_IPV6_CSUM;
+#endif
+#endif // CONFIG_LEON_COPRO && CONFIG_LEON_OFFLOAD_TX
+
+#ifdef USE_RX_CSUM
+	netdev->features |= NETIF_F_RXCSUM;
+#endif
+//	netdev->features |= NETIF_F_SG;
+
+	netdev->hw_features = netdev->features;
+
+	// Initialize PHY support
+	gmac_priv->using_100     = 0;
+	gmac_priv->using_1000    = 1;
+	gmac_priv->using_pause   = 1;
+	gmac_priv->mii_full_duplex   = 1;
+#ifndef CONFIG_SYNOPSYS_GMAC_PHYLIB
+	gmac_priv->mii.dev           = netdev;
+	gmac_priv->mii.mdio_read     = gmac_phy_read;
+	gmac_priv->mii.mdio_write    = gmac_phy_write;
+	gmac_priv->mii.phy_id_mask   = 0x1f;
+	gmac_priv->mii.reg_num_mask  = 0x1f;
+	gmac_priv->mii.force_media   = 0;
+	gmac_priv->mii.full_duplex   = 1;
+#endif
+
+	gmac_priv->gmii_csr_clk_range = 5;   // Slowest for now
+
+	// Use simple mux for 25/125 Mhz clock switching and
+	// enable GMII_GTXCLK to follow GMII_REFCLK - required for gigabit PHY
+	oxnas_sys_andor(SYS_CTRL_GMAC_CTRL, ~0UL, (1UL << SYS_CTRL_GMAC_SIMPLE_MUX_BIT) | (1UL << SYS_CTRL_GMAC_CKEN_GTX_BIT));
+
+#ifdef CONFIG_SYNOPSYS_GMAC_PHYLIB
+	err = gmac_mdio_register();
+	if (err) {
+		goto probe_err_out;
+	}
+
+	err = gmac_phy_connect(netdev);
+	if (err) {
+		goto probe_err_out;
+	}
+#else // CONFIG_SYNOPSYS_GMAC_PHYLIB
+	// Remember whether auto-negotiation is allowed
+#ifdef ALLOW_AUTONEG
+	gmac_priv->ethtool_cmd.autoneg = 1;
+	gmac_priv->ethtool_pauseparam.autoneg = 1;
+#else
+	gmac_priv->ethtool_cmd.autoneg = 0;
+	gmac_priv->ethtool_pauseparam.autoneg = 0;
+#endif
+
+	// Set up PHY mode for when auto-negotiation is not allowed
+	gmac_priv->ethtool_cmd.speed = SPEED_1000;
+	gmac_priv->ethtool_cmd.duplex = DUPLEX_FULL;
+	gmac_priv->ethtool_cmd.port = PORT_MII;
+	gmac_priv->ethtool_cmd.transceiver = XCVR_INTERNAL;
+
+	// We can support both reception and generation of pause frames
+	gmac_priv->ethtool_pauseparam.rx_pause = 1;
+	gmac_priv->ethtool_pauseparam.tx_pause = 1;
+
+	// Initialize the set of features we would like to advertise as being
+	// available for negotiation
+	gmac_priv->ethtool_cmd.advertising = ADVERTISED_10baseT_Half
+		| ADVERTISED_10baseT_Full
+		| ADVERTISED_100baseT_Half
+		| ADVERTISED_100baseT_Full
+		| ADVERTISED_1000baseT_Half
+		| ADVERTISED_1000baseT_Full
+		| ADVERTISED_Autoneg
+		| ADVERTISED_MII;
+
+	// Attempt to locate the PHY
+	phy_detect(netdev);
+	gmac_priv->ethtool_cmd.phy_address = gmac_priv->mii.phy_id;
+
+	// Did we find a PHY?
+	if (gmac_priv->phy_type == PHY_TYPE_NONE) {
+		gmac_err("No PHY found\n");
+		err = ENXIO;
+		goto probe_err_out;
+	}
+
+	// Setup the PHY
+	initialize_phy();
+
+	// Find out what modes the PHY supports
+	gmac_priv->ethtool_cmd.supported = get_phy_capabilies();
+
+	gmac_priv->mii.supports_gmii = (gmac_priv->mii.mdio_read(gmac_priv->mii.dev, gmac_priv->mii.phy_id, MII_BMSR) & BMSR_ESTATEN) ? 1 : 0;
+#endif // CONFIG_SYNOPSYS_GMAC_PHYLIB
+
+	// Register the device with the network intrastructure
+	err = register_netdev(netdev);
+	if (err) {
+		gmac_err("Failed to register device\n");
+		goto probe_err_out;
+	}
+
+	gmac_state_proc_init();
+	INIT_WORK(&gmac_tx_hang_reset_work, gmac_tx_hang_reset);
+
+	// Record details about the hardware we found
+	gmac_info("GMAC version=%u, vendor=%u, iomap=0x%08X\n",
+		synopsis_version, vendor_version, (u32)netdev->base_addr);
+#ifdef CONFIG_SYNOPSYS_GMAC_PHYLIB
+	gmac_info("Found PHY: %s at addr %u, type 0x%08X\n",
+		gmac_priv->phydev && gmac_priv->phydev->drv ? gmac_priv->phydev->drv->name : "Generic PHY",
+		gmac_priv->phydev ? gmac_priv->phydev->mdio.addr : 0,
+		gmac_priv->phydev ? gmac_priv->phydev->phy_id : 0);
+#else // CONFIG_SYNOPSYS_GMAC_PHYLIB
+	gmac_info("Found PHY: %s at addr %u, type 0x%08X -> %s\n", gmac_priv->phy_info, gmac_priv->phy_addr, gmac_priv->phy_type,
+		(gmac_priv->ethtool_cmd.supported & SUPPORTED_1000baseT_Full) ? "10/100/1000" : "10/100");
+#endif
+	gmac_info("Using %u Rx and %u Tx DMA descriptors\n",
+		NUM_RX_DMA_DESCRIPTORS, NUM_TX_DMA_DESCRIPTORS);
+	hw_set_mac_address(netdev->dev_addr);
+	mac_reg_write(MAC_INT_MASK_REG, MAC_INT_DEFAULT_MASK);
+	netdev->min_mtu = MIN_PACKET_SIZE;
+	netdev->max_mtu = MAX_JUMBO;
+
+#ifdef CONFIG_LEON_COPRO
+	// Zeroise the queues, so checks for empty etc will work before storage
+	// for queue entries has been allocated
+	tx_que_init(&gmac_priv->tx_queue_, 0, 0);
+	cmd_que_init(&gmac_priv->cmd_queue_, 0, 0);
+#endif // CONFIG_LEON_COPRO
+
+	gmac_priv->interface_up = 0;
+	return 0;
+
+probe_err_out:
+#ifdef CONFIG_SYNOPSYS_GMAC_PHYLIB
+	// undo the phylib attach and the MDIO bus
+	gmac_phy_disconnect(netdev);
+	gmac_mdio_unregister();
+#endif // CONFIG_SYNOPSYS_GMAC_PHYLIB
+#ifdef CONFIG_LEON_COPRO
+	shutdown_copro();
+#endif
+
+	// Disable the clock to the MAC block
+	oxnas_sys_write(SYS_CTRL_CKEN_CLR_CTRL, 1UL << SYS_CTRL_CKEN_MAC_BIT);
+
+	return err;
+}
+
+static int __init gmac_module_init(void)
+{
+	struct net_device *netdev = NULL;
+	void __iomem *port_base = NULL;
+	int err = platform_driver_register(&plat_driver);
+
+	if (err) {
+		gmac_err("Failed to register platform driver\n");
+		return err;
+	}
+
+	// Ensure all of the device private data are zero, so we can clean up in
+	// the event of a later failure to initialize all fields
+	// Will allocate private data later, as may want descriptors etc in special memory
+#ifdef CONFIG_DRIVERS_PRIVATE_IN_SRAM
+	netdev = alloc_etherdev(0);
+#else
+	netdev = alloc_etherdev(sizeof(gmac_priv_t) + NUM_DMA_DESCRIPTORS * sizeof(gmac_dma_desc_t));
+#endif
+	if (netdev == NULL) {
+		gmac_err("Failed to allocate ethernet device\n");
+		err = -ENOMEM;
+		goto init_err;
+	}
+#ifdef CONFIG_DRIVERS_PRIVATE_IN_SRAM
+	gmac_priv = oxnas_sram_zalloc(sizeof(gmac_priv_t) + NUM_DMA_DESCRIPTORS * sizeof(gmac_dma_desc_t), NULL);
+	if (gmac_priv == NULL) {
+		gmac_err("Failed to allocate %u bytes for private data\n", sizeof(gmac_priv_t));
+		err = -ENOMEM;
+		goto init_err;
+	}
+#else
+	gmac_priv = netdev_priv(netdev);
+#endif
+	gmac_priv->shadow_descriptors = (void *)(gmac_priv + 1);
+
+	// Set pointer to device in private data
+	gmac_priv->netdev = netdev;
+
+	sprintf(netdev->name, "eth%d", 0);
+
+	if (!oxnas_ioremap(&port_base, MAC_BASE_PA, GMAC_REGS_SIZE)) {
+		gmac_err("Failed to map registers region\n");
+		err = -EBUSY;
+		goto init_err;
+	}
+	netdev->base_addr = (u32)port_base;
+	netdev->irq = MAC_INTERRUPT;
+
+	err = gmac_probe(netdev);
+	if (err) {
+		gmac_err("Probing failed, err=%d\n", err);
+		goto init_err;
+	}
+
+#ifdef CONFIG_LEON_COPRO
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_COPRO_BIT);
+	oxnas_sys_write(SYS_CTRL_SEMA_CLR_CTRL, SEM_INTA_MASK | SEM_INTB_MASK);
+	wmb();
+
+	// Register ISRs for the semaphore register interrupt sources, which will
+	// originate from the CoPro
+	if (devm_request_irq(&netdev->dev, SEM_A_INTERRUPT, &gmac_common_irq_handler, IRQF_IRQPOLL, "SEMA", netdev)) {
+		gmac_err("Failed to allocate IRQ %u for semaphore A\n", SEM_A_INTERRUPT);
+		err = -ENODEV;
+		goto init_err;
+	}
+
+	if (devm_request_irq(&netdev->dev, SEM_B_INTERRUPT, &gmac_common_irq_handler, IRQF_IRQPOLL, "SEMB", netdev)) {
+		gmac_err("Failed to allocate IRQ %u for semaphore B\n", SEM_B_INTERRUPT);
+		err = -ENODEV;
+		goto init_err;
+	}
+#else // CONFIG_LEON_COPRO
+	// Allocate the IRQ
+	if (devm_request_irq(&netdev->dev, netdev->irq, &gmac_common_irq_handler, IRQF_IRQPOLL, netdev->name, netdev)) {
+		gmac_err("Failed to allocate IRQ %u\n", netdev->irq);
+		err = -ENODEV;
+		goto init_err;
+	}
+#endif // CONFIG_LEON_COPRO
+
+	netdev->dev.dma_mask = &oxnas_dma_mask;
+	netdev->dev.coherent_dma_mask = OXNAS_MAX_DMA_ADDRESS;
+
+#ifdef CONFIG_DESCRIPTORS_IN_SRAM
+	gmac_priv->descriptors = oxnas_sram_zalloc(OXNAS_SRAM_GMAC_DESCRIPTORS_SIZE, &gmac_priv->descriptors_phys);
+#else
+	gmac_priv->descriptors = dma_alloc_coherent(
+		&netdev->dev, OXNAS_SRAM_GMAC_DESCRIPTORS_SIZE, &gmac_priv->descriptors_phys, GFP_KERNEL);
+#endif
+	if (gmac_priv->descriptors == NULL) {
+		gmac_err("Failed to allocate %u bytes for GMAC descriptors\n", (u32)OXNAS_SRAM_GMAC_DESCRIPTORS_SIZE);
+		err = -ENODEV;
+		goto init_err;
+	}
+
+	return 0;
+
+init_err:
+	if (gmac_priv != NULL) {
+		if (netdev != NULL) {
+			if (netdev->base_addr != 0) {
+				iounmap((void __iomem *)netdev->base_addr);
+				netdev->base_addr = 0;
+			}
+			if (netdev->reg_state != NETREG_RELEASED) {
+				if (netdev->reg_state != NETREG_UNREGISTERED) {
+					unregister_netdev(netdev);
+					netdev->reg_state = NETREG_UNREGISTERED;
+				}
+				free_netdev(netdev);
+			}
+		}
+		gmac_priv = NULL;
+	}
+	platform_driver_unregister(&plat_driver);
+
+	return err;
+}
+module_init(gmac_module_init);
+
+static void __exit gmac_module_cleanup(void)
+{
+	cancel_work_sync(&gmac_tx_hang_reset_work);
+
+	if (gmac_priv != NULL) {
+		struct net_device *netdev = gmac_priv->netdev;
+
+#ifdef CONFIG_SYNOPSYS_GMAC_PHYLIB
+		/* PATCH PHYLIB: detach the PHY and remove the MDIO bus */
+		gmac_phy_disconnect(netdev);
+		gmac_mdio_unregister();
+#endif // CONFIG_SYNOPSYS_GMAC_PHYLIB
+
+		if (netdev->base_addr != 0) {
+#ifdef CONFIG_LEON_COPRO
+			devm_free_irq(&netdev->dev, SEM_A_INTERRUPT, netdev);
+			devm_free_irq(&netdev->dev, SEM_B_INTERRUPT, netdev);
+#else // CONFIG_LEON_COPRO
+			devm_free_irq(&netdev->dev, netdev->irq, netdev);
+#endif // CONFIG_LEON_COPRO
+			iounmap((void __iomem *)netdev->base_addr);
+			netdev->base_addr = 0;
+		}
+		unregister_netdev(netdev);
+		netdev->reg_state = NETREG_UNREGISTERED;
+		gmac_priv->netdev = NULL;
+		free_netdev(netdev);
+		gmac_state_proc_exit();
+
+		platform_driver_unregister(&plat_driver);
+		gmac_priv = NULL;
+	}
+}
+module_exit(gmac_module_cleanup);
