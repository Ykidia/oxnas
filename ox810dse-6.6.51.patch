+	},
+	{ },
+};
+
+MODULE_DEVICE_TABLE(of, ehci_hcd_oxnas_match);
+#endif
+
+static struct platform_driver ehci_hcd_oxnas_driver = {
+	.driver = {
+		.name = DRIVER_NAME,
+		.owner = THIS_MODULE,
+		.of_match_table = of_match_ptr(ehci_hcd_oxnas_match),
+	},
+	.probe = ehci_hcd_oxnas_drv_probe,
+	.remove = ehci_hcd_oxnas_drv_remove,
+	.shutdown = usb_hcd_platform_shutdown,
+};
+
+module_platform_driver(ehci_hcd_oxnas_driver);
