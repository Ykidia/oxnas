--- a/drivers/net/ethernet/synopsys/gmac/gmac_offload.c	1970-01-01 03:00:00.000000000 +0300
+++ b/drivers/net/ethernet/synopsys/gmac/gmac_offload.c	2026-11-20 23:34:24.000000000 +0300
@@ -0,0 +1,232 @@
+/*
+ * linux/arch/arm/mach-oxnas/gmac-offload.c
+ *
