+/** 
+ * Shared between all DMA interrupts and run with interrupts enabled,
+ * thus any access to shared data structures must be sync'ed
+ */
+static irqreturn_t oxnas_dma_irq_handler(int irq, void *dev_id)
+{
+	// dev_id IS the channel pointer (see the request_irq in oxnas_dma_init())
+	oxnas_adma_channel_t *const channel = dev_id;
+	const unsigned channel_number = channel->common.chan_id;
+	u32 lim = 1UL << 20;
+
+	if (WARN_ON_ONCE(channel_number != 4 && irq != DMA_INTERRUPT_0 + channel_number))
+		return IRQ_NONE;
+
+	// Only acknowledge interrupts from the channel directly responsible for the
+	// RPS interrupt line which caused the ISR to be entered, to get around the
+	// problem that the SG-DMA controller can only filter DMA interrupts exter-
+	// nally to the DMA controller, i.e. the DMA controller interrupt status
+	// register always shows all active interrupts for all channels, regardless
+	// of whether the SG-DMA controller is filtering them
+
+	// Find the DMA channel that can generate interrupts on the RPS interrupt
+	// line which caused the ISR to be invoked.
+
+	adma_dbg("RPS interrupt %u from channel %u\n", irq, channel_number);
+
+	// Non-SG transfers have no completion status, so initialize
+	// channel's error code to no-error. If transfer turns out to
+	// have been SG, this status will be overwritten
+	channel->error_code_ = 0;
+
+	// Cope with the DMA controller's ability to have a pair of chained
+	// transfers which have both completed, which causes the interrupt request
+	// to stay active until both have been acknowledged, which is causing the SG
+	// controller problems
+	while (oxnas_dma_iochannel_read(0, DMA_INTR_ID) & (1UL << channel_number)) {
+		// Write to the interrupt clear register to clear interrupt
+		oxnas_dma_iochannel_andor(channel_number, DMA_INTR_CLEAR_REG, 0, 0);
+		if (--lim == 0) {
+			adma_err("could not clear interrupt for channel %u\n", channel_number);
+			break;
+		}
+	}
+
+	// If was a SG transfer, record the completion status
+	if (likely(channel->sg_info_->p_srcEntries_)) {
+		// Record the SG transfer completion status
+		u32 error_code = oxnas_dma_iosgchannel_read(channel_number, DMA_SG_STATUS);
+		channel->error_code_ = (error_code >> DMA_SG_STATUS_ERROR_CODE_BIT)
+			& ((1UL << DMA_SG_STATUS_ERROR_CODE_NUM_BITS) - 1);
+
+		adma_dbg("return SG controller to idle, error_code=0x%08x\n", error_code);
+		// Return the SG DMA controller to the IDLE state and clear any SG
+		// controller error interrupt
+		oxnas_dma_iosgchannel_andor(channel_number, DMA_SG_STATUS, 0, 1);
+
+		// Zeroise SG DMA descriptor info
+		channel->sg_info_->p_srcEntries_ = 0;
+		channel->sg_info_->p_dstEntries_ = 0;
+	}
+
+	atomic_set(&channel->active_count_, 0);
+
+	// If there is a callback registered, notify the user that the
+	// transfer is complete
+	if (channel->callback_ != NULL) {
+		(*channel->callback_)(channel->callback_param_);
+	}
+
+	return IRQ_HANDLED;
+}
+
+static void oxnas_dma_reset_assert(void)
+{
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_DMA_BIT);
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_SGDMA_BIT);
+	wmb();
+}
+
+static void oxnas_dma_reset_deassert(void)
+{
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_DMA_BIT);
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_SGDMA_BIT);
+	wmb();
+}
+
+static void oxnas_dma_clock_disable(void)
+{
+	oxnas_sys_write(SYS_CTRL_CKEN_CLR_CTRL, 1UL << SYS_CTRL_CKEN_DMA_BIT);
+	wmb();
+}
+
+static void oxnas_dma_clock_enable(void)
+{
+	oxnas_sys_write(SYS_CTRL_CKEN_SET_CTRL, 1UL << SYS_CTRL_CKEN_DMA_BIT);
+	wmb();
+}
