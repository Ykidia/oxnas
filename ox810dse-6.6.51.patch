+static struct semaphore start_sem;
+static struct semaphore heartbeat_sem;
+
+void start_callback(volatile gmac_cmd_que_ent_t *entry)
+{
+	gmac_info("START callback, operand = 0x%08x\n", entry->operand_);
+	up(&start_sem);
+}
+
+void heartbeat_callback(volatile gmac_cmd_que_ent_t *entry)
+{
+	gmac_info("Heartbeat callback, operand = 0x%08x\n", entry->operand_);
+	up(&heartbeat_sem);
+}
+
+static void gmac_test_copro(void)
+{
+	sema_init(&start_sem, 0);
+	sema_init(&heartbeat_sem, 0);
+
+	cmd_que_queue_cmd(&gmac_priv->cmd_queue_, GMAC_CMD_STOP, 0, copro_ack_noop_callback);
+	oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+	cmd_que_queue_cmd(&gmac_priv->cmd_queue_, GMAC_CMD_START, 0, start_callback);
+	oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+	cmd_que_queue_cmd(&gmac_priv->cmd_queue_, GMAC_CMD_HEARTBEAT, 0, heartbeat_callback);
+	oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+
+	gmac_info("Waiting for start ack...\n");
+	if (down_timeout(&start_sem, COPRO_GENERAL_TIMEOUT) == -ETIME)
+		gmac_warn("...timeout!\n");
+	else
+		gmac_info("Start ack received\n");
+	gmac_info("Waiting for heartbeat ack...\n");
+	if (down_timeout(&heartbeat_sem, COPRO_GENERAL_TIMEOUT) == -ETIME)
+		gmac_warn("...timeout!\n");
+	else
+		gmac_info("Heartbeat ack received\n");
+
+	cmd_que_queue_cmd(&gmac_priv->cmd_queue_, GMAC_CMD_STOP, 0, copro_stop_callback);
+	oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+	if (down_timeout(&gmac_priv->copro_stop_semaphore_, COPRO_GENERAL_TIMEOUT) == -ETIME)
+		gmac_warn("Timeout CoPro stop acknowledge\n");
+	// Wait until the CoPro acknowledges that it has completed stopping
+	if (down_timeout(&gmac_priv->copro_stop_complete_semaphore_, COPRO_GENERAL_TIMEOUT) == -ETIME)
+		gmac_warn("Timeout stopping CoPro\n");
+
+	// Need full reinit after GMAC_CMD_STOP
+	gmac_init_copro();
+}
