+static void __init oxnas_setup_uarts(void)
+{
+#ifndef ARCH_OXNAS_NO_UART
+	uint uart_lines[4] = { 0, 1, 2, 3 };
+	uint uart_line_index = 0;
+	uint uart_line_system = 0;	// ttyS0
+	const uint uart_line_selected = CONFIG_ARCH_OXNAS_CONSOLE_UART - 1;
+	struct uart_port s;
+
+	if (uart_line_system != uart_line_selected) {
+		uint line = uart_lines[uart_line_system];
+		uart_lines[uart_line_system] = uart_lines[uart_line_selected];
+		uart_lines[uart_line_selected] = line;
+	}
+
+	memset(&s, 0, sizeof(s));
+	s.flags = UPF_BOOT_AUTOCONF | UPF_SKIP_TEST/* | UPF_AUTO_IRQ*/ | UPF_IOREMAP;
+	s.iotype = UPIO_MEM;
+	s.uartclk = NOMINAL_SYSCLK;
+	s.mapsize = SZ_4K;
+	s.irqflags = IRQF_SHARED;	/* GPIO bank lines are shared (buttons) */
+	s.type = PORT_16550A;
+	s.fifosize = 16;
+
+#if defined(CONFIG_ARCH_OXNAS_UART1) || (CONFIG_ARCH_OXNAS_CONSOLE_UART == 1)
+#if (CONFIG_ARCH_OXNAS_CONSOLE_UART != 1)
+	// Block reset UART1
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_UART1_BIT);
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_UART1_BIT);
+
+	// Route UART1 SOUT onto external pin
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0x80000000, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~0x80000000, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~0UL, 0x80000000);
+
+	// Route UART1 SIN onto external pin
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_1, ~0x00000001, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_1, ~0x00000001, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_1, ~0UL, 0x00000001);
+
+	// Setup GPIO line direction for UART1 SOUT
+	oxnas_gpio_andor(GPIO_A_OUTPUT_ENABLE_SET, ~0UL, 0x80000000);
+
+	// Setup GPIO line direction for UART1 SIN
+	oxnas_gpio_andor(GPIO_B_OUTPUT_ENABLE_CLEAR, ~0UL, 0x00000001);
+#endif
+
+#ifdef CONFIG_ARCH_OXNAS_UART1_MODEM
+	// Route UART1 modem control lines onto external pins
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0x78000000, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~0x78000000, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~0UL, 0x78000000);
+
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_1, ~0x00000006, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_1, ~0x00000006, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_1, ~0UL, 0x00000006);
+
+	// Setup GPIO line directions for UART1 modem control lines
+	oxnas_gpio_andor(GPIO_A_OUTPUT_ENABLE_SET, ~0UL, 0x08000000);
+	oxnas_gpio_andor(GPIO_A_OUTPUT_ENABLE_CLEAR, ~0UL, 0x70000000);
+
+	oxnas_gpio_andor(GPIO_B_OUTPUT_ENABLE_SET, ~0UL, 0x00000004);
+	oxnas_gpio_andor(GPIO_B_OUTPUT_ENABLE_CLEAR, ~0UL, 0x00000002);
+#endif // CONFIG_ARCH_OXNAS_UART1_MODEM
+
+	// Give Linux a contiguous numbering scheme for available UARTs
+	s.mapbase = UART_1_BASE_PA;
+	s.irq = UART_1_INTERRUPT;
+	s.line = uart_lines[uart_line_index++];
+	early_serial_setup(&s);
+#endif // CONFIG_ARCH_OXNAS_UART1
+
+#if defined(CONFIG_ARCH_OXNAS_UART2) || (CONFIG_ARCH_OXNAS_CONSOLE_UART == 2)
+#if (CONFIG_ARCH_OXNAS_CONSOLE_UART != 2)
+	// Block reset UART2
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_UART2_BIT);
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_UART2_BIT);
+
+	// Route UART2 SIN/SOUT onto external pin
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0x00500000, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~0x00500000, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~0UL, 0x00500000);
+
+	// Setup GPIO line directions for UART2 SIN/SOUT
+	oxnas_gpio_andor(GPIO_A_OUTPUT_ENABLE_SET, ~0UL, 0x00100000);
+	oxnas_gpio_andor(GPIO_A_OUTPUT_ENABLE_CLEAR, ~0UL, 0x00400000);
+#endif
+
+#ifdef CONFIG_ARCH_OXNAS_UART2_MODEM
+	// Route UART2 modem control lines onto external pins
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0x07800300, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~0x07800300, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~0UL, 0x07800300);
+
+	// Setup GPIO line directions for UART2 modem control lines
+	oxnas_gpio_andor(GPIO_A_OUTPUT_ENABLE_SET, ~0UL, 0x02000200);
+	oxnas_gpio_andor(GPIO_A_OUTPUT_ENABLE_CLEAR, ~0UL, 0x05800100);
+#endif // CONFIG_ARCH_OXNAS_UART2_MODEM
+
+	// Give Linux a contiguous numbering scheme for available UARTs
+	s.mapbase = UART_2_BASE_PA;
+	s.irq = UART_2_INTERRUPT;
+	s.line = uart_lines[uart_line_index++];
+	early_serial_setup(&s);
+#endif // CONFIG_ARCH_OXNAS_UART2
+
+#if defined(CONFIG_ARCH_OXNAS_UART3) || (CONFIG_ARCH_OXNAS_CONSOLE_UART == 3)
+#if (CONFIG_ARCH_OXNAS_CONSOLE_UART != 3)
+	// Block reset UART3
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_UART3_BIT);
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_UART3_BIT);
+
+	// Route UART3 SIN/SOUT onto external pin
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0x000000C0, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~0x000000C0, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~0UL, 0x000000C0);
+
+	// Setup GPIO line directions for UART3 SIN/SOUT
+	oxnas_gpio_andor(GPIO_A_OUTPUT_ENABLE_SET, ~0UL, 0x00000080);
+	oxnas_gpio_andor(GPIO_A_OUTPUT_ENABLE_CLEAR, ~0UL, 0x00000040);
+
+	// Enable UART3 interrupt
+	oxnas_sys_andor(SYS_CTRL_UART_CTRL, ~0UL, 1UL << SYS_CTRL_UART3_IQ_EN_BIT);
+#endif
+
+#ifdef CONFIG_ARCH_OXNAS_UART3_MODEM
+	// Route UART3 modem control lines onto external pins
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0x0000003f, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~0x0000003f, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~0UL, 0x0000003f);
+
+	// Setup GPIO line directions for UART3 modem control lines
+	oxnas_gpio_andor(GPIO_A_OUTPUT_ENABLE_SET, ~0UL, 0x00000030);
+	oxnas_gpio_andor(GPIO_A_OUTPUT_ENABLE_CLEAR, ~0UL, 0x0000000f);
+#endif // CONFIG_ARCH_OXNAS_UART3_MODEM
+
+	// Give Linux a contiguous numbering scheme for available UARTs
+	s.mapbase = UART_3_BASE_PA;
+	s.irq = UART_3_INTERRUPT;
+	s.line = uart_lines[uart_line_index++];
+	early_serial_setup(&s);
+#endif // CONFIG_ARCH_OXNAS_UART3
+
+#if defined(CONFIG_ARCH_OXNAS_UART4) || (CONFIG_ARCH_OXNAS_CONSOLE_UART == 4)
+	// Block reset UART4
+	oxnas_sys_write(SYS_CTRL_RSTEN_SET_CTRL, 1UL << SYS_CTRL_RSTEN_UART4_BIT);
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_UART4_BIT);
+
+	// Enable UART4 interrupt
+	oxnas_sys_andor(SYS_CTRL_UART_CTRL, ~0UL, 1UL << SYS_CTRL_UART4_IQ_EN_BIT);
+
+	// Enable UART4 to override PCI functions onto GPIOs
+	oxnas_sys_andor(SYS_CTRL_UART_CTRL, ~0UL, 1UL << SYS_CTRL_UART4_NOT_PCI_MODE_BIT);
+
+	s.mapbase = UART_4_BASE_PA;
+	s.irq = UART_4_INTERRUPT;
+	s.line = uart_lines[uart_line_index++];
+	early_serial_setup(&s);
+#endif // CONFIG_ARCH_OXNAS_UART4
+
+#endif // ARCH_OXNAS_NO_UART
+}
