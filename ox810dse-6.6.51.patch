+static struct file_operations oxsemi_therm_miscdev_fops = {
+	.owner		= THIS_MODULE,
+	.open		= nonseekable_open,
+};
+
+static struct proc_ops oxsemi_therm_fan_fops = {
+	.proc_open	= oxsemi_therm_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
+static struct miscdevice oxsemi_therm_miscdev = {
+	TEMP_MINOR,
+	"temp",
+//	&oxsemi_temp_fops,
+	&oxsemi_therm_miscdev_fops,
+};
+
+static int __init oxsemi_therm_init(void)
+{
+	struct thermostat* th;
+	int rc, ret;
+
+	if (thermostat)
+		return 0;
+
+	oxnas_sys_read(SYS_CTRL_RSTEN_CTRL);
+
+/* release fan/tacho from system reset */
+	oxnas_sys_write(SYS_CTRL_RSTEN_CLR_CTRL, 1UL << SYS_CTRL_RSTEN_MISC_BIT);
+
+/* Pull Down the GPIO 29 from the software */
+	oxnas_sys_andor(SYS_CTRL_GPIO_PULLUP_CTRL_0, ~0UL, TEMP_TACHO_PULLUP_CTRL_VALUE);
+
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~(1UL << QUAD_FUNCTION_ENABLE_FAN_PWM), 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PRIMARY_FUNCTION_ENABLE_FAN_TACHO);
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~0UL, 1UL << PRIMARY_FUNCTION_ENABLE_FAN_TEMP);
+
+/* disable secondary use */
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~(1UL << QUAD_FUNCTION_ENABLE_FAN_PWM), 0);
+
+/* disable tertiary use */
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~(1UL << QUAD_FUNCTION_ENABLE_FAN_PWM), 0);
+
+/* disable quadinary use */
+	oxnas_sys_andor(SYS_CTRL_GPIO_PWMSEL_CTRL_0, ~0UL, 1UL << QUAD_FUNCTION_ENABLE_FAN_PWM);
+
+	oxnas_sys_read(SYS_CTRL_RSTEN_CTRL);
+	oxnas_sys_read(SYS_CTRL_GPIO_PRIMSEL_CTRL_0);
+	oxnas_sys_read(SYS_CTRL_GPIO_SECSEL_CTRL_0);
+	oxnas_sys_read(SYS_CTRL_GPIO_TERTSEL_CTRL_0);
+
+	th = (struct thermostat *)
+		kmalloc(sizeof(struct thermostat), GFP_KERNEL);
+
+	if (!th)
+		return -ENOMEM;
+
+	fanmon_regs_base = (u32)ioremap(FAN_MON_BASE_PA, 0x100000);
+	if (!fanmon_regs_base) {
+		printk(KERN_ERR "thermAndFan: Thermostat failed to ioremap FAN_MON_BASE_PA");
+		kfree(th);
+		return -ENODEV;
+	}
+
+	memset(th, 0, sizeof(struct thermostat));
+	sema_init(&th->sem, 1);
+
+	rc = oxnas_fanmon_read(TACHO_CLOCK_DIVIDER);
+	if (rc < 0) {
+		printk(KERN_ERR "thermAndFan: Thermostat failed to read config ");
+		kfree(th);
+		return -ENODEV;
+	}
+
+	/* Set the Tacho clock divider up */
+	oxnas_fanmon_write(TACHO_CLOCK_DIVIDER, TACHO_CORE_TACHO_DIVIDER_VALUE);
+
+	/* check tacho divider set correctly */
+	rc = oxnas_fanmon_read(TACHO_CLOCK_DIVIDER);
+	/* Comparing a 10 bit value to a 32 bit return value */
+	if ((rc & TACHO_CORE_TACHO_DIVIDER_VALUE) != TACHO_CORE_TACHO_DIVIDER_VALUE) {
+		printk(KERN_ERR "thermAndFan: Set Tacho Divider Value Failed readback:%d\n", rc);
+		kfree(th);
+		return -ENODEV;
+	}
+
+	oxnas_pwm_write(PWM_CLOCK_REGISTER, PWM_CORE_CLK_DIVIDER_VALUE);
+
+	printk(KERN_INFO "thermAndFan: initializing - ox810\n");
+
+#ifdef DEBUG
+	DumpTachoRegisters();
+#endif
+
+	thermostat = th;
+
+	/* Start the thermister measuring */
+	oxnas_fanmon_write(TACHO_THERMISTOR_CONTROL, (1 << TACHO_THERMISTOR_CONTROL_THERM_ENABLE));
+
+	/* Start Speed measuring */
+	oxnas_fanmon_write(TACHO_FAN_SPEED_CONTROL,
+			(1 << (TACHO_FAN_SPEED_CONTROL_PWM_ENABLE_BASE
+							+ TACHO_FAN_SPEED_CONTROL_PWM_USED))
+				| (1 << TACHO_FAN_SPEED_CONTROL_FAN_COUNT_MODE));
+
+	/* be sure to really write fan speed the first time */
+	th->last_speed    = -2;
+	th->last_var	  = -80;
+
+	/* Set fan to initial speed */
+	write_fan_speed(th, min_fan_speed_ratio);
+
+	thread_therm = kthread_run(monitor_task, th, "kfand");
+
+	if (thread_therm == ERR_PTR(-ENOMEM)) {
+		printk(KERN_INFO "thermAndFan: Kthread creation failed\n");
+		thread_therm = NULL;
+		return -ENOMEM;
+	}
+
+	ret = misc_register(&oxsemi_therm_miscdev);
+	if (ret < 0)
+		return ret;
+
+	proc_oxsemi_therm = proc_create("therm-fan", S_IRUGO, NULL, &oxsemi_therm_fan_fops);
+	if (proc_oxsemi_therm) {
+//		proc_oxsemi_therm->read_proc = oxsemi_therm_read;
+	} else {
+		printk(KERN_ERR "therm-fan: unable to register /proc/therm\n");
+	}
+
+	return 0;
+}
+
+
+static void __exit oxsemi_therm_exit(void)
+{
+	if ( thread_therm )
+	{
+		kthread_stop(thread_therm);
+	}
+
+	/* Stop the fan so that it doesnot run anymore - dont reset
+	 * SYS_CTRL_RSTEN_MISC_BIT as other modules may use it
+	 */
+	write_fan_speed(thermostat, 0);
+
+	remove_proc_entry("therm-fan", NULL);
+	misc_deregister(&oxsemi_therm_miscdev);
+
+	kfree(thermostat);
+	thermostat = NULL;
+
+}
+
+
+module_init(oxsemi_therm_init);
+module_exit(oxsemi_therm_exit);
+
