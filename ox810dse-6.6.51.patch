+	printk(KERN_DEBUG "PWM registers remapped:    from 0x%08X to 0x%08X\n", PWM_BASE_PA, (u32)pwm_regs_base);
+	cached_sram_base
+#if defined(CONFIG_DRIVERS_PRIVATE_IN_SRAM) && !defined(CONFIG_DESCRIPTORS_IN_SRAM)
+		= ioremap_cache(SRAM_BASE_PA, OXNAS_SRAM_SIZE);
+#else
+		= ioremap_wc(SRAM_BASE_PA, OXNAS_SRAM_SIZE);
+#endif
+	printk(KERN_DEBUG "System RAM remapped:       from 0x%08X to 0x%08X\n", SRAM_BASE_PA, (u32)cached_sram_base);
+	cached_sram_alloc_ptr = cached_sram_base;
