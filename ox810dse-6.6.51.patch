+/**
+ * MAC register access functions
+ */
+
+/**
+ * @param reg_num An int specifying the index of the MAC register to access
+ */
+static inline u32 mac_reg_read(int reg_num)
+{
+//printk("Reading MAC register %u at byte adr 0x%08x\n", reg_num, gmac_priv->macBase + (reg_num << 2));
+	return readl((void __iomem *)(gmac_priv->macBase + (reg_num << 2)));
+}
+
+/**
+ * @param reg_num An int specifying the index of the MAC register to access
+ */
+static inline void mac_reg_write(int reg_num, u32 value)
+{
+//printk("Writing MAC register %u at byte adr 0x%08x with 0x%08x\n", reg_num, gmac_priv->macBase + (reg_num << 2), value);
+	writel(value, (void __iomem *)(gmac_priv->macBase + (reg_num << 2)));
+}
+
+/**
+ * @param reg_num An int specifying the index of the MAC register to access
+ * @param bits_to_clear A u32 specifying which bits of the specified register to
+ *  clear. A set bit in this parameter will cause the matching bit in the
+ *  register to be cleared
+ */
+static inline void mac_reg_clear_mask(int reg_num, u32 bits_to_clear)
+{
+	mac_reg_write(reg_num, mac_reg_read(reg_num) & ~bits_to_clear);
+}
+
+/**
+ * @param reg_num An int specifying the index of the MAC register to access
+ * @param bits_to_set A u32 specifying which bits of the specified register to
+ *  set. A set bit in this parameter will cause the matching bit in the register
+ *  to be set
+ */
+static inline void mac_reg_set_mask(int reg_num, u32 bits_to_set)
+{
+	mac_reg_write(reg_num, mac_reg_read(reg_num) | bits_to_set);
+}
+
