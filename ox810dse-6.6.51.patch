+// Invoked from the watchdog timer action routine which runs as softirq,
+// so must disable interrupts when obtaining locks
+#ifdef CONFIG_SYNOPSYS_GMAC_PHYLIB
+void change_gig_mode(void)
+#else
+static void change_gig_mode(void)
+#endif
+{
+	unsigned int is_gig = gmac_priv->using_1000;
+
+#ifdef CONFIG_LEON_COPRO
+	copro_queue_cmd(GMAC_CMD_CHANGE_GIG_MODE, is_gig, copro_ack_noop_callback);
+
+	// Interrupt the CoPro so it sees the new command
+	oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+#else // CONFIG_LEON_COPRO
+	u32 tries = CHECK_TX_STOP_TRIES;
+
+	// Mask to extract the transmit status field from the status register
+	u32 ts_mask = ((1UL << DMA_STATUS_TS_NUM_BITS) - 1) << DMA_STATUS_TS_BIT;
+
+	if (tx_available_for_read(&gmac_priv->tx_gmac_desc_list_info, NULL)) {
+		while ((dma_reg_read(DMA_STATUS_REG) & ts_mask) != (DMA_STATUS_TS_STOPPED << DMA_STATUS_TS_BIT)) {
+			if (--tries == 0) {
+				gmac_warn("Timeout waiting for Tx to stop\n");
+				break;
+			}
+			udelay(100);
+		}
+	}
+
+	// Must stop transmission in order to change store&forward mode
+	dma_reg_clear_mask(DMA_OP_MODE_REG, (1UL << DMA_OP_MODE_ST_BIT));
+
+	if (is_gig)
+		mac_reg_clear_mask(MAC_CONFIG_REG, (1UL << MAC_CONFIG_PS_BIT));
+	else
+		mac_reg_set_mask(MAC_CONFIG_REG, (1UL << MAC_CONFIG_PS_BIT));
+#endif // CONFIG_LEON_COPRO
+
+	// Re-start transmission after store&forward change applied
+	gmac_tx_restart();
+}
