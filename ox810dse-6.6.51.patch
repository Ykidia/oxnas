+//printk("<1> oxnas_wd810_leds_set_capacity_gauge capacity_gauge_bits=%x\n", capacity_gauge_bits);
+//if ( state < 3 )
+	if (activity_block == 0 )
+	{
+//	start = 0;
+		state = SHOW_CAPACITY;
+//	activity_block = 0;
+	}
+}
