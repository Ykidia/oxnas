+/**
+ * irq_handler is the interrupt handling routine registered with the system,
+ * by libata.
+ */
+static irqreturn_t ox810se_sata_irq_handler(int irq, void *dev_instance)
+{
+	int i = SATA_OXNAS_MAX_PORTS;
+	irqreturn_t ret = IRQ_NONE;
+	struct ata_port *ap = sata_priv->active_ap;
+
+	if (unlikely(NULLPTR(ap))) {
+		ap = ((struct ata_host *)dev_instance)->ports[0];
+		if (NULLPTR(ap) && (SATA_OXNAS_MAX_PORTS > 1))
+			ap = ((struct ata_host *)dev_instance)->ports[1];
+	}
+
+	do {
+		if (likely(!NULLPTR(ap))) {
+			// check the ISR for the port to see if it created the interrupt
+			u32 int_status = ox810se_sata_ioportraid_read(ap, INT_STATUS) & INT_USED;
+			// Clear and mask pending interrupts
+			ox810se_sata_ioportraid_andor(ap, INT_CLEAR, 0, int_status);
+///			ox810se_sata_ioportraid_andor(ap, INT_DISABLE, 0, int_status);
+
+			if (likely(int_status & INT_USED)) {
+				if (likely((int_status & INT_END_OF_CMD) && !ox810se_sata_dma_busy_check(ap)))
+					ox810se_sata_qc_complete(ap);
+				else {
+					if (int_status & (INT_ERROR | INT_LINK_SERROR | INT_LINK_IRQ)) {
+						u32 serror = ox810se_sata_scr_read_port(ap, SCR_ERROR);
+						if(serror & (SERR_DEV_XCHG | SERR_PHYRDY_CHG)) {
+							ata_port_info(ap, "hotplug event, INT_STATUS:%s%s%s, SCR_ERROR:%s%s\n",
+								(int_status & INT_ERROR) ? " INT_ERROR" : "",
+								(int_status & INT_LINK_SERROR) ? " INT_LINK_SERROR" : "",
+								(int_status & INT_LINK_IRQ) ? " INT_LINK_IRQ" : "",
+								(serror & SERR_DEV_XCHG) ? " SERR_DEV_XCHG" : "",
+								(serror & SERR_PHYRDY_CHG) ? " SERR_PHYRDY_CHG" : "");
+							ap->link.eh_info.action |= ATA_EH_RESET;
+							ata_ehi_hotplugged(&ap->link.eh_info);
+							ata_port_freeze(ap);
+						}
+					}
+
+					if (int_status & (INT_REG_ACCESS_ERR | INT_BIST_FIS))
+						ata_port_err(ap, "aux. event, INT_STATUS:%s%s\n",
+							(int_status & INT_REG_ACCESS_ERR) ? " INT_REG_ACCESS_ERR" : "",
+							(int_status & INT_BIST_FIS) ? " INT_BIST_FIS" : "");
+				}
+
+				ret = IRQ_HANDLED;
+			}
+		}
+		ap = ox810se_sata_other_ap(ap);
+	} while (--i > 0);
+
+	if (unlikely(irq != SATA_INTERRUPT)) {
+		printki(DRIVER_NAME ": non-standard spurious SATA irq#%d\n", irq);
+	}
+	return ret;
+}
+
+/**
+ * port_start() is called just after the data structures for each port are
+ * initialized. Typically this is used to alloc per-port DMA buffers, tables
+ * rings, enable DMA engines and similar tasks.
+ *
+ * @return 0 = success
+ * @param ap hardware with the registers in
+ */
+static int ox810se_sata_port_start(struct ata_port *ap)
+{
+	/* allocate port private data memory and attach to port */
+//	ox810se_sata_port_priv_t *pd = devm_kzalloc(
+//		&sata_priv->pdev->dev, sizeof(ox810se_sata_port_priv_t), GFP_KERNEL);
+//	if (NULLPTR(pd))
+//		return -ENOMEM;
+	ox810se_sata_port_priv_t *pd = &sata_priv->ports_priv[ap->port_no];
+
+	sata_priv->active_ap = ap;
+	ap->private_data = pd;
+	ap->print_id = ap->port_no + 1;
+	pd->port = ap;
+	pd->scrlock = __SPIN_LOCK_UNLOCKED(pd->scrlock);
+
+	// Additional cleanup/reset(s) to workaround for
+	// core not responding when issuing first queued command
+	ox810se_sata_cleanup(ap);
+	if (ox810se_sata_core_busy_check(ap)) {
+		// core not ready, reset it (with both ports)
+		ox810se_sata_core_reset();
+	}
+
+	return 0;
+}
+
+/**
+ * port_stop() is called after ->host_stop(). It's sole function is to
+ * release DMA/memory resources, now that they are no longer actively being
+ * used.
+ */
+static void ox810se_sata_port_stop(struct ata_port *ap)
+{
+//	ox810se_sata_qc_complete(ap);
+	ox810se_sata_cleanup(ap);
+	ox810se_sata_irq_off(ap);
+	if (sata_priv->active_ap == ap)
+		sata_priv->active_ap = ox810se_sata_other_ap(ap);
+	ata_port_info(ap, "port stopped\n");
+}
+
+static void ox810se_sata_host_stop(struct ata_host *host)
+{
+	printki("host stopped\n");
+	ox810se_sata_core_reset();
+}
+
+
+static void ox810se_sata_error_handler(struct ata_port *ap)
+{
+	ox810se_sata_cleanup(ap);
+	if (ox810se_sata_core_busy_check(ap)) {
+		struct ata_device *adev;
+		// core not recovering, reset it (with both ports)
+		ox810se_sata_core_reset();
+		ata_port_warn(ap, "core reset!\n");
+		// Perform any SATA core re-initialization after reset
+		// post reset init needs to be called for both ports as there's one reset
+		// for both ports
+		ata_for_each_dev(adev, &ap->link, ENABLED) {
+			(void)ata_dev_configure(adev);
+		}
+	}
+	ata_std_error_handler(ap);
+}
+
+
+
+static void ox810se_sata_post_internal_cmd(struct ata_queued_cmd *qc)
+{
+	VPRINTKI("ata%u: tag#%u\n", qc->ap->print_id, qc->tag);
+
+	if (qc->flags & ATA_QCFLAG_EH)
+		ox810se_sata_cleanup(qc->ap);
+}
+
+
+static int ox810se_sata_check_ready(struct ata_link *link)
+{
+	u8 status = ox810se_sata_check_status(link->ap);
+
+	return ata_check_ready(status);
+}
+
+static int ox810se_sata_softreset(struct ata_link *link, unsigned int *class, unsigned long deadline)
+{
+	int rc;
+	struct ata_taskfile tf;
+	struct ata_port *ap = link->ap;
+
+	if (NULLPTR(ap))
+		return -EINVAL;
+
+	if (ata_link_offline(link)) {
+		DPRINTKW("PHY reports no device\n");
+		if (!NULLPTR(class))
+			*class = ATA_DEV_NONE;
+		return 0;
+	}
+
+	ox810se_sata_srst_send(ap);
+
+	rc = ata_wait_ready(link, deadline, ox810se_sata_check_ready);
+
+	// if link is occupied, -ENODEV too is an error
+	if (rc && (rc != -ENODEV || sata_scr_valid(link))) {
+		ata_port_err(ap, "SRST failed (errno=%d)\n", rc);
+		return rc;
+	}
+
+	// determine by signature whether we have ATA or ATAPI devices
+	ox810se_sata_tf_read(ap, &tf);
+	if (!NULLPTR(class)) {
+		*class = ata_dev_classify(&tf);
+
+		if (*class == ATA_DEV_UNKNOWN)
+			*class = ATA_DEV_NONE;
+
+		VPRINTKI("class=%u\n", *class);
+	}
+
+	return 0;
+}
