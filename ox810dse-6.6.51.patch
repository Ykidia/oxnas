diff -ruN a/drivers/net/ethernet/synopsys/gmac/Kconfig b/drivers/net/ethernet/synopsys/gmac/Kconfig
--- a/drivers/net/ethernet/synopsys/gmac/Kconfig	1970-01-01 03:00:00.000000000 +0300
+++ b/drivers/net/ethernet/synopsys/gmac/Kconfig	2026-11-17 23:51:40.000000000 +0300
@@ -0,0 +1,36 @@
+#
+# Synopsys GMAC configuration
+#
+
+config SYNOPSYS_GMAC
+	tristate "Synopsys Gigabit MAC"
+	select CRC32
+	select MII
+	depends on ARCH_OXNAS
+	help
+		Driver for the Synopsys Gigabit MAC
+
+config OXNAS_GMAC_AVOID_CACHE_CLEAN
+	bool "Avoid cleaning cache on network Tx"
+	depends on SYNOPSYS_GMAC
+	default y
+	help
+		Assume all disk i/o is via DMA so can avoid cleaning cache
+		before DMA to network if page is mapped to disk and not dirty
+
+config GMAC_DESCRIPTORS_PAGES
+	int "The number of 4k pages for GMAC descriptors to allocate"
+	default 1
+	depends on SYNOPSYS_GMAC
+
+config SYNOPSYS_GMAC_PHYLIB
+	bool "Use PHYLIB for PHY management"
+	depends on SYNOPSYS_GMAC
+	select PHYLIB
+	help
+		If you say Y here, the Synopsys GMAC driver will use the
+		kernel's PHY library (phylib) for PHY device discovery,
+		configuration, and link state management.
+		This replaces the driver's custom, built-in PHY handling code.
+		It is generally recommended as it provides a standard, well-tested
+		framework for PHY interaction and simplifies the driver code.
