+bool oxnas_dma_is_active(struct dma_chan *chan)
+{
+	if (likely(chan != NULL)) {
+		oxnas_adma_channel_t *channel = container_of(chan, oxnas_adma_channel_t, common);
+		return oxnas_dma_busy_check(channel);
+	}
+
+	return false;
+}
