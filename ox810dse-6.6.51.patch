+// May be invoked from either ISR or process context
+static inline void change_rx_enable(u32 start, int waitForAck)
+{
+#ifdef CONFIG_LEON_COPRO
+	copro_queue_cmd(GMAC_CMD_CHANGE_RX_ENABLE, start,
+		waitForAck ? copro_rx_enable_callback : copro_ack_noop_callback);
+
+	// Interrupt the CoPro so it sees the new command
+	oxnas_sys_write(SYS_CTRL_SEMA_SET_CTRL, 1UL << COPRO_SEM_INT_CMD);
+
+	if (waitForAck) {
+		// Wait until the CoPro acknowledges that the receiver has been stopped
+		if (in_irq()) {
+			int tries = COPRO_CMD_QUEUE_RETRIES;
+
+			gmac_dbg("down_trylock\n");
+			while (down_trylock(&gmac_priv->copro_rx_enable_semaphore_)) {
+				if (--tries == 0) {
+					gmac_warn("Timeout stopping CoPro receiver (irq)\n");
+					break;
+				}
+				udelay(100);
+			}
+		} else {
+			if (down_timeout(&gmac_priv->copro_rx_enable_semaphore_, COPRO_GENERAL_TIMEOUT) == -ETIME) {
+				gmac_warn("Timeout stopping CoPro receiver\n");
+			}
+		}
+	}
+#else // CONFIG_LEON_COPRO
+	start ? dma_reg_set_mask(DMA_OP_MODE_REG, 1UL << DMA_OP_MODE_SR_BIT)
+		: dma_reg_clear_mask(DMA_OP_MODE_REG, 1UL << DMA_OP_MODE_SR_BIT);
+#endif
+
+}
