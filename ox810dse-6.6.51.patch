+static void test_leds(void)
+{
+	// Disable primary, secondary and teriary GPIO functions for six LEDS on the front panel
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_0, ~FIRST_LEDS_MASK, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_0, ~FIRST_LEDS_MASK, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_0, ~FIRST_LEDS_MASK, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_PRIMSEL_CTRL_1, ~SECOND_LEDS_MASK, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_SECSEL_CTRL_1, ~SECOND_LEDS_MASK, 0);
+	oxnas_sys_andor(SYS_CTRL_GPIO_TERTSEL_CTRL_1, ~SECOND_LEDS_MASK, 0);
+
+	// Disable PWMs
+	oxnas_sys_write(SYS_CTRL_GPIO_PWMSEL_CTRL_0, 0);
+	oxnas_sys_write(SYS_CTRL_GPIO_PWMSEL_CTRL_1, 0);
+
+	// Turn off LEDs
+	oxnas_gpio_write(GPIO_A_OUTPUT_CLEAR, FIRST_LEDS_MASK);
+	oxnas_gpio_write(GPIO_B_OUTPUT_CLEAR, SECOND_LEDS_MASK);
+
+	// Enable first nine LEDs as outputs
+	oxnas_gpio_write(GPIO_A_OUTPUT_ENABLE_SET, FIRST_LEDS_MASK);
+
+	// Enable tenth LED as output
+	oxnas_gpio_write(GPIO_B_OUTPUT_ENABLE_SET, SECOND_LEDS_MASK);
+
+	oxnas_gpio_write(GPIO_A_OUTPUT_SET, LED_D1);
+	test_leds_delay();
+	oxnas_gpio_write(GPIO_A_OUTPUT_SET, LED_D2);
+	oxnas_gpio_write(GPIO_A_OUTPUT_CLEAR, LED_D1);
+	test_leds_delay();
+	oxnas_gpio_write(GPIO_A_OUTPUT_SET, LED_D3);
+	oxnas_gpio_write(GPIO_A_OUTPUT_CLEAR, LED_D2);
+	test_leds_delay();
+	oxnas_gpio_write(GPIO_A_OUTPUT_SET, LED_D4);
+	oxnas_gpio_write(GPIO_A_OUTPUT_CLEAR, LED_D3);
+	test_leds_delay();
+	oxnas_gpio_write(GPIO_A_OUTPUT_SET, LED_D5);
+	oxnas_gpio_write(GPIO_A_OUTPUT_CLEAR, LED_D4);
+	test_leds_delay();
+	oxnas_gpio_write(GPIO_B_OUTPUT_SET, LED_D6);
+	oxnas_gpio_write(GPIO_A_OUTPUT_CLEAR, LED_D5);
+
+	test_leds_delay();
+	oxnas_gpio_write(GPIO_A_OUTPUT_SET, LED_D5);
+	oxnas_gpio_write(GPIO_B_OUTPUT_CLEAR, LED_D6);
+	test_leds_delay();
+	oxnas_gpio_write(GPIO_A_OUTPUT_SET, LED_D4);
+	oxnas_gpio_write(GPIO_A_OUTPUT_CLEAR, LED_D5);
+	test_leds_delay();
+	oxnas_gpio_write(GPIO_A_OUTPUT_SET, LED_D3);
+	oxnas_gpio_write(GPIO_A_OUTPUT_CLEAR, LED_D4);
+	test_leds_delay();
+	oxnas_gpio_write(GPIO_A_OUTPUT_SET, LED_D2);
+	oxnas_gpio_write(GPIO_A_OUTPUT_CLEAR, LED_D3);
+	test_leds_delay();
+	oxnas_gpio_write(GPIO_A_OUTPUT_SET, LED_D1);
+	oxnas_gpio_write(GPIO_A_OUTPUT_CLEAR, LED_D2);
+	test_leds_delay();
+}
