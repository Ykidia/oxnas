diff -ruN a/arch/arm/mach-oxnas/user-recovery-button.c b/arch/arm/mach-oxnas/user-recovery-button.c
--- a/arch/arm/mach-oxnas/user-recovery-button.c	1970-01-01 03:00:00.000000000 +0300
+++ b/arch/arm/mach-oxnas/user-recovery-button.c	2024-09-18 21:57:23.000000000 +0300
@@ -0,0 +1,262 @@
+/*
+ * linux/arch/arm/mach-oxnas/user_recovery_button.c
+ *
+ * Copyright (C) 2008 Oxford Semiconductor Ltd
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/timer.h>
+#include <linux/kobject.h>
+#include <linux/workqueue.h>
+#include <mach/hardware.h>
+
+
+#if (CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS)
+#define IRQ_NUM             GPIOA_INTERRUPT
+#else
+#define IRQ_NUM             GPIOB_INTERRUPT
+#endif
+
+#define IRQ_FLAGS           (IRQF_SHARED)
+#define SWITCH_MASK (1UL << (CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO % GPIO_AB_NUM_PINS))
+#define TIMER_INTERVAL_JIFFIES  ((HZ) >> 3) /* An eigth of a second */
+#define DEFAULT_TIMER_COUNT_LIMIT 24	/* In eigths of a second */
+
+
+MODULE_LICENSE("GPL v2");
+
+extern spinlock_t oxnas_gpio_spinlock;
+
+static int timer_count_limit = DEFAULT_TIMER_COUNT_LIMIT;
+module_param(timer_count_limit, int, S_IRUGO|S_IWUSR);
+
+static unsigned long count;
+static struct timer_list timer;
+
+/*
+ * Device driver object
+ */
+typedef struct user_recovery_button_driver_s {
+	/** sysfs dir tree root for user recovery button driver */
+	struct kset *kset;
+	struct kobject kobject;
+} user_recovery_button_driver_t;
+static user_recovery_button_driver_t user_recovery_button_driver;
+static struct kobj_type ktype_user_recovery_button = {
+	.release = 0,
+	.sysfs_ops = 0,
+};
+
+
+/** Have to use active low level interupt generation, as otherwise might miss
+ *  interrupts that arrive concurrently with a PCI interrupt, as PCI interrupts
+ *  are generated via GPIO pins and std PCI drivers will not know that there
+ *  may be other pending GPIO interrupt sources waiting to be serviced and will
+ *  simply return IRQ_HANDLED if they see themselves as having generated the
+ *  interrupt, thus preventing later chained handlers from being called
+ */
+static irqreturn_t user_recovery_button_irq_handler(int irq, void *dev_id)
+{
+	int status = IRQ_NONE;
+	u32 int_status = oxnas_gpio_read(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_INTERRUPT_STATUS_REGISTER : GPIO_B_INTERRUPT_STATUS_REGISTER);
+
+	/* Is the interrupt for us? */
+	if (int_status & SWITCH_MASK) {
+		/* Disable the user recovery button GPIO line interrupt */
+		spin_lock(&oxnas_gpio_spinlock);
+		oxnas_gpio_andor(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+				? GPIO_A_FALLING_EDGE_ACTIVE_LOW_ENABLE : GPIO_B_FALLING_EDGE_ACTIVE_LOW_ENABLE,
+			~SWITCH_MASK,
+			0);
+		spin_unlock(&oxnas_gpio_spinlock);
+
+		/* Zeroise button hold down counter */
+		count = 0;
+
+		/* Start hold down timer with a timeout of 1/8 second */
+		mod_timer(&timer, jiffies + TIMER_INTERVAL_JIFFIES);
+
+		/* Only mark interrupt as serviced if no other unmasked GPIO interrupts
+		   are pending */
+		if (!oxnas_gpio_read(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+				? GPIO_A_INTERRUPT_STATUS_REGISTER : GPIO_B_INTERRUPT_STATUS_REGISTER))
+		{
+			status = IRQ_HANDLED;
+		}
+	}
+
+	return status;
+}
+
+static void work_handler(struct work_struct *not_used)
+{
+	kobject_uevent(&user_recovery_button_driver.kobject, KOBJ_OFFLINE);
+
+	printk(KERN_INFO "User recovery button event!\n");
+}
+
+DECLARE_WORK(user_recovery_button_hotplug_work, work_handler);
+
+static void timer_handler(struct timer_list *t)
+{
+	unsigned long flags;
+
+	/* Is the user recovery button still pressed? */
+	if (!(oxnas_gpio_read(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_DATA : GPIO_B_DATA) & SWITCH_MASK))
+	{
+		/* Yes, so increment count of how many timer intervals have passed since
+		   user recovery button was pressed */
+		if (++count == timer_count_limit) {
+			schedule_work(&user_recovery_button_hotplug_work);
+		} else {
+			/* Restart timer with a timeout of 1/8 second */
+			mod_timer(&timer, jiffies + TIMER_INTERVAL_JIFFIES);
+		}
+	} else {
+		/* The h/w debounced user recovery button has been released, so reenable the
+		   active low interrupt detection to trap the user's next attempt to
+		   recover */
+		spin_lock_irqsave(&oxnas_gpio_spinlock, flags);
+		/* Clear the original interrupt */
+		oxnas_gpio_write(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+				? GPIO_A_INTERRUPT_STATUS_REGISTER : GPIO_B_INTERRUPT_STATUS_REGISTER,
+			SWITCH_MASK);
+		/* Enable falling edge interrupts */
+		oxnas_gpio_andor(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+				? GPIO_A_FALLING_EDGE_ACTIVE_LOW_ENABLE : GPIO_B_FALLING_EDGE_ACTIVE_LOW_ENABLE,
+			~0UL,
+			SWITCH_MASK);
+		spin_unlock_irqrestore(&oxnas_gpio_spinlock, flags);
+	}
+}
+
+static int user_recovery_button_hotplug_filter(const struct kobject *kobj) {
+	return get_ktype(kobj) == &ktype_user_recovery_button;
+}
+
+static const char *user_recovery_button_hotplug_name(const struct kobject *kobj) {
+	return "oxnas-user-recovery-button";
+}
+
+static struct kset_uevent_ops user_recovery_button_uevent_ops = {
+	.filter = user_recovery_button_hotplug_filter,
+	.name   = user_recovery_button_hotplug_name,
+	.uevent = NULL,
+};
+
+static int __init user_recovery_button_init(void)
+{
+	int err = 0;
+	unsigned long flags;
+
+	/* Prepare the sysfs interface for use */
+	user_recovery_button_driver.kset = kset_create_and_add("user-recovery-button", &user_recovery_button_uevent_ops, kernel_kobj);
+	if (!user_recovery_button_driver.kset) {
+		printk(KERN_ERR "user_recovery_button_init() Failed to create kset\n");
+		return -ENOMEM;
+	}
+
+	user_recovery_button_driver.kobject.kset = user_recovery_button_driver.kset;
+	err = kobject_init_and_add(&user_recovery_button_driver.kobject,
+		&ktype_user_recovery_button, NULL, "%d", 0);
+	if (err) {
+		printk(KERN_ERR "user_recovery_button_init() Failed to add kobject\n");
+		kset_unregister(user_recovery_button_driver.kset);
+		kobject_put(&user_recovery_button_driver.kobject);
+		return -EINVAL;
+	}
+
+	/* Setup the timer that will time how long the user holds down the user
+	   recovery button */
+	timer_setup(&timer, timer_handler, 0);
+
+	spin_lock_irqsave(&oxnas_gpio_spinlock, flags);
+	/* Disable primary, secondary and teriary GPIO functions on switch lines */
+	oxnas_sys_andor(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+		? SYS_CTRL_GPIO_PRIMSEL_CTRL_0 : SYS_CTRL_GPIO_PRIMSEL_CTRL_1, ~SWITCH_MASK, 0);
+	oxnas_sys_andor(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+		? SYS_CTRL_GPIO_SECSEL_CTRL_0 : SYS_CTRL_GPIO_SECSEL_CTRL_1, ~SWITCH_MASK, 0);
+	oxnas_sys_andor(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+		? SYS_CTRL_GPIO_TERTSEL_CTRL_0 : SYS_CTRL_GPIO_TERTSEL_CTRL_1, ~SWITCH_MASK, 0);
+	/* Clear the original interrupt */
+	oxnas_gpio_write(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_INTERRUPT_STATUS_REGISTER : GPIO_B_INTERRUPT_STATUS_REGISTER,
+		SWITCH_MASK);
+
+	/* Install a shared interrupt handler on the appropriate GPIO bank's
+	   interrupt line */
+	if (request_irq(IRQ_NUM, user_recovery_button_irq_handler, IRQ_FLAGS, "User Recovery Button", &user_recovery_button_driver)) {
+		printk(KERN_ERR "User Recovery Button: cannot register IRQ %d\n", IRQ_NUM);
+		del_timer_sync(&timer);
+		return -EIO;
+	}
+
+	/* Enable GPIO input on switch line */
+	oxnas_gpio_write(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_OUTPUT_ENABLE_CLEAR : GPIO_B_OUTPUT_ENABLE_CLEAR,
+		SWITCH_MASK);
+
+	/* Set up the user recovery button GPIO line for active low, debounced interrupt */
+	oxnas_gpio_andor(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_INPUT_DEBOUNCE_ENABLE : GPIO_B_INPUT_DEBOUNCE_ENABLE,
+		~0UL,
+		SWITCH_MASK);
+	oxnas_gpio_andor(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_LEVEL_INTERRUPT_ENABLE : GPIO_B_LEVEL_INTERRUPT_ENABLE,
+		~0UL,
+		SWITCH_MASK);
+	oxnas_gpio_andor(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_FALLING_EDGE_ACTIVE_LOW_ENABLE : GPIO_B_FALLING_EDGE_ACTIVE_LOW_ENABLE,
+		~0UL,
+		SWITCH_MASK);
+	spin_unlock_irqrestore(&oxnas_gpio_spinlock, flags);
+
+	printk(KERN_INFO "User recovery button driver registered\n");
+	return 0;
+}
+
+static void __exit user_recovery_button_exit(void)
+{
+	unsigned long flags;
+
+	kobject_put(&user_recovery_button_driver.kobject);
+	kset_unregister(user_recovery_button_driver.kset);
+
+	/* Deactive the timer */
+	del_timer_sync(&timer);
+
+	/* Disable interrupt generation by the user recovery button GPIO line */
+	spin_lock_irqsave(&oxnas_gpio_spinlock, flags);
+	oxnas_gpio_andor(CONFIG_OXNAS_USER_RECOVERY_BUTTON_GPIO < GPIO_AB_NUM_PINS
+			? GPIO_A_FALLING_EDGE_ACTIVE_LOW_ENABLE : GPIO_B_FALLING_EDGE_ACTIVE_LOW_ENABLE,
+		~SWITCH_MASK,
+		0);
+	spin_unlock_irqrestore(&oxnas_gpio_spinlock, flags);
+
+	/* Remove the handler for the shared interrupt line */
+	free_irq(IRQ_NUM, &user_recovery_button_driver);
+}
+
+/**
+ * macros to register intiialisation and exit functions with kernal
+ */
+module_init(user_recovery_button_init);
+module_exit(user_recovery_button_exit);
