+	// gmac_phy_adjust_link() when the link parameters change.
+	if (!gmac_priv->watchdog_timer_shutdown) {
+		mod_timer(&gmac_priv->watchdog_timer, jiffies + WATCHDOG_TIMER_INTERVAL);
+	}
+}
