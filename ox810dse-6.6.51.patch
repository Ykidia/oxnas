+static inline void refill_rx_ring(void)
+{
+	int filled = 0;
+
+	// The since-refill counter is only meaningful inside one
+	// poll cycle - a fresh refill also restarts the count
+	gmac_priv->rx_descs_since_refill_cnr = 0;
+
+	if (unlikely(gmac_priv->rx_buffers_per_page)) {
+		// Receive into pages
+		struct page *page = NULL;
+		int offset = 0;
+		dma_addr_t phys_adr = 0;
+
+		// While there are empty Rx descriptor ring slots
+		while (1) {
+			int desc;
+			rx_frag_info_t frag_info;
+
+			// Have we run out of space in the current page?
+			if (offset + NET_IP_ALIGN + gmac_priv->rx_buffer_size_ > GMAC_ALLOC_SIZE) {
+				page = NULL;
+				offset = 0;
+			}
+
+			if (page == NULL) {
+				// Start a new page
+				int available = available_for_write(&gmac_priv->rx_gmac_desc_list_info);
+				if (available < gmac_priv->rx_buffers_per_page) {
+					break;
+				}
+
+				// Allocate a page to hold a received packet
+				page = gmac_alloc_page();
+				if (unlikely(page == NULL)) {
+					gmac_warn("Could not allocate page\n");
+					break;
+				}
+
+				// Get a consistent DMA mapping for the entire page that will be
+				// DMAed to - causing an invalidation of any entries in the CPU's
+				// cache covering the memory region
+				phys_adr = dma_map_page(&gmac_priv->netdev->dev, page, 0, GMAC_ALLOC_SIZE, DMA_FROM_DEVICE);
+				BUG_ON(dma_mapping_error(&gmac_priv->netdev->dev, phys_adr));
+			} else {
+				// Using the current page again
+				get_page(page);
+			}
+
+			// Ensure IP header is quad aligned
+			offset += NET_IP_ALIGN;
+			frag_info.page = page;
+			frag_info.length = gmac_priv->rx_buffer_size_;
+			frag_info.phys_adr = phys_adr + offset;
+
+			// Try to associate a descriptor with the fragment info
+			desc = set_rx_descriptor(&frag_info);
+			if (desc >= 0) {
+				filled = 1;
+			} else {
+				// Failed to associate the descriptor, so release the DMA mapping
+				// for the socket buffer
+				dma_unmap_page(&gmac_priv->netdev->dev, frag_info.phys_adr, frag_info.length, DMA_FROM_DEVICE);
+
+				// No more Rx descriptor ring entries to refill
+				break;
+			}
+
+			// Account for the space used in the current page
+			offset += frag_info.length;
+
+			// Start next packet on a cacheline boundary
+			offset = SKB_DATA_ALIGN(offset);
+		}
+	} else {
+		// Preallocate MTU-sized SKBs
+		while (1) {
+			struct sk_buff *skb;
+			rx_frag_info_t frag_info;
+			int desc;
+
+			if (!available_for_write(&gmac_priv->rx_gmac_desc_list_info)) {
+				break;
+			}
+
+			// Allocate a new skb for the descriptor ring which is large enough
+			// for any packet received from the link
+			skb = gmac_alloc_skb(gmac_priv->rx_buffer_size_ + NET_IP_ALIGN);
+			if (unlikely(!skb)) {
+				// Can't refill any more Rx descriptor ring entries
+				gmac_warn("Cannot allocate sk_buff\n");
+				break;
+			}
+			// Despite what the comments in the original code from Synopsys
+			// claimed, the GMAC DMA can cope with non-quad aligned buffers
+			// - it will always perform quad transfers but zero/ignore the
+			// unwanted bytes.
+			skb_reserve(skb, NET_IP_ALIGN);
+
+			// Get a consistent DMA mapping for the memory to be DMAed to
+			// causing invalidation of any entries in the CPU's cache covering
+			// the memory region
+			frag_info.page = (struct page *)skb;
+			frag_info.length = skb_tailroom(skb);
+			frag_info.phys_adr = dma_map_single(&gmac_priv->netdev->dev, skb->tail, frag_info.length, DMA_FROM_DEVICE);
+			BUG_ON(dma_mapping_error(&gmac_priv->netdev->dev, frag_info.phys_adr));
+
+			// Associate the skb with the descriptor
+			desc = set_rx_descriptor(&frag_info);
+			if (desc >= 0) {
+				filled = 1;
+			} else {
+				// No, so release the DMA mapping for the socket buffer
+				dma_unmap_single(&gmac_priv->netdev->dev, frag_info.phys_adr, frag_info.length, DMA_FROM_DEVICE);
+
+				// Free the socket buffer
+				dev_kfree_skb(skb);
+
+				// No more Rx descriptor ring entries to refill
+				break;
+			}
+		}
+	}
+
+	if (likely(filled)) {
+		// Issue a Rx poll demand to restart Rx descriptor processing and DFF
+		// mode does not automatically restart descriptor processing after a
+		// descriptor unavailable event
+		dma_reg_write(DMA_RX_POLL_REG, 0);
+	}
+}
+
+static void initialize_phy(void)
+{
+	char *info = NULL;
+
+	switch (GMAC_PHY_ID) {
+		case PHY_TYPE_VITESSE_VSC8201XVZ:
+			{
+				// Allow s/w to override mode/duplex pin settings
+				u32 acsr = GMAC_PHY_READ(VSC8201_MII_ACSR);
+
+				acsr |= (1UL << VSC8201_MII_ACSR_MDPPS_BIT);
+				GMAC_PHY_WRITE(VSC8201_MII_ACSR, acsr);
+				info = "Vitesse VSC8201XVZ";
+			}
+			break;
+		case PHY_TYPE_REALTEK_RTL8211BGR:
+			// Use sysctrl to switch MAC link lines into either (G)MII or RGMII mode
+			oxnas_sys_andor(SYS_CTRL_GMAC_CTRL, ~0UL, 1UL << SYS_CTRL_GMAC_RGMII_BIT);
+			info = "Realtek RTL8211BGR";
+			break;
+		case PHY_TYPE_LSI_ET1011C:
+		case PHY_TYPE_LSI_ET1011C2:
+			{
+				u32 phy_reg;
+
+				// Configure clocks for (G)MII
+				phy_reg = GMAC_PHY_READ(ET1011C_MII_CONFIG);
+				phy_reg &= ~(((1UL << ET1011C_MII_CONFIG_IFMODESEL_NUM_BITS) - 1) << ET1011C_MII_CONFIG_IFMODESEL);
+				phy_reg |= (ET1011C_MII_CONFIG_IFMODESEL_GMII_MII << ET1011C_MII_CONFIG_IFMODESEL);
+				phy_reg |= ((1UL << ET1011C_MII_CONFIG_SYSCLKEN)
+						| (1UL << ET1011C_MII_CONFIG_TXCLKEN)
+						| (1UL << ET1011C_MII_CONFIG_TBI_RATESEL)
+						| (1UL << ET1011C_MII_CONFIG_CRS_TX_EN));
+				GMAC_PHY_WRITE(ET1011C_MII_CONFIG, phy_reg);
+
+				// Enable Tx/Rx LED
+				phy_reg = GMAC_PHY_READ(ET1011C_MII_LED2);
+				phy_reg &= ~(((1UL << ET1011C_MII_LED2_LED_NUM_BITS) - 1) << ET1011C_MII_LED2_LED_TXRX);
+				phy_reg |= (ET1011C_MII_LED2_LED_TXRX_ACTIVITY << ET1011C_MII_LED2_LED_TXRX);
+				GMAC_PHY_WRITE(ET1011C_MII_LED2, phy_reg);
+				info = GMAC_PHY_ID == PHY_TYPE_LSI_ET1011C2
+					? "LSI ET1011C2" : "LSI ET1011C";
+			}
+			break;
+		case PHY_TYPE_ICPLUS_IP1001:
+			info = "ICPlus 1001";
+			break;
+	}
+
+#ifdef CONFIG_SYNOPSYS_GMAC_PHYLIB
+	// PHYLIB owns the PHY: only report which one we have
+	if (gmac_priv->phydev != NULL) {
+		gmac_info("PHY at addr %u, id 0x%08X, driver \"%s\"\n",
+			gmac_priv->phydev->mdio.addr,
+			gmac_priv->phydev->phy_id,
+			gmac_priv->phydev->drv ? gmac_priv->phydev->drv->name : "Generic PHY");
+	}
+#else // CONFIG_SYNOPSYS_GMAC_PHYLIB
+	if (gmac_priv->phy_info != info) {
+		if (gmac_priv->phy_info != NULL && info == NULL) {
+			gmac_err("PHY suddenly disappeared, will continue to use previously found\n");
+		}
+		else {
+			if (gmac_priv->phy_info != NULL && info != NULL && strcmp(gmac_priv->phy_info, info) != 0) {
+				gmac_err("PHY was changed\n");
+			}
+			gmac_priv->phy_info = info;
+		}
+	}
+#endif // CONFIG_SYNOPSYS_GMAC_PHYLIB
+}
+
+static void do_pre_reset_actions(void)
+{
+	switch (GMAC_PHY_ID) {
+		case PHY_TYPE_LSI_ET1011C:
+		case PHY_TYPE_LSI_ET1011C2:
+			{
+				u32 phy_reg;
+
+				gmac_dbg("no Rx clk workaround start\n");
+
+				// Enable all digital loopback
+				phy_reg = GMAC_PHY_READ(ET1011C_MII_LOOPBACK_CNTL);
+				phy_reg &= ~(1UL << ET1011C_MII_LOOPBACK_MII_LOOPBACK);
+				phy_reg |=  (1UL << ET1011C_MII_LOOPBACK_DIGITAL_LOOPBACK);
+				GMAC_PHY_WRITE(ET1011C_MII_LOOPBACK_CNTL, phy_reg);
+
+				// Disable auto-negotiation and enable loopback
+				phy_reg = GMAC_PHY_READ(MII_BMCR);
+				phy_reg &= ~BMCR_ANENABLE;
+				phy_reg |=  BMCR_LOOPBACK;
+				GMAC_PHY_WRITE(MII_BMCR, phy_reg);
+			}
+			break;
+	}
+}
+
+static void do_post_reset_actions(void)
+{
+	switch (GMAC_PHY_ID) {
+		case PHY_TYPE_LSI_ET1011C:
+		case PHY_TYPE_LSI_ET1011C2:
+			{
+				u32 phy_reg;
+
+				gmac_dbg("no Rx clk workaround end\n");
+
+				// Disable loopback and enable auto-negotiation
+				phy_reg = GMAC_PHY_READ(MII_BMCR);
+				phy_reg |=  BMCR_ANENABLE;
+				phy_reg &= ~BMCR_LOOPBACK;
+				GMAC_PHY_WRITE(MII_BMCR, phy_reg);
+			}
+			break;
+	}
+}
