+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+ */
+
+
+#include <linux/delay.h>
+
+#include "gmac.h"
+#include "gmac_phy.h"
+#include "gmac_reg.h"
+
+
+static const int PHY_TRANSFER_TIMEOUT_MS = 100;
+
+/*
+ * Reads a register from the MII Management serial interface
+ */
+int gmac_phy_read(struct net_device *dev, int phyaddr, int phyreg)
+{
+    int data = 0;
+    unsigned long end;
+
+    u32 addr = (phyaddr << MAC_GMII_ADR_PA_BIT) |
+               (phyreg << MAC_GMII_ADR_GR_BIT) |
+               (gmac_priv->gmii_csr_clk_range << MAC_GMII_ADR_CR_BIT) |
+               (1UL << MAC_GMII_ADR_GB_BIT);
+
+    mac_reg_write(MAC_GMII_ADR_REG, addr);
+
+    end = jiffies + MS_TO_JIFFIES(PHY_TRANSFER_TIMEOUT_MS);
+    while (time_before(jiffies, end)) {
+        if (!(mac_reg_read(MAC_GMII_ADR_REG) & (1UL << MAC_GMII_ADR_GB_BIT))) {
+            // Successfully read from PHY
+            data = mac_reg_read(MAC_GMII_DATA_REG) & 0xFFFF;
+            break;
+        }
+    }
+
+//    gmac_dbg("phyaddr=0x%x, phyreg=0x%x, phydata=0x%x\n", phyaddr, phyreg, data);
+
+    return data;
+}
+
+/*
+ * Writes a register to the MII Management serial interface
+ */
+void gmac_phy_write(struct net_device *dev, int phyaddr, int phyreg, int phydata)
+{
+    unsigned long end;
+
+    u32 addr = (phyaddr << MAC_GMII_ADR_PA_BIT) |
+               (phyreg << MAC_GMII_ADR_GR_BIT) |
+               (gmac_priv->gmii_csr_clk_range << MAC_GMII_ADR_CR_BIT) |
+               (1UL << MAC_GMII_ADR_GW_BIT) |
+               (1UL << MAC_GMII_ADR_GB_BIT);
+
+    mac_reg_write(MAC_GMII_DATA_REG, phydata);
+    mac_reg_write(MAC_GMII_ADR_REG, addr);
+
+    end = jiffies + MS_TO_JIFFIES(PHY_TRANSFER_TIMEOUT_MS);
+    while (time_before(jiffies, end)) {
+        if (!(mac_reg_read(MAC_GMII_ADR_REG) & (1UL << MAC_GMII_ADR_GB_BIT))) {
+            break;
+        }
+    }
+
+//    gmac_dbg("phyaddr=0x%x, phyreg=0x%x, phydata=0x%x\n", phyaddr, phyreg, phydata);
+}
+
+#ifdef CONFIG_SYNOPSYS_GMAC_PHYLIB
+/* PATCH PHYLIB: PHY management via the kernel's PHY library.
+ *
+ * The GMAC's own MII management interface is exported as a struct mii_bus so
+ * that phylib can discover the attached PHY and drive it with a proper
+ * phy_driver (if one matches the PHY ID) or the generic C22 driver.  The
+ * driver-side link configuration is done from gmac_phy_adjust_link(), the
+ * callback phylib invokes whenever the negotiated link parameters change.
+ * This replaces the hand-rolled polling watchdog state machine
+ * (phy_detect/phy_reset/set_phy_negotiate_mode/mii_check_media_ex et al)
+ * which is kept compiled in when the option is not defined. */
+
+#include <linux/module.h>
+#include <linux/phy.h>
+#include <linux/platform_device.h>
+
+/* The original driver scanned addresses 1..31 (phy_detect() starts at 1),
+ * so do not let phylib probe address 0 either. */
+#define GMAC_MDIO_PHY_MASK	0x00000001
+
+/* Interrupt-less operation: the PHY is polled by phylib's state machine
+ * (1 second period), mirroring the legacy watchdog polling interval. */
+
+static int gmac_mdio_read(struct mii_bus *bus, int phyaddr, int phyreg)
+{
+	/* Only clause 22 transfers are implemented by the GMAC MII interface */
+	return gmac_phy_read(gmac_priv->netdev, phyaddr, phyreg);
+}
+
+static int gmac_mdio_write(struct mii_bus *bus, int phyaddr, int phyreg, u16 val)
+{
+	gmac_phy_write(gmac_priv->netdev, phyaddr, phyreg, val);
+
+	return 0;
+}
+
+/**
+ * Configures the MAC for the link parameters reported by phylib, and keeps
+ * the private using_* /duplex mirrors in sync for the same consumers that
+ * the legacy mii_check_media_ex() fed (gmac_up()/change_gig_mode()/...).
+ * Called by phylib from the PHY state machine context.
+ */
+static void gmac_phy_adjust_link(struct net_device *netdev)
+{
+	struct phy_device *phydev = netdev->phydev;
+	unsigned long irq_flags;
+	int duplex_changed = 0;
+	int gigabit_changed = 0;
+	int pause_changed = 0;
+	bool link_up = phydev->link;
+	bool full_duplex = (phydev->duplex == DUPLEX_FULL);
+	bool using_1000 = (phydev->speed == SPEED_1000);
+	bool using_100 = (phydev->speed == SPEED_100);
+	bool using_pause = phydev->pause;
+
+	spin_lock_irqsave(&gmac_priv->phy_lock, irq_flags);
+
+	if (gmac_priv->mii_init_media) {
+		/* First result after open(): report everything as changed */
+		duplex_changed = 1;
+		gigabit_changed = 1;
+		pause_changed = 1;
+	} else {
+		if (gmac_priv->mii_full_duplex != full_duplex)
+			duplex_changed = 1;
+		if (gmac_priv->using_1000 != using_1000)
+			gigabit_changed = 1;
+		if (gmac_priv->using_pause != using_pause)
+			pause_changed = 1;
+	}
+	gmac_priv->mii_init_media = 0;
+	gmac_priv->mii_full_duplex = full_duplex;
+	gmac_priv->using_100 = using_100;
+	gmac_priv->using_1000 = using_1000;
+	gmac_priv->using_pause = using_pause;
+	gmac_priv->link_state = link_up ? 1 : 0;
+
+	spin_unlock_irqrestore(&gmac_priv->phy_lock, irq_flags);
+
+	if (link_up) {
+		gmac_info("Link up, %uMbps, %s-duplex, %s pause\n",
+			using_1000 ? 1000 : using_100 ? 100 : 10,
+			full_duplex ? "full" : "half",
+			using_pause ? "using" : "not using");
+	} else {
+		gmac_info("Link down\n");
+	}
+
+	if (link_up && duplex_changed) {
+		full_duplex ? mac_reg_set_mask(  MAC_CONFIG_REG, (1UL << MAC_CONFIG_DM_BIT)) :
+			      mac_reg_clear_mask(MAC_CONFIG_REG, (1UL << MAC_CONFIG_DM_BIT));
+	}
+
+	if (gigabit_changed) {
+		change_gig_mode();
+	}
+
+	if (pause_changed) {
+		change_pause_mode();
+	}
+}
+
+/**
+ * Creates the MDIO bus, registers it with phylib (which scans it for PHYs,
+ * instantiating phy_device structures), then attaches the first PHY found
+ * to the netdev.
+ */
+int gmac_phy_connect(struct net_device *netdev)
+{
+	struct mii_bus *mdio_bus;
+	struct phy_device *phydev;
+	int status;
+
+	mdio_bus = mdiobus_alloc();
+	if (mdio_bus == NULL) {
+		gmac_err("Failed to allocate MDIO bus\n");
+		return -ENOMEM;
+	}
+
+	mdio_bus->name = "gmac-mdio";
+	snprintf(mdio_bus->id, MII_BUS_ID_SIZE, "%s", "gmac-mdio-0");
+	mdio_bus->read = gmac_mdio_read;
+	mdio_bus->write = gmac_mdio_write;
+	mdio_bus->phy_mask = GMAC_MDIO_PHY_MASK;
+	mdio_bus->parent = &gmac_priv->mdio_parent_pdev->dev;
+	/* phy_attach_direct() compares the netdev owner (the module owning
+	 * netdev->dev.parent->driver, i.e. us) with bus->owner and only takes a
+	 * reference on the bus module when they differ: "For Ethernet device
+	 * drivers that register their own MDIO bus, we will have bus->owner
+	 * match ndev_mod, so we do not want to increment our own
+	 * module->refcnt here, otherwise we would not be able to unload later
+	 * on."  Set it to THIS_MODULE to match, and to keep the module pinned
+	 * while the bus exists (mdiobus_register itself also relies on
+	 * bus->owner for get/put_device bookkeeping). */
+	mdio_bus->owner = THIS_MODULE;
+
+	status = mdiobus_register(mdio_bus);
+	if (status) {
+		gmac_err("Failed to register MDIO bus, err=%d\n", status);
+		mdiobus_free(mdio_bus);
+		return status;
+	}
+	gmac_priv->mdio_bus = mdio_bus;
+
+	/* phylib instantiated the PHYs it found on the bus; take the first one */
+	phydev = phy_find_first(mdio_bus);
+	if (phydev == NULL) {
+		gmac_err("No PHY found\n");
+		gmac_mdio_unregister();
+		return -ENXIO;
+	}
+
+	status = phy_connect_direct(netdev, phydev, &gmac_phy_adjust_link,
+				    PHY_INTERFACE_MODE_GMII);
+	if (status) {
+		gmac_err("Could not attach to PHY\n");
+		gmac_mdio_unregister();
+		return status;
+	}
+
+	gmac_priv->phydev = netdev->phydev;
+
+	/* Tell phylib the MAC can do symmetric and asymmetric pause frames;
+	 * phy_support_asym_pause() copies the pause bits from the PHY's
+	 * supported mask into its advertisement. */
+	phy_support_asym_pause(phydev);
+
+	phy_attached_info(phydev);
+
+	return 0;
+}
+
+void gmac_phy_disconnect(struct net_device *netdev)
+{
+	if (gmac_priv->phydev != NULL) {
+		phy_disconnect(gmac_priv->phydev);
+		gmac_priv->phydev = NULL;
+	}
+}
+
+int gmac_mdio_register(void)
+{
+	/* The netdev is created by the module init code and has no parent
+	 * device (the GMAC block is mapped by hand via oxnas_ioremap()), but
+	 * phy_attach_direct() dereferences netdev->dev.parent->driver->owner
+	 * unconditionally to take a module reference on the netdev's owner.
+	 * Create a platform device that will serve both as the netdev's parent
+	 * (SET_NETDEV_DEV, so dev->dev.parent->driver is the bound gmac
+	 * platform driver) and as the MDIO bus parent for phylib's sysfs
+	 * placement.  plat_driver (name "gmac") has no probe callback, which
+	 * platform_probe() tolerates: it binds the device and returns 0.
+	 * The device must be registered before gmac_phy_connect() attaches
+	 * the PHY, and must outlive phy_disconnect() at module exit, hence
+	 * it is freed by gmac_mdio_unregister() after the PHY is detached. */
+	gmac_priv->mdio_parent_pdev =
+		platform_device_register_simple("gmac", -1, NULL, 0);
+	if (IS_ERR(gmac_priv->mdio_parent_pdev)) {
+		int status = PTR_ERR(gmac_priv->mdio_parent_pdev);
+		gmac_priv->mdio_parent_pdev = NULL;
+		gmac_err("Failed to register parent platform device, err=%d\n", status);
+		return status;
+	}
+
+	SET_NETDEV_DEV(gmac_priv->netdev, &gmac_priv->mdio_parent_pdev->dev);
+
+	/* platform_device_register_simple() registers the device, but the
+	 * driver core binds plat_driver to it asynchronously from a deferred
+	 * probe work; wait for the binding so that
+	 * netdev->dev.parent->driver is not NULL when phy_attach_direct()
+	 * runs.  The wait is bounded purely as a hang guard: binding on the
+	 * platform bus normally completes before the register call returns
+	 * (plat_driver is registered at the top of gmac_module_init()). */
+	{
+		unsigned long bind_timeout =
+			jiffies + MS_TO_JIFFIES(PHY_TRANSFER_TIMEOUT_MS);
+
+		while (gmac_priv->mdio_parent_pdev->dev.driver == NULL) {
+			if (time_after(jiffies, bind_timeout)) {
+				gmac_err("Parent platform device did not bind\n");
+				platform_device_unregister(gmac_priv->mdio_parent_pdev);
+				gmac_priv->mdio_parent_pdev = NULL;
+				return -ENODEV;
+			}
+			msleep(1);
+		}
+	}
+
+	return 0;
+}
+
+void gmac_mdio_unregister(void)
+{
+	if (gmac_priv->mdio_bus != NULL) {
+		mdiobus_unregister(gmac_priv->mdio_bus);
+		mdiobus_free(gmac_priv->mdio_bus);
+		gmac_priv->mdio_bus = NULL;
+	}
+
+	if (gmac_priv->mdio_parent_pdev != NULL) {
+		platform_device_unregister(gmac_priv->mdio_parent_pdev);
+		gmac_priv->mdio_parent_pdev = NULL;
+	}
+}
+
+#else /* !CONFIG_SYNOPSYS_GMAC_PHYLIB */
+
+/*
+ * Finds and reports the PHY address
+ */
+void phy_detect(struct net_device *dev)
+{
+	int phyaddr;
+
+	// Scan all 32 PHY addresses if necessary
+	gmac_priv->phy_type = 0;
+	for (phyaddr = 1; phyaddr < 33; ++phyaddr) {
+		unsigned int id1, id2;
+
+		// Read the PHY identifiers
+		id1 = gmac_priv->mii.mdio_read(gmac_priv->netdev, phyaddr & gmac_priv->mii.reg_num_mask, MII_PHYSID1);
+		id2 = gmac_priv->mii.mdio_read(gmac_priv->netdev, phyaddr & gmac_priv->mii.reg_num_mask, MII_PHYSID2);
+
+		// Make sure it is a valid identifier
+		if (id1 != 0x0000 && id1 != 0xffff && id1 != 0x8000 &&
+			id2 != 0x0000 && id2 != 0xffff && id2 != 0x8000)
+		{
+//			gmac_dbg("Found PHY at address=%u\n", phyaddr);
+			gmac_priv->mii.phy_id = phyaddr & gmac_priv->mii.phy_id_mask;
+			gmac_priv->phy_type = id1 << 16 | id2;
+			gmac_priv->phy_addr = phyaddr;
+			break;
+		}
+	}
+}
+
+void start_phy_reset(void)
+{
+	// Ask the PHY to reset
+	gmac_priv->mii.mdio_write(gmac_priv->netdev, gmac_priv->phy_addr, MII_BMCR, BMCR_RESET);
+}
+
+int is_phy_reset_complete(void)
+{
+    int complete = 0;
+    int bmcr;
+
+    // Read back the status until it indicates reset, or we timeout
+    bmcr = gmac_priv->mii.mdio_read(gmac_priv->netdev, gmac_priv->phy_addr, MII_BMCR);
+    if (!(bmcr & BMCR_RESET)) {
+        complete = 1;
+    }
+
+    return complete;
+}
+
+int phy_reset(struct net_device *dev)
+{
+	int complete = 0;
+	unsigned long end;
+
+	// Start the reset operation
+	start_phy_reset();
+
+	// Total time to wait for reset to complete
+	end = jiffies + MS_TO_JIFFIES(PHY_TRANSFER_TIMEOUT_MS);
+
+	// Read back the status until it indicates reset, or we timeout
+	while (!(complete = is_phy_reset_complete()) && time_before(jiffies, end)) {
+		msleep(1);
+	}
+
+	return !complete;
+}
+
+void phy_powerdown(struct net_device *dev)
+{
+	unsigned int bmcr = gmac_priv->mii.mdio_read(dev, gmac_priv->phy_addr, MII_BMCR);
+	gmac_priv->mii.mdio_write(dev, gmac_priv->phy_addr, MII_BMCR, bmcr | BMCR_PDOWN);
+
+	if (gmac_priv->phy_type == PHY_TYPE_ICPLUS_IP1001) {
+		// Cope with weird ICPlus PHY behaviour
+		gmac_priv->mii.mdio_read(dev, gmac_priv->phy_addr, MII_BMCR);
+	}
+}
+
+void set_phy_negotiate_mode(struct net_device *dev)
+{
+    struct mii_if_info *mii = &gmac_priv->mii;
+    struct ethtool_cmd *ecmd = &gmac_priv->ethtool_cmd;
+    u32                 bmcr;
+
+	bmcr = mii->mdio_read(dev, mii->phy_id, MII_BMCR);
+
+    if (ecmd->autoneg == AUTONEG_ENABLE) {
+        u32 advert, tmp;
+        u32 advert2 = 0, tmp2 = 0;
+
+//printk("set_phy_negotiate_mode() Auto negotiating link mode\n");
+        // Advertise only what has been requested
+        advert = mii->mdio_read(dev, mii->phy_id, MII_ADVERTISE);
+        tmp = advert & ~(ADVERTISE_ALL | ADVERTISE_100BASE4 |
+	                 ADVERTISE_PAUSE_CAP | ADVERTISE_PAUSE_ASYM);
+
+        if (ecmd->supported & (SUPPORTED_1000baseT_Full | ADVERTISE_1000HALF)) {
+            advert2 = mii->mdio_read(dev, mii->phy_id, MII_CTRL1000);
+            tmp2 = advert2 & ~(ADVERTISE_1000HALF | ADVERTISE_1000FULL);
+        }
+
+        if (ecmd->advertising & ADVERTISED_10baseT_Half) {
+            tmp |= ADVERTISE_10HALF;
+        }
+        if (ecmd->advertising & ADVERTISED_10baseT_Full) {
+            tmp |= ADVERTISE_10FULL;
+        }
+        if (ecmd->advertising & ADVERTISED_100baseT_Half) {
+            tmp |= ADVERTISE_100HALF;
+        }
+        if (ecmd->advertising & ADVERTISED_100baseT_Full) {
+            tmp |= ADVERTISE_100FULL;
+        }
+        if ((ecmd->supported & SUPPORTED_1000baseT_Half) &&
+            (ecmd->advertising & ADVERTISED_1000baseT_Half)) {
+            tmp2 |= ADVERTISE_1000HALF;
+        }
+        if ((ecmd->supported & SUPPORTED_1000baseT_Full) &&
+            (ecmd->advertising & ADVERTISED_1000baseT_Full)) {
+            tmp2 |= ADVERTISE_1000FULL;
+        }
+
+        if (ecmd->advertising & ADVERTISED_Pause) {
+            tmp |= ADVERTISE_PAUSE_CAP;
+        }
+        if (ecmd->advertising & ADVERTISED_Asym_Pause) {
+            tmp |= ADVERTISE_PAUSE_ASYM;
+        }
+
+        if (advert != tmp) {
+//printk("set_phy_negotiate_mode() Setting MII_ADVERTISE to 0x%08x\n", tmp);
+            mii->mdio_write(dev, mii->phy_id, MII_ADVERTISE, tmp);
+            mii->advertising = tmp;
+        }
+        if (advert2 != tmp2) {
+//printk("set_phy_negotiate_mode() Setting MII_CTRL1000 to 0x%08x\n", tmp2);
+            mii->mdio_write(dev, mii->phy_id, MII_CTRL1000, tmp2);
+        }
+
+        // Auto-negotiate the link state
+        bmcr |= (BMCR_ANRESTART | BMCR_ANENABLE);
+        mii->mdio_write(dev, mii->phy_id, MII_BMCR, bmcr);
+    } else {
+        u32 tmp;
+//printk("set_phy_negotiate_mode() Unilaterally setting link mode\n");
+
+        // Turn off auto negotiation, set speed and duplicitly unilaterally
+        tmp = bmcr & ~(BMCR_ANENABLE | BMCR_SPEED100 | BMCR_SPEED1000 | BMCR_FULLDPLX);
+        if (ecmd->speed == SPEED_1000) {
+            tmp |= BMCR_SPEED1000;
+        } else if (ecmd->speed == SPEED_100) {
+            tmp |= BMCR_SPEED100;
+        }
+
+        if (ecmd->duplex == DUPLEX_FULL) {
+            tmp |= BMCR_FULLDPLX;
+            mii->full_duplex = 1;
+        } else {
+            mii->full_duplex = 0;
+        }
+
+        if (bmcr != tmp) {
+            mii->mdio_write(dev, mii->phy_id, MII_BMCR, tmp);
+        }
+    }
+}
+
+u32 get_phy_capabilies(void)
+{
+	struct mii_if_info *mii = &gmac_priv->mii;
+
+	// Ask the PHY for it's capabilities
+	u32 reg = mii->mdio_read(gmac_priv->netdev, mii->phy_id, MII_BMSR);
+
+	// Assume PHY has MII interface
+	u32 features = SUPPORTED_MII;
+
+	if (reg & BMSR_ANEGCAPABLE) {
+		features |= SUPPORTED_Autoneg;
+	}
+	if (reg & BMSR_100FULL) {
+		features |= SUPPORTED_100baseT_Full;
+	}
+	if (reg & BMSR_100HALF) {
+		features |= SUPPORTED_100baseT_Half;
+	}
+	if (reg & BMSR_10FULL) {
+		features |= SUPPORTED_10baseT_Full;
+	}
+	if (reg & BMSR_10HALF) {
+		features |= SUPPORTED_10baseT_Half;
+	}
+
+	// Does the PHY have the extended status register?
+	if (reg & BMSR_ESTATEN) {
+		reg = mii->mdio_read(gmac_priv->netdev, mii->phy_id, MII_ESTATUS);
+
+		if (reg & ESTATUS_1000_TFULL)
+			features |= SUPPORTED_1000baseT_Full;
+		if (reg & ESTATUS_1000_THALF)
+			features |= SUPPORTED_1000baseT_Half;
+	}
+
+	return features;
+}
+
+#endif /* CONFIG_SYNOPSYS_GMAC_PHYLIB */
