+void oxnas_dma_abort(struct dma_chan *const chan)
+{
+	oxnas_adma_channel_t *const channel = container_of(chan, oxnas_adma_channel_t, common);
+	const unsigned channel_number = channel->common.chan_id;
+	u32 lim = 1UL << 20;
+
+	// Assert reset for the channel
+	spin_lock(&adma_priv->spinlock_);
+	oxnas_dma_iochannel_andor(channel_number, DMA_CTRL_STATUS, ~0UL, DMA_CTRL_STATUS_RESET);
+	spin_unlock(&adma_priv->spinlock_);
+
+	// Wait for the channel to become idle - should be quick as should finish
+	// after the next AHB single or burst transfer
+	while ((oxnas_dma_iochannel_read(channel_number, DMA_CTRL_STATUS) & DMA_CTRL_STATUS_IN_PROGRESS) && (--lim != 0));
+	if (lim == 0)
+		adma_err("channel %u is still active\n", channel_number);
+
+	// Deassert reset for the channel
+	spin_lock(&adma_priv->spinlock_);
+	oxnas_dma_iochannel_andor(channel_number, DMA_CTRL_STATUS, ~DMA_CTRL_STATUS_RESET, 0);
+	spin_unlock(&adma_priv->spinlock_);
+
+	if (channel->sg_info_->p_srcEntries_) {
+		// Zeroise SG DMA descriptor info
+		channel->sg_info_->p_srcEntries_ = 0;
+		channel->sg_info_->p_dstEntries_ = 0;
+	}
+
+	// Transfer has failed so no interrupts counted and channel now inactive
+	atomic_set(&channel->active_count_, 0);
+}
+
+void oxnas_dma_start(struct dma_chan *const chan)
+{
+	oxnas_adma_channel_t *const channel = container_of(chan, oxnas_adma_channel_t, common);
+
+	// Are there SG lists setup for this channel?
+	if (channel->sg_info_->p_srcEntries_) {
+		// Write to the SG-DMA channel's reset register to reset the control
+		// in case the previous SG-DMA transfer failed in some way, thus
+		// leaving the SG-DMA controller hung up part way through processing
+		// its SG list. The reset bits are self-clearing
+		oxnas_dma_iosgchannel_andor(channel->common.chan_id,
+			DMA_SG_RESETS,
+			0,
+			1UL << DMA_SG_RESETS_CONTROL_BIT);
+
+		// Write the pointer to the SG info struct into the Request Pointer reg.
+		oxnas_dma_iosgchannel_andor(channel->common.chan_id,
+			DMA_SG_REQ_PTR,
+			0,
+			adma_virt_to_phys(channel->sg_info_));
+
+		// Start the transfer
+		oxnas_dma_iosgchannel_andor(channel->common.chan_id,
+			DMA_SG_CONTROL,
+			0,
+			(1UL << DMA_SG_CONTROL_START_BIT)
+				| (1UL << DMA_SG_CONTROL_QUEUING_ENABLE_BIT)
+				| (1UL << DMA_SG_CONTROL_HBURST_ENABLE_BIT));
+	} else {
+		// Single transfer mode, so unpause the DMA controller channel
+		spin_lock(&adma_priv->spinlock_);
+		oxnas_dma_iochannel_andor(channel->common.chan_id,
+			DMA_CTRL_STATUS,
+			~DMA_CTRL_STATUS_PAUSE,
+			0);
+		spin_unlock(&adma_priv->spinlock_);
+	}
+}
+
+
+static int oxnas_adma_remove(struct platform_device *dev)
+{
+	struct dma_chan *chan, *ch;
+
+	if (dev->dev.of_node != NULL)
+		of_dma_controller_free(dev->dev.of_node);
+	dma_async_device_unregister(&adma_priv->common);
+
+	list_for_each_entry_safe(chan, ch, &adma_priv->common.channels, device_node) {
+		list_del(&chan->device_node);
+		/* channels_[] is interior storage of adma_priv, NOT kmalloc'd;
+		 * the old kfree(chan) here freed an interior pointer */
+	}
+
+	return 0;
+}
+
+/* ---- Cookie-aware tx_status ------------------------------------------ */
+
+static enum dma_status oxnas_adma_tx_status(struct dma_chan *chan,
+	dma_cookie_t            cookie,
+	struct dma_tx_state     *txstate)
+{
+	oxnas_adma_channel_t *channel =
+		container_of(chan, oxnas_adma_channel_t, common);
+	enum dma_status ret = dma_cookie_status(chan, cookie, txstate);
+
+	/* dma_cookie_status() tracks last-completed vs. in-flight
+	 * cookies per channel, so a completed descriptor polled after a
+	 * later transfer started still reports DMA_COMPLETE. The raw
+	 * busy check is only a fallback while nothing has completed. */
+	if (ret == DMA_COMPLETE || !txstate)
+		return ret;
+
+	return oxnas_dma_busy_check(channel) ? DMA_IN_PROGRESS : DMA_COMPLETE;
+}
+
+/* ---- Channel resource management ------------------------------------- */
+
+static int oxnas_adma_alloc_chan_resources(struct dma_chan *chan)
+{
+	/* The dma_chan already owns its ADMA channel: probe() linked
+	 * every channels_[i] into dma_device.channels, so DMAengine
+	 * hands out channels that are reserved for it. The old body
+	 * called oxnas_dma_request_chan(NULL, NULL) a SECOND time and
+	 * leaked that channel forever. */
+	return 1;
+}
+
+static void oxnas_adma_free_chan_resources(struct dma_chan *chan)
+{
+	oxnas_adma_channel_t *channel =
+		container_of(chan, oxnas_adma_channel_t, common);
+	oxnas_adma_tx_t *tx, *tmp;
+	unsigned long flags;
+
+	/* Flush any descriptors still queued on this channel */
+	spin_lock_irqsave(&adma_priv->spinlock_, flags);
+	list_for_each_entry_safe(tx, tmp, &channel->queue, node) {
+		list_del(&tx->node);
+		kfree(tx);
+	}
+	spin_unlock_irqrestore(&adma_priv->spinlock_, flags);
+
+	oxnas_dma_free(channel);
+}
+
+/* Finish a descriptor: cookie, waiter/client callback, then free.
+ * kfree from hardirq is fine; the channel return is deferred to
+ * process context via the workqueue. */
+static void oxnas_adma_tx_finish(oxnas_adma_tx_t *tx)
+{
+	dma_cookie_complete(&tx->txd);
+
+	if (unlikely(tx->sync)) {
+		complete(tx->sync_done);
+	} else if (tx->txd.callback) {
+		tx->txd.callback(tx->txd.callback_param);
+	}
+
+	if (unlikely(tx->return_chan)) {
+		INIT_WORK(&tx->work, oxnas_adma_tx_work);
+		schedule_work(&tx->work);
+	} else {
+		kfree(tx);
+	}
+}
+
+/* Returns the channel to the free list from process context; the
+ * allocation spinlock is _bh, so it must not be taken from hardirq. */
+static void oxnas_adma_tx_work(struct work_struct *work)
+{
+	oxnas_adma_tx_t *tx = container_of(work, oxnas_adma_tx_t, work);
+	oxnas_adma_channel_t *channel =
+		container_of(tx->txd.chan, oxnas_adma_channel_t, common);
+
+	oxnas_dma_free_chan(&channel->common);
+	kfree(tx);
+}
+
+/* ISR trampoline. The driver's interrupt handler ends every transfer
+ * by calling channel->callback_(channel->callback_param_) - that is
+ * the only completion notification the hardware gives, so the
+ * DMAengine queue must hang off it. */
+static void oxnas_adma_tx_isr(void *arg)
+{
+	oxnas_adma_channel_t *channel = arg;
+	oxnas_adma_tx_t *tx;
+	unsigned long flags;
+
+	spin_lock_irqsave(&adma_priv->spinlock_, flags);
+	tx = channel->active_tx;
+	channel->active_tx = NULL;
+	spin_unlock_irqrestore(&adma_priv->spinlock_, flags);
+
+	if (likely(tx != NULL))
+		oxnas_adma_tx_finish(tx);
+
+	oxnas_adma_start_next(channel);
+}
+
+/* Claim the head of the pending queue and program it. The claim
+ * (channel->active_tx) is atomic, so the issue_pending() idle path
+ * and the ISR completion path can never program the same descriptor
+ * twice; a descriptor is only ever programmed after the previous one
+ * has completed, which is what the chained-transfer hardware needs. */
+static void oxnas_adma_start_next(oxnas_adma_channel_t *channel)
+{
+	oxnas_dma_device_settings_t src;
+	oxnas_dma_device_settings_t dst;
+	oxnas_adma_tx_t *tx;
+	unsigned long flags;
+	int rc;
+
+	for (;;) {
+		spin_lock_irqsave(&adma_priv->spinlock_, flags);
+		if (channel->active_tx != NULL) {
+			spin_unlock_irqrestore(&adma_priv->spinlock_, flags);
+			return;
+		}
+		tx = list_first_entry_or_null(&channel->queue,
+					      oxnas_adma_tx_t, node);
+		if (tx == NULL) {
+			/* Queue drained: drop our ISR trampoline so a raw
+			 * oxnas_dma_request_chan() user starts clean. */
+			if (channel->callback_ == oxnas_adma_tx_isr) {
+				channel->callback_ = NULL;
+				channel->callback_param_ = NULL;
+			}
+			spin_unlock_irqrestore(&adma_priv->spinlock_, flags);
+			return;
+		}
+		list_del(&tx->node);
+		channel->active_tx = tx;
+		spin_unlock_irqrestore(&adma_priv->spinlock_, flags);
+
+		if (tx->is_memset) {
+			u32 word = tx->pattern;
+
+			/* Byte-replicate into this channel's coherent
+			 * staging word; the DMA reads the pattern from
+			 * there with a fixed source address. Coherent
+			 * memory: no manual cache maintenance needed. */
+			word |= word << 8;
+			word |= word << 16;
+			adma_priv->staging_words[channel->common.chan_id]
+				= word;
+
+			src = oxnas_ram_only_src_dma_settings;
+			src.address_ = adma_priv->staging_words_dma
+				+ sizeof(u32) * channel->common.chan_id;
+			src.address_mode_ = OXNAS_DMA_MODE_FIXED;
+			src.address_really_fixed_ = 1;
+			src.read_eot_policy_ = OXNAS_DMA_EOT_NONE;
+			src.bus_ = OXNAS_DMA_SIDE_A;
+
+			dst = oxnas_ram_generic_dma_settings;
+			dst.address_ = tx->dst;
+			dst.address_mode_ = OXNAS_DMA_MODE_INC;
+			dst.address_really_fixed_ = 0;
+			dst.write_eot_policy_ = OXNAS_DMA_EOT_NONE;
+			dst.bus_ = OXNAS_DMA_SIDE_B;
+
+			rc = oxnas_dma_set_common(channel, tx->len,
+						  &src, &dst, true);
+		} else {
+			rc = oxnas_dma_set(channel, tx->src, tx->len,
+					   tx->dst, OXNAS_DMA_MODE_INC,
+					   OXNAS_DMA_MODE_INC);
+		}
+
+		if (likely(rc == 0)) {
+			/* Make sure completion re-enters the queue logic;
+			 * raw API users install their own callback when
+			 * they program their own transfers. */
+			spin_lock_irqsave(&adma_priv->spinlock_, flags);
+			if (channel->callback_ == NULL) {
+				channel->callback_ = oxnas_adma_tx_isr;
+				channel->callback_param_ = channel;
+			}
+			spin_unlock_irqrestore(&adma_priv->spinlock_, flags);
+
+			oxnas_dma_start(&channel->common);
+			return;
+		}
+
+		/* Programming failed: report this descriptor complete
+		 * (the DMAengine API has no error cookie) and retry
+		 * with the next one. Each iteration drops one entry,
+		 * so the loop terminates. */
+		spin_lock_irqsave(&adma_priv->spinlock_, flags);
+		channel->active_tx = NULL;
+		spin_unlock_irqrestore(&adma_priv->spinlock_, flags);
+		oxnas_adma_tx_finish(tx);
+	}
+}
+
+/* DMAengine ops ------------------------------------------------------- */
+
+static dma_cookie_t oxnas_adma_submit_tx(struct dma_async_tx_descriptor *txd)
+{
+	oxnas_adma_tx_t *tx = container_of(txd, oxnas_adma_tx_t, txd);
+	oxnas_adma_channel_t *channel =
+		container_of(txd->chan, oxnas_adma_channel_t, common);
+	dma_cookie_t cookie;
+	unsigned long flags;
+
+	/* Queue ONLY. The old body programmed the channel registers via
+	 * oxnas_dma_set() BEFORE the busy check, corrupting the chained
+	 * transfer slot of an in-flight transfer; programming now happens
+	 * exclusively in start_next(). */
+	spin_lock_irqsave(&adma_priv->spinlock_, flags);
+	cookie = dma_cookie_assign(txd);
+	list_add_tail(&tx->node, &channel->queue);
+	spin_unlock_irqrestore(&adma_priv->spinlock_, flags);
+
+	return cookie;
+}
+
+/* ---- Blocking sync wrapper (exported API from dma.h) ---------------- */
+
+int oxnas_dma_memset_sync(dma_addr_t dst, u8 pattern, unsigned length)
+{
+	DECLARE_COMPLETION_ONSTACK(done);
+	oxnas_adma_channel_t *channel;
+	struct dma_chan *chan;
+	oxnas_adma_tx_t *tx;
+
+	if (adma_priv == NULL)
+		return -ENODEV;
+	if (unlikely(length == 0))
+		return 0;
+	if (unlikely(length > OXNAS_DMA_MAX_TRANSFER_LENGTH) ||
+	    unlikely(dst & 3) || unlikely(length & 3))
+		return -ERANGE;
+
+	chan = oxnas_dma_request_chan(adma_priv->common.dev,
+		&oxnas_ram_generic_dma_settings);
+	if (chan == NULL)
+		return -EBUSY;
+	channel = container_of(chan, oxnas_adma_channel_t, common);
+
+	tx = kzalloc(sizeof(*tx), GFP_KERNEL);
+	if (unlikely(!tx)) {
+		oxnas_dma_free_chan(chan);
+		return -ENOMEM;
+	}
+
+	tx->dst = dst;
+	tx->len = length;
+	tx->pattern = pattern;
+	tx->is_memset = true;
+	tx->sync = true;
+	tx->sync_done = &done;
+	dma_async_tx_descriptor_init(&tx->txd, chan);
+	tx->txd.tx_submit = oxnas_adma_submit_tx;
+
+	/* Enqueue and start; the ISR trampoline (installed by
+	 * start_next()) completes the head descriptor, which calls
+	 * complete(&done), and then starts the next queued tx. */
+	oxnas_adma_submit_tx(&tx->txd);
+	oxnas_adma_start_next(channel);
+
+	wait_for_completion(&done);
+
+	/* The tx was already freed by oxnas_adma_tx_finish(); only the
+	 * channel has to go back to the free list. */
+	oxnas_dma_free_chan(chan);
+	return 0;
+}
+EXPORT_SYMBOL(oxnas_dma_memset_sync);
+
+static struct dma_async_tx_descriptor *oxnas_adma_prep_dma_memcpy(
+	struct dma_chan *chan, dma_addr_t dest, dma_addr_t src,
+	size_t len, unsigned long flags)
+{
+	oxnas_adma_tx_t *tx;
+
+	if (unlikely(len < OXNAS_DMA_MEMCPY_MIN_BYTES) ||
+	    unlikely(len > OXNAS_DMA_MAX_TRANSFER_LENGTH))
+		return NULL;    /* async_tx falls back to the CPU */
+
+	tx = kzalloc(sizeof(*tx), GFP_NOWAIT);
+	if (unlikely(!tx))
+		return NULL;
+
+	tx->src = src;
+	tx->dst = dest;
+	tx->len = len;
+	tx->is_memset = false;
+	dma_async_tx_descriptor_init(&tx->txd, chan);
+	tx->txd.tx_submit = oxnas_adma_submit_tx;
+
+	return &tx->txd;
+}
+
+static struct dma_async_tx_descriptor *oxnas_adma_prep_dma_memset(
+	struct dma_chan *chan, dma_addr_t dest, int value,
+	size_t len, unsigned long flags)
+{
+	oxnas_adma_tx_t *tx;
+
+	if (unlikely(len < OXNAS_DMA_MEMSET_MIN_BYTES) ||
+	    unlikely(len > OXNAS_DMA_MAX_TRANSFER_LENGTH) ||
+	    unlikely(dest & 3) || unlikely(len & 3))
+		return NULL;
+
+	tx = kzalloc(sizeof(*tx), GFP_NOWAIT);
+	if (unlikely(!tx))
+		return NULL;
+
+	tx->dst = dest;
+	tx->len = len;
+	tx->pattern = (u8)value;
+	tx->is_memset = true;
+	dma_async_tx_descriptor_init(&tx->txd, chan);
+	tx->txd.tx_submit = oxnas_adma_submit_tx;
+
+	return &tx->txd;
+}
+
+static void oxnas_adma_issue_pending(struct dma_chan *chan)
+{
+	oxnas_adma_channel_t *channel =
+		container_of(chan, oxnas_adma_channel_t, common);
+
+	/* Start the head descriptor if the channel is idle; if it is
+	 * busy, the ISR completion path starts the next one. */
+	oxnas_adma_start_next(channel);
+}
+
+/* Async helper (exported API from dma.h) ------------------------------ */
+
+int oxnas_dma_memcpy_async(dma_addr_t dst, dma_addr_t src,
+	unsigned length, void (*callback)(void *), void *callback_arg)
+{
+	oxnas_adma_channel_t *channel;
+	struct dma_chan *chan;
+	oxnas_adma_tx_t *tx;
+	unsigned long flags;
+
+	if (adma_priv == NULL)
+		return -ENODEV;
+	if (unlikely(length == 0))
+		return 0;
+	if (unlikely(length > OXNAS_DMA_MAX_TRANSFER_LENGTH))
+		return -ERANGE;
+
+	chan = oxnas_dma_request_chan(adma_priv->common.dev,
+		&oxnas_ram_generic_dma_settings);
+	if (unlikely(chan == NULL))
+		return -EBUSY;
+	channel = container_of(chan, oxnas_adma_channel_t, common);
+
+	tx = kzalloc(sizeof(*tx), callback ? GFP_ATOMIC : GFP_KERNEL);
+	if (unlikely(!tx)) {
+		oxnas_dma_free_chan(chan);
+		return -ENOMEM;
+	}
+
+	tx->src = src;
+	tx->dst = dst;
+	tx->len = length;
+	tx->is_memset = false;
+	tx->return_chan = true;     /* freed by the completion work */
+	dma_async_tx_descriptor_init(&tx->txd, chan);
+	tx->txd.tx_submit = oxnas_adma_submit_tx;
+	if (callback) {
+		tx->txd.callback = callback;
+		tx->txd.callback_param = callback_arg;
+	}
+
+	spin_lock_irqsave(&adma_priv->spinlock_, flags);
+	dma_cookie_assign(&tx->txd);
+	list_add_tail(&tx->node, &channel->queue);
+	spin_unlock_irqrestore(&adma_priv->spinlock_, flags);
+
+	oxnas_adma_start_next(channel);
+
+	return 0;
+}
+EXPORT_SYMBOL(oxnas_dma_memcpy_async);
+
+static int oxnas_adma_probe(struct platform_device *pdev)
+{
+	struct dma_device *dma_device;
+	int ret;
+
+//	if (!of_machine_is_compatible("oxsemi,ox810se-dma"))
+//		return -ENODEV;
+
+
+	// Among other things, channels must be allocated as soon as possible
+	ret = oxnas_dma_init(pdev);
+	if (ret)
+		goto probe_err;
+
+	dma_device = &adma_priv->common;
+	platform_set_drvdata(pdev, adma_priv);
+
+	dma_cap_set(DMA_MEMCPY, dma_device->cap_mask);
+	dma_cap_set(DMA_MEMSET, dma_device->cap_mask);
+	dma_device->device_alloc_chan_resources = oxnas_adma_alloc_chan_resources;
+	dma_device->device_free_chan_resources = oxnas_adma_free_chan_resources;
+	dma_device->device_tx_status = oxnas_adma_tx_status;
+	dma_device->device_issue_pending = oxnas_adma_issue_pending;
+	dma_device->device_prep_dma_memcpy = oxnas_adma_prep_dma_memcpy;
+	dma_device->device_prep_dma_memset = oxnas_adma_prep_dma_memset;
+
+	ret = dma_async_device_register(dma_device);
+	if (ret)
+		goto probe_err;
+
+//	if (pdev->dev.of_node == NULL) {
+//		pdev->dev.of_node = of_find_node_by_name(NULL, "sgdma");
+//	}
+	if (pdev->dev.of_node != NULL) {
+		ret = of_dma_controller_register(pdev->dev.of_node,
+						of_dma_xlate_by_chan_id,
+						dma_device);
+		if (ret)
+			adma_warn("failed to register OF\n");
+	}
+	else
+		adma_warn("OF is NULL\n");
+
+//	adma_info("OXNAS DMA registered\n");
+
+	return 0;
+
+probe_err:
+
+	return ret;
+}
+
+#ifdef CONFIG_OF
+static struct of_device_id oxnas_adma_match[] = {
+	{
+		.compatible = "oxsemi," DRIVER_NAME,
+	},
+	{ },
+};
+
+MODULE_DEVICE_TABLE(of, oxnas_adma_match);
+#endif
+
+static struct platform_driver oxnas_adma_driver = {
+	.driver = {
+		.name = DRIVER_NAME,
+		.owner = THIS_MODULE,
+		.of_match_table = of_match_ptr(oxnas_adma_match),
+	},
+	.probe = oxnas_adma_probe,
+	.remove = oxnas_adma_remove,
+};
+
+module_platform_driver(oxnas_adma_driver);
+
+/**
+ * Describes the identity of the ADMA and the resources it requires
+ */
+static struct resource oxnas_adma_resources[] = {
+	{
+		.name = "dma",
+		.start = DMA_BASE_PA,
+		.end = DMA_BASE_PA + 0x100000 - 1,
+		.flags = IORESOURCE_MEM,
+	},
+	{
+		.name = "sgdma",
+		.start = DMA_SG_BASE_PA,
+		.end = DMA_SG_BASE_PA + 0x100000 - 1,
+		.flags = IORESOURCE_MEM,
+	},
+	{
+		.name = "dma0-irq",
+		.start = DMA_INTERRUPT_0,
+		.flags = IORESOURCE_IRQ,
+	},
+	{
+		.name = "dma1-irq",
+		.start = DMA_INTERRUPT_1,
+		.flags = IORESOURCE_IRQ,
+	},
+	{
+		.name = "dma2-irq",
+		.start = DMA_INTERRUPT_2,
+		.flags = IORESOURCE_IRQ,
+	},
+	{
+		.name = "dma3-irq",
+		.start = DMA_INTERRUPT_3,
+		.flags = IORESOURCE_IRQ,
+	},
+	{
+		.name = "dma4-irq",
+		.start = DMA_INTERRUPT_4,
+		.flags = IORESOURCE_IRQ,
+	},
+};
+
+static struct platform_device oxnas_adma_device = 
+{
+	.name = DRIVER_NAME,
+	.id = 0,
+	.num_resources = ARRAY_SIZE(oxnas_adma_resources),
+	.resource = oxnas_adma_resources,
+}; 
+
+static int __init oxnas_adma_device_init(void)
+{
+	// register the ata device for the driver to find
+	return platform_device_register(&oxnas_adma_device);
+}
+module_init(oxnas_adma_device_init);
+
+/** 
+ * module cleanup
+ */
+static void __exit oxnas_adma_device_exit(void)
+{
+	platform_device_unregister(&oxnas_adma_device);
+}
+module_exit(oxnas_adma_device_exit);
+
