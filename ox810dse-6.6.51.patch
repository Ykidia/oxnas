+/* PATCH TXRX: short aliases kept for the two virtual CoPro status bits, plus
+ * new combined masks aligned with how the ISR/poll actually use them:
+ * VX = the virtual semaphore events (CoPro builds only, else 0 so the masks
+ * fold away in the non-CoPro compile); TXRX = the RI|TI pair that drives the
+ * NAPI schedule decision; FLAGS = everything handled inline by the ISR.
+ * The 5.15 prototype renamed these and DROPPED RU/OVF/TJT/UNF from RX/TX
+ * masks into FLAGS - a reclassification that is fine per se, but it changed
+ * which events suppress interrupt delivery, so it is redone deliberately
+ * here: RI and TI stay the NAPI trigger, everything abnormal stays in
+ * FLAGS, and RX/TX masks keep their original member sets for the ISR's
+ * stat-accumulation code. */
+#define DMA_STATUS_VIA_BIT  DMA_STATUS_V_SEM_INT_ACK_BIT
+#define DMA_STATUS_VSA_BIT  DMA_STATUS_V_SEM_STOP_ACK_BIT
+#ifdef CONFIG_LEON_COPRO
+#define DMA_STATUS_VX_MASK ((1UL << DMA_STATUS_VIA_BIT) | (1UL << DMA_STATUS_VSA_BIT))
+#else
+#define DMA_STATUS_VX_MASK 0
+#endif
+#define DMA_STATUS_V_SEM_MASK DMA_STATUS_VX_MASK
+#define DMA_STATUS_NA_MASK ((1UL << DMA_STATUS_NIS_BIT) | (1UL << DMA_STATUS_AIS_BIT))
+#define DMA_STATUS_NAI_MASK DMA_STATUS_NA_MASK
+#define DMA_STATUS_RX_MASK ((1UL << DMA_STATUS_RI_BIT) \
+	| (1UL << DMA_STATUS_RU_BIT) \
+	| (1UL << DMA_STATUS_OVF_BIT))
+#define DMA_STATUS_TX_MASK ((1UL << DMA_STATUS_TI_BIT) \
+	| (1UL << DMA_STATUS_ETI_BIT) \
+	| (1UL << DMA_STATUS_TJT_BIT) \
+	| (1UL << DMA_STATUS_UNF_BIT))
+#define DMA_STATUS_TXRX_MASK ((1UL << DMA_STATUS_RI_BIT) | (1UL << DMA_STATUS_TI_BIT))
+#define DMA_STATUS_FLAGS_MASK ((1UL << DMA_STATUS_ERI_BIT) \
+	| (1UL << DMA_STATUS_RWT_BIT) \
+	| (1UL << DMA_STATUS_RPS_BIT) \
+	| (1UL << DMA_STATUS_TPS_BIT) \
+	| (1UL << DMA_STATUS_FBE_BIT))
+
