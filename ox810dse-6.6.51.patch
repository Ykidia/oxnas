+/**
+ *
+ */
+static int ox810se_sata_qc_defer(struct ata_queued_cmd *qc)
+{
+	int ret;
+
+	if (!ox810se_sata_port_ready_check(qc))
+		return ATA_DEFER_PORT;
+
+	ret = ata_std_qc_defer(qc);
+	if (ret)
+		return ret;
+
+	VPRINTKI("ata%u: tag#%u -------\n",
+		qc->ap->print_id, qc->tag);
+
+	return 0;
+}
+
+/**
+ * Prepare as much as possible for a command without involving anything that is
+ * shared between ports.
+ */
+static enum ata_completion_errors ox810se_sata_qc_prep(struct ata_queued_cmd *qc)
+{
+	struct ata_port *ap = qc->ap;
+	bool raid_reg = false;  // default to no raid
+	bool port_fail, other_port_fail = false;
+	u32 tries;
+
+	VPRINTKI("ata%u: tag#%u\n", ap->print_id, qc->tag);
+
+	// disable interrupts (qc_issue will enable it)
+	ox810se_sata_irq_off(ap);
+
+	// If it is an internal cmd then there was no qc_defer
+	if (ata_tag_internal(qc->tag)) {
+		tries = SATA_OXNAS_INTERNAL_CMD_IDLE_WAIT_TRIES;
+		do {
+			if (ox810se_sata_port_ready_check(qc))
+				break;
+			ox810se_sata_cleanup(ap);
+		} while (--tries > 0);
+	}
+
+	sata_priv->active_ap = ap;
+
+	// get raid settings from the bio if they exist
+	if (qc->scsicmd && scsi_cmd_to_rq(qc->scsicmd) && scsi_cmd_to_rq(qc->scsicmd)->bio) {
+//		raid_reg = scsi_cmd_to_rq(qc->scsicmd)->bio->bi_raid;
+		if (sata_priv->hw_raid_active != raid_reg) {
+			printki("hardware RAID %s", raid_reg ? "activated" : "deactivated");
+			sata_priv->hw_raid_active = raid_reg;
+		}
+	}
+
+	if (!ox810se_sata_core_idle_wait(ap)) {
+		ata_port_warn(ap, "preparing qc while core still not idle\n");
+	}
+
+	tries = SATA_OXNAS_PORT_FAIL_TRIES;
+	while (1) {
+		// check for failed ports prior to issuing raid-ed commands
+		port_fail = ox810se_sata_check_link(ap) ? false : true;
+		other_port_fail = false;
+		if (sata_priv->hw_raid_active)
+			other_port_fail = !ox810se_sata_check_link(ox810se_sata_other_ap(ap));
+
+		ox810se_sata_accumulated_RAID_faults |= port_fail ? 1UL << ox810se_sata_port_no(ap) : 0;
+		ox810se_sata_accumulated_RAID_faults |= other_port_fail ? 1UL << ox810se_sata_other_port_no(ap) : 0;
+
+		if (!port_fail && !other_port_fail)
+			break;
+
+		if (--tries == 0)
+			return AC_ERR_ATA_BUS;
+
+		ox810se_sata_cleanup(ap);
+		if (ox810se_sata_port_ready_check(qc))
+			break;
+	}
+
+	// clear errors
+	ox810se_sata_errors_clear(ap);
+
+	if (sata_priv->hw_raid_active) {
+		// at the moment we only do raid-1
+		ox810se_sata_iocore_andor(RAID_CONTROL, 0, OXNASSATA_RAID1);
+		ox810se_sata_iocore_andor(RAID_SET, 0, OXNASSATA_RAID_TWODISKS);
+	}
+	else {
+		// Set the RAID controller hardware to idle
+		ox810se_sata_iocore_andor(RAID_CONTROL, 0, OXNASSATA_NOTRAID);
+	}
+
+///	ox810se_sata_irq_on(ap);
+
+	return AC_ERR_OK;
+}
+
+/**
+ * qc_issue is used to make a command active, once the hardware and S/G tables
+ * have been prepared. IDE BMDMA drivers use the helper function
+ * ata_qc_issue_prot() for taskfile protocol-based dispatch. More advanced drivers
+ * roll their own ->qc_issue implementation, using this as the "issue new ATA
+ * command to hardware" hook.
+ * @param qc the queued command to issue
+ */
+static unsigned int ox810se_sata_qc_issue(struct ata_queued_cmd *qc)
+{
+	struct ata_port *ap = NULLPTR(qc) ? NULL : qc->ap;
+
+	if (!ox810se_sata_core_idle_wait(ap)) {
+		ata_port_warn(ap, "issuing qc while core still not idle\n");
+	}
+
+	ox810se_sata_tf_load(ap, &qc->tf);
+
+	if (!NULLPTR(sata_priv->chan)) {
+		if (ox810se_sata_qc_is_dma(qc) && !NULLPTR(qc->sg)) {
+			if (ox810se_sata_dma_busy_check(qc->ap)) {
+				ata_port_warn(ap, "starting DMA transfer while still active, aborting\n");
+				ox810se_sata_dma_abort();
+			}
+#ifdef SATA_USE_NEW_ADMA_DRIVER
+			struct dma_slave_config sconf;
+
+			if (qc->dma_dir == DMA_FROM_DEVICE) {
+				sconf.src_addr = sata_priv->data_phys;
+				sconf.direction = DMA_DEV_TO_MEM;
+			}
+			else {
+				sconf.dst_addr = sata_priv->data_phys;
+				sconf.direction = DMA_MEM_TO_DEV;
+			}
+			dmaengine_slave_config(sata_priv->chan, &sconf);
+			sata_priv->desc = dmaengine_prep_slave_sg(
+				sata_priv->chan,
+				qc->sg,
+				qc->n_elem,
+				qc->dma_dir,
+				DMA_PREP_INTERRUPT | DMA_CTRL_ACK);
+			if (!NULLPTR(sata_priv->desc)) {
+				sata_priv->desc->callback = ox810se_sata_dma_callback;
+				sata_priv->desc->callback_param = ap;
+				dmaengine_submit(sata_priv->desc);
+			}
+			dma_async_issue_pending(sata_priv->chan);
+		}
+///		else {
+///			if (!NULLPTR(sata_priv->desc)) {
+///				sata_priv->desc->callback = NULL;
+///				sata_priv->desc = NULL;
+///			}
+///		}
+#else
+			oxnas_dma_set_callback(sata_priv->chan, ox810se_sata_dma_callback, ap);
+			oxnas_dma_device_set_sg(
+				sata_priv->chan,
+				qc->dma_dir,
+				qc->sg,
+				qc->n_elem,
+				&oxnas_sata_dma_settings,
+				OXNAS_DMA_MODE_INC,
+				qc->nbytes);
+			oxnas_dma_start(sata_priv->chan);
+		}
+///		else
+///			oxnas_dma_set_callback(sata_priv->chan, NULL, NULL);
+#endif
+	}
+
+	ox810se_sata_led_ON();
+
+	// Enable interrupts BEFORE the command FIS:
+	// a fast device can complete almost immediately
+	ox810se_sata_irq_on(ap);
+
+	// Command that the orb registers get written to drive
+	ox810se_sata_send_control_fis(ap, CMD_WRITE_TO_ORB_REGS);
+
+	return AC_ERR_OK;
+}
+
+static void ox810se_sata_qc_fill_rtf(struct ata_queued_cmd *qc)
+{
+//	(void)ox810se_sata_core_idle_wait(qc->ap);
+
+	ox810se_sata_tf_read(qc->ap, &qc->result_tf);
+}
