+
+static int __init set_mac_adr(char *addr)
+{
+	int i, eth_octets[ARRAY_SIZE(mac_adr) + 1];
+	for (i = 0; i < ARRAY_SIZE(eth_octets); i++)
+		eth_octets[i] = -1;
+	if (get_options(addr, ARRAY_SIZE(eth_octets), eth_octets)) {
+		mac_adr_len = 0;
+		i = 1;
+		while (i <= eth_octets[0]) {
+			mac_adr[i - 1] = eth_octets[i];
+			mac_adr_len++;
+			if (++i >= ARRAY_SIZE(eth_octets))
+				break;
+		}
+		i = ARRAY_SIZE(mac_adr) - mac_adr_len;
+		if (i > 0)
+			memmove(&mac_adr[i], mac_adr, ARRAY_SIZE(mac_adr) - i);
+		return 1;
+	}
+
+	return 0;
+}
+__setup("mac_adr=", set_mac_adr);
