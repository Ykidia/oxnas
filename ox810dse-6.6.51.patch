--- a/drivers/net/ethernet/synopsys/gmac/gmac_desc.c	1970-01-01 03:00:00.000000000 +0300
+++ b/drivers/net/ethernet/synopsys/gmac/gmac_desc.c	2026-11-18 09:14:19.000000000 +0300
@@ -0,0 +1,99 @@
