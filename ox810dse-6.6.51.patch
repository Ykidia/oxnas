+	STATIC_CONTROL_BANK1 = STATIC_CONTROL_VERSION + 0x8,
+	STATIC_CONTROL_BANK2 = STATIC_CONTROL_VERSION + 0xC,
+
+	/*  200nS rd/wr cycles to allow DMAing to SMC91x on static bus */
+	STATIC_BUS1_CONTROL_VALUE = 0x04010484,
+};
+
+
+#endif // __MACH_OXNAS_HARDWARE_H__
