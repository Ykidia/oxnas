+static void *cached_sram_alloc_ptr = NULL;
+
+void *oxnas_sram_alloc(size_t sz, dma_addr_t *ppa, gfp_t gfp)
+{
+	const u32 align = 16;
+	unsigned long flags;
+	void *ptr;
+
+	local_irq_save(flags);
+	{
+		ptr = (void *)(((u32)cached_sram_alloc_ptr + align - 1) & ~(align - 1));
+		if (((void *)cached_sram_base + OXNAS_SRAM_SIZE - ptr) >= sz) {
+			cached_sram_alloc_ptr = ptr + sz;
+			if (gfp & __GFP_ZERO) {
+				memset(ptr, 0, sz);
+			}
+			if (ppa != NULL)
+				*ppa = (u32)ptr - (u32)cached_sram_base + SRAM_BASE_PA;
+			printk(KERN_DEBUG "%s(): allocated %u bytes at address 0x%08X (pa=0x%08X)\n",
+				__func__, (u32)sz, (u32)ptr, (u32)ptr - (u32)cached_sram_base + SRAM_BASE_PA);
+		}
+		else
+			ptr = NULL;
+	}
+	local_irq_restore(flags);
+
+	return ptr;
+}
+
+void *oxnas_sram_zalloc(size_t sz, dma_addr_t *ppa)
+{
+	return oxnas_sram_alloc(sz, ppa, __GFP_ZERO);
