+static int oxnas_dma_init(struct platform_device *pdev)
+{
+    int i;
+    u32 intId;
+    void __iomem *port_base = NULL;
+	struct resource *res;
+
+#ifdef CONFIG_DRIVERS_PRIVATE_IN_SRAM
+	adma_priv = oxnas_sram_zalloc(sizeof(oxnas_adma_controller_t), NULL);
+#else
+	adma_priv = devm_kzalloc(&pdev->dev, sizeof(oxnas_adma_controller_t), GFP_KERNEL);
+#endif
+	if (adma_priv == NULL) {
+		adma_err(DRIVER_NAME ": couldn't allocate %u bytes for private data\n", sizeof(oxnas_adma_controller_t));
+		return -ENOMEM;
+	}
+	platform_set_drvdata(pdev, adma_priv);
+	adma_priv->common.dev = &pdev->dev;
+
+	// Coherent per-channel pattern words (memset fixed-source trick);
+	// dma_alloc_coherent() guarantees the DMA sees what we wrote
+	// without any manual cache maintenance.
+	adma_priv->staging_words = dma_alloc_coherent(
+		&pdev->dev,
+		sizeof(u32) * OXNAS_DMA_MAX_CHANNELS,
+		&adma_priv->staging_words_dma,
+		GFP_KERNEL);
+	if (adma_priv->staging_words == NULL) {
+		adma_err("failed to allocate DMA staging words\n");
+		return -ENOMEM;
+	}
+
+	// Ensure the DMA and SG-DMA blocks is properly reset
+	oxnas_dma_reset_assert();
+	oxnas_dma_reset_deassert();
+	// Enable the clock to the DMA block
+	oxnas_dma_clock_enable();
+
+	port_base = oxnas_devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(port_base)) {
+		return PTR_ERR(port_base);
+	}
+	adma_priv->iomap = port_base;
+
+	port_base = oxnas_devm_platform_get_and_ioremap_resource(pdev, 1, &res);
+	if (IS_ERR(port_base)) {
+		return PTR_ERR(port_base);
+	}
+	adma_priv->iomap_sg = port_base;
+
+    // Initialize the DMA controller
+    spin_lock_init(&adma_priv->spinlock_);
+    spin_lock_init(&adma_priv->channel_alloc_spinlock_);
+
+    // Initialize channel allocation management
+    adma_priv->channel_head_ = 0;
+
+    // Discover the number of channels available
+    intId = oxnas_dma_iochannel_read(0, DMA_INTR_ID);
+    adma_priv->common.chancnt = ((intId) >> 16) & 0xFF;
+    if (adma_priv->common.chancnt > OXNAS_DMA_MAX_CHANNELS) {
+	adma_warn("too many channels (reported %u but maximum supported is %u)\n",
+		adma_priv->common.chancnt, OXNAS_DMA_MAX_CHANNELS);
+        adma_priv->common.chancnt = OXNAS_DMA_MAX_CHANNELS;
+    }
+
+    intId = ((intId) >> 24) & 0xFF;
+    if (intId < 4) {
+        adma_err("%u-channel DMA Controller v%u has no support for v4+ interrupt clearing\n",
+	adma_priv->common.chancnt, intId);
+	    return -ENODEV;
+    }
+
+    adma_info("%u-channel DMA Controller v%u, iomap=0x%08X, iomap_sg=0x%08X\n",
+        adma_priv->common.chancnt, intId,
+	(u32)adma_priv->iomap, (u32)adma_priv->iomap_sg);
+
+	// Initialize list of DMA descriptors
+	adma_priv->sg_entries_per_channel = (OXNAS_SRAM_ADMA_DESCRIPTORS_SIZE
+		- sizeof(oxnas_dma_sg_info_t) * adma_priv->common.chancnt)
+		/ (sizeof(oxnas_dma_sg_entry_t) * adma_priv->common.chancnt);
+	// Initialize SRAM buffer management
+	adma_info("allocating %u %u-byte descriptors per channel\n",
+		adma_priv->sg_entries_per_channel, sizeof(oxnas_dma_sg_entry_t));
+
+	pdev->dev.dma_mask = &oxnas_dma_mask;
+	pdev->dev.coherent_dma_mask = OXNAS_MAX_DMA_ADDRESS;
+
+#ifdef CONFIG_DESCRIPTORS_IN_SRAM
+	adma_priv->descriptors = oxnas_sram_zalloc(OXNAS_SRAM_ADMA_DESCRIPTORS_SIZE, &adma_priv->descriptors_phys);
+#else
+	adma_priv->descriptors = dma_alloc_coherent(
+		&pdev->dev, OXNAS_SRAM_ADMA_DESCRIPTORS_SIZE, &adma_priv->descriptors_phys, GFP_KERNEL);
+#endif
+	if (adma_priv->descriptors == NULL) {
+		adma_err("failed to allocate %u bytes for ADMA descriptors\n", (u32)OXNAS_SRAM_ADMA_DESCRIPTORS_SIZE);
+		return -ENODEV;
+	}
+
+    // Initialize all available DMA channels
+	INIT_LIST_HEAD(&adma_priv->common.channels);
+    for (i = adma_priv->common.chancnt - 1; i >= 0; i--) {
+	u32 irq = 0;
+
+        oxnas_adma_channel_t *channel = &adma_priv->channels_[i];
+
+	channel->common.device = &adma_priv->common;
+        channel->common.chan_id = i;
+	list_add(&channel->common.device_node, &adma_priv->common.channels);
+
+        // Initialize heads of src and dst SG lists to null
+	channel->sg_info_ = adma_priv->descriptors + sizeof(oxnas_dma_sg_info_t) * i;
+        channel->sg_info_->p_srcEntries_ = 0;
+        channel->sg_info_->p_dstEntries_ = 0;
+	channel->sg_entries_ = adma_priv->descriptors
+		+ sizeof(oxnas_dma_sg_info_t) * adma_priv->common.chancnt
+		+ sizeof(oxnas_dma_sg_entry_t) * adma_priv->sg_entries_per_channel * i;
+
+        channel->callback_ = NULL;
+
+        // Per-channel pending queue for the DMAengine layer
+        INIT_LIST_HEAD(&channel->queue);
+        channel->active_tx = NULL;
+
+        channel->error_code_ = 0;
+
+        // Initialize the atomic variable maintaining the count of in-progress
+        // transfers for the channel. Currently can be a maximum of two, as
+        // the hardware can only queue details for a pair of transfers
+        atomic_set(&channel->active_count_, 0);
+
+        // Add channel to free list
+        oxnas_dma_free(channel);
+
+		// Connect the dma interrupt handler
+		if (pdev->dev.of_node != NULL)
+			irq = irq_of_parse_and_map(pdev->dev.of_node, i);
+		if (irq <= 0)
+			irq = platform_get_irq(pdev, i);
+		if (devm_request_irq(&pdev->dev, irq, &oxnas_dma_irq_handler, 0, dev_driver_string(&pdev->dev), channel)) {
+			panic("DMA: Failed to allocate interrupt %u\n", irq);
+		}
+    }
+
+	return 0;
+}
