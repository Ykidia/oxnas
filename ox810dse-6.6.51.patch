+MODULE_LICENSE("GPL");
+MODULE_VERSION("2.0");
+MODULE_AUTHOR(DRIVER_AUTHOR);
+MODULE_DESCRIPTION(DRIVER_DESC);
+
+/**************************************************************************
+* TYPEDEF
+**************************************************************************/
+
+/**
+ * Structs to hold host and per-port private (specific to this driver) datas
+ */
+typedef struct ox810se_sata_port_priv {
+	struct ata_port *port;
+	spinlock_t scrlock;
+	u8 last_ctl;
+} ox810se_sata_port_priv_t;
+
+typedef struct ox810se_sata_host_priv {
+	struct ata_host *host;
+	void __iomem *iomap;
+	dma_addr_t data_phys;
+	struct ata_port_operations port_ops;
+	ox810se_sata_port_priv_t ports_priv[SATA_OXNAS_MAX_PORTS];
+	struct ata_port *active_ap;
+	struct dma_chan *chan;
+#ifdef SATA_USE_NEW_ADMA_DRIVER
+	struct dma_async_tx_descriptor *desc;
+#endif
+	bool hw_raid_active;
+#ifdef SATA_USE_RESOURCES_BY_DT
+	struct clk *clk;
+	struct reset_control *rst_sata;
+	struct reset_control *rst_link;
+	struct reset_control *rst_phy;
+#endif
+	struct ata_port_info port_info;
+	struct scsi_host_template sht;
+	struct platform_device *pdev;
+} ox810se_sata_host_priv_t;
