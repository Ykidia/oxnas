diff -ruN a/arch/arm/lib/memcmp.c b/arch/arm/lib/memcmp.c
--- a/arch/arm/lib/memcmp.c	1970-01-01 03:00:00.000000000 +0300
+++ b/arch/arm/lib/memcmp.c	2023-06-03 23:08:34.000000000 +0300
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Faster memcmp() implementation.
+ *
+ * Copyright (C) Artem Bogdanov <temabogdanov@gmail.com>
+ */
+
+#include <linux/kernel.h>
+#include <linux/limits.h>
+
+
+#define mcmp_tail(addr1, addr2, end) \
+	while ((addr1) < (end)) { \
+		int res = *(addr1)++ - *(addr2)++; \
+		if (res != 0) \
+			return res; \
+	}
+#define mcmp_load(w_t, idx, addr1, addr2, d1, d2, lbl) \
+	d1 = *(const w_t *)(&(addr1)[sizeof(w_t) * (idx)]); \
+	d2 = *(const w_t *)(&(addr2)[sizeof(w_t) * (idx)]); \
+	if (d1 != d2) \
+		goto lbl;
+#define mcmp_rep1(w_t, idx, addr1, addr2, d1, d2, lbl); \
+	mcmp_load(w_t, idx, addr1, addr2, d1, d2, lbl);
+#define mcmp_rep2(w_t, idx, addr1, addr2, d1, d2, lbl); \
+	mcmp_rep1(w_t, idx, addr1, addr2, d1, d2, lbl); \
+	mcmp_rep1(w_t, (idx)+1, addr1, addr2, d1, d2, lbl);
+#define mcmp_rep4(w_t, idx, addr1, addr2, d1, d2, lbl); \
+	mcmp_rep2(w_t, idx, addr1, addr2, d1, d2, lbl); \
+	mcmp_rep2(w_t, (idx)+2, addr1, addr2, d1, d2, lbl);
+#define mcmp_rep8(w_t, idx, addr1, addr2, d1, d2, lbl); \
+	mcmp_rep4(w_t, idx, addr1, addr2, d1, d2, lbl); \
+	mcmp_rep4(w_t, (idx)+4, addr1, addr2, d1, d2, lbl);
+#define mcmp_rep16(w_t, idx, addr1, addr2, d1, d2, lbl); \
+	mcmp_rep8(w_t, idx, addr1, addr2, d1, d2, lbl); \
+	mcmp_rep8(w_t, (idx)+8, addr1, addr2, d1, d2, lbl);
+#define mcmp_repn(w_t, addr1, addr2, end, d1, d2, lbl, x); \
+	while ((addr1) <= (end)) { \
+		mcmp_rep##x(w_t, 0, addr1, addr2, d1, d2, lbl); \
+		addr1 += sizeof(w_t) * (x); \
+		addr2 += sizeof(w_t) * (x); \
+	} \
+	end += sizeof(w_t) * ((x)/2);
+#define mcmp_words(w_t, addr1, addr2, end, mask, count) \
+	if ((((u32)(addr1) - (u32)(addr2)) & (mask)) == 0) { \
+		u32 r = ((u32)(addr1) + (mask)) & ~(mask); \
+		const u8 *end0 = (const u8 *)(((u32)addr1 + count) & ~(sizeof(w_t) - 1)) - (sizeof(w_t) * 8); \
+		w_t d1, d2; \
+		mcmp_tail(addr1, addr2, (u8 *)r); \
+		mcmp_repn(w_t, addr1, addr2, end0, d1, d2, mcmp_w##w_t, 8); \
+		mcmp_repn(w_t, addr1, addr2, end0, d1, d2, mcmp_w##w_t, 4); \
+		mcmp_repn(w_t, addr1, addr2, end0, d1, d2, mcmp_w##w_t, 2); \
+		mcmp_repn(w_t, addr1, addr2, end0, d1, d2, mcmp_w##w_t, 1); \
+		mcmp_tail(addr1, addr2, end); \
+		return 0; \
+mcmp_w##w_t: \
+		while (1) { \
+			int res = (d1 & U8_MAX) - (d2 & U8_MAX); \
+			if (res != 0) \
+				return res; \
+			d1 /= U8_MAX + 1; \
+			d2 /= U8_MAX + 1; \
+		} \
+	}
+
+
+int memcmp(const void *cs, const void *ct, size_t count)
+{
+	const u8 *su1 = (const u8 *)cs, *su2 = (const u8 *)ct, *su_end = su1 + count;
+	if (count >= 16) {
+		mcmp_words(u64, su1, su2, su_end, sizeof(u32) - 1, count);
+		mcmp_words(u16, su1, su2, su_end, sizeof(u16) - 1, count);
+	}
+
+	mcmp_tail(su1, su2, su_end);
+	return 0;
+}
+EXPORT_SYMBOL(memcmp);
+
diff -ruN a/arch/arm/mach-oxnas/i2s.c b/arch/arm/mach-oxnas/i2s.c
--- a/arch/arm/mach-oxnas/i2s.c	1970-01-01 03:00:00.000000000 +0300
+++ b/arch/arm/mach-oxnas/i2s.c	2023-04-17 01:30:40.000000000 +0300
@@ -0,0 +1,221 @@
+/*
+ */
+
+#include <linux/types.h>
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/kernel.h>	/* We're doing kernel work */
+#include <linux/module.h>	/* Specifically, a module */
+#include <linux/proc_fs.h>	/* Necessary because we use proc fs */
+#include <linux/seq_file.h>
+#include <linux/cred.h>
+#include <linux/sched.h>
+#include <mach/hardware.h>
+
+
+#define DRV_NAME		"i2s"
+#define DRV_VERSION	"0.1"
+#define PROC_ENTRY_FILENAME 	"i2s"
+#define PROCFS_MAX_SIZE 	2048
+
+
+MODULE_AUTHOR("Chris Ford");
+MODULE_DESCRIPTION("I2S Test module");
+MODULE_LICENSE("GPL");
+MODULE_VERSION(DRV_VERSION);
+
+
+// Virtual I2S_BASE_PA
+static u32 i2s_regs_base = 0;
+
+
+/**
+ * The buffer (2k) for this module
+ *
+ */
+static char procfs_buffer[PROCFS_MAX_SIZE];
+
+/**
+ * The size of the data hold in the buffer
+ *
+ */
+static unsigned long procfs_buffer_size = 0;
+
+/**
+ * The structure keeping information about the /proc file
+ *
+ */
+static struct proc_dir_entry *procfs_i2s_file;
+
+
+static inline u32 oxnas_i2s_read(u32 reg)
+{
+	return readl((void __iomem *)(i2s_regs_base + reg));
+}
+
+static inline void oxnas_i2s_write(u32 reg, u32 val)
+{
+	writel(val, (void __iomem *)(i2s_regs_base + reg));
+}
+
+void RefreshI2SRegisters(void)
+{
+	int iLen = sprintf(procfs_buffer,
+		"--- DumpI2SRegisters ---------------------------\n"
+		"\n"
+		"     TX_CONTROL                = 0x%08x\n"
+		"     TX_SETUP                  = 0x%08x\n"
+		"     TX_SETUP1                 = 0x%08x\n"
+		"     TX_STATUS                 = 0x%08x\n"
+		"     RX_CONTROL                = 0x%08x\n"
+		"     RX_SETUP                  = 0x%08x\n"
+		"     RX_SETUP1                 = 0x%08x\n"
+		"     RX_STATUS                 = 0x%08x\n"
+		"     TX_DEBUG                  = 0x%08x\n"
+		"     TX_DEBUG2                 = 0x%08x\n"
+		"     TX_DEBUG3                 = 0x%08x\n"
+		"     RX_DEBUG                  = 0x%08x\n"
+		"     RX_DEBUG2                 = 0x%08x\n"
+		"     RX_DEBUG3                 = 0x%08x\n"
+		"     TX_BUFFER_LEVEL           = 0x%08x\n"
+		"     TX_BUFFER_INTERRUPT_LEVEL = 0x%08x\n"
+		"     RX_BUFFER_LEVEL           = 0x%08x\n"
+		"     RX_BUFFER_INTERRUPT_LEVEL = 0x%08x\n"
+		"     RX_SPDIF_DEBUG            = 0x%08x\n"
+		"     RX_SPDIF_DEBUG2           = 0x%08x\n",
+		oxnas_i2s_read(TX_CONTROL               ),
+		oxnas_i2s_read(TX_SETUP                 ),
+		oxnas_i2s_read(TX_SETUP1                ),
+		oxnas_i2s_read(TX_STATUS                ),
+		oxnas_i2s_read(RX_CONTROL               ),
+		oxnas_i2s_read(RX_SETUP                 ),
+		oxnas_i2s_read(RX_SETUP1                ),
+		oxnas_i2s_read(RX_STATUS                ),
+		oxnas_i2s_read(TX_DEBUG                 ),
+		oxnas_i2s_read(TX_DEBUG2                ),
+		oxnas_i2s_read(TX_DEBUG3                ),
+		oxnas_i2s_read(RX_DEBUG                ),
+		oxnas_i2s_read(RX_DEBUG2                ),
+		oxnas_i2s_read(RX_DEBUG3                ),
+		oxnas_i2s_read(TX_BUFFER_LEVEL          ),
+		oxnas_i2s_read(TX_BUFFER_INTERRUPT_LEVEL),
+		oxnas_i2s_read(RX_BUFFER_LEVEL          ),
+		oxnas_i2s_read(RX_BUFFER_INTERRUPT_LEVEL),
+		oxnas_i2s_read(RX_SPDIF_DEBUG           ),
+		oxnas_i2s_read(RX_SPDIF_DEBUG2          ));
+
+	procfs_buffer_size = iLen + sprintf(procfs_buffer + iLen,
+		"     INTERRUPT_CONTROL_STATUS  = 0x%08x\n"
+		"     INTERRUPT_MASK            = 0x%08x\n"
+		"     VERSION                   = 0x%08x\n"
+		"     TX_DATA_IN_FORMAT         = 0x%08x\n"
+		"     TX_CHANNELS_ENABLE        = 0x%08x\n"
+		"     TX_WRITES_TO              = 0x%08x\n"
+		"     RX_DATA_OUT_FORMAT        = 0x%08x\n"
+		"     RX_CHANNELS_ENABLE        = 0x%08x\n"
+		"     RX_READS_FROM             = 0x%08x\n"
+		"     TX_CPU_DATA_WRITES_ALT    = 0x%08x\n"
+		"     RX_CPU_DATA_READS_ALT     = 0x%08x\n"
+		"     TX_CPU_DATA_WRITES        = 0x%08x\n"
+		"     RX_CPU_DATA_READS         = 0x%08x\n"
+		"\n"
+		"------------------------------------------------\n",
+		oxnas_i2s_read(INTERRUPT_CONTROL_STATUS ),
+		oxnas_i2s_read(INTERRUPT_MASK           ),
+		oxnas_i2s_read(VERSION                  ),
+		oxnas_i2s_read(TX_DATA_IN_FORMAT        ),
+		oxnas_i2s_read(TX_CHANNELS_ENABLE       ),
+		oxnas_i2s_read(TX_WRITES_TO             ),
+		oxnas_i2s_read(RX_DATA_OUT_FORMAT       ),
+		oxnas_i2s_read(RX_CHANNELS_ENABLE       ),
+		oxnas_i2s_read(RX_READS_FROM            ),
+		oxnas_i2s_read(TX_CPU_DATA_WRITES_ALT   ),
+		oxnas_i2s_read(RX_CPU_DATA_READS_ALT    ),
+		oxnas_i2s_read(TX_CPU_DATA_WRITES       ),
+		oxnas_i2s_read(RX_CPU_DATA_READS        ));
+}
+
+/**
+ * This funtion is called when the /proc file is read
+ *
+ */
+static int procfs_i2s_file_show(struct seq_file *m, void *v)
+{
+	/* Setup the I2S TX Core... */
+	u32 temp = 1UL             << TX_CONTROL_ENABLE
+		| 1UL             << TX_CONTROL_FLUSH
+		| 0UL             << TX_CONTROL_MUTE
+		| 0UL             << TX_CONTROL_TRICK
+		| 0UL             << TX_CONTROL_SPEED
+		| 1UL             << TX_CONTROL_ABORT_DMA
+		| 0UL             << TX_CONTROL_AHB_ENABLE
+		| 1UL             << TX_CONTROL_QUAD_BURSTS;
+	oxnas_i2s_write(TX_CONTROL, temp);
+
+	temp = TRUE_I2S        << TX_SETUP_FORMAT
+		| I2S_SLAVE       << TX_SETUP_MODE
+		| 0UL             << TX_SETUP_FLOW_INVERT
+		| 0UL             << TX_SETUP_POS_EDGE
+		| 0UL             << TX_SETUP_CLOCK_STOP
+		| 0UL             << TX_SETUP_SPLIT_QUAD
+		| 0UL             << TX_SETUP_SPDIF_EN;
+	oxnas_i2s_write(TX_SETUP, temp);
+
+	temp = TWOS_COMPLIMENT << TX_SETUP1_INPUT
+		| 0UL             << TX_SETUP1_REVERSE
+		| 0UL             << TX_SETUP1_INVERT
+		| 0UL             << TX_SETUP1_BIG_ENDIAN
+		| 0UL             << TX_SETUP1_QUAD_ENDIAN
+		| 0UL             << TX_SETUP1_QUAD_SAMPLES
+		| 0UL             << TX_SETUP1_FLOW_CONTROL;
+	oxnas_i2s_write(TX_SETUP1, temp);
+
+	/* Setup the I2S RX Core... */
+
+	RefreshI2SRegisters();
+
+	seq_printf(m, "%s", procfs_buffer);
+
+	return 0;
+}
+
+/*
+ * Module initialization and cleanup
+ */
+static int __init oxnas_i2s_init_module(void)
+{
+	printk(KERN_DEBUG "I2S::init_module\n");
+
+	i2s_regs_base = (u32)ioremap(I2S_BASE_PA, 0x100000);
+	if (!i2s_regs_base) {
+		printk(KERN_ERR "Error: Could not ioremap I2S_BASE_PA\n");
+		proc_remove(procfs_i2s_file);
+		return -ENODEV;
+	}
+
+	/* create the /proc file */
+	procfs_i2s_file = proc_create_single(PROC_ENTRY_FILENAME, 0, NULL, procfs_i2s_file_show);
+
+	/* check if the /proc file was created successfuly */
+	if (procfs_i2s_file == NULL){
+		printk(KERN_ERR "Error: Could not initialize /proc/%s\n",
+		       PROC_ENTRY_FILENAME);
+		return -ENOMEM;
+	}
+
+	printk(KERN_INFO "/proc/%s created\n", PROC_ENTRY_FILENAME);
+
+	return 0;	/* success */
+}
+
+static void __exit oxnas_i2s_cleanup_module(void)
+{
+	printk(KERN_DEBUG "I2S::cleanup_module\n");
+	proc_remove(procfs_i2s_file);
+	printk(KERN_INFO "/proc/%s removed\n", PROC_ENTRY_FILENAME);
+}
+
+module_init(oxnas_i2s_init_module);
+module_exit(oxnas_i2s_cleanup_module);
+
+
diff -ruN a/arch/arm/mach-oxnas/include/mach/dma.h b/arch/arm/mach-oxnas/include/mach/dma.h
--- a/arch/arm/mach-oxnas/include/mach/dma.h	1970-01-01 03:00:00.000000000 +0300
+++ b/arch/arm/mach-oxnas/include/mach/dma.h	2026-11-19 22:06:33.000000000 +0300
@@ -0,0 +1,159 @@
+/*
+ * linux/arch/arm/include/asm/arch-oxnas/dma.h
+ *
+ * Copyright (C) 2005 Oxford Semiconductor Ltd
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
+ *
+ *
+ * We have a generic DMAC that is a two port, memory to memory design, supporting
+ * multiple channels, each of which can transfer between any pair of memory
+ * regions. This DMAC architecture does not sit well with the std. ARM DMA
+ * architecture, thus we define a custom way of acquiring and operating on the
+ * available channels of the DMAC
+ */
+
+#ifndef __MACH_OXNAS_DMA_H__
+#define __MACH_OXNAS_DMA_H__
+
+
+#ifndef __ASSEMBLY__
+
+#include <linux/semaphore.h>
+#include <linux/interrupt.h>
+#include <linux/device.h>
+#include <linux/of_irq.h>
+#include <linux/of_dma.h>
+
+#endif //__ASSEMBLY__
+
+/* Do not want to use the std. ARM DMA architecure */
+//#define MAX_DMA_CHANNELS 0
+
+/* All memory DMAable */
+#define OXNAS_MAX_DMA_ADDRESS UL(~0)
+
+/* Below these sizes the ARM926 core beats the channel setup cost */
+#define OXNAS_DMA_MEMCPY_MIN_BYTES	512
+#define OXNAS_DMA_MEMSET_MIN_BYTES	256
+
+
+#ifndef __ASSEMBLY__
+
+typedef enum oxnas_dma_mode {
+	OXNAS_DMA_MODE_FIXED,
+	OXNAS_DMA_MODE_INC
+} oxnas_dma_mode_t;
+
+typedef struct oxnas_dma_device_settings {
+	dma_addr_t      address_;
+//	unsigned        fifo_size_;   // Chained transfers must take account of FIFO offset at end of previous transfer
+	unsigned        max_sg_entries_         : 12,
+	                dreq_                   : 4,
+	                read_eot_policy_        : 2,
+	                write_eot_policy_       : 2,
+	                bus_                    : 1,
+	                width_                  : 2,
+	                transfer_mode_          : 1,
+	                address_mode_           : 1,
+	                address_really_fixed_   : 1;
+} oxnas_dma_device_settings_t;
+
+extern u64 oxnas_dma_mask;
+
+/* Pre-defined settings for known DMA devices */
+extern oxnas_dma_device_settings_t oxnas_sata_dma_settings;
+extern oxnas_dma_device_settings_t oxnas_dpe_rx_dma_settings;
+extern oxnas_dma_device_settings_t oxnas_dpe_tx_dma_settings;
+
+/**
+ * Blocking DMA fill of a physical range with a byte pattern using the
+ * constant-source hardware trick (vendor dma.c heritage). dst must be
+ * 4-byte aligned, length a multiple of 4 and <= the hardware maximum.
+ * Returns 0 on success, -ERANGE/-EBUSY on refusal (caller falls back
+ * to the CPU).
+ */
+extern int oxnas_dma_memset_sync(dma_addr_t dst, u8 pattern, unsigned length);
+
+/**
+ * Asynchronous single-shot physical copy on a free channel; the
+ * callback (hardirq context) fires on completion. 0 on success.
+ */
+extern int oxnas_dma_memcpy_async(dma_addr_t dst, dma_addr_t src,
+	unsigned length, void (*callback)(void *), void *callback_arg);
+
+extern struct dma_chan *oxnas_dma_request_chan(
+	struct device                   *const dev,
+	oxnas_dma_device_settings_t     *const settings);
+
+extern void oxnas_dma_free_chan(struct dma_chan *const chan);
+
+extern bool oxnas_dma_is_active(struct dma_chan *const chan);
+
+/**
+ * @return An int which is zero on success. Non-zero will returned if the length
+ *         exceeds that allowed by the hardware
+ */
+extern int oxnas_dma_device_set(
+	struct dma_chan                 *const chan,
+	const enum dma_data_direction   direction,
+	void                            *const mem_adr,   // Physical address
+	const unsigned                  length,
+	oxnas_dma_device_settings_t     *const device_settings,
+	const oxnas_dma_mode_t          mem_mode);
+
+/**
+ *  NB This function does not have an error return value, but if it is passed
+ *     a transfer segment longer than the maximum allowed by the hardware, that
+ *     entry will be zeroed in the SG descriptor list and a kernel warning
+ *     message generated
+ */
+extern int oxnas_dma_set_sg(
+	struct dma_chan         *const chan,
+	struct scatterlist      *const src_sg,
+	const unsigned          src_sg_count,
+	struct scatterlist      *const dst_sg,
+	const unsigned          dst_sg_count,
+	const oxnas_dma_mode_t  src_mode,
+	const oxnas_dma_mode_t  dst_mode);
+
+/**
+ *  NB This function does not have an error return value, but if it is passed
+ *     a transfer segment longer than the maximum allowed by the hardware, that
+ *     entry will be zeroed in the SG descriptor list and a kernel warning
+ *     message generated
+ */
+extern int oxnas_dma_device_set_sg(
+	struct dma_chan                 *const chan,
+	const enum dma_data_direction   direction,
+	struct scatterlist              *mem_sg,
+	unsigned                        mem_sg_count,
+	oxnas_dma_device_settings_t     *const device_settings,
+	const oxnas_dma_mode_t          mem_mode,
+	const unsigned                  length);
+
+/**
+ * The callback function should complete quickly and must not sleep
+ */
+extern void oxnas_dma_set_callback(struct dma_chan *const chan, void (*callback)(void *), void *callback_arg);
+
+extern void oxnas_dma_abort(struct dma_chan *const chan);
+
+extern void oxnas_dma_start(struct dma_chan *const chan);
+
+#endif // __ASSEMBLY__
+
+
+#endif // __MACH_OXNAS_DMA_H__
