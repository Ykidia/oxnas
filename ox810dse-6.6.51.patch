+	oxnas_gpio_write(CONFIG_SATA_OXNAS_DISK_LIGHT_GPIO_LINE < GPIO_AB_NUM_PINS
+			? GPIO_A_OUTPUT_SET : GPIO_B_OUTPUT_SET,
+		SATA_LED_MASK);
+#endif
+#endif
+
+#ifdef CONFIG_WDC_LEDS_TRIGGER_SATA_DISK
