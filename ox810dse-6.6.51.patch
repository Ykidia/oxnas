+enum {
+	FCS_LEN = 4,		// Ethernet CRC length
+	MIN_PACKET_SIZE = 68,
+	NORMAL_PACKET_SIZE = 1500,
+	MAX_JUMBO = 9000,
+	RX_BUFFER_SIZE = 2040,	// Must be multiple of 4, If lower than MIN_PACKET_SIZE will size buffer to hold a single MTU-sized packet
+	EXTRA_RX_SKB_SPACE = 22,	// Ethernet header 14, VLAN 4, CRC 4
+	GMAC_HLEN = 66,		// The amount of header to copy from a receive packet into the skb buffer
+	GMAC_ALLOC_SIZE = PAGE_SIZE,
+};
+
+enum {
