+static void __init oxnas_init_time(void)
+{
+	printk(KERN_DEBUG "%s():\n", __func__);
+
+	clockevents_config_and_register(&oxnas_clk_event, TIMER_1_TICK_RATE, 0x40, 0x00FFFFFFUL);
+
+	// Connect the timer 1 interrupt handler
+	if (request_irq(oxnas_clk_event.irq, oxnas_timer1_irq_handler, IRQF_TIMER, "oxnas-timer1", &oxnas_clk_event)) {
+		printk(KERN_ERR "oxnas-timer1: cannot register IRQ %d\n", oxnas_clk_event.irq);
+		return;
+	}
+
+	// Stop timer 2 before programming it
+	// Note: do not expect 32-bit timer, both timers are 24-bit!!!
+	oxnas_rps_write(TIMER2_CONTROL, 0);
+	oxnas_rps_write(TIMER2_VALUE, 0);
+
+	// Setup timer 2 load value
+	oxnas_rps_write(TIMER2_LOAD, CLOCKSOURCE_MASK(24));
+
+	timer2_high_counter = 1;
+	oxnas_rps_write(RPS_IRQ_ENABLE, 1UL << TIMER_2_INTERRUPT);
+
+	// Setup timer 2 prescaler, free-running operation and start it
+	// This will not be used to generate interrupt, just as a hi-res
+	// source of timing information
+	oxnas_rps_write(TIMER2_CONTROL, TIMER_2_CONTROL_VALUE);
+	oxnas_rps_write(TIMER2_CLEAR, 0);
+
+	clocksource_register_hz(&oxnas_clk, TIMER_2_TICK_RATE);
+	sched_clock_register(oxnas_sched_clock, 56, TIMER_2_TICK_RATE);
+
+	// Connect the timer 2 interrupt handler
+	if (request_irq(TIMER_2_INTERRUPT, oxnas_timer2_irq_handler, IRQF_TIMER, "oxnas-timer2", NULL)) {
+		printk(KERN_ERR "oxnas-timer2: cannot register IRQ %d\n", TIMER_2_INTERRUPT);
+		return;
+	}
+}
