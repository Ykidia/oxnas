+static oxnas_adma_controller_t *adma_priv = NULL;
+
+
+static inline dma_addr_t adma_virt_to_phys(void *const va) {
+	return (u32)va - (u32)adma_priv->descriptors + adma_priv->descriptors_phys;
+}
+
+static inline void *adma_phys_to_virt(dma_addr_t pa) {
+	return (void *)(pa - adma_priv->descriptors_phys + (u32)adma_priv->descriptors);
+}
+
+static inline void __iomem *oxnas_dma_io(void)
+{
+	return adma_priv->iomap;
+}
+
+static inline void __iomem *oxnas_dma_iosg(void)
+{
+	return adma_priv->iomap_sg;
+}
+
+static inline u32 oxnas_dma_io_read(const u32 reg)
+{
+	return readl(oxnas_dma_io() + reg);
+}
+
+static inline void oxnas_dma_io_andor(const u32 reg, const u32 andmask, const u32 orval)
+{
+	if (andmask != 0)
+		writel((readl(oxnas_dma_io() + reg) & andmask) | orval, oxnas_dma_io() + reg);
+	else
+		writel(orval, oxnas_dma_io() + reg);
+}
+
+// Std DMA controller has 8 quad-sized registers per channel arranged contiguously
+//#define DMA_CALC_REG_ADR(channel, register) (DMA_BASE + ((channel) << 5) + (register))
+static inline u32 oxnas_dma_iochannel_read(const u32 channel, const u32 reg)
+{
+	return oxnas_dma_io_read((channel << 5) + reg);
+}
+
+static inline void oxnas_dma_iochannel_andor(const u32 channel, const u32 reg, const u32 andmask, const u32 orval)
+{
+	oxnas_dma_io_andor((channel << 5) + reg, andmask, orval);
+}
+
+static inline u32 oxnas_dma_iosg_read(const u32 reg)
+{
+	return readl(oxnas_dma_iosg() + reg);
+}
+
+static inline void oxnas_dma_iosg_andor(const u32 reg, const u32 andmask, const u32 orval)
+{
+	if (andmask != 0)
+		writel((readl(oxnas_dma_iosg() + reg) & andmask) | orval, oxnas_dma_iosg() + reg);
+	else
+		writel(orval, oxnas_dma_iosg() + reg);
+}
+
+// SGDMA controller has 4 quad-sized registers per channel arranged contiguously
+//#define DMA_SG_CALC_REG_ADR(channel, register) (DMA_SG_BASE + ((channel) << 4) + (register))
+static inline u32 oxnas_dma_iosgchannel_read(const u32 channel, const u32 reg)
+{
+	return oxnas_dma_iosg_read((channel << 4) + reg);
+}
+
+static inline void oxnas_dma_iosgchannel_andor(const u32 channel, const u32 reg, const u32 andmask, const u32 orval)
+{
+	oxnas_dma_iosg_andor((channel << 4) + reg, andmask, orval);
+}
+
+static inline bool oxnas_dma_busy_check(const oxnas_adma_channel_t *const channel)
+{
+	return atomic_read(&channel->active_count_) != 0;
+}
+
+static void oxnas_dma_unmap_sata_sg(struct device *dev, struct scatterlist *sg, int nents,
+		enum dma_data_direction dir, unsigned long attrs)
+{
+	oxnas_adma_channel_t *channel = dev->platform_data;
+	const struct dma_map_ops *ops = get_dma_ops(dev);
+	struct scatterlist *s;
+	int i;
+
+	if (nents == 1)
+		ops->unmap_page(dev, sg_dma_address(sg), sg_dma_len(sg), dir, attrs);
+	else {
+		oxnas_dma_sg_entry_t *sg_entry = channel->sg_entries_;
+		for_each_sg(sg, s, nents, i) {
+			ops->unmap_page(dev, sg_entry->addr_, sg_dma_len(s), dir, attrs);
+			sg_entry++;
+		}
+	}
+}
+
+static int oxnas_dma_map_sata_sg(struct device *dev, struct scatterlist *sg, int nents,
+		enum dma_data_direction dir, unsigned long attrs)
+{
+	oxnas_adma_channel_t *channel = dev->platform_data;
+	const struct dma_map_ops *ops = get_dma_ops(dev);
+	struct scatterlist *s;
+	int i;
+
+	if (nents == 1) {
+		sg->dma_address = ops->map_page(dev, sg_page(sg), sg->offset,
+						sg->length, dir, attrs);
+		if (dma_mapping_error(dev, sg->dma_address))
+			return -EIO;
+	}
+	else {
+		oxnas_dma_sg_entry_t *sg_entry = channel->sg_entries_, *previous_entry;
+
+		for_each_sg(sg, s, nents, i) {
+			dma_addr_t p_addr = ops->map_page(dev, sg_page(s), s->offset,
+							s->length, dir, attrs);
+			if (dma_mapping_error(dev, p_addr)) {
+				int j;
+				sg_entry = channel->sg_entries_;
+				for_each_sg(sg, s, i, j) {
+					ops->unmap_page(dev, sg_entry->addr_, sg_dma_len(s), dir, attrs);
+					sg_entry++;
+				}
+				adma_err("error mapping SG list on channel %u for SATA\n",
+					channel->common.chan_id);
+				return -EIO;
+			}
+			// Fill in the SG list entry with start address, ensuring only valid
+			// address bits are used, preserving the checksum enabling flag
+			sg_entry->addr_ = p_addr/* & OXNAS_DMA_ADR_MASK*/;
+			// Fill in the length, checking that it does not exceed the hardware
+			// allowed maximum
+			sg_entry->length_ = s->length;
+			if (unlikely(sg_entry->length_ > OXNAS_DMA_MAX_TRANSFER_LENGTH)) {
+				adma_warn("source entry too long, zeroing\n");
+				sg_entry->length_ = 0;
+			}
+			// Get pointer to next available SG entry
+			previous_entry = sg_entry;
+			sg_entry++;
+			// Link the previous SG list entry forward to this one
+			previous_entry->p_next_ = adma_virt_to_phys(sg_entry);
+		}
+		previous_entry->p_next_ = 0;
+	}
+
+	return nents;
+}
