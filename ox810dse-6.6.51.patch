+#ifdef CONFIG_NET_POLL_CONTROLLER
+// Polling 'interrupt' - used by things like netconsole to send skbs without
+// having to re-enable interrupts. It's not called while the interrupt routine
+// is executing.
+static void gmac_netpoll(struct net_device *netdev)
+{
+#ifdef CONFIG_LEON_COPRO
+	// PATCH (fix netpoll): in CoPro mode the driver owns the
+	// semaphore interrupts, not netdev->irq. Poll both of them
+	disable_irq(SEM_A_INTERRUPT);
+	gmac_common_irq_handler(SEM_A_INTERRUPT, netdev);
+	enable_irq(SEM_A_INTERRUPT);
+	disable_irq(SEM_B_INTERRUPT);
+	gmac_common_irq_handler(SEM_B_INTERRUPT, netdev);
+	enable_irq(SEM_B_INTERRUPT);
+#else
+	disable_irq(netdev->irq);
+	gmac_common_irq_handler(netdev->irq, netdev);
+	enable_irq(netdev->irq);
+#endif
+}
+#endif // CONFIG_NET_POLL_CONTROLLER
