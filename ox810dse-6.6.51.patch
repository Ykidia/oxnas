+	printk("  available_for_write = %d\n", available_for_write(&gmac_priv->rx_gmac_desc_list_info));
+	printk("  available_for_read    %s\n", rx_available_for_read(&gmac_priv->rx_gmac_desc_list_info, 0) ? "yes" :"no");
+
+	/* PATCH TXRX-4 follow-up: the tx_lock this used to take was removed
+	 * with the lockless xmit redesign (see gmac-napi.c); there is no lock
+	 * to serialise against anymore.  The ring reads below stay bare:
+	 * get_regs() is ethtool diagnostics (process context), the data is
+	 * advisory-only, and on this UP machine the worst case is a torn
+	 * snapshot of indices from one poll cycle - acceptable for a debug
+	 * dump, and exactly what the vendor's unlocked ethtool did too. */
+	printk("TX ring info:\n");
+	printk("  num_descriptors     = %d\n", gmac_priv->tx_gmac_desc_list_info.num_descriptors);
+	printk("  empty_count         = %d\n", gmac_priv->tx_gmac_desc_list_info.empty_count);
+	printk("  r_index             = %d\n", gmac_priv->tx_gmac_desc_list_info.r_index);
+	printk("  w_index             = %d\n", gmac_priv->tx_gmac_desc_list_info.w_index);
+	printk("  available_for_write = %d\n", available_for_write(&gmac_priv->tx_gmac_desc_list_info));
+	printk("  available_for_read    %s\n", tx_available_for_read(&gmac_priv->tx_gmac_desc_list_info, &status) ? "yes" : "no");
+	printk("TX skb ring info:\n");
+	printk("  head_index          = %u\n", gmac_priv->tx_skb_ring_head_index);
+	printk("  tail_index          = %u\n", gmac_priv->tx_skb_ring_tail_index);
