+static inline struct sk_buff *gmac_alloc_skb(const unsigned length)
+{
+	struct sk_buff *skb = __netdev_alloc_skb(gmac_priv->netdev, length, GFP_ATOMIC | __GFP_NOWARN);
+	if (!skb) {
+		skb = __netdev_alloc_skb(gmac_priv->netdev, length, GFP_ATOMIC | __GFP_NOWARN | __GFP_RETRY_MAYFAIL);
+		if (!skb) {
+			skb = __netdev_alloc_skb(
+				gmac_priv->netdev, length, GFP_ATOMIC | __GFP_NOWARN | __GFP_RETRY_MAYFAIL | __GFP_MEMALLOC);
+		}
+	}
+
+	return skb;
+}
+
+static inline struct page *gmac_alloc_page(void)
+{
+	struct page *page = alloc_page(GFP_ATOMIC | __GFP_NOWARN);
+	if (!page) {
+		page = alloc_page(GFP_ATOMIC | __GFP_NOWARN | __GFP_RETRY_MAYFAIL);
+		if (!page) {
+			page = alloc_page(GFP_ATOMIC | __GFP_NOWARN | __GFP_RETRY_MAYFAIL | __GFP_MEMALLOC);
+		}
+	}
+
+	return page;
+}
