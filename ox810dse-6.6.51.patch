+/***************************************************************************/
+/* FUNCTION: oxnas_wd810_leds_set_switch                                            */
+/*                                                                         */
+/* PURPOSE:                                                                */
+/*   Set the LED display "on/off" of each state by Web GUI                      */
+/***************************************************************************/
+static void oxnas_wd810_leds_set_switch
+	(struct led_classdev *led_cdev, enum led_brightness value) {
+	leds_switch = value;
+}
